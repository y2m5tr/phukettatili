---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';

export const prerender = true;

const quickLinks = [
  { href: '/turlar', title: 'Tüm Turlar', desc: 'Ada turları ve macera rotaları', icon: '🏝️' },
  { href: '/vip', title: 'VIP Hizmetler', desc: 'Özel yat ve katamaran kiralama', icon: '🛥️' },
  { href: '/blog', title: 'Phuket Rehberi', desc: 'Hava durumu ve seyahat ipuçları', icon: '📖' },
  { href: '/iletisim', title: 'Bize Ulaşın', desc: '7/24 Türkçe WhatsApp destek', icon: '💬' },
];
---

<Layout title="Sayfa Bulunamadı" noIndex={true}>
  <div class="min-h-[75vh] flex items-center justify-center bg-slate-50 dark:bg-surface-1 py-16 px-4 transition-colors">
    <div class="max-w-2xl mx-auto text-center">
      <FadeIn direction="up">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-accent bg-brand-accent/10 px-4 py-1.5 rounded-full mb-4">
          Hata 404
        </span>
        <h1 class="text-7xl md:text-9xl font-serif font-bold text-brand-primary dark:text-white opacity-25 leading-none select-none">
          404
        </h1>
      </FadeIn>

      <FadeIn delay={0.15} direction="up">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-brand-primary dark:text-white mt-4 mb-3">
          Rotayı Kaybettik!
        </h2>
        <p class="text-slate-600 dark:text-slate-300 text-base max-w-md mx-auto mb-8 font-light leading-relaxed">
          Aradığınız sayfa taşınmış, silinmiş veya henüz haritalandırılmamış olabilir. Aşağıdaki rotalardan devam edebilirsiniz:
        </p>
      </FadeIn>

      <!-- Quick Navigation Grid -->
      <FadeIn delay={0.25} direction="up">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left mb-10">
          {quickLinks.map((link) => (
            <a 
              href={link.href}
              class="group p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-brand-accent/50 dark:hover:border-brand-accent/50 transition-all flex items-center gap-4"
            >
              <span class="text-2xl shrink-0 p-2.5 rounded-xl bg-slate-100 dark:bg-slate-700/60 group-hover:scale-110 transition-transform">
                {link.icon}
              </span>
              <div>
                <h3 class="font-bold text-sm text-brand-primary dark:text-white group-hover:text-brand-accent transition-colors">
                  {link.title}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                  {link.desc}
                </p>
              </div>
            </a>
          ))}
        </div>
      </FadeIn>

      <FadeIn delay={0.35} direction="up">
        <a 
          href="/" 
          class="premium-cta inline-flex items-center gap-2 bg-brand-accent hover:bg-brand-accent/90 text-white px-8 py-4 rounded-full font-bold transition-all transform hover:scale-105 shadow-xl shadow-amber-900/20"
        >
          <span>← Ana Sayfaya Dön</span>
        </a>
      </FadeIn>
    </div>
  </div>
</Layout>
