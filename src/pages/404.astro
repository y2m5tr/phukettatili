---
import Layout from '@/layouts/Layout.astro';
import { buildWhatsAppUrl } from '@/utils/whatsapp';

const waUrl = buildWhatsAppUrl('Sayfa Bulunamadı - Yardım');
---

<Layout
  title="Sayfa Bulunamadı"
  description="Aradığınız sayfa taşınmış veya silinmiş olabilir."
  breadcrumbTitle="404"
>
  <section class="shell" style="padding-block: var(--space-4xl); text-align: center; max-width: 600px;">
    <span class="wb-eyebrow" style="font-size: 14px;">Hata 404</span>
    <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); margin: 12px 0 20px; font-family: var(--font-display);">Sayfa Bulunamadı</h1>
    <p style="font-size: 1.125rem; color: var(--wb-olive); line-height: 1.6; margin-bottom: 32px;">
      Aradığınız rota veya sayfa adresi değişmiş olabilir. Ana sayfaya dönebilir veya turlarımızı inceleyebilirsiniz.
    </p>

    <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
      <a class="wb-button wb-button--text" href="/">Ana Sayfaya Dön</a>
      <a class="wb-button wb-button--text" href="/turlar/">Turları İncele</a>
      <a class="wb-button wb-button--primary" href={waUrl} target="_blank" rel="noopener">
        <img
          src="/assets/whatsapp-mark.svg"
          alt=""
          width="18"
          height="18"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        WhatsApp'tan Sor ↗
      </a>
    </div>
  </section>
</Layout>