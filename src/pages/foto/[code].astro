---
import '../../styles/global.css';
import { initialBookings, type Booking } from '../../data/adminInitialData';
import {
  generateDefaultTourPhotos,
  DEFAULT_INSTAGRAM_HANDLE,
  DEFAULT_GOOGLE_REVIEW_URL,
} from '../../lib/tourMediaVault';

export const prerender = false;

const { code } = Astro.params;

let booking: Booking | undefined;
if (code) {
  booking = initialBookings.find(
    (b) => b.id.toLowerCase() === code.toLowerCase() || (b.ticketCode && b.ticketCode.toLowerCase() === code.toLowerCase())
  );
}

const guestName = booking?.customerName || 'Değerli Misafirimiz';
const tourTitle = booking?.tourTitle || 'Phi Phi Adaları & Maya Bay VIP Turu';
const tourDate = booking?.tourDate || 'Bugün';
const photos = generateDefaultTourPhotos(tourTitle);
const cloudAlbumUrl = Astro.url.searchParams.get('album') || 'https://drive.google.com';
---

<!doctype html>
<html lang="tr" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{`${guestName} - Tur Hatıra Fotoğrafları | Phuket Tatili`}</title>
  <meta name="description" content="Phuket Tatili tur hatıra fotoğrafları ve yüksek çözünürlüklü dijital medya kasası." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-brand-accent selection:text-slate-950 font-sans">
  <div class="min-h-screen py-8 sm:py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-8 sm:space-y-12">
      
      <!-- Marka Navigasyon Barı -->
      <header class="flex items-center justify-between border-b border-slate-800 pb-5">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-xl">
            🌴
          </div>
          <div>
            <span class="text-sm font-black tracking-wider uppercase text-white block">Phuket Tatili</span>
            <span class="text-[10px] text-slate-400 block font-mono">VIP MEDYA KASASI</span>
          </div>
        </a>

        <div class="flex items-center gap-3">
          {code && (
            <a
              href={`/bilet/${code}`}
              class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition"
            >
              🎟️ Bilet & Plan
            </a>
          )}
          <a
            href="https://wa.me/66828900000"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/20 transition flex items-center gap-1.5"
          >
            <span>💬 Destek</span>
          </a>
        </div>
      </header>
      
      <!-- Üst Başlık & Karşılama Kartı -->
      <div class="bg-gradient-to-b from-slate-900 to-slate-950 p-6 sm:p-10 rounded-3xl border border-slate-800 shadow-2xl relative overflow-hidden text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-3 z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-brand-accent/10 border border-brand-accent/30 text-brand-accent">
            <span>📸</span>
            <span>ÖZEL DİJİTAL MEDYA KASASI</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black font-serif text-white tracking-tight">
            Harika Anılar Biriktirdik, Sayın {guestName}!
          </h1>

          <p class="text-sm text-slate-400">
            <strong class="text-white">{tourTitle}</strong> turumuzdan rehber ve fotoğrafçılarımızın çektiği yüksek çözünürlüklü fotoğraflar hazır. İster tek tek indirin, ister bulut albümün tamamını telefonunuza kaydedin.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 font-mono text-slate-300">
              📅 Tur Tarihi: {tourDate}
            </span>
            <span class="px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 font-mono text-emerald-400 font-bold">
              ✓ {photos.length} Profesyonel Kare
            </span>
          </div>
        </div>

        <!-- Google Drive / Orijinal Albüm Butonu -->
        <div class="z-10 shrink-0 w-full sm:w-auto">
          <a
            href={cloudAlbumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm shadow-xl shadow-amber-500/20 flex items-center justify-center gap-2.5 transition transform hover:-translate-y-0.5 cursor-pointer"
          >
            <span class="text-lg">📂</span>
            <span>Tüm Albümü İndir (Google Drive)</span>
          </a>
        </div>
      </div>

      <!-- FOTOĞRAF GALERİ GRİDİ -->
      <div>
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold font-serif text-white flex items-center gap-2">
              <span>🖼️</span>
              <span>Tur Fotoğraf Galeriniz</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
              Fotoğrafların üzerine tıklayarak büyütebilir veya doğrudan indirebilirsiniz.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
          {photos.map((photo, idx) => (
            <div class="bg-slate-900 border border-slate-800/80 rounded-3xl overflow-hidden shadow-lg group hover:border-slate-700 transition flex flex-col justify-between">
              <div class="relative overflow-hidden aspect-video bg-slate-950">
                <img
                  src={photo.url}
                  alt={photo.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-slate-950/80 text-white backdrop-blur-md border border-white/10">
                  {photo.category.toUpperCase()}
                </span>
                <span class="absolute top-3 right-3 w-7 h-7 rounded-full bg-slate-950/80 text-white flex items-center justify-center text-xs font-mono font-bold backdrop-blur-md">
                  #{idx + 1}
                </span>
              </div>

              <div class="p-5 flex items-center justify-between gap-3 border-t border-slate-800/60 bg-slate-900/50">
                <div class="min-w-0">
                  <h3 class="text-sm font-bold text-white truncate">{photo.title}</h3>
                  <span class="text-[11px] text-slate-400 font-mono">Yüksek Çözünürlük (4K)</span>
                </div>

                <a
                  href={photo.highResDownloadUrl}
                  download
                  class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold transition flex items-center gap-1.5 shrink-0 shadow-sm cursor-pointer"
                >
                  <span>⬇️</span>
                  <span>İndir</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- SOSYAL MEDYA & GOOGLE REVIEW BOOSTER KARTI -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Instagram Story Paylaşım Kartı -->
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-purple-950/40 via-slate-900 to-slate-950 border border-purple-500/20 text-left space-y-4 shadow-xl">
          <div class="flex items-center gap-3">
            <span class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 flex items-center justify-center text-2xl text-white shadow-lg">
              📸
            </span>
            <div>
              <h3 class="text-lg font-bold text-white">Instagram'da Bizi Etiketleyin</h3>
              <p class="text-xs text-purple-300">Fotoğraflarınızı hikayemizde paylaşalım!</p>
            </div>
          </div>

          <p class="text-xs text-slate-300 leading-relaxed">
            Phuket anılarınızı Instagram Story veya Post olarak paylaşırken hesabımızı etiketleyin, tur fotoğraflarınızı resmi sayfamızda öne çıkaralım:
          </p>

          <div class="flex items-center justify-between p-3 rounded-2xl bg-slate-950 border border-purple-500/30">
            <span class="font-mono font-bold text-sm text-purple-300">{DEFAULT_INSTAGRAM_HANDLE}</span>
            <button
              type="button"
              onclick={`navigator.clipboard.writeText('${DEFAULT_INSTAGRAM_HANDLE}'); alert('Instagram kullanıcı adı kopyalandı! 📋');`}
              class="px-3 py-1 rounded-xl bg-purple-600/30 hover:bg-purple-600/40 text-purple-200 text-xs font-bold transition cursor-pointer"
            >
              Kopyala
            </button>
          </div>
        </div>

        <!-- Google 5-Yıldız Yorum Teşviki -->
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-amber-950/40 via-slate-900 to-slate-950 border border-amber-500/20 text-left space-y-4 shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3">
              <span class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-2xl text-amber-400 shadow-lg">
                ⭐
              </span>
              <div>
                <h3 class="text-lg font-bold text-white">Deneyiminizi Yorumlayın</h3>
                <p class="text-xs text-amber-300">Diğer Türk gezginlere rehber olun!</p>
              </div>
            </div>

            <p class="text-xs text-slate-300 leading-relaxed mt-3">
              Rehberimizden ve ada turumuzdan memnun kaldıysanız, Google Haritalar'da bize 1 dakikanızı ayırıp 5 yıldızlı yorum bırakmanız bizi çok mutlu eder.
            </p>
          </div>

          <a
            href={DEFAULT_GOOGLE_REVIEW_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-center font-black text-xs sm:text-sm shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2 transition cursor-pointer"
          >
            <span>⭐⭐⭐⭐⭐</span>
            <span>Google'da Bizi Değerlendirin</span>
          </a>
        </div>
      </div>

      <!-- Alt Concierge Barı -->
      <div class="text-center pt-6 border-t border-slate-900 text-xs text-slate-500">
        <p>Phuket Tatili Operasyon Merkezi · 24/7 Misafir Destek Hattı: +66 82 890 0000</p>
      </div>

    </div>
  </div>
</body>
</html>
