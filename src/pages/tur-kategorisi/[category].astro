---
/**
 * 301 Kalıcı Yönlendirme (Permanent Redirect):
 * Eski /tur-kategorisi/[category] linklerini ve Google indekslerini
 * doğrudan ilgili tura veya /turlar/?kategori= filtresine taşır.
 * Böylece 404 hatası veya kırık link kalmaz, SEO gücü korunur.
 */
export const prerender = false;

const rawCategory = (Astro.params.category || '').toLowerCase().replace(/\/+$/, '');

// Özel doğrudan tura giden alt kategoriler / destinasyonlar
const TOUR_REDIRECTS: Record<string, string> = {
  'elephant': '/turlar/fil-besleme-ve-bakim-deneyimi',
  'phi-phi-islands': '/turlar/phi-phi-maya-ve-bamboo-adasi',
  'phi-phi': '/turlar/phi-phi-maya-ve-bamboo-adasi',
  'james-bond-island': '/turlar/james-bond-adasi-ve-kano-turu',
  'james-bond': '/turlar/james-bond-adasi-ve-kano-turu',
  'coral-island': '/turlar/coral-adasi-tam-gun-surat-teknesi',
  'similan-islands': '/turlar/similan-adalari-surat-teknesi-turu',
  'similan': '/turlar/similan-adalari-surat-teknesi-turu',
  'hong-by-starlight': '/turlar/hong-by-starlight-gece-kano-ve-plankton-deneyimi',
  'carnival-magic': '/turlar/carnival-magic-isik-ve-tema-parki',
  'fantasea-show': '/turlar/phuket-fantasea-kultur-ve-sahne-sovu',
  'simon-cabaret': '/turlar/simon-cabaret-phuket-gosterisi',
  'siam-niramit-show': '/turlar/siam-niramit-gosteri-deneyimi',
  'hanuman-world-zipline': '/turlar/hanuman-world-zipline-deneyimi',
  'atv-quad-bike': '/turlar/atv-quad-safari-ve-orman-macerasi',
  'white-water-rafting': '/turlar/khao-sok-ve-cheow-lan-golu-macerasi',
  'raya-yai-island': '/turlar/?kategori=island-tours',
  'khai-islands': '/turlar/?kategori=island-tours',
  'krabi-islands': '/turlar/?kategori=island-tours',
  'surin-islands': '/turlar/?kategori=island-tours',
};

// Ana kategori filtre yönlendirmeleri
const CATEGORY_REDIRECTS: Record<string, string> = {
  'island-tours': '/turlar/?kategori=island-tours',
  'adventure-tours': '/turlar/?kategori=adventure-tours',
  'entertainment-tours': '/turlar/?kategori=entertainment-tours',
  'private-charters': '/turlar/?kategori=private-charters',
};

let destination = '/turlar';

if (TOUR_REDIRECTS[rawCategory]) {
  destination = TOUR_REDIRECTS[rawCategory];
} else if (CATEGORY_REDIRECTS[rawCategory]) {
  destination = CATEGORY_REDIRECTS[rawCategory];
}

return Astro.redirect(destination, 301);
---
