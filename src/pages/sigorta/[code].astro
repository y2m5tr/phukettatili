---
export const prerender = false;

import { initialBookings, type Booking } from '../../data/adminInitialData';
import { getSupabaseAdmin, isSupabaseAdminConfigured } from '../../lib/server/supabaseAdmin';
import { rowToBooking } from '../../lib/supabase';
import siteSettings from '../../content/settings/site.json';

const codeParam = (Astro.params.code || '').trim();
const cleanCode = codeParam.toUpperCase();

let booking: Booking | null = null;

if (isSupabaseAdminConfigured()) {
  const db = getSupabaseAdmin();
  if (db && cleanCode) {
    try {
      const { data, error } = await db
        .from('bookings')
        .select('*')
        .eq('ticket_code', cleanCode)
        .maybeSingle();

      if (!error && data) {
        booking = rowToBooking(data);
      }

      if (!booking) {
        const { data: byId } = await db
          .from('bookings')
          .select('*')
          .eq('id', cleanCode)
          .maybeSingle();
        if (byId) {
          booking = rowToBooking(byId);
        }
      }
    } catch (err) {
      console.warn('Sigorta portalı sorgulama hatası:', err);
    }
  }
}

if (!booking && cleanCode) {
  const found = initialBookings.find(
    (b) => b.id.toUpperCase() === cleanCode || b.ticketCode?.toUpperCase() === cleanCode
  );
  if (found) {
    booking = found;
  }
}

const whatsappNumber = siteSettings.whatsappNumber || '905321112233';
---

<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{booking ? `${booking.customerName} - Tur Sigortası & Sağlık Beyanı | Phuket Tatili` : 'Sigorta Formu'}</title>
  <meta name="description" content="Tayland Turizm Bakanlığı (TAT) resmi acente sigortası ve sağlık beyanı formu" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-192.png?v=pt" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=pt" />
  <link rel="shortcut icon" href="/favicon.ico?v=pt" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=pt" />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-brand-accent selection:text-slate-950">
  <div class="max-w-xl mx-auto px-4 py-8 space-y-6">
    <!-- Header -->
    <header class="flex items-center justify-between border-b border-slate-800 pb-5">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-xl">
          🛡️
        </div>
        <div>
          <span class="text-sm font-black tracking-wider uppercase text-white block">Phuket Tatili</span>
          <span class="text-[10px] text-slate-400 block">TAT Tur Sigortası & Sağlık Beyanı</span>
        </div>
      </a>

      {booking && (
        <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-900 border border-slate-800 text-slate-300">
          {booking.id}
        </span>
      )}
    </header>

    {!booking ? (
      <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 text-center space-y-3">
        <div class="text-4xl">🔍</div>
        <h1 class="text-lg font-bold text-white">Rezervasyon Bulunamadı</h1>
        <p class="text-xs text-slate-400 max-w-sm mx-auto">
          Belirtilen koda ait aktif tur kaydı bulunamadı. Lütfen size iletilen linki kontrol ediniz veya destek hattımızla iletişime geçiniz.
        </p>
        <div class="pt-2">
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, tur sigortası formuna ulaşamadım, yardımcı olabilir misiniz?')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-lg"
          >
            <span>💬 7/24 WhatsApp Destek</span>
          </a>
        </div>
      </div>
    ) : (
      <main class="space-y-6">
        <!-- Tour Info Summary Card -->
        <div class="p-5 rounded-3xl bg-slate-900 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-black uppercase tracking-wider text-rose-400">
              🇹🇭 Tayland Seyahat & Kaza Sigortası
            </span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
              Zorunlu Kayıt
            </span>
          </div>

          <h1 class="text-lg font-black text-white">{booking.tourTitle}</h1>
          <p class="text-xs text-slate-400">
            Tarih: <strong class="text-white">{booking.tourDate}</strong> • Misafir: <strong class="text-white">{booking.customerName}</strong> ({booking.adultCount} Yetişkin{booking.childCount > 0 ? `, ${booking.childCount} Çocuk` : ''})
          </p>
        </div>

        <!-- Interactive Fast Form -->
        <div id="waiver-form-container" class="p-6 rounded-3xl bg-slate-900 border border-slate-800 shadow-xl space-y-5">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-white">Sağlık & Emniyet Beyan Formu</h2>
            <p class="text-xs text-slate-400">
              Tayland Turizm Otoritesi (TAT) ve deniz liman emniyeti kuralları gereğince lütfen aşağıdaki beyanları doldurunuz.
            </p>
          </div>

          <form id="waiver-form" class="space-y-4">
            <input type="hidden" id="booking-id" value={booking.id} />
            <input type="hidden" id="customer-name" value={booking.customerName} />

            <div>
              <label for="passport-no" class="block text-xs font-bold uppercase text-slate-400 mb-1">
                Pasaport Numarası (Sigorta Poliçesi İçin)
              </label>
              <input
                type="text"
                id="passport-no"
                placeholder="Örn: U12345678"
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-sm font-mono uppercase text-white focus:outline-none focus:border-rose-500"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="contact-name" class="block text-xs font-bold uppercase text-slate-400 mb-1">
                  Acil Durum İletişim Kişisi *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="Yakınınızın Adı Soyadı"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-rose-500"
                />
              </div>
              <div>
                <label for="contact-phone" class="block text-xs font-bold uppercase text-slate-400 mb-1">
                  Acil Durum Telefonu *
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  required
                  placeholder="+90 532..."
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-rose-500"
                />
              </div>
            </div>

            <!-- Health Checklist -->
            <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800/80 space-y-3">
              <span class="text-xs font-black uppercase tracking-wider text-amber-400 block">
                ⚠️ Sağlık Beyanı (Varsa lütfen işaretleyiniz):
              </span>

              <label class="flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="check-pregnant" class="mt-0.5 rounded bg-slate-900 border-slate-700 text-rose-600 focus:ring-0" />
                <span>Misafirlerimiz arasında <strong>hamile yolcu</strong> bulunmaktadır (Sürat teknesinde güvenli arka koltuk tahsis edilir).</span>
              </label>

              <label class="flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="check-heart" class="mt-0.5 rounded bg-slate-900 border-slate-700 text-rose-600 focus:ring-0" />
                <span>Kalp rahatsızlığı, tansiyon veya solunum güçlüğü geçmişi vardır.</span>
              </label>

              <label class="flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="check-back" class="mt-0.5 rounded bg-slate-900 border-slate-700 text-rose-600 focus:ring-0" />
                <span>Bel/boyun fıtığı veya yakın zamanda geçirilmiş omurga cerrahisi vardır.</span>
              </label>

              <label class="flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="check-allergy" class="mt-0.5 rounded bg-slate-900 border-slate-700 text-rose-600 focus:ring-0" />
                <span>Deniz ürünü (karides vb.) veya fıstık konusunda <strong>ciddi gıda alerjisi</strong> vardır.</span>
              </label>
            </div>

            <!-- Terms acceptance -->
            <div class="pt-1">
              <label class="flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer">
                <input type="checkbox" id="check-terms" required class="mt-0.5 rounded bg-slate-900 border-slate-700 text-emerald-600 focus:ring-0" />
                <span>
                  Tayland Turizm Bakanlığı (TAT) resmi kaza sigortası poliçe şartlarını okudum, can yeleği kullanımı dahil tekne kaptanı ve tur rehberinin güvenlik talimatlarına uyacağımı beyan ve taahhüt ederim.
                </span>
              </label>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-2xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm transition-all shadow-lg shadow-rose-600/20 cursor-pointer flex items-center justify-center gap-2"
            >
              <span>🛡️ Dijital Sigorta & Feragatnameyi Onayla</span>
            </button>
          </form>

          <!-- Success Display (Hidden by default, shown via client JS) -->
          <div id="waiver-success-box" class="hidden p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-center space-y-3 animate-in fade-in">
            <div class="text-4xl text-emerald-400">✅</div>
            <h3 class="text-base font-bold text-white">Sigorta Beyanınız Başarıyla Onaylandı!</h3>
            <p class="text-xs text-slate-300">
              Kayıt numaranız: <strong id="success-waiver-id" class="font-mono text-emerald-400"></strong>. Belgeleriniz tur operasyon merkezimize iletilmiştir.
            </p>
            <div class="pt-2">
              <span class="inline-block px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500 text-slate-950">
                TAT Sigortası Aktif
              </span>
            </div>
          </div>
        </div>
      </main>
    )}
  </div>

  <script is:inline>
    const form = document.getElementById('waiver-form');
    if (form) {
      const bId = document.getElementById('booking-id')?.value;
      const STORAGE_KEY = 'phuket_tatili_waivers_v1';

      // Check if already signed
      try {
        const existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        const signed = existing.find((w) => w.bookingId === bId);
        if (signed) {
          form.classList.add('hidden');
          const successBox = document.getElementById('waiver-success-box');
          const successId = document.getElementById('success-waiver-id');
          if (successBox && successId) {
            successId.textContent = signed.id;
            successBox.classList.remove('hidden');
          }
        }
      } catch (e) {}

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const record = {
          id: 'WAV-' + Date.now().toString().slice(-6),
          bookingId: bId,
          passengerName: document.getElementById('customer-name')?.value || 'Misafir',
          passportNumber: document.getElementById('passport-no')?.value,
          emergencyContactName: document.getElementById('contact-name')?.value,
          emergencyContactPhone: document.getElementById('contact-phone')?.value,
          isPregnant: document.getElementById('check-pregnant')?.checked,
          hasHeartCondition: document.getElementById('check-heart')?.checked,
          hasBackNeckSurgery: document.getElementById('check-back')?.checked,
          hasSevereAllergy: document.getElementById('check-allergy')?.checked,
          acceptedLiability: document.getElementById('check-terms')?.checked,
          signedAt: new Date().toISOString(),
          status: document.getElementById('check-pregnant')?.checked || document.getElementById('check-heart')?.checked ? 'flagged_medical' : 'approved',
        };

        try {
          const list = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          list.push(record);
          localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        } catch (err) {}

        form.classList.add('hidden');
        const successBox = document.getElementById('waiver-success-box');
        const successId = document.getElementById('success-waiver-id');
        if (successBox && successId) {
          successId.textContent = record.id;
          successBox.classList.remove('hidden');
        }
      });
    }
  </script>
</body>
</html>
