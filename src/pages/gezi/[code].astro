---
export const prerender = false;

import { initialBookings, type Booking } from '../../data/adminInitialData';
import { getSupabaseAdmin, isSupabaseAdminConfigured } from '../../lib/server/supabaseAdmin';
import { rowToBooking } from '../../lib/supabase';
import {
  buildGuestItinerary,
  generateItineraryWhatsAppSummary,
  getItineraryWhatsAppUrl,
} from '../../lib/guestItinerary';
import GuestItineraryCard from '../../components/guest/GuestItineraryCard';
import { getMarineSafetyStatus } from '../../lib/marineWeather';
import siteSettings from '../../content/settings/site.json';

const codeParam = (Astro.params.code || '').trim();
const cleanCode = codeParam.toUpperCase();

let booking: Booking | null = null;

if (isSupabaseAdminConfigured()) {
  const db = getSupabaseAdmin();
  if (db && cleanCode) {
    try {
      const { data, error } = await db
        .from('bookings')
        .select('*')
        .eq('ticket_code', cleanCode)
        .maybeSingle();

      if (!error && data) {
        booking = rowToBooking(data);
      }

      if (!booking) {
        const { data: byId } = await db
          .from('bookings')
          .select('*')
          .eq('id', cleanCode)
          .maybeSingle();
        if (byId) {
          booking = rowToBooking(byId);
        }
      }
    } catch (err) {
      console.warn('Gezi takvimi bulut sorgulama hatası:', err);
    }
  }
}

if (!booking && cleanCode) {
  const found = initialBookings.find(
    (b) => b.id.toUpperCase() === cleanCode || b.ticketCode?.toUpperCase() === cleanCode
  );
  if (found) {
    booking = found;
  }
}

const itinerary = booking ? buildGuestItinerary(booking) : null;
const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const whatsappSummaryText = itinerary ? generateItineraryWhatsAppSummary(itinerary) : '';
const whatsappShareUrl = itinerary ? getItineraryWhatsAppUrl(itinerary.phone, whatsappSummaryText) : '';

let marineSafety = null;
try {
  marineSafety = await getMarineSafetyStatus();
} catch (e) {
  marineSafety = null;
}
---

<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{booking ? `${booking.customerName} - Phuket Gezi Ajandası | Phuket Tatili` : 'Gezi Ajandası Bulunamadı'}</title>
  <meta name="description" content="Phuket Tatili gün gün gezi takvimi, lobi alınış saatleri ve tur hazırlık listesi" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      .print\:hidden, button, a[href*="wa.me"] {
        display: none !important;
      }
      .bg-slate-900, .bg-slate-950, .bg-slate-800 {
        background: #ffffff !important;
        color: #000000 !important;
        border: 1px solid #d1d5db !important;
      }
      .text-white, .text-slate-100, .text-slate-200, .text-slate-300 {
        color: #111827 !important;
      }
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-brand-accent selection:text-slate-950">
  <div class="max-w-2xl mx-auto px-4 py-8 space-y-6">
    <!-- Brand Header -->
    <header class="flex items-center justify-between border-b border-slate-800 pb-5">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-xl">
          🌴
        </div>
        <div>
          <span class="text-sm font-black tracking-wider uppercase text-white block">Phuket Tatili</span>
          <span class="text-[10px] text-slate-400 block">Kişisel Tatil & Gezi Ajandası</span>
        </div>
      </a>

      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="window.print()"
          class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 transition-colors cursor-pointer flex items-center gap-1.5 print:hidden"
          title="Ajandayı Yazdır veya PDF Kaydet"
        >
          <span>🖨️ Yazdır / PDF</span>
        </button>
        {booking && (
          <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-900 border border-slate-800 text-slate-300">
            {booking.ticketCode || booking.id}
          </span>
        )}
      </div>
    </header>

    {!itinerary ? (
      <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 text-center space-y-3">
        <div class="text-4xl">🔍</div>
        <h1 class="text-lg font-bold text-white">Gezi Ajandası Bulunamadı</h1>
        <p class="text-xs text-slate-400 max-w-sm mx-auto">
          Belirtilen rezervasyon koduna ait aktif tur programı bulunamadı. Lütfen rezervasyon kodunuzu kontrol ediniz veya destek hattımızla iletişime geçiniz.
        </p>
        <div class="pt-2">
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, gezi programıma ulaşamadım, yardımcı olabilir misiniz?')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-lg"
          >
            <span>💬 7/24 WhatsApp Destek</span>
          </a>
        </div>
      </div>
    ) : (
      <main class="space-y-6">
        <!-- Guest Welcome Card -->
        <div class="p-6 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-900/90 border border-slate-800 shadow-xl space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">
              Phuket Tatil Programınız
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              {itinerary.totalDays} Günlük Plan
            </span>
          </div>

          <h1 class="text-xl sm:text-2xl font-black text-white">
            Hoş Geldiniz, {itinerary.guestName}! 👋
          </h1>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs pt-1 text-slate-300">
            <div class="flex items-center gap-2">
              <span class="text-slate-500">🏨 Otel:</span>
              <strong class="text-white truncate">{itinerary.hotel} {itinerary.roomNumber ? `(Oda: ${itinerary.roomNumber})` : ''}</strong>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-slate-500">📞 WhatsApp:</span>
              <strong class="text-white">{itinerary.phone}</strong>
            </div>
          </div>
        </div>

        <!-- 🌊 ANDAMAN DENİZİ CANLI GÜVENLİK & SEYİR RADARI -->
        {marineSafety && (
          <div class={`p-5 rounded-3xl border shadow-xl space-y-3 transition-all ${
            marineSafety.level === 'severe'
              ? 'bg-rose-950/30 border-rose-800 text-rose-200'
              : marineSafety.level === 'moderate'
              ? 'bg-amber-950/30 border-amber-800 text-amber-200'
              : 'bg-gradient-to-br from-emerald-950/40 via-slate-900 to-slate-900 border-emerald-800/60 text-emerald-100'
          }`}>
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <div class="flex items-center gap-2.5">
                <span class="text-2xl">🌊</span>
                <div>
                  <h3 class="text-xs font-black uppercase tracking-wider text-white">
                    Andaman Denizi Canlı Güvenlik & Seyir Durumu
                  </h3>
                  <span class="text-[10px] text-slate-400 font-mono block">
                    Phuket Operasyon & Tayland Liman Başkanlığı Verisi
                  </span>
                </div>
              </div>
              <span class={`px-3 py-1 rounded-full text-xs font-black border ${
                marineSafety.level === 'severe'
                  ? 'bg-rose-500/20 text-rose-300 border-rose-500/40'
                  : marineSafety.level === 'moderate'
                  ? 'bg-amber-500/20 text-amber-300 border-amber-500/40'
                  : 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40'
              }`}>
                {marineSafety.level === 'severe'
                  ? '⚠️ Yüksek Dalga Uyarısı'
                  : marineSafety.level === 'moderate'
                  ? '⚡ Orta Dalga'
                  : '🟢 Deniz Sakin · Güvenli Seyir'}
              </span>
            </div>

            <p class="text-xs text-slate-300 leading-relaxed font-medium">
              {marineSafety.summary} {marineSafety.warningNote}
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1 text-center font-mono text-xs">
              <div class="p-2.5 rounded-2xl bg-slate-950/70 border border-slate-800">
                <span class="text-[10px] text-slate-400 uppercase block font-sans">Dalga Boyu</span>
                <strong class="text-white text-sm">{marineSafety.waveHeightMeters}m</strong>
              </div>
              <div class="p-2.5 rounded-2xl bg-slate-950/70 border border-slate-800">
                <span class="text-[10px] text-slate-400 uppercase block font-sans">Rüzgar Hızı</span>
                <strong class="text-white text-sm">{marineSafety.windSpeedKnots} kn</strong>
              </div>
              <div class="p-2.5 rounded-2xl bg-slate-950/70 border border-slate-800">
                <span class="text-[10px] text-slate-400 uppercase block font-sans">Phi Phi Koridoru</span>
                <strong class="text-emerald-400 text-xs">Açık / Güvenli</strong>
              </div>
              <div class="p-2.5 rounded-2xl bg-slate-950/70 border border-slate-800">
                <span class="text-[10px] text-slate-400 uppercase block font-sans">Phang Nga Körfez</span>
                <strong class="text-emerald-400 text-xs">Durgun / Korumalı</strong>
              </div>
            </div>
          </div>
        )}

        <!-- Gün Gün ve Story Formatında Dijital Tatil Karnesi -->
        <GuestItineraryCard
          client:load
          itinerary={itinerary}
          ticketCode={cleanCode}
          whatsappNumber={whatsappNumber}
          whatsappShareUrl={whatsappShareUrl}
          whatsappSummaryText={whatsappSummaryText}
        />

        <!-- Misafir Yardımcı Araçları: Fotoğraflar & Tayca Asistan -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href={`/foto/${codeParam}`}
            class="p-4 rounded-2xl bg-gradient-to-r from-purple-950/40 to-slate-900 border border-purple-500/30 hover:border-purple-400 transition flex items-center justify-between gap-3 group"
          >
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center text-xl">
                📸
              </span>
              <div>
                <strong class="text-xs sm:text-sm font-bold text-white block group-hover:text-purple-300 transition">
                  Tur Fotoğraf Kasanız
                </strong>
                <span class="text-[11px] text-slate-400">Yüksek çözünürlüklü hatıra fotoğrafları</span>
              </div>
            </div>
            <span class="text-purple-400 text-xs font-bold">Aç →</span>
          </a>

          <a
            href="/tayca"
            class="p-4 rounded-2xl bg-gradient-to-r from-emerald-950/40 to-slate-900 border border-emerald-500/30 hover:border-emerald-400 transition flex items-center justify-between gap-3 group"
          >
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center text-xl">
                🗣️
              </span>
              <div>
                <strong class="text-xs sm:text-sm font-bold text-white block group-hover:text-emerald-300 transition">
                  Tayca Sesli İletişim Kartları
                </strong>
                <span class="text-[11px] text-slate-400">Acısız yemek, taksi ve acil durumlar</span>
              </div>
            </div>
            <span class="text-emerald-400 text-xs font-bold">Aç →</span>
          </a>
        </div>

        <!-- 24/7 Operations Concierge Card -->
        <div class="p-5 rounded-3xl bg-slate-900 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="space-y-0.5 text-center sm:text-left">
            <h4 class="text-sm font-bold text-white">Tatil Boyunca 7/24 Yanınızdayız</h4>
            <p class="text-xs text-slate-400">Otel lobisi alınış saatleri veya acil durumlar için bize dilediğiniz zaman ulaşabilirsiniz.</p>
          </div>
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Merhaba, ${itinerary.guestName} (${itinerary.bookingId}) tatil programım hakkında bir sorum olacaktı.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-all shadow-lg shrink-0 flex items-center gap-2"
          >
            <span>💬 WhatsApp Canlı Asistan</span>
          </a>
        </div>
      </main>
    )}
  </div>
</body>
</html>
