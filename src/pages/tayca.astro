---
import Layout from '../layouts/Layout.astro';
import {
  POCKET_THAI_PHRASES,
  POCKET_THAI_CATEGORIES,
} from '../lib/pocketThai';

export const prerender = true;
---

<Layout
  title="Tayca Hızlı İletişim & Sesli Çevirmen"
  description="Phuket ve Tayland tatilinizde restoran, taksi, ada turları ve acil durumlarda kullanabileceğiniz sesli Tayca iletişim kartları."
>
  <div class="min-h-screen bg-slate-950 text-slate-100 py-8 sm:py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- Başlık Kartı -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
          <span>🇹🇭</span>
          <span>POCKET THAI ASSISTANT</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-serif text-white tracking-tight">
          Tayca Hızlı İletişim & Sesli Kartlar
        </h1>

        <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto">
          Restoranda acısız yemek isterken, takside veya teknede dil bariyerini aşın. Kartın üzerine basarak Tayca seslendirmesini dinletebilir veya ekrandan gösterebilirsiniz.
        </p>
      </div>

      <!-- Arama & Filtre Çubuğu -->
      <div class="space-y-4">
        <!-- Arama Inputu -->
        <div class="relative max-w-xl mx-auto">
          <input
            type="text"
            id="search-input"
            placeholder="İfade ara (örn: acısız, hesap, hastane, taksi)..."
            class="w-full px-5 py-3.5 pl-11 rounded-2xl bg-slate-900 border border-slate-800 text-sm font-medium text-white placeholder-slate-500 focus:outline-none focus:border-brand-accent transition shadow-inner"
          />
          <span class="absolute left-4 top-3.5 text-slate-500 text-base">🔍</span>
        </div>

        <!-- Kategori Butonları -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
          {POCKET_THAI_CATEGORIES.map((cat) => (
            <button
              type="button"
              data-category={cat.id}
              class={`category-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all border border-slate-800 cursor-pointer ${
                cat.id === 'all'
                  ? 'bg-brand-accent text-white font-black shadow-md shadow-brand-accent/20'
                  : 'bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-850'
              }`}
            >
              <span>{cat.icon}</span>
              <span class="ml-1">{cat.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- KARTLAR LİSTESİ -->
      <div id="phrases-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {POCKET_THAI_PHRASES.map((phrase) => (
          <div
            data-category={phrase.category}
            data-search={`${phrase.turkish.toLowerCase()} ${phrase.phonetic.toLowerCase()} ${phrase.thai}`}
            class="phrase-card bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-3xl p-5 shadow-lg flex flex-col justify-between transition-all group"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-semibold text-slate-400 flex items-center gap-1.5">
                  <span>{phrase.icon}</span>
                  <span class="truncate">{phrase.turkish}</span>
                </span>
                {phrase.urgency === 'high' && (
                  <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/30">
                    Önemli
                  </span>
                )}
              </div>

              <!-- Dev Tayca Metin -->
              <div class="py-2">
                <p class="text-2xl sm:text-3xl font-black text-amber-300 font-sans tracking-wide leading-tight group-hover:text-amber-200 transition">
                  {phrase.thai}
                </p>
                <p class="text-sm font-mono font-bold text-slate-300 mt-1">
                  🗣️ {phrase.phonetic}
                </p>
              </div>
            </div>

            <!-- Kart Alt Butonları: Dinlet & Büyük Göster -->
            <div class="flex items-center justify-between gap-2 pt-3 border-t border-slate-800/80 mt-2">
              <button
                type="button"
                data-speak={phrase.thai}
                class="btn-speak px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-750 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-xs active:scale-95"
                title="Tayca Seslendir"
              >
                <span>🔊</span>
                <span>Sesli Dinlet</span>
              </button>

              <button
                type="button"
                data-show-thai={phrase.thai}
                data-show-phonetic={phrase.phonetic}
                data-show-tr={phrase.turkish}
                class="btn-fullscreen-card px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold transition flex items-center gap-1 cursor-pointer"
                title="Ekranda Büyük Göster"
              >
                <span>📱</span>
                <span>Ekranda Göster</span>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- TAM EKRAN GÖSTERİM MODALI (Garsona/Şoföre Göstermek İçin) -->
      <div id="show-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-950/95 backdrop-blur-md animate-fade-in">
        <div class="bg-slate-900 border border-amber-500/40 rounded-3xl w-full max-w-xl p-8 sm:p-12 text-center space-y-6 shadow-2xl relative">
          <button
            type="button"
            id="btn-close-modal"
            class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition text-lg"
          >
            ✕
          </button>

          <span class="text-xs font-bold uppercase tracking-widest text-slate-400 block">
            Lütfen Ekrana Bakınız (โปรดดูที่นี่)
          </span>

          <div class="py-4 border-y border-slate-800">
            <h2 id="modal-thai-text" class="text-4xl sm:text-6xl font-black text-amber-300 leading-tight">
              ไม่เผ็ดครับ
            </h2>
            <p id="modal-phonetic-text" class="text-lg sm:text-xl font-mono text-slate-300 mt-3">
              Mai Phet
            </p>
          </div>

          <p id="modal-tr-text" class="text-sm font-semibold text-slate-400">
            Acısız olsun lütfen
          </p>

          <button
            type="button"
            id="modal-speak-btn"
            class="px-6 py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm shadow-xl flex items-center justify-center gap-2 mx-auto cursor-pointer"
          >
            <span>🔊</span>
            <span>Tekrar Seslendir</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    // Web Speech API Seslendirme Motoru
    function speakThai(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'th-TH';
        utterance.rate = 0.85; // Net anlaşılması için biraz yavaş
        window.speechSynthesis.speak(utterance);
      } else {
        alert('Tarayıcınız ses sentezini desteklemiyor.');
      }
    }

    // Seslendir Butonları
    document.querySelectorAll('.btn-speak').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const text = btn.getAttribute('data-speak');
        if (text) speakThai(text);
      });
    });

    // Tam Ekran Gösterim Modalı
    const modal = document.getElementById('show-modal');
    const modalClose = document.getElementById('btn-close-modal');
    const modalThai = document.getElementById('modal-thai-text');
    const modalPhonetic = document.getElementById('modal-phonetic-text');
    const modalTr = document.getElementById('modal-tr-text');
    const modalSpeak = document.getElementById('modal-speak-btn');
    let currentModalThai = '';

    document.querySelectorAll('.btn-fullscreen-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const thai = btn.getAttribute('data-show-thai') || '';
        const phonetic = btn.getAttribute('data-show-phonetic') || '';
        const tr = btn.getAttribute('data-show-tr') || '';

        currentModalThai = thai;
        modalThai.textContent = thai;
        modalPhonetic.textContent = phonetic;
        modalTr.textContent = tr;

        modal.classList.remove('hidden');
        speakThai(thai);
      });
    });

    if (modalClose) {
      modalClose.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
    }

    if (modalSpeak) {
      modalSpeak.addEventListener('click', () => {
        if (currentModalThai) speakThai(currentModalThai);
      });
    }

    // Arama & Filtreleme Mantığı
    const searchInput = document.getElementById('search-input');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const cards = document.querySelectorAll('.phrase-card');
    let activeCategory = 'all';

    function filterCards() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const searchData = card.getAttribute('data-search') || '';
        const matchCat = activeCategory === 'all' || cat === activeCategory;
        const matchSearch = !q || searchData.includes(q);

        if (matchCat && matchSearch) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterCards);
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach((b) => {
          b.classList.remove('bg-brand-accent', 'text-white', 'font-black', 'shadow-md');
          b.classList.add('bg-slate-900', 'text-slate-400');
        });

        btn.classList.add('bg-brand-accent', 'text-white', 'font-black', 'shadow-md');
        btn.classList.remove('bg-slate-900', 'text-slate-400');

        activeCategory = btn.getAttribute('data-category') || 'all';
        filterCards();
      });
    });
  </script>
</Layout>
