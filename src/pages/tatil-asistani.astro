---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HomeHolidayAssistant from '../components/home/HomeHolidayAssistant';
import siteSettingsJson from '../content/settings/site.json';
import { getPublicHomeContent, mergeSiteSettings } from '../lib/server/homeSettings';
import { getCloudTours, applyTourOverlay } from '../lib/server/tourContent';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let siteSettings: Record<string, any> = siteSettingsJson;
try {
  const panelContent = await getPublicHomeContent();
  siteSettings = mergeSiteSettings(siteSettingsJson, panelContent.siteSettings) as Record<string, any>;
} catch {}

const tours: CollectionEntry<'tours'>[] = applyTourOverlay(
  (await getCollection('tours')) as CollectionEntry<'tours'>[],
  await getCloudTours(),
);

const wizardTours = tours.map((t) => ({
  id: t.id,
  title: t.data.title,
  priceThb: t.data.price_thb || 0,
  duration: t.data.duration,
  category: t.data.category,
  image: t.data.image,
}));

const pageTitle = "Phuket Tatil Asistanı & 3 Adımda Rota Planlayıcı | Phuket Tatili";
const pageDesc = "Phuket tatilinizi 3 adımda planlayın: Kalış sürenizi, tatil tarzınızı ve otel bölgenizi seçin; en ideal tur kombinasyonları, VIP transferler ve bütçeniz anında hazırlansın.";
const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
---

<Layout
  title={pageTitle}
  description={pageDesc}
>
  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 pt-28 pb-20">
    <!-- Hero / Giriş Alanı -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4 mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400">
        <span>✨</span>
        <span>KİŞİYE ÖZEL PHUKET TATİL PLANLAYICI</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif tracking-tight text-slate-900 dark:text-white">
        Hayalinizdeki Phuket Tatilini <span class="text-amber-500 italic">3 Adımda</span> Planlayın
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
        Balayı, aile veya macera odaklı tatiliniz için gün gün optimize edilmiş ada turları, VIP transferler ve yerel ipuçlarıyla kusursuz rotanızı keşfedin.
      </p>

      <!-- Hızlı Avantaj Hapları -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs font-semibold text-slate-600 dark:text-slate-300">
        <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <span>🇹🇷</span> Türkçe Rehber Desteği
        </span>
        <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <span>🚐</span> Kapıdan Kapıya VIP Lobi Transferi
        </span>
        <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs">
          <span>⚡</span> Anında WhatsApp Onayı & Esnek İptal
        </span>
      </div>
    </div>

    <!-- Asistan Bileşeni -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <HomeHolidayAssistant client:load tours={wizardTours} whatsappNumber={whatsappNumber} />
    </div>

    <!-- Sıkça Sorulan Sorular / Bilgilendirme Kutuları -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-20 space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900 dark:text-white">
          Tatil Planlarken En Çok Merak Edilenler
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Phuket seyahatinizi daha keyifli ve sorunsuz geçirmeniz için operasyon ekibimizden altın tavsiyeler.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-surface-2 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-2">
          <span class="text-2xl">📅</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Kaç Günlük Bir Tatil İdeal?</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Phuket'te hem Phi Phi ve James Bond gibi temel adaları görmek hem de dinlenmeye vakit ayırmak için en az 5-7 gün konaklamanızı öneriyoruz.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-surface-2 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-2">
          <span class="text-2xl">🏨</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Hangi Bölgede Kalmalıyım?</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Hareketli gece hayatı için Patong; aileler ve sakin deniz için Kata/Karon; lüks ve huzurlu bir balayı için Bang Tao veya Kamala plajları idealdir.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-surface-2 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-2">
          <span class="text-2xl">💬</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Özel Bir İstek Var mı?</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Rotanızda helikopter turu, özel evlilik teklifi veya ada konaklaması eklemek isterseniz doğrudan WhatsApp danışmanımıza yazabilirsiniz.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>
