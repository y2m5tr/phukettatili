---
export const prerender = false;

import GuestTicketPortal from '../../components/guest/GuestTicketPortal';
import { initialBookings, type Booking } from '../../data/adminInitialData';
import { getSupabaseAdmin, isSupabaseAdminConfigured } from '../../lib/server/supabaseAdmin';
import { toGuestBookingView } from '../../lib/server/guestView';
import { checkRateLimit } from '../../lib/server/rateLimit';
import { rowToBooking } from '../../lib/supabase';
import siteSettings from '../../content/settings/site.json';

const codeParam = (Astro.params.code || '').trim();
const cleanCode = codeParam.toUpperCase();

// ---------------------------------------------------------------------------
// Hız limiti — bilet kodu probe/brute-force denemelerini sınırlar.
// IP başına dakikada 10 sorgu; kalıcı sayaç (Supabase rate_limits) tüm
// serverless instance'larında ortaktır. 429 durumunda sayfa değil
// basit bir mesaj render edilir — veritabanı sorgusuna hiç girilmez.
// Localhost'ta (dev) IP hep aynı olduğundan limit yine de sayılır ama
// sayfa testini zorlaştırmaz (dakikada 10 genelde yeterli).
// ---------------------------------------------------------------------------
const clientIp =
  Astro.clientAddress ||
  (Astro.request.headers.get('x-forwarded-for') || '').split(',')[0].trim() ||
  'unknown';

const biletLimiter = await checkRateLimit('bilet', clientIp, 10, 60);
if (!biletLimiter.allowed) {
  Astro.response.status = 429;
  Astro.response.headers.set('Retry-After', String(biletLimiter.retryAfterSeconds));
}
const isRateLimitedRequest = !biletLimiter.allowed;

let booking: Booking | null = null;

// Limit aşıldıysa veritabanı sorgusu hiç yapılmaz — probe trafiği
// pahalı DB isteklerini tetikleyemez.
if (isRateLimitedRequest) {
  // bilinçli olarak sorgulanmaz
} else if (isSupabaseAdminConfigured()) {
  const db = getSupabaseAdmin();
  if (db && cleanCode) {
    try {
      // `.eq` kullanılıyor, `.ilike` DEĞİL: ilike'ta `%` ve `_` wildcard
      // sayılır, yani "/bilet/BK-%25" gibi bir istek desene dönüşürdü.
      const { data, error } = await db
        .from('bookings')
        .select('*')
        .eq('ticket_code', cleanCode)
        .maybeSingle();

      if (!error && data) {
        booking = rowToBooking(data);
      }

      // Bilet kodu eşleşmediyse eski id ile dene (PT- dışı her şey).
      if (!booking && !cleanCode.startsWith('PT-')) {
        const { data: byId, error: idErr } = await db
          .from('bookings')
          .select('*')
          .eq('id', cleanCode)
          .maybeSingle();
        if (!idErr && byId) {
          booking = rowToBooking(byId);
        }
      }
    } catch (err) {
      console.warn('Bilet portalı bulut sorgulama hatası:', err);
    }
  }
}

// 2. Bulutta bulunamadıysa veya çevrimdışıysa yerel verilerden sorgula.
//    ⚠️ Yalnızca TAM eşleşme: `.includes()` kısmi kodla (örn. "BK") başkasının
//    kaydını getirirdi ve kodlar 4 haneye kadar tahmin edilebilir olurdu.
if (!booking && cleanCode && !isRateLimitedRequest) {
  const found = initialBookings.find(
    (b) => b.id.toUpperCase() === cleanCode || b.ticketCode?.toUpperCase() === cleanCode
  );
  if (found) {
    booking = found;
  }
}

/**
 * Misafire gönderilecek ASGARİ veri — dönüşüm ve izinli alan listesi
 * src/lib/server/guestView.ts içinde tek kaynak olarak durur;
 * test/guestView.test.ts sızıntı regression koruması sağlar.
 */
const guestView = toGuestBookingView(booking);

const managerPhone = siteSettings?.whatsappNumber || '66828950665';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>
      {booking ? `${booking.tourTitle} - Biniş Kartı | Phuket Tatili` : 'Rezervasyon Sorgulama | Phuket Tatili'}
    </title>
    <!-- Misafir gizliliği için arama motorlarına kapatılır -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#020617" />
    
      <!-- Fontlar self-hosted (fontsource) -->
    <style is:inline>
      @import "@fontsource/plus-jakarta-sans/400.css";
      @import "@fontsource/plus-jakarta-sans/500.css";
      @import "@fontsource/plus-jakarta-sans/600.css";
      @import "@fontsource/plus-jakarta-sans/700.css";
      @import "@fontsource/plus-jakarta-sans/800.css";
      @import "@fontsource/playfair-display/600.css";
      @import "@fontsource/playfair-display/700.css";
      @import "@fontsource/playfair-display/600-italic.css";
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans min-h-screen">
    {isRateLimitedRequest ? (
      <div class="min-h-screen flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center">
          <p class="text-4xl mb-4">⏳</p>
          <h1 class="text-xl font-bold text-white mb-2">Çok fazla sorgulama</h1>
          <p class="text-sm text-slate-400 leading-relaxed">
            Güvenlik için bilet sorgulama sayfası kısa süreliğine sınırlandırıldı.
            Lütfen bir dakika sonra tekrar deneyin veya WhatsApp'tan bizimle iletişime geçin.
          </p>
        </div>
      </div>
    ) : booking ? (
      <GuestTicketPortal client:load booking={guestView!} managerPhone={managerPhone} />
    ) : (
      <div class="min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-md p-6 sm:p-8 rounded-3xl bg-slate-900 border border-slate-800 text-center shadow-2xl">
          <div class="w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-400 mx-auto flex items-center justify-center font-serif text-2xl font-bold mb-4">
            PT
          </div>
          <h1 class="text-xl font-bold font-serif text-white">
            Rezervasyon Bulunamadı
          </h1>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">
            <span class="font-mono font-bold text-amber-400">"{codeParam}"</span> kodlu rezervasyon kaydı bulunamadı. Lütfen size iletilen onay mesajındaki rezervasyon kodunuzu kontrol ediniz.
          </p>

          <form class="mt-6 space-y-3" id="bilet-search-form">
            <div class="relative">
              <input
                id="code-input"
                type="text"
                placeholder="Örn: BK-1001"
                class="w-full px-4 py-3 rounded-2xl bg-slate-950 border border-slate-800 text-center font-mono font-bold text-sm text-white uppercase tracking-wider focus:outline-none focus:border-amber-500"
                autofocus
                required
              />
            </div>
            <button
              type="submit"
              class="w-full py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-colors shadow-lg shadow-amber-500/20"
            >
              Bileti Sorgula
            </button>
          </form>

          <script is:inline>
            document.getElementById('bilet-search-form')?.addEventListener('submit', (e) => {
              e.preventDefault();
              const input = document.getElementById('code-input');
              const val = input ? input.value.trim() : '';
              if (val) window.location.href = '/bilet/' + encodeURIComponent(val);
            });
          </script>

          <div class="mt-6 pt-5 border-t border-slate-800/80 text-xs text-slate-500">
            Yardıma mı ihtiyacınız var?{" "}
            <a
              href={`https://wa.me/${managerPhone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Merhaba, tur rezervasyonum hakkında bilgi almak istiyorum.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-400 hover:underline font-bold"
            >
              WhatsApp Destek Hattı
            </a>
          </div>
        </div>
      </div>
    )}
  </body>
</html>
