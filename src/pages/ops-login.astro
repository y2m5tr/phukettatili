---
export const prerender = false;

// Operasyon panelleri giriş sayfası — sunucu tarafında render edilir.
// Şifre burada değil, POST /api/ops-login içinde (sunucuda) doğrulanır.
import { isAuthConfigured } from '../lib/auth';

const configured = isAuthConfigured();
const nextParam = Astro.url.searchParams.get('next') || '';
const safeNext = nextParam === '/admin' || nextParam === '/ekip' ? nextParam : '/admin';
const errorCode = Astro.url.searchParams.get('error') || '';

const heading = safeNext === '/ekip' ? 'Saha & Rehber Girişi' : 'Yönetim Paneli Girişi';
const accent = safeNext === '/ekip' ? '#f59e0b' : '#0ea5e9';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{heading} | Phuket Tatili</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#020617" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        background: radial-gradient(circle at 50% 0%, #0f2438 0%, #020617 60%);
        color: #f1f5f9;
      }
      .card {
        width: 100%;
        max-width: 400px;
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 24px;
        padding: 32px 28px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
      }
      .badge {
        width: 52px;
        height: 52px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: color-mix(in srgb, var(--accent) 16%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
        color: var(--accent);
      }
      h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        text-align: center;
      }
      p.sub {
        margin: 6px 0 26px;
        font-size: 12.5px;
        text-align: center;
        color: #94a3b8;
      }
      label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #cbd5e1;
        margin-bottom: 8px;
      }
      input {
        width: 100%;
        padding: 14px 16px;
        font-size: 16px;
        font-family: inherit;
        color: #f8fafc;
        background: rgba(2, 6, 23, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 14px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
      }
      button {
        width: 100%;
        margin-top: 18px;
        padding: 14px;
        font-size: 14.5px;
        font-weight: 800;
        font-family: inherit;
        color: #020617;
        background: var(--accent);
        border: 0;
        border-radius: 14px;
        cursor: pointer;
        transition: filter 0.15s ease, transform 0.1s ease;
      }
      button:hover:not(:disabled) {
        filter: brightness(1.08);
      }
      button:active:not(:disabled) {
        transform: scale(0.99);
      }
      button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }
      .msg {
        margin-top: 14px;
        padding: 11px 14px;
        font-size: 12.5px;
        line-height: 1.5;
        border-radius: 12px;
        background: rgba(244, 63, 94, 0.12);
        border: 1px solid rgba(244, 63, 94, 0.35);
        color: #fda4af;
      }
      .msg[hidden] {
        display: none;
      }
      .foot {
        margin-top: 22px;
        font-size: 11px;
        text-align: center;
        color: #64748b;
      }
    </style>
  </head>
  <body style={`--accent: ${accent}`}>
    <div class="card">
      <div class="badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>

      <h1>{heading}</h1>
      <p class="sub">Bu alan yalnızca yetkili ekip içindir.</p>

      {
        !configured && (
          <div class="msg">
            Sunucuda <code>ADMIN_PASSCODE</code> tanımlı değil. Panel kilitli —
            hosting ortamında bu değişkeni ayarlayın.
          </div>
        )
      }

      <div id="msg" class="msg" hidden></div>

      <!-- Üyelik ile giriş (yeni sistem) -->
      <div id="membership-form-wrap">
        <form id="membership-form">
          <label for="username">Kullanıcı Adı</label>
          <input
            id="username"
            name="username"
            type="text"
            autocomplete="username"
            required
            autofocus
          />
          <label for="password" style="margin-top: 12px">Şifre</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
          <button type="submit">Giriş Yap</button>
        </form>
        <p class="foot" style="margin-top: 10px">
          <a href="#" id="switch-to-passcode" style="color: #64748b">Eski tek-şifre girişi</a>
        </p>
      </div>

      <!-- Tek şifre ile giriş (geçiş dönemi) -->
      <div id="passcode-form-wrap" hidden>
        <form id="login-form" method="post" action={`/api/ops-login?next=${safeNext}`}>
          <label for="passcode">Erişim Şifresi</label>
          <input
            id="passcode"
            name="passcode"
            type="password"
            autocomplete="current-password"
            required
            disabled={!configured}
          />
          <button type="submit" disabled={!configured}>Giriş Yap</button>
        </form>
        <p class="foot" style="margin-top: 10px">
          <a href="#" id="switch-to-membership" style="color: #64748b">Üyelik ile giriş</a>
        </p>
      </div>

      <p class="foot">Phuket Tatili Operasyon · {new Date().getFullYear()}</p>
    </div>

    <script is:inline define:vars={{ configured, errorCode }}>
      (() => {
        const msg = document.getElementById('msg');
        const showError = (text) => {
          msg.textContent = text;
          msg.hidden = false;
        };

        const membershipWrap = document.getElementById('membership-form-wrap');
        const passcodeWrap = document.getElementById('passcode-form-wrap');
        const switchToPasscode = document.getElementById('switch-to-passcode');
        const switchToMembership = document.getElementById('switch-to-membership');

        switchToPasscode.addEventListener('click', (e) => {
          e.preventDefault();
          membershipWrap.hidden = true;
          passcodeWrap.hidden = false;
          msg.hidden = true;
          document.getElementById('passcode').focus();
        });
        switchToMembership.addEventListener('click', (e) => {
          e.preventDefault();
          passcodeWrap.hidden = true;
          membershipWrap.hidden = false;
          msg.hidden = true;
          document.getElementById('username').focus();
        });

        if (errorCode === 'unconfigured') {
          showError('Panel kilitli: sunucuda ADMIN_PASSCODE tanımlı değil.');
        }

        // ---- Üyelik girişi ----
        const mForm = document.getElementById('membership-form');
        const mButton = mForm.querySelector('button');
        mForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.hidden = true;
          mButton.disabled = true;
          mButton.textContent = 'Doğrulanıyor…';

          try {
            const res = await fetch('/api/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                username: document.getElementById('username').value,
                password: document.getElementById('password').value,
              }),
            });

            if (res.ok) {
              const data = await res.json();
              window.location.href = data.redirect;
              return;
            }

            if (res.status === 401) {
              showError('Kullanıcı adı veya şifre hatalı.');
            } else if (res.status === 429) {
              const data = await res.json().catch(() => ({}));
              const minutes = Math.ceil((data.retryAfterMs || 900000) / 60000);
              showError(`Çok fazla deneme. ${minutes} dakika sonra tekrar deneyin.`);
            } else if (res.status === 503) {
              showError('Üyelik sistemi yapılandırılmamış. Eski tek-şifre girişini kullanın.');
            } else {
              showError('Giriş yapılamadı. Lütfen tekrar deneyin.');
            }
          } catch {
            showError('Bağlantı hatası. İnternetinizi kontrol edin.');
          }

          mButton.disabled = false;
          mButton.textContent = 'Giriş Yap';
          document.getElementById('password').value = '';
          document.getElementById('password').focus();
        });

        // ---- Eski tek-şifre girişi (geçiş dönemi) ----
        const form = document.getElementById('login-form');
        const button = form.querySelector('button');
        const input = document.getElementById('passcode');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.hidden = true;
          button.disabled = true;
          button.textContent = 'Doğrulanıyor…';

          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ passcode: input.value }),
            });

            if (res.ok) {
              const data = await res.json();
              window.location.href = data.redirect;
              return;
            }

            if (res.status === 401) {
              showError('Hatalı şifre. Tekrar deneyin.');
            } else if (res.status === 429) {
              const data = await res.json().catch(() => ({}));
              const minutes = Math.ceil((data.retryAfterMs || 900000) / 60000);
              showError(`Çok fazla deneme. ${minutes} dakika sonra tekrar deneyin.`);
            } else {
              showError('Giriş yapılamadı. Lütfen tekrar deneyin.');
            }
          } catch {
            showError('Bağlantı hatası. İnternetinizi kontrol edin.');
          }

          button.disabled = false;
          button.textContent = 'Giriş Yap';
          input.value = '';
          input.focus();
        });
      })();
    </script>
  </body>
</html>
