---
export const prerender = false;

// Operasyon panelleri giriş sayfası — sunucu tarafında render edilir.
// Şifre burada değil, POST /api/ops-login içinde (sunucuda) doğrulanır.
import { isAuthConfigured } from '../lib/auth';

const configured = isAuthConfigured();
const nextParam = Astro.url.searchParams.get('next') || '';
const safeNext = nextParam === '/ekip' ? '/admin?tab=transfers' : (nextParam || '/admin');
const errorCode = Astro.url.searchParams.get('error') || '';

const heading = 'Yönetim & Operasyon Girişi';
const accent = '#0ea5e9';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{heading} | Phuket Tatili</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#020617" />
    <!-- Fontlar self-hosted (fontsource) -->
    <style is:inline>
      @import "@fontsource/plus-jakarta-sans/400.css";
      @import "@fontsource/plus-jakarta-sans/500.css";
      @import "@fontsource/plus-jakarta-sans/600.css";
      @import "@fontsource/plus-jakarta-sans/700.css";
      @import "@fontsource/plus-jakarta-sans/800.css";
    </style>
    <style>
      :root {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        background: radial-gradient(circle at 50% 0%, #0f2438 0%, #020617 60%);
        color: #f1f5f9;
      }
      .card {
        width: 100%;
        max-width: 400px;
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 24px;
        padding: 32px 28px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
      }
      .badge {
        width: 52px;
        height: 52px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: color-mix(in srgb, var(--accent) 16%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
        color: var(--accent);
      }
      h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        text-align: center;
      }
      p.sub {
        margin: 6px 0 26px;
        font-size: 12.5px;
        text-align: center;
        color: #94a3b8;
      }
      label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #cbd5e1;
        margin-bottom: 8px;
      }
      input {
        width: 100%;
        padding: 14px 16px;
        font-size: 16px;
        font-family: inherit;
        color: #f8fafc;
        background: rgba(2, 6, 23, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 14px;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
      }
      button {
        width: 100%;
        margin-top: 18px;
        padding: 14px;
        font-size: 14.5px;
        font-weight: 800;
        font-family: inherit;
        color: #020617;
        background: var(--accent);
        border: 0;
        border-radius: 14px;
        cursor: pointer;
        transition: filter 0.15s ease, transform 0.1s ease;
      }
      button:hover:not(:disabled) {
        filter: brightness(1.08);
      }
      button:active:not(:disabled) {
        transform: scale(0.99);
      }
      button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }
      .msg {
        margin-top: 14px;
        padding: 11px 14px;
        font-size: 12.5px;
        line-height: 1.5;
        border-radius: 12px;
        background: rgba(244, 63, 94, 0.12);
        border: 1px solid rgba(244, 63, 94, 0.35);
        color: #fda4af;
      }
      .msg[hidden] {
        display: none;
      }
      .tabs-nav {
        display: flex;
        gap: 6px;
        margin: 20px 0 16px 0;
        background: rgba(2, 6, 23, 0.6);
        padding: 4px;
        border-radius: 14px;
        border: 1px solid rgba(148, 163, 184, 0.15);
      }
      .tab-btn {
        flex: 1;
        margin: 0;
        padding: 9px 12px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 10px;
        border: 0;
        cursor: pointer;
        background: transparent;
        color: #94a3b8;
        transition: all 0.15s ease;
      }
      .tab-btn.active {
        background: var(--accent);
        color: #020617;
      }
      .foot {
        margin-top: 22px;
        font-size: 11px;
        text-align: center;
        color: #64748b;
      }
    </style>
  </head>
  <body style={`--accent: ${accent}`}>
    <div class="card">
      <div style="text-align: center; margin-bottom: 20px;">
        <a href="/" title="Phuket Tatili Ana Sayfa" style="display: inline-block;">
          <img
            src="/assets/logo-main-transparent.png"
            alt="Phuket Tatili"
            style="height: 54px; width: auto; object-fit: contain; margin: 0 auto;"
          />
        </a>
      </div>

      <h1>{heading}</h1>
      <p class="sub">Bu alan yalnızca yetkili ekip içindir.</p>

      {
        !configured && (
          <div class="msg">
            Sunucuda <code>ADMIN_PASSCODE</code> tanımlı değil. Panel kilitli —
            hosting ortamında bu değişkeni ayarlayın.
          </div>
        )
      }

      <div id="msg" class="msg" hidden></div>

      <!-- Giriş Yöntemi Tabları -->
      <div class="tabs-nav">
        <button type="button" id="tab-passcode" class="tab-btn active">🔑 Ana Şifre</button>
        <button type="button" id="tab-membership" class="tab-btn">👤 Ekip Girişi</button>
      </div>

      <!-- 1. Tek şifre ile giriş (Varsayılan / En Pratik) -->
      <div id="passcode-form-wrap">
        <form id="login-form" method="post" action={`/api/ops-login?next=${safeNext}`}>
          <label for="passcode">Yönetici Şifresi</label>
          <input
            id="passcode"
            name="passcode"
            type="password"
            placeholder="Yönetici şifreniz..."
            autocomplete="current-password"
            required
            autofocus
            disabled={!configured}
          />
          <button type="submit" disabled={!configured}>Giriş Yap</button>
        </form>
      </div>

      <!-- 2. Ekip üyeliği ile giriş (Kullanıcı Adı + Şifre) -->
      <div id="membership-form-wrap" hidden>
        <form id="membership-form">
          <label for="username">Kullanıcı Adı</label>
          <input
            id="username"
            name="username"
            type="text"
            placeholder="admin"
            autocomplete="username"
          />
          <label for="password" style="margin-top: 12px">Şifre</label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Şifreniz..."
            autocomplete="current-password"
            required
          />
          <button type="submit">Giriş Yap</button>
        </form>
      </div>

      <p class="foot">Phuket Tatili Operasyon · {new Date().getFullYear()}</p>
    </div>

    <script is:inline define:vars={{ configured, errorCode }}>
      (() => {
        // HTTP ile açıldıysa güvenli HTTPS bağlantısına yönlendir
        if (window.location.protocol === 'http:' && !['localhost', '127.0.0.1'].includes(window.location.hostname)) {
          window.location.replace('https://' + window.location.host + window.location.pathname + window.location.search);
          return;
        }

        const msg = document.getElementById('msg');
        const showError = (text) => {
          msg.textContent = text;
          msg.hidden = false;
        };

        const membershipWrap = document.getElementById('membership-form-wrap');
        const passcodeWrap = document.getElementById('passcode-form-wrap');
        const tabPasscode = document.getElementById('tab-passcode');
        const tabMembership = document.getElementById('tab-membership');

        const selectPasscodeTab = () => {
          tabPasscode.classList.add('active');
          tabMembership.classList.remove('active');
          passcodeWrap.hidden = false;
          membershipWrap.hidden = true;
          msg.hidden = true;
          document.getElementById('passcode').focus();
        };

        const selectMembershipTab = () => {
          tabMembership.classList.add('active');
          tabPasscode.classList.remove('active');
          membershipWrap.hidden = false;
          passcodeWrap.hidden = true;
          msg.hidden = true;
          document.getElementById('username').focus();
        };

        tabPasscode.addEventListener('click', selectPasscodeTab);
        tabMembership.addEventListener('click', selectMembershipTab);

        if (errorCode === 'unconfigured') {
          showError('Panel kilitli: sunucuda ADMIN_PASSCODE tanımlı değil.');
        }

        // ---- Üyelik girişi ----
        const mForm = document.getElementById('membership-form');
        const mButton = mForm.querySelector('button');
        mForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.hidden = true;
          mButton.disabled = true;
          mButton.textContent = 'Doğrulanıyor…';

          try {
            const targetUrl = new URL('/api/auth/login', window.location.href);
            if (window.location.protocol === 'https:') targetUrl.protocol = 'https:';

            const res = await fetch(targetUrl.toString(), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                username: (document.getElementById('username').value || '').trim() || 'admin',
                password: document.getElementById('password').value,
              }),
            });

            if (res.ok) {
              const data = await res.json();
              window.location.href = data.redirect;
              return;
            }

            if (res.status === 401) {
              showError('Kullanıcı adı veya şifre hatalı.');
            } else if (res.status === 429) {
              const data = await res.json().catch(() => ({}));
              const minutes = Math.ceil((data.retryAfterMs || 900000) / 60000);
              showError(`Çok fazla deneme. ${minutes} dakika sonra tekrar deneyin.`);
            } else if (res.status === 503) {
              const data = await res.json().catch(() => ({}));
              showError(data.error || 'Üyelik sistemi yapılandırılmamış. Eski tek-şifre girişini kullanın.');
            } else {
              showError('Giriş yapılamadı. Lütfen tekrar deneyin.');
            }
          } catch {
            showError('Bağlantı hatası. İnternetinizi kontrol edin.');
          }

          mButton.disabled = false;
          mButton.textContent = 'Giriş Yap';
          document.getElementById('password').value = '';
          document.getElementById('password').focus();
        });

        // ---- Eski tek-şifre girişi (geçiş dönemi) ----
        const form = document.getElementById('login-form');
        const button = form.querySelector('button');
        const input = document.getElementById('passcode');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          msg.hidden = true;
          button.disabled = true;
          button.textContent = 'Doğrulanıyor…';

          try {
            const targetUrl = new URL(form.action, window.location.href);
            if (window.location.protocol === 'https:') targetUrl.protocol = 'https:';

            const res = await fetch(targetUrl.toString(), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ passcode: input.value }),
            });

            if (res.ok) {
              const data = await res.json();
              window.location.href = data.redirect;
              return;
            }

            if (res.status === 401) {
              showError('Hatalı şifre. Tekrar deneyin.');
            } else if (res.status === 429) {
              const data = await res.json().catch(() => ({}));
              const minutes = Math.ceil((data.retryAfterMs || 900000) / 60000);
              showError(`Çok fazla deneme. ${minutes} dakika sonra tekrar deneyin.`);
            } else {
              showError('Giriş yapılamadı. Lütfen tekrar deneyin.');
            }
          } catch {
            showError('Bağlantı hatası. İnternetinizi kontrol edin.');
          }

          button.disabled = false;
          button.textContent = 'Giriş Yap';
          input.value = '';
          input.focus();
        });
      })();
    </script>
  </body>
</html>
