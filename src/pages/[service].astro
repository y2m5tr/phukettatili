---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';
import siteSettings from '../content/settings/site.json';

export const prerender = true;

export async function getStaticPaths() {
  const services: CollectionEntry<'services'>[] = await getCollection('services');
  return services.map((svc) => ({
    params: { service: svc.data.slug },
    props: { service: svc.data },
  }));
}

const { service } = Astro.props;

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const waMessage = `Merhaba, ${service.title} hakkında bilgi ve teklif almak istiyorum.`;
const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waMessage)}`;

const site = Astro.site || 'https://phukettatili.com';
const serviceURL = new URL(`/${service.slug}/`, site).toString();

const schemas: Record<string, unknown>[] = [
  {
    "@type": "Service",
    "name": service.title,
    "url": serviceURL,
    "description": service.intro || service.title,
    "provider": {
      "@type": "TravelAgency",
      "name": "Phuket Tatili",
      "url": site.toString(),
    },
    "areaServed": { "@type": "Place", "name": "Phuket, Tayland" },
    ...(service.media ? { "image": new URL(`/assets/${service.media}`, site).toString() } : {}),
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": new URL('/', site).toString() },
      { "@type": "ListItem", "position": 2, "name": service.title, "item": serviceURL },
    ],
  },
];
---

<Layout
  title={`${service.title} — Phuket Tatili`}
  noTitleSuffix
  description={service.intro}
  image={service.media ? `/assets/${service.media}` : undefined}
  schemas={schemas}
>
  <!-- Hero Section -->
  <section class="relative h-[55vh] min-h-[400px] flex items-end pb-12 overflow-hidden bg-brand-primary">
    <div class="absolute inset-0 z-0">
      <img
        src={`/assets/${service.media}`}
        alt={service.media_alt || service.title}
        class="w-full h-full object-cover animate-ken-burns"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-1 via-surface-1/60 to-transparent z-10"></div>
    </div>

    <div class="relative z-20 max-w-6xl mx-auto px-4 w-full">
      <FadeIn direction="up">
        {service.eyebrow && (
          <span class="inline-block bg-brand-amber text-white px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase mb-3 shadow-lg">
            {service.eyebrow}
          </span>
        )}
        <h1 class="text-4xl md:text-6xl text-white font-serif font-bold mb-4 drop-shadow-md">
          {service.heading || service.title}
        </h1>
        <p class="text-slate-200 max-w-2xl text-base md:text-lg font-light leading-relaxed">
          {service.intro}
        </p>
      </FadeIn>
    </div>
  </section>

  <!-- Options Grid -->
  {service.options && service.options.length > 0 && (
    <section class="py-20 bg-white dark:bg-surface-1 px-4 border-b border-slate-100 dark:border-slate-800">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">Seçenekler & Yaklaşım</span>
          <h2 class="text-3xl md:text-4xl font-serif text-brand-primary dark:text-white mt-2">Size En Uygun Planı Belirleyelim</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {service.options.map((opt, index: number) => (
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-brand-accent">0{index + 1}</span>
                <h3 class="text-lg font-bold text-brand-primary dark:text-white mt-2 mb-3">{opt.title}</h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{opt.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- How It Works / WhatsApp CTA -->
  <section class="py-20 bg-slate-50 dark:bg-surface-2 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">Teklif ve Rezervasyon</span>
        <h2 class="text-3xl font-serif text-brand-primary dark:text-white mt-2 mb-6">Hangi Bilgileri Paylaşmalısınız?</h2>
        <p class="text-slate-600 dark:text-slate-300 mb-6 text-sm leading-relaxed">
          Size en doğru teklifi hızla sunabilmemiz için WhatsApp mesajınızda aşağıdaki detayları paylaşmanız yeterlidir:
        </p>
        {service.questions && service.questions.length > 0 && (
          <ul class="space-y-3">
            {service.questions.map((q: string) => (
              <li class="flex items-center gap-3 text-sm text-slate-700 dark:text-slate-300">
                <svg class="w-5 h-5 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>{q}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="bg-white dark:bg-slate-800 p-8 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-700 text-center">
        <h3 class="text-2xl font-serif font-bold text-brand-primary dark:text-white mb-3">Hemen İletişime Geçin</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm mb-8 leading-relaxed">
          Türkçe destek veren yerel ekibimiz talebinizi inceleyip müsaitlik ve fiyat detaylarını doğrudan WhatsApp üzerinden iletecektir.
        </p>
        <a
          href={waUrl}
          target="_blank"
          class="inline-flex items-center justify-center gap-3 w-full bg-whatsapp text-white py-4 px-6 rounded-2xl font-bold hover:bg-whatsapp-dark transition-all shadow-lg shadow-green-500/20"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp ile Teklif İste ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
