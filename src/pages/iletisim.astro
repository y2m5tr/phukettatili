---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';
import siteSettings from '../content/settings/site.json';
const whatsappUrl = `https://wa.me/${siteSettings.whatsappNumber || '66828950665'}`;

export const prerender = true;

const contactSchemas: Record<string, unknown>[] = [
  {
    "@type": "ContactPage",
    "name": "İletişim & Destek — Phuket Tatili",
    "url": "https://phukettatili.com/iletisim/",
    "description": "Phuket turları, VIP havalimanı transferleri ve özel ada planlamanız için 7/24 Türkçe iletişim.",
    "mainEntity": {
      "@type": "TravelAgency",
      "name": "Phuket Tatili",
      "telephone": "+66 82 895 0665",
      "email": siteSettings.email || "info@phukettatili.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Phuket",
        "addressCountry": "TH"
      }
    }
  }
];
---

<Layout
  title="İletişim & 7/24 Destek — Phuket Tatili"
  description="Phuket turları, havalimanı transferleri ve özel gezi planlamanız için bize WhatsApp veya telefon üzerinden 7/24 ulaşabilirsiniz. Yerinde Türkçe destek."
  schemas={contactSchemas}
>
  {/* Hero Header */}
  <div class="bg-brand-primary text-white py-20 md:py-24 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25 z-0">
      <img src="/assets/phuket_culture.webp" alt="Phuket Tatili ekibi ve Tayland kültürü" class="w-full h-full object-cover animate-ken-burns" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-primary/80 via-brand-primary/60 to-brand-primary z-0 pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      <FadeIn client:load direction="up">
        <span class="inline-block text-xs uppercase tracking-[0.2em] text-brand-accent font-bold mb-3">
          Yerel Türk Acentesi
        </span>
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4 text-white drop-shadow-lg tracking-tight">
          İletişim & Hakkımızda
        </h1>
      </FadeIn>
      <FadeIn client:load delay={0.15} direction="up">
        <p class="text-slate-200 text-base md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
          10 yılı aşkın ada tecrübemiz ve yerel Türk ekibimizle Phuket'te 7/24 yanınızdayız.
        </p>
      </FadeIn>
    </div>
  </div>

  {/* Hakkımızda & Hikayemiz Bölümü */}
  <section class="py-20 md:py-24 bg-slate-50 dark:bg-surface-1 px-4 border-b border-slate-200/80 dark:border-slate-800">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <FadeIn client:visible direction="right">
        <div>
          <span class="text-xs uppercase tracking-widest text-brand-accent font-bold block mb-2">Hikâyemiz & Deneyimimiz</span>
          <h2 class="text-3xl md:text-4xl font-serif text-brand-primary dark:text-white font-bold mb-5 tracking-tight">
            Hayallerinizdeki Phuket Tatili İçin Buradayız
          </h2>
          <div class="space-y-4 text-slate-600 dark:text-slate-300 leading-relaxed text-base sm:text-lg">
            <p>
              Phuket, sadece muhteşem plajlarıyla değil; gizli kalmış cennet koyları, tarihi tapınakları ve tropik ada kültürüyle benzersiz bir coğrafyadır. Biz, bu cenneti sizin için güvenle ulaşılabilir kılıyoruz.
            </p>
            <p>
              Yabancı dil engeli ve yerel acente karmaşasından uzak; Türkçe rehberlik hizmetiyle kendi dilinizde ve kültürünüzde rahat edeceğiniz VIP hizmetler sunuyoruz. En popüler Phi Phi ve James Bond rotalarından, kişiye özel katamaran ve transferlere kadar her detayı yerinde denetleyerek organize ediyoruz.
            </p>
          </div>
          
          {/* İstatistikler */}
          <div class="mt-8 grid grid-cols-2 gap-6 pt-6 border-t border-slate-200 dark:border-slate-800">
            <div>
              <h4 class="text-3xl sm:text-4xl font-bold text-brand-accent mb-1">
                <span class="stat-count" data-target="10" data-suffix="+">10+</span>
              </h4>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">Yıllık Ada Tecrübesi</p>
            </div>
            <div>
              <h4 class="text-3xl sm:text-4xl font-bold text-brand-accent mb-1">
                <span class="stat-count" data-target="5000" data-suffix="+">5000+</span>
              </h4>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">Mutlu Misafir & Aile</p>
            </div>
          </div>
        </div>
      </FadeIn>
      
      <FadeIn client:visible delay={0.2} direction="left">
        <div class="relative">
          <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-xl border border-slate-200/60 dark:border-slate-700/60">
            <img 
              src="/assets/phuket_hero.webp" 
              alt="Phuket Tatili Deneyimi" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" 
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-xl max-w-xs hidden sm:block border border-slate-100 dark:border-slate-700">
            <p class="font-serif text-base text-brand-primary dark:text-white italic leading-snug">
              "Mükemmel bir Phuket tatili, yerel ekiple doğru planlamayla başlar."
            </p>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

  {/* 3 Temel Güven Sütunu (Hakkımızda'dan Birleştirildi) */}
  <section class="py-16 md:py-20 bg-white dark:bg-surface-2 px-4 border-b border-slate-200/80 dark:border-slate-800">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs tracking-widest uppercase text-brand-accent font-bold mb-2 block">Güven & Kalite Standartlarımız</span>
        <h3 class="text-2xl md:text-3xl font-serif text-brand-primary dark:text-white font-bold">Neden Phuket Tatili ile Seyahat Etmelisiniz?</h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <FadeIn client:visible delay={0.1} direction="up">
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 text-center">
            <div class="w-14 h-14 bg-brand-accent/15 rounded-2xl flex items-center justify-center mx-auto mb-4 text-brand-accent">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Resmi TAT Lisansı & Sigorta</h4>
            <p class="text-slate-600 dark:text-slate-400 text-sm font-light leading-relaxed">
              Tayland Turizm Otoritesi (TAT) lisanslı acente güvencesiyle tüm turlarımız tam kapsamlı yolcu sigortası altındadır.
            </p>
          </div>
        </FadeIn>

        <FadeIn client:visible delay={0.2} direction="up">
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 text-center">
            <div class="w-14 h-14 bg-emerald-500/15 rounded-2xl flex items-center justify-center mx-auto mb-4 text-emerald-600 dark:text-emerald-400">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2">7/24 Kesintisiz Türkçe Destek</h4>
            <p class="text-slate-600 dark:text-slate-400 text-sm font-light leading-relaxed">
              Phuket'te yaşayan Türk ekibimiz uçağınız indiği andan dönüşünüze kadar WhatsApp üzerinden anlık yanınızdadır.
            </p>
          </div>
        </FadeIn>

        <FadeIn client:visible delay={0.3} direction="up">
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 text-center">
            <div class="w-14 h-14 bg-amber-500/15 rounded-2xl flex items-center justify-center mx-auto mb-4 text-amber-500">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
            </div>
            <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Ayrıcalıklı VIP Deneyim</h4>
            <p class="text-slate-600 dark:text-slate-400 text-sm font-light leading-relaxed">
              Klimalı konforlu transfer araçları, butik yat kiralama ve tamamen size özel esnek saatli rota planlaması.
            </p>
          </div>
        </FadeIn>
      </div>
    </div>
  </section>

  {/* İletişim Bilgileri & Mesaj / WhatsApp Formu */}
  <section class="py-20 md:py-24 bg-slate-50 dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
      
      {/* İletişim Kanalları */}
      <FadeIn client:visible direction="right">
        <div>
          <span class="text-xs uppercase tracking-widest text-brand-accent font-bold block mb-2">Bize Ulaşın</span>
          <h2 class="text-3xl font-serif text-brand-primary dark:text-white font-bold mb-6 tracking-tight">
            Doğrudan İletişim Kanallarımız
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm mb-8 leading-relaxed">
            Tatil tarihleriniz, tur uygunlukları veya özel VIP transfer talepleriniz için dilediğiniz kanaldan anında iletişime geçebilirsiniz.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-xs">
              <div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div class="min-w-0">
                <h4 class="font-bold text-slate-800 dark:text-slate-200 text-sm mb-0.5">WhatsApp / Telefon</h4>
                <p class="text-slate-500 dark:text-slate-400 text-xs mb-1.5">Hızlı rezervasyon & anlık Türkçe danışma:</p>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 font-bold text-sm hover:underline">
                  +66 82 895 0665
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-xs">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-xl flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div class="min-w-0">
                <h4 class="font-bold text-slate-800 dark:text-slate-200 text-sm mb-0.5">E-Posta</h4>
                <p class="text-slate-500 dark:text-slate-400 text-xs mb-1.5">Özel grup indirimleri & kurumsal talepler:</p>
                <a href={`mailto:${siteSettings.email || 'info@phukettatili.com'}`} class="text-brand-accent font-bold text-sm hover:underline">
                  {siteSettings.email || 'info@phukettatili.com'}
                </a>
              </div>
            </div>
            
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-xs">
              <div class="w-12 h-12 bg-sky-500/10 rounded-xl flex items-center justify-center text-sky-600 dark:text-sky-400 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div class="min-w-0">
                <h4 class="font-bold text-slate-800 dark:text-slate-200 text-sm mb-0.5">Merkez Operasyon Ofisi</h4>
                <p class="text-slate-500 dark:text-slate-400 text-xs">
                  Phuket, Tayland (Misafir karşılama ve operasyon üssü)
                </p>
              </div>
            </div>
          </div>
        </div>
      </FadeIn>

      {/* İletişim & Mesaj Formu */}
      <FadeIn client:visible delay={0.2} direction="left">
        <div class="bg-white dark:bg-slate-800 p-7 sm:p-8 rounded-3xl shadow-md border border-slate-200/80 dark:border-slate-700">
          <h3 class="text-2xl font-serif font-bold text-brand-primary dark:text-white mb-2">Bize Mesaj Gönderin</h3>
          <p class="text-slate-500 dark:text-slate-400 text-xs mb-6">Formu doldurarak doğrudan e-posta gönderebilir veya WhatsApp'tan yazabilirsiniz.</p>

          <div id="contact-status" class="hidden mb-6 rounded-xl border p-4 text-sm font-medium" role="status" aria-live="polite"></div>

          <form 
            id="contact-form"
            data-whatsapp-number={siteSettings.whatsappNumber || '66828950665'}
            data-email={siteSettings.email || 'info@phukettatili.com'}
            class="space-y-4"
          >
            <div>
              <label for="form-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Adınız Soyadınız</label>
              <input type="text" id="form-name" name="name" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white text-sm transition-all" />
            </div>
            <div>
              <label for="form-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">E-Posta Adresiniz</label>
              <input type="email" id="form-email" name="email" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white text-sm transition-all" />
            </div>
            <div>
              <label for="form-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">WhatsApp / Telefon Numaranız</label>
              <input type="tel" id="form-phone" name="phone" placeholder="+90 veya +66..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white text-sm transition-all" />
            </div>
            <div>
              <label for="form-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">Mesajınız veya Tur Talebiniz</label>
              <textarea id="form-message" name="message" rows="4" required placeholder="Tur tarihiniz, kişi sayınız ve merak ettikleriniz..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white text-sm transition-all"></textarea>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <button type="submit" id="submit-btn" class="w-full bg-brand-primary text-white py-3.5 px-4 rounded-xl font-bold text-xs sm:text-sm hover:bg-brand-accent transition-colors shadow-md cursor-pointer">
                Mesaj Gönder
              </button>
              <button type="button" id="whatsapp-btn" class="w-full bg-[#25D366] text-white py-3.5 px-4 rounded-xl font-bold text-xs sm:text-sm hover:bg-[#128C7E] transition-colors shadow-md flex items-center justify-center gap-2 cursor-pointer">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                <span>WhatsApp'tan Yaz</span>
              </button>
            </div>
          </form>
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const waBtn = document.getElementById('whatsapp-btn');
    const msg = document.getElementById('contact-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const showStatus = (text: string, success: boolean) => {
      if (!msg) return;
      msg.textContent = text;
      msg.className = success
        ? 'mb-6 rounded-xl border border-green-200 bg-green-50 p-4 text-sm font-medium text-green-800 dark:border-green-800 dark:bg-green-950/40 dark:text-green-300 block'
        : 'mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-800 dark:border-red-800 dark:bg-red-950/40 dark:text-red-300 block';
    };

    if (waBtn) {
      waBtn.onclick = () => {
        const name = (document.getElementById('form-name') as HTMLInputElement)?.value.trim() || '';
        const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value.trim() || '';
        const email = (document.getElementById('form-email') as HTMLInputElement)?.value.trim() || '';
        const message = (document.getElementById('form-message') as HTMLTextAreaElement)?.value.trim() || '';

        const text = `Merhaba Phuket Tatili,\n\nİsim: ${name}\nTelefon: ${phone}\nE-posta: ${email}\n\nMesaj:\n${message}`;
        const waNumber = form.dataset.whatsappNumber || '66828950665';
        window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
      };
    }

    if (form) {
      form.onsubmit = async (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.textContent = 'Gönderiliyor...';
        }

        const formData = new FormData(form);
        const name = (formData.get('name') as string)?.trim() || '';
        const email = (formData.get('email') as string)?.trim() || '';
        const phone = (formData.get('phone') as string)?.trim() || '';
        const message = (formData.get('message') as string)?.trim() || '';

        const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '';

        try {
          if (accessKey) {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                access_key: accessKey,
                from_name: name,
                email: email,
                phone: phone,
                message: message,
                subject: `Phuket Tatili İletişim Formu: ${name}`,
              }),
            });

            if (response.ok) {
              showStatus('Mesajınız başarıyla iletildi! Ekibimiz en kısa sürede sizinle iletişime geçecektir.', true);
              form.reset();
            } else {
              throw new Error('Form submission failed');
            }
          } else {
            const targetEmail = form.dataset.email || 'info@phukettatili.com';
            window.location.href = `mailto:${targetEmail}?subject=${encodeURIComponent(`Phuket Tatili İletişim: ${name}`)}&body=${encodeURIComponent(`İsim: ${name}\nTelefon: ${phone}\nE-posta: ${email}\n\nMesaj:\n${message}`)}`;
            showStatus('E-posta uygulamanız açılıyor... Dilerseniz WhatsApp üzerinden de anında yazabilirsiniz.', true);
            form.reset();
          }
        } catch {
          const targetEmail = form.dataset.email || 'info@phukettatili.com';
          window.location.href = `mailto:${targetEmail}?subject=${encodeURIComponent(`Phuket Tatili İletişim: ${name}`)}&body=${encodeURIComponent(`İsim: ${name}\nTelefon: ${phone}\nE-posta: ${email}\n\nMesaj:\n${message}`)}`;
          showStatus('E-posta uygulamanız açılıyor... Dilerseniz WhatsApp üzerinden de anında yazabilirsiniz.', true);
        } finally {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.textContent = 'Mesaj Gönder';
          }
        }
      };
    }
  });
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const stats = Array.from(document.querySelectorAll<HTMLElement>('.stat-count'));
    if (stats.length === 0) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      const suffix = el.dataset.suffix || '';
      if (reduce) { el.textContent = target.toLocaleString('tr-TR') + suffix; return; }
      const dur = 1600;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('tr-TR') + suffix;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    stats.forEach((el) => io.observe(el));
  });
</script>
