---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';
import siteSettings from '../content/settings/site.json';
const whatsappUrl = `https://wa.me/${siteSettings.whatsappNumber}`;

export const prerender = true;
---

<Layout
  title="İletişim & 7/24 Destek — Phuket Tatili"
  description="Phuket turları, havalimanı transferleri ve özel gezi planlamanız için bize WhatsApp veya telefon üzerinden 7/24 ulaşabilirsiniz. Yerinde Türkçe destek."
>
  <div class="bg-brand-primary text-white py-24 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-30 z-0">
      <img src="/assets/phuket_culture.webp" alt="Phuket Tatili ekibi ve Tayland kültürü" class="w-full h-full object-cover animate-ken-burns" />
    </div>
    <div class="relative max-w-4xl mx-auto text-center z-10">
      <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6 text-white drop-shadow-lg">Hakkımızda & İletişim</h1>
      <p class="text-slate-200 text-lg font-light">Yılların tecrübesiyle Phuket'te Türkçe rehberlik — bize 7/24 ulaşabilirsiniz.</p>
    </div>
  </div>

  <!-- Hakkimizda bolumu (birlestirildi) -->
  <section class="py-24 bg-slate-50 dark:bg-surface-1 px-4 border-b border-slate-100 dark:border-slate-800">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-serif text-brand-primary dark:text-white font-bold mb-6">Hayallerinizdeki Tatil İçin Buradayız</h2>
        <div class="space-y-4 text-slate-600 dark:text-slate-300 leading-relaxed text-lg">
          <p>
            Phuket, sadece muhteşem plajlarıyla değil, gizli kalmış adaları, tapınakları ve yerel kültürüyle benzersiz bir cennettir. Biz, bu cenneti sizin için ulaşılabilir kılıyoruz.
          </p>
          <p>
            Yerel acentelerin karmaşasından uzak, Türkçe rehberlik hizmetiyle kendi dilinizde ve kültürünüzde rahat edeceğiniz VIP hizmetler sunuyoruz. En popüler Phi Phi Adaları'ndan, gizli kalmış cennet koylara kadar her rotayı özenle tasarladık.
          </p>
        </div>
        
        <div class="mt-10 grid grid-cols-2 gap-8">
          <div>
            <h4 class="text-4xl font-bold text-brand-accent mb-2">
              <span class="stat-count" data-target="10" data-suffix="+">10+</span>
            </h4>
            <p class="text-slate-500 dark:text-slate-400">Yıllık Tecrübe</p>
          </div>
          <div>
            <h4 class="text-4xl font-bold text-brand-accent mb-2">
              <span class="stat-count" data-target="5000" data-suffix="+">5000+</span>
            </h4>
            <p class="text-slate-500 dark:text-slate-400">Mutlu Misafir</p>
          </div>
        </div>
      </div>
      
      <div class="relative">
        <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl">
          <img src="/assets/phuket_hero.webp" alt="Phuket Vacation" class="w-full h-full object-cover hover:scale-110 transition-transform duration-1000" />
        </div>
        <div class="absolute -bottom-8 -left-8 bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-xl max-w-xs hidden md:block border border-slate-100 dark:border-slate-700">
          <p class="font-serif text-xl text-brand-primary dark:text-white italic">"Mükemmel bir tatil, kusursuz bir planlamayla başlar."</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">
      
      <!-- Contact Info -->
      <FadeIn client:visible direction="right">
        <div>
          <h2 class="text-3xl font-serif text-brand-primary dark:text-white font-bold mb-8">İletişim Bilgilerimiz</h2>
          
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-1">WhatsApp / Telefon</h4>
                <p class="text-slate-600 dark:text-slate-400 mb-2">Hızlı rezervasyon ve Türkçe destek için:</p>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-brand-accent font-bold hover:underline">+66 82 895 0665</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-1">E-Posta</h4>
                <p class="text-slate-600 dark:text-slate-400 mb-2">Özel talepleriniz ve grup indirimleri için:</p>
                <a href={`mailto:${siteSettings.email}`} class="text-brand-accent font-bold hover:underline">{siteSettings.email}</a>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center text-brand-accent shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 dark:text-slate-200 mb-1">Merkez Ofis</h4>
                <p class="text-slate-600 dark:text-slate-400">Phuket, Tayland (Randevu ile kabul edilmektedir)</p>
              </div>
            </div>
          </div>
        </div>
      </FadeIn>

      <!-- Contact Form -->
      <FadeIn client:visible delay={0.2} direction="left">
        <div class="bg-slate-50 dark:bg-slate-800 p-8 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-700">
          <h3 class="text-2xl font-bold text-brand-primary dark:text-white mb-6">Mesaj Gönderin</h3>

          <div id="contact-status" class="hidden mb-6 rounded-xl border p-4 text-sm font-medium" role="status" aria-live="polite"></div>

          <form 
            id="contact-form"
            data-whatsapp-number={siteSettings.whatsappNumber}
            data-email={siteSettings.email}
            class="space-y-4"
          >
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Adınız Soyadınız</label>
              <input type="text" id="form-name" name="name" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white dark:bg-surface-2 text-slate-800 dark:text-white transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">E-Posta Adresiniz</label>
              <input type="email" id="form-email" name="email" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white dark:bg-surface-2 text-slate-800 dark:text-white transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">WhatsApp / Telefon Numaranız</label>
              <input type="tel" id="form-phone" name="phone" placeholder="+90 veya +66..." class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white dark:bg-surface-2 text-slate-800 dark:text-white transition-all" />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Mesajınız</label>
              <textarea id="form-message" name="message" rows="4" required class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent bg-white dark:bg-surface-2 text-slate-800 dark:text-white transition-all"></textarea>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <button type="submit" id="submit-btn" class="w-full bg-brand-primary text-white py-3.5 px-4 rounded-xl font-bold hover:bg-brand-amber transition-colors shadow-lg">
                Mesaj Gönder
              </button>
              <button type="button" id="whatsapp-btn" class="w-full bg-[#25D366] text-white py-3.5 px-4 rounded-xl font-bold hover:bg-[#128C7E] transition-colors shadow-lg flex items-center justify-center gap-2">
                <span>WhatsApp'tan Yaz</span>
              </button>
            </div>
          </form>
        </div>
      </FadeIn>
      
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const waBtn = document.getElementById('whatsapp-btn');
    const msg = document.getElementById('contact-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const showStatus = (text: string, success: boolean) => {
      if (!msg) return;
      msg.textContent = text;
      msg.className = success
        ? 'mb-6 rounded-xl border border-green-200 bg-green-50 p-4 text-sm font-medium text-green-800 dark:border-green-800 dark:bg-green-950/40 dark:text-green-300 block'
        : 'mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-800 dark:border-red-800 dark:bg-red-950/40 dark:text-red-300 block';
    };

    if (waBtn) {
      waBtn.onclick = () => {
        const name = (document.getElementById('form-name') as HTMLInputElement)?.value.trim() || '';
        const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value.trim() || '';
        const email = (document.getElementById('form-email') as HTMLInputElement)?.value.trim() || '';
        const message = (document.getElementById('form-message') as HTMLTextAreaElement)?.value.trim() || '';

        const text = `Merhaba Phuket Tatili,\n\nİsim: ${name}\nTelefon: ${phone}\nE-posta: ${email}\n\nMesaj:\n${message}`;
        const waNumber = form.dataset.whatsappNumber || '66828950665';
        window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
      };
    }

    if (form) {
      form.onsubmit = async (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.textContent = 'Gönderiliyor...';
        }

        const formData = new FormData(form);
        const name = (formData.get('name') as string)?.trim() || '';
        const email = (formData.get('email') as string)?.trim() || '';
        const phone = (formData.get('phone') as string)?.trim() || '';
        const message = (formData.get('message') as string)?.trim() || '';

        const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '';

        try {
          if (accessKey) {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                access_key: accessKey,
                from_name: name,
                email: email,
                phone: phone,
                message: message,
                subject: `Phuket Tatili İletişim Formu: ${name}`,
              }),
            });

            if (response.ok) {
              showStatus('Mesajınız başarıyla iletildi! Ekibimiz en kısa sürede sizinle iletişime geçecektir.', true);
              form.reset();
            } else {
              throw new Error('Form submission failed');
            }
          } else {
            const targetEmail = form.dataset.email || 'info@phukettatili.com';
            window.location.href = `mailto:${targetEmail}?subject=${encodeURIComponent(`Phuket Tatili İletişim: ${name}`)}&body=${encodeURIComponent(`İsim: ${name}\nTelefon: ${phone}\nE-posta: ${email}\n\nMesaj:\n${message}`)}`;
            showStatus('E-posta uygulamanız açılıyor... Dilerseniz WhatsApp üzerinden de anında yazabilirsiniz.', true);
            form.reset();
          }
        } catch {
          const targetEmail = form.dataset.email || 'info@phukettatili.com';
          window.location.href = `mailto:${targetEmail}?subject=${encodeURIComponent(`Phuket Tatili İletişim: ${name}`)}&body=${encodeURIComponent(`İsim: ${name}\nTelefon: ${phone}\nE-posta: ${email}\n\nMesaj:\n${message}`)}`;
          showStatus('E-posta uygulamanız açılıyor... Dilerseniz WhatsApp üzerinden de anında yazabilirsiniz.', true);
        } finally {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.textContent = 'Mesaj Gönder';
          }
        }
      };
    }
  });
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const stats = Array.from(document.querySelectorAll<HTMLElement>('.stat-count'));
    if (stats.length === 0) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const animate = (el: HTMLElement) => {
      const target = parseInt(el.dataset.target || '0', 10);
      const suffix = el.dataset.suffix || '';
      if (reduce) { el.textContent = target.toLocaleString('tr-TR') + suffix; return; }
      const dur = 1600;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased).toLocaleString('tr-TR') + suffix;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    stats.forEach((el) => io.observe(el));
  });
</script>
