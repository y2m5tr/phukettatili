---
import { getCollection, type CollectionEntry } from 'astro:content';
import FieldApp from '../components/field/FieldApp';
import siteData from '../content/settings/site.json';
import '../styles/global.css';

// Sunucu tarafında render edilir: /ekip adresine gelen istek önce
// src/middleware.ts içindeki oturum kontrolünden geçer. Prerender edilirse
// middleware çalışmaz ve sayfa içeriği herkese açık statik dosya olur.
export const prerender = false;

// Turlar - sahada hızlı satış için liste
const tours: CollectionEntry<'tours'>[] = await getCollection('tours');
const initialTours = tours
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((tour) => ({
    id: tour.id,
    title: tour.data.title,
    category: tour.data.category,
    categoryLabel: tour.data.category_label || tour.data.category,
    priceThb: tour.data.price_thb || 0,
    duration: tour.data.duration || 'Tam Gün',
    featured: Boolean(tour.data.featured),
    active: true,
    image: tour.data.image || 'phuket_hero.webp',
  }));

const managerPhone = siteData?.whatsappNumber || '66828950665';
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <title>Saha & Rehber Mobil Operasyon | Phuket Tatili</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest-ekip.json" />
    <meta name="theme-color" content="#020617" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Saha Ekibi" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }
      /* Mobil akıcılık ve scrollbar gizleme */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased selection:bg-amber-500 selection:text-slate-950 min-h-screen">
    <FieldApp
      client:only="react"
      initialTours={initialTours}
      managerPhone={managerPhone}
    />
  </body>
</html>
