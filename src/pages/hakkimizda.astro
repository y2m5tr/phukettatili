---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';
import siteSettings from '../content/settings/site.json';

export const prerender = true;
---

<Layout title="Hakkımızda" description="Phuket Tatili ekibi - Tayland'da unutulmaz anılar için lüks tur hizmetleri. 7/24 Türkçe rehberlik.">
  <div class="bg-brand-primary text-white py-24 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-30 z-0">
      <img src="/assets/phuket_culture.webp" alt="Phuket Culture" class="w-full h-full object-cover animate-ken-burns" />
    </div>
    <div class="relative max-w-4xl mx-auto text-center z-10">
      <FadeIn client:load direction="up">
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6">Biz Kimiz?</h1>
      </FadeIn>
      <FadeIn client:load delay={0.2} direction="up">
        <p class="text-slate-300 text-lg md:text-xl font-light">
          Yılların getirdiği tecrübeyle Tayland ve Phuket'teki en iyi yerel ağları sizin için birleştirdik.
        </p>
      </FadeIn>
    </div>
  </div>

  <section class="py-24 bg-slate-50 dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <FadeIn client:visible direction="right">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif text-brand-primary dark:text-white font-bold mb-6">Hayallerinizdeki Tatil İçin Buradayız</h2>
          <div class="space-y-4 text-slate-600 dark:text-slate-400 leading-relaxed text-lg">
            <p>
              Phuket, sadece muhteşem plajlarıyla değil, gizli kalmış adaları, tapınakları ve yerel kültürüyle benzersiz bir cennettir. Biz, bu cenneti sizin için ulaşılabilir kılıyoruz.
            </p>
            <p>
              Yerel acentelerin karmaşasından uzak, Türkçe rehberlik hizmetiyle kendi dilinizde ve kültürünüzde rahat edeceğiniz VIP hizmetler sunuyoruz.
            </p>
          </div>
          
          <div class="mt-10 grid grid-cols-2 gap-8">
            <div>
              <h4 class="text-4xl font-bold text-brand-accent mb-2">
                <span class="stat-count" data-target="10" data-suffix="+">10+</span>
              </h4>
              <p class="text-slate-500 dark:text-slate-400">Yıllık Tecrübe</p>
            </div>
            <div>
              <h4 class="text-4xl font-bold text-brand-accent mb-2">
                <span class="stat-count" data-target="5000" data-suffix="+">5000+</span>
              </h4>
              <p class="text-slate-500 dark:text-slate-400">Mutlu Misafir</p>
            </div>
          </div>
        </div>
      </FadeIn>
      
      <FadeIn client:visible delay={0.3} direction="left">
        <div class="relative">
          <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl">
            <img src="/assets/phuket_hero.webp" alt="Phuket Vacation" class="w-full h-full object-cover hover:scale-110 transition-transform duration-1000" />
          </div>
          <div class="absolute -bottom-8 -left-8 bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-xl max-w-xs hidden md:block border border-slate-100 dark:border-slate-700">
            <p class="font-serif text-xl text-brand-primary dark:text-white italic">"Mükemmel bir tatil, kusursuz bir planlamayla başlar."</p>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>

  <section class="py-24 bg-white dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto">
      <FadeIn client:visible delay={0.5} direction="up">
        <div class="text-center mb-16">
          <h2 class="text-sm tracking-widest uppercase text-brand-accent font-sans font-bold mb-3">Neden Güvenirsiniz?</h2>
          <h3 class="text-4xl md:text-5xl font-serif text-brand-primary dark:text-white">Phuket Tatili ile Seyahat Edin</h3>
        </div>
      </FadeIn>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        <FadeIn client:visible delay={0.1} direction="up">
          <div class="w-16 h-16 bg-brand-accent/20 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-accent transform hover:scale-110 hover:rotate-12 transition-transform duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h4 class="text-xl font-bold mb-3">Güvenli Seyahat</h4>
          <p class="text-slate-400 dark:text-slate-400 font-light">Tüm turlarımız tam kapsamlı sigorta ile güvence altındadır.</p>
        </FadeIn>
        <FadeIn client:visible delay={0.3} direction="up">
          <div class="w-16 h-16 bg-brand-accent/20 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-accent transform hover:scale-110 hover:-rotate-12 transition-transform duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <h4 class="text-xl font-bold mb-3">7/24 Türkçe Destek</h4>
          <p class="text-slate-400 dark:text-slate-400 font-light">Tayland'daki ekibimizden kesintisiz Türkçe iletişim desteği.</p>
        </FadeIn>
        <FadeIn client:visible delay={0.5} direction="up">
          <div class="w-16 h-16 bg-brand-accent/20 rounded-full flex items-center justify-center mx-auto mb-6 text-brand-accent transform hover:scale-110 hover:rotate-12 transition-transform duration-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
          </div>
          <h4 class="text-xl font-bold mb-3">VIP Deneyim</h4>
          <p class="text-slate-400 dark:text-slate-400 font-light">Kişiye özel lüks araçlar ve ayrıcalıklı VIP turlar.</p>
        </FadeIn>
      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-50 dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <FadeIn client:visible delay={0.1}>
        <h2 class="text-3xl md:text-4xl font-serif text-brand-primary dark:text-white mb-8">İletişimde Olun</h2>
      </FadeIn>
      <FadeIn client:visible delay={0.2}>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto text-left">
          <a
            href="https://wa.me/66828950665"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-3 p-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 hover:border-emerald-400 dark:hover:border-emerald-600 transition-colors shadow-2xs group"
          >
            <div class="w-10 h-10 bg-[#25D366] rounded-full flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white mb-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">WhatsApp</h4>
              <p class="text-slate-600 dark:text-slate-400 text-sm">+66 82 895 0665</p>
            </div>
          </a>
          <a
            href={`mailto:${siteSettings.email || 'info@phukettatili.com'}`}
            class="flex items-start gap-3 p-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 hover:border-amber-400 dark:hover:border-amber-600 transition-colors shadow-2xs group"
          >
            <div class="w-10 h-10 bg-brand-accent/20 rounded-full flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white mb-1 group-hover:text-brand-accent transition-colors">E-Posta</h4>
              <p class="text-slate-600 dark:text-slate-400 text-sm">{siteSettings.email || 'info@phukettatili.com'}</p>
            </div>
          </a>
          <div class="flex items-start gap-3 p-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-2xs">
            <div class="w-10 h-10 bg-brand-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white mb-1">Ofis</h4>
              <p class="text-slate-600 dark:text-slate-400 text-sm">Phuket, Tayland</p>
            </div>
          </div>
        </div>
      </FadeIn>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.stat-count').forEach((el) => {
    const target = parseInt(el.dataset.target || '0', 10);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (reduce) {
      el.textContent = target.toLocaleString('tr-TR');
      return;
    }
    
    let count = 0;
    const duration = 2000;
    const interval = 50;
    
    const updateCount = () => {
      if (count < target) {
        count += Math.ceil(target / (duration / interval));
        if (count > target) count = target;
        el.textContent = count.toLocaleString('tr-TR');
        setTimeout(updateCount, interval);
      }
    };
    
    updateCount();
  });
</script>