---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogRelatedTour from '../../components/BlogRelatedTour.astro';
import siteSettings from '../../content/settings/site.json';
import { getCloudBlogPosts, applyBlogOverlayToEntry } from '../../lib/server/blogContent';

// Dinamik SSR: panelde değişen başlık/özet/kapak/tarih anında yansır (bulut
// overlay). Build'deki .md verisi taban; üzerine content_store 'blogs' kaydı
// gelir. Bulut yoksa site statik veriyle çalışmaya devam eder.
export const prerender = false;

// CDN cache: sayfa 60sn Vercel edge'de, 5 dk bayat kabul edilir.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// Yazı kaydını id'den bul (dinamik route — getStaticPaths yok)
const { id } = Astro.params;
const mdPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const post = mdPosts.find((p) => p.id === id);

if (!post) {
  return Astro.redirect('/blog', 302);
}

// Bulut overlay: panelde düzenlenen metadata alanları bu yazıya uygulanır.
// Entry YERİNDE güncellenir — render(post) gövdeyi entry'nin iç alanlarından
// üretir (turlar/[id].astro emsalindeki gibi).
applyBlogOverlayToEntry(post, await getCloudBlogPosts());

const allTours: CollectionEntry<'tours'>[] = await getCollection('tours');
const { Content } = await render(post);
const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';

// Default tour and badge mapping by blog post ID
const tourMapping: Record<string, { tourId: string; badge: string }> = {
  'phi-phi-adalari-rehberi-ilk-kez-gidecekler-icin-ipuclari': {
    tourId: 'phi-phi-maya-ve-bamboo-adasi',
    badge: 'Popüler Phi Phi Turunu İnceleyin',
  },
  'phuket-etik-fil-koruma-alanlari-rehberi': {
    tourId: 'fil-besleme-ve-bakim-deneyimi',
    badge: 'Etik Fil Bakım Deneyimi Turu',
  },
  'phuket-en-iyi-plajlar-ve-bolge-rehberi': {
    tourId: 'phuket-sehir-ve-kultur-turu',
    badge: 'Phuket Şehir ve Manzara Turu',
  },
  'phukette-kasim-ayi-hava-durumu': {
    tourId: 'similan-adalari-surat-teknesi-turu',
    badge: 'Yalnızca Yüksek Sezonda Açık: Similan Turu',
  },
  'tayland-mutfagi-phukette-ne-yenir': {
    tourId: 'phuket-sehir-ve-kultur-turu',
    badge: 'Kültür ve Lezzet Turu',
  },
  'phuket-gezilecek-yerler-gezi-rehberi': {
    tourId: 'phuket-sehir-ve-kultur-turu',
    badge: 'Kültür ve Şehir Turuyla Keşfedin',
  },
  'james-bond-adasi-ve-phang-nga-korfezi-rehberi': {
    tourId: 'james-bond-adasi-ve-kano-turu',
    badge: 'James Bond & Kano Turunu İnceleyin',
  },
  'phuket-havalimani-transfer-ve-ulasim-rehberi': {
    tourId: 'phuket-sehir-ve-kultur-turu',
    badge: 'Konforlu VIP Transfer Hizmeti',
  },
  'phi-phi-mi-james-bond-mu-karsilastirma-rehberi': {
    tourId: 'phi-phi-maya-ve-bamboo-adasi',
    badge: 'Karşılaştırmanın Favorisi: Phi Phi Turu',
  },
};

const mapping = tourMapping[post.id];
const targetTourId = post.data.related_tour || mapping?.tourId || 'phi-phi-maya-ve-bamboo-adasi';
const relatedTour = allTours?.find((t) => t.id === targetTourId) || null;
const badgeText = mapping?.badge || 'Rehberde Bahsedilen Öne Çıkan Rota';

const site = Astro.site || 'https://phukettatili.com';
const postURL = new URL(`/blog/${post.id}/`, site).toString();
const publishedISO = post.data.date ? new Date(post.data.date).toISOString() : undefined;
const authorName = post.data.author || 'Phuket Tatili Ekibi';

const schemas: Record<string, unknown>[] = [
  {
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.excerpt || post.data.title,
    "url": postURL,
    "inLanguage": "tr",
    ...(post.data.cover_image ? { "image": new URL(`/assets/${post.data.cover_image}`, site).toString() } : {}),
    ...(publishedISO ? { "datePublished": publishedISO, "dateModified": publishedISO } : {}),
    "author": { "@type": "Organization", "name": authorName },
    "publisher": {
      "@type": "Organization",
      "name": "Phuket Tatili",
      "url": site.toString(),
    },
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": new URL('/', site).toString() },
      { "@type": "ListItem", "position": 2, "name": "Rehber", "item": new URL('/blog/', site).toString() },
      { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postURL },
    ],
  },
];
---

<Layout
  title={`${post.data.title} — Phuket Tatili Rehberi`}
  noTitleSuffix
  description={post.data.excerpt}
  image={post.data.cover_image ? `/assets/${post.data.cover_image}` : '/assets/blog-hero-phuket.webp'}
  ogType="article"
  publishedTime={publishedISO}
  schemas={schemas}
>
  <!-- Hero Section -->
  <section class="relative h-[50vh] min-h-[350px] flex items-end pb-12 overflow-hidden bg-brand-primary">
    <div class="absolute inset-0 z-0">
      <img
        src={post.data.cover_image ? `/assets/${post.data.cover_image}` : '/assets/blog-hero-phuket.webp'}
        alt={post.data.title}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover animate-ken-burns"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-1 via-surface-1/60 to-transparent z-10"></div>
    </div>

    <div class="relative z-20 max-w-4xl mx-auto px-4 w-full">
      <a href="/blog" class="inline-flex items-center text-brand-accent text-sm font-semibold mb-3 hover:underline">
        ← Tüm Rehber Yazıları
      </a>
      <h1 class="text-3xl md:text-5xl text-white font-serif font-bold mb-4 drop-shadow-md">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-slate-300 text-xs md:text-sm">
          <span class="flex items-center gap-1.5 font-medium text-white">
            <svg class="w-4 h-4 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            {authorName}
          </span>
          {post.data.date && (
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <time datetime={publishedISO}>
                {new Date(post.data.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </span>
          )}
        </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 bg-white dark:bg-surface-1 px-4">
    <div class="max-w-3xl mx-auto">
      <article class="prose prose-lg prose-slate dark:prose-invert prose-headings:font-serif prose-headings:text-brand-primary dark:prose-headings:text-white prose-a:text-brand-accent hover:prose-a:underline max-w-none">
        <Content />
      </article>

      {relatedTour && (
        <BlogRelatedTour tour={relatedTour} badgeText={badgeText} />
      )}

      <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center">
        <a href="/blog" class="text-brand-accent font-bold hover:underline">
          ← Rehbere Dön
        </a>
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, Phuket rehberinizdeki bilgiler hakkında bir sorum olacaktı.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25D366] text-white px-6 py-2.5 rounded-full text-sm font-bold hover:bg-[#128C7E] transition-all shadow-md"
        >
          WhatsApp'tan Sor
        </a>
      </div>
    </div>
  </section>
</Layout>
