---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FadeIn from '../../components/ui/FadeIn';

export const prerender = true;

const posts: CollectionEntry<'blog'>[] = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.date || 0).getTime();
  const dateB = new Date(b.data.date || 0).getTime();
  return dateB - dateA;
});

const site = Astro.site || 'https://phukettatili.com';
const schemas: Record<string, unknown>[] = [
  {
    "@type": "Blog",
    "name": "Phuket Rehberi",
    "url": new URL('/blog/', site).toString(),
    "inLanguage": "tr",
    "publisher": { "@type": "Organization", "name": "Phuket Tatili", "url": site.toString() },
    "blogPost": sortedPosts.map((post) => {
      const publishedISO = post.data.date ? new Date(post.data.date).toISOString() : undefined;
      return {
        "@type": "BlogPosting",
        "headline": post.data.title,
        "url": new URL(`/blog/${post.id}/`, site).toString(),
        ...(post.data.excerpt ? { "description": post.data.excerpt } : {}),
        ...(publishedISO ? { "datePublished": publishedISO } : {}),
        "author": { "@type": "Organization", "name": post.data.author || "Phuket Tatili Ekibi" },
      };
    }),
  },
];
---

<Layout title="Phuket Rehberi & Blog" description="Phuket hava durumu, gezilecek yerler ve ada rehberi." schemas={schemas}>
  <div class="bg-brand-primary text-white py-20 px-4 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/assets/blog-hero-phuket.jpg" alt="Phuket sahil manzarasi - rehber kapagi" class="w-full h-full object-cover animate-ken-burns" />
      <div class="absolute inset-0 bg-gradient-to-b from-surface-1/85 via-brand-primary/60 to-brand-primary z-10"></div>
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-20">
      <span class="inline-block bg-brand-accent text-white px-3.5 py-1 rounded-full text-xs font-bold tracking-wider uppercase mb-4 shadow-lg">
        Seyahat İpuçları & Rehber
      </span>
      <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4 text-white drop-shadow-lg">Phuket Rehberi</h1>
      <p class="text-slate-200 text-base md:text-lg max-w-xl mx-auto font-light">
        Tayland seyahatinizi kusursuz kılcak yerine: kusursuz güncel bilgiler, hava durumu tavsiyeleri ve rota onerileri.
      </p>
    </div>
  </div>

  <section class="py-20 bg-slate-50 dark:bg-surface-1 px-4 min-h-[500px]">
    <div class="max-w-6xl mx-auto">
      {sortedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post, index) => (
            <FadeIn client:visible delay={0.1 * index} direction="up">
              <a href={`/blog/${post.id}`} class="group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
                <div class="relative h-60 overflow-hidden">
                  <img
                    src={post.data.cover_image ? `/assets/${post.data.cover_image}` : '/assets/beach.webp'}
                    alt={post.data.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                </div>
                <div class="p-6">
                  <h2 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white line-clamp-2">
                    {post.data.title}
                  </h2>
                  <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-3">
                    {post.data.excerpt}
                  </p>
                  
                  <div class="border-t border-slate-100 dark:border-slate-700 pt-4 text-xs text-slate-500 dark:text-slate-400">
                    <div class="flex items-center justify-between mb-2">
                      <span class="font-medium text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        {post.data.author || 'Phuket Tatili Ekibi'}
                      </span>
                      {post.data.date && (
                        <time datetime={post.data.date instanceof Date ? post.data.date.toISOString() : String(post.data.date)} class="flex items-center gap-1 text-slate-500 dark:text-slate-400">
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                          {new Date(post.data.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
                        </time>
                      )}
                    </div>
                    <div class="text-right">
                      <span class="text-brand-accent font-semibold group-hover:underline">Devamını Oku →</span>
                    </div>
                  </div>
                </div>
              </a>
            </FadeIn>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 text-slate-500">Yeni rehber yazıları hazırlanıyor...</div>
      )}
    </div>
  </section>
</Layout>
