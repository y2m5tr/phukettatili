---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FadeIn from '../../components/ui/FadeIn';
import { resolveAssetUrl } from '../../lib/assets';
import { getCloudBlogPosts, applyBlogOverlay } from '../../lib/server/blogContent';

// Dinamik SSR: panelin Blog ekranında değişen başlık/özet/kapak/tarih anında
// yansır (bulut overlay). Build'deki .md verisi taban; üzerine content_store
// 'blogs' kaydı gelir. Bulut yoksa site statik veriyle çalışmaya devam eder.
// Not: gövde içeriği yalnızca .md dosyalarından gelir (panelde gövde alanı yok).
export const prerender = false;

// CDN cache: sayfa 60sn Vercel edge'de, 5 dk bayat kabul edilir.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const mdPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const posts: CollectionEntry<'blog'>[] = applyBlogOverlay(mdPosts, await getCloudBlogPosts());
const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.date || 0).getTime();
  const dateB = new Date(b.data.date || 0).getTime();
  return dateB - dateA;
});

// Kategori eşlemesi (yazı içeriğine ve ID'sine göre)
function getPostCategory(id: string): { label: string; slug: string } {
  if (id.includes('hava-durumu')) return { label: 'Hava Durumu', slug: 'hava-durumu' };
  if (id.includes('plajlar')) return { label: 'Plaj Rehberi', slug: 'plajlar' };
  if (id.includes('fil')) return { label: 'Doğa & Etik', slug: 'doga-etik' };
  if (id.includes('mutfagi') || id.includes('yemek')) return { label: 'Yeme - İçme', slug: 'yeme-icme' };
  if (id.includes('phi-phi') || id.includes('ada')) return { label: 'Ada Turları', slug: 'ada-turlari' };
  return { label: 'Genel Rehber', slug: 'genel' };
}

const categories = [
  { label: 'Tüm Yazılar', slug: 'all' },
  { label: 'Ada Turları', slug: 'ada-turlari' },
  { label: 'Plaj Rehberi', slug: 'plajlar' },
  { label: 'Hava Durumu', slug: 'hava-durumu' },
  { label: 'Yeme - İçme', slug: 'yeme-icme' },
  { label: 'Doğa & Etik', slug: 'doga-etik' },
];

const site = Astro.site || 'https://phukettatili.com';
const schemas: Record<string, unknown>[] = [
  {
    "@type": "Blog",
    "name": "Phuket Rehberi",
    "url": new URL('/blog/', site).toString(),
    "inLanguage": "tr",
    "publisher": { "@type": "Organization", "name": "Phuket Tatili", "url": site.toString() },
    "blogPost": sortedPosts.map((post) => {
      const publishedISO = post.data.date ? new Date(post.data.date).toISOString() : undefined;
      return {
        "@type": "BlogPosting",
        "headline": post.data.title,
        "url": new URL(`/blog/${post.id}/`, site).toString(),
        ...(post.data.excerpt ? { "description": post.data.excerpt } : {}),
        ...(publishedISO ? { "datePublished": publishedISO } : {}),
        "author": { "@type": "Organization", "name": post.data.author || "Phuket Tatili Ekibi" },
      };
    }),
  },
];
---

<Layout
  title="Phuket Gezi Rehberi — Pratik Bilgiler, Plajlar & Seyahat İpuçları"
  description="Phuket seyahatiniz için kapsamlı gezi rehberi: En güzel plajlar, aylara göre hava durumu, Tayland mutfağı, ada turları ve pratik tatil tavsiyeleri."
  schemas={schemas}
>
  <div class="bg-brand-primary text-white py-20 px-4 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/assets/blog-hero-phuket.webp" alt="Phuket sahil manzarasi - rehber kapagi" class="w-full h-full object-cover animate-ken-burns" />
      <div class="absolute inset-0 bg-gradient-to-b from-surface-1/85 via-brand-primary/60 to-brand-primary z-10"></div>
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-20">
      <span class="inline-block bg-brand-accent text-white px-3.5 py-1 rounded-full text-xs font-bold tracking-wider uppercase mb-4 shadow-lg">
        Seyahat İpuçları & Rehber
      </span>
      <h1 class="text-4xl md:text-6xl font-serif font-bold mb-4 text-white drop-shadow-lg">Phuket Rehberi</h1>
      <p class="text-slate-200 text-base md:text-lg max-w-xl mx-auto font-light">
        Tayland seyahatinizi kusursuz kılacak güncel bilgiler, hava durumu tavsiyeleri ve rota önerileri.
      </p>
    </div>
  </div>

  <section class="py-16 bg-slate-50 dark:bg-surface-1 px-4 min-h-[500px]">
    <div class="max-w-6xl mx-auto">
      <!-- Filter Bar & Search -->
      <div class="mb-12 flex flex-col md:flex-row items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div class="flex flex-wrap items-center gap-2" id="blog-category-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`blog-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer ${
                idx === 0
                  ? 'bg-brand-primary text-white shadow-sm'
                  : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700'
              }`}
              data-filter={cat.slug}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="blog-search-input"
            placeholder="Rehberde ara..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-accent/50"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
      </div>

      {sortedPosts.length > 0 ? (
        <div id="blog-posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post, index) => {
            const cat = getPostCategory(post.id);
            return (
              <div
                class="blog-card-item"
                data-category={cat.slug}
                data-title={post.data.title.toLowerCase()}
                data-excerpt={(post.data.excerpt || '').toLowerCase()}
              >
                <FadeIn client:visible delay={0.08 * (index % 3)} direction="up">
                  <a href={`/blog/${post.id}`} class="group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-md hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
                    <div class="relative h-60 overflow-hidden">
                      <img
                        src={resolveAssetUrl(post.data.cover_image, '/assets/beach.webp')}
                        alt={post.data.title}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                      />
                      <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                      <span class="absolute top-4 left-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur px-3 py-1 rounded-full text-xs font-bold text-brand-primary dark:text-brand-accent shadow-sm">
                        {cat.label}
                      </span>
                    </div>
                    <div class="p-6">
                      <h2 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white line-clamp-2">
                        {post.data.title}
                      </h2>
                      <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-3">
                        {post.data.excerpt}
                      </p>
                      
                      <div class="border-t border-slate-100 dark:border-slate-700 pt-4 text-xs text-slate-500 dark:text-slate-400">
                        <div class="flex items-center justify-between mb-2">
                          <span class="font-medium text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            {post.data.author || 'Phuket Tatili Ekibi'}
                          </span>
                          {post.data.date && (
                            <time datetime={post.data.date instanceof Date ? post.data.date.toISOString() : String(post.data.date)} class="flex items-center gap-1 text-slate-500 dark:text-slate-400">
                              <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                              {new Date(post.data.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}
                            </time>
                          )}
                        </div>
                        <div class="text-right">
                          <span class="text-brand-accent font-semibold group-hover:underline">Devamını Oku →</span>
                        </div>
                      </div>
                    </div>
                  </a>
                </FadeIn>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 text-slate-500">Yeni rehber yazıları hazırlanıyor...</div>
      )}

      <!-- No Results Message -->
      <div id="blog-no-results" class="hidden text-center py-16 text-slate-500 dark:text-slate-400">
        <p class="text-base font-semibold">Aradığınız kriterlere uygun rehber yazısı bulunamadı.</p>
        <button type="button" id="blog-reset-filter-btn" class="mt-3 text-xs font-bold text-brand-accent hover:underline">
          Tüm yazıları göster
        </button>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.blog-filter-btn');
      const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
      const cards = document.querySelectorAll<HTMLElement>('.blog-card-item');
      const noResults = document.getElementById('blog-no-results');
      const resetBtn = document.getElementById('blog-reset-filter-btn');

      if (!cards.length) return;

      let currentCategory = 'all';
      let currentQuery = '';

      const applyFilters = () => {
        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCat = card.dataset.category || '';
          const cardTitle = card.dataset.title || '';
          const cardExcerpt = card.dataset.excerpt || '';

          const matchCat = currentCategory === 'all' || cardCat === currentCategory;
          const matchQuery = !currentQuery || cardTitle.includes(currentQuery) || cardExcerpt.includes(currentQuery);

          if (matchCat && matchQuery) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      };

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.dataset.filter || 'all';
          filterBtns.forEach((b) => {
            if (b === btn) {
              b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border');
              b.classList.add('bg-brand-primary', 'text-white', 'shadow-sm');
            } else {
              b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border');
              b.classList.remove('bg-brand-primary', 'text-white', 'shadow-sm');
            }
          });
          applyFilters();
        });
      });

      searchInput?.addEventListener('input', () => {
        currentQuery = searchInput.value.trim().toLowerCase();
        applyFilters();
      });

      resetBtn?.addEventListener('click', () => {
        currentCategory = 'all';
        currentQuery = '';
        if (searchInput) searchInput.value = '';
        filterBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border');
            b.classList.add('bg-brand-primary', 'text-white', 'shadow-sm');
          } else {
            b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border');
            b.classList.remove('bg-brand-primary', 'text-white', 'shadow-sm');
          }
        });
        applyFilters();
      });
    });
  </script>
</Layout>
