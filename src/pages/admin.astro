---
import { getCollection, type CollectionEntry } from 'astro:content';
import AdminDashboard from '../components/admin/AdminDashboard';
import '../styles/global.css';

export const prerender = true;

// Fetch all tours from Astro Content collection
const tours: CollectionEntry<'tours'>[] = await getCollection('tours');
const initialTours = tours
  .sort((a, b) => a.data.order - b.data.order)
  .map((tour) => ({
    id: tour.id,
    title: tour.data.title,
    category: tour.data.category_label || tour.data.category,
    priceThb: tour.data.price_thb || 0,
    duration: tour.data.duration || 'Tam Gün',
    featured: Boolean(tour.data.featured),
    image: tour.data.image || 'phuket_hero.webp',
  }));
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetim & Operasyon Paneli | Phuket Tatili</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-brand-accent selection:text-white">
    <AdminDashboard client:only="react" initialTours={initialTours} />
  </body>
</html>
