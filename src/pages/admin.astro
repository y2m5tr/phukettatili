---
import { getCollection, type CollectionEntry } from 'astro:content';
import AdminDashboard from '../components/admin/AdminDashboard';
import faqData from '../content/settings/faq.json';
import testimonialsData from '../content/settings/testimonials.json';
import siteData from '../content/settings/site.json';
import homeData from '../content/pages/home.json';
import { SESSION_COOKIE, readMembershipSession, readSessionValue } from '../lib/auth';
import '../styles/global.css';

// Sunucu tarafında render edilir: /admin adresine gelen istek önce
// src/middleware.ts içindeki oturum kontrolünden geçer. Prerender edilirse
// middleware atlanır ve tüm CRM verisi statik HTML olarak herkese açık olur.
export const prerender = false;

// Oturum rolü — UsersTab yalnızca owner'a gösterilir. Middleware zaten
// manager-altını bu sayfaya almaz; buradaki kontrol UI seviyesinde ek
// ayrım (manager paneli görür, kullanıcı yönetimini görmez).
const cookieVal = Astro.cookies.get(SESSION_COOKIE)?.value;
const membershipSession = readMembershipSession(cookieVal);
const oldSession = readSessionValue(cookieVal);
const viewerRole = membershipSession?.role || (oldSession === 'admin' ? 'owner' : oldSession === 'field' ? 'guide' : null);

// 1. Tours — gallery ve tüm operasyonel ayrıntılar dahil
const tours: CollectionEntry<'tours'>[] = await getCollection('tours');
const initialTours = tours
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((tour) => ({
    id: tour.id,
    title: tour.data.title,
    category: tour.data.category,
    categoryLabel: tour.data.category_label || tour.data.category,
    priceThb: tour.data.price_thb || 0,
    duration: tour.data.duration || 'Tam Gün',
    featured: Boolean(tour.data.featured),
    active: true,
    image: tour.data.image || 'phuket_hero.webp',
    excerpt: tour.data.excerpt || '',
    gallery: tour.data.gallery || [],
    programImages: tour.data.program_images || [],
    included: tour.data.included || [],
    excluded: tour.data.excluded || [],
    program: tour.data.program || [],
    faq: tour.data.faq || [],
    restrictions: tour.data.restrictions || [],
    body: tour.body || '',
  }));

// 2. Blog Articles
const blogs: CollectionEntry<'blog'>[] = await getCollection('blog');
const initialBlogs = blogs.map((b) => ({
  id: b.id,
  title: b.data.title,
  excerpt: b.data.excerpt || '',
  cover_image: b.data.cover_image || 'pileh.webp',
  date: b.data.date ? b.data.date.toISOString().split('T')[0] : '',
  author: b.data.author || 'Phuket Tatili Ekibi',
  featured: Boolean(b.data.featured),
}));

// 3. Services (Transfer, Otel, Paket, VIP)
const services: CollectionEntry<'services'>[] = await getCollection('services');
const initialServices = services
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((s) => ({
    slug: s.data.slug,
    title: s.data.title,
    eyebrow: s.data.eyebrow || '',
    heading: s.data.heading || '',
    intro: s.data.intro || '',
    media: s.data.media || 'longtail.webp',
  }));

// 4. FAQ
const initialFaqs = (faqData?.faq || []).map((f: any, idx: number) => ({
  id: `faq-${idx + 1}`,
  question: f.question,
  answer: f.answer,
}));

// 5. Testimonials
const initialTestimonials = (testimonialsData?.testimonials || []).map((t: any, idx: number) => ({
  id: `testi-${idx + 1}`,
  name: t.name,
  type: t.type,
  tour: t.tour,
  stars: t.stars || 5,
  text: t.text,
}));

// 6. Site Settings & Home
const initialSiteSettings = {
  whatsappNumber: siteData?.whatsappNumber || '66828950665',
  email: siteData?.email || 'info@phukettatili.com',
  siteTitle: siteData?.siteTitle || 'Phuket Tatili',
  logoUrl: (siteData as any)?.logoUrl || '/assets/logo-main-transparent.png',
  logoText: (siteData as any)?.logoText || 'Phuket Tatili',
  instagramUrl: siteData?.instagramUrl || 'https://instagram.com/phukettatili',
  googleReviewUrl: (siteData as any)?.googleReviewUrl || 'https://g.page/r/phukettatili/review',
  heroTitle: homeData?.heroTitle || "Phuket'in Büyüsünü Keşfedin",
  heroSubtitle: homeData?.heroSubtitle || "Size özel tasarlanmış turlar, gizli kalmış cennet koylar ve unutulmaz anılar için en doğru yerdesiniz.",
  heroImage: homeData?.heroImage || 'phuket_hero.webp',
};

// 7. Görsel envanteri — paneldeki 'Turdan Fotoğraflar' (galeri) seçimi için mevcut kapak görselleri
const availableImages: string[] = [
  'phuket_hero.webp',
  'phuket_yacht.webp',
  'pileh.webp',
  'beach.webp',
  'beachclub.webp',
  'couple.webp',
  'family.webp',
  'longtail.webp',
  'railay.webp',
  'bay.webp',
  'elephant.webp',
  'underwater.webp',
  'culture.webp',
  'food.webp',
  'phuket_transfer.webp',
  'yacht.webp',
  'phuket_culture.webp',
];
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetim & Operasyon Paneli | Phuket Tatili</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a192f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Phuket Operasyon" />
    <!-- Fontlar self-hosted (fontsource) -->
    <style is:inline>
      @import "@fontsource/plus-jakarta-sans/400.css";
      @import "@fontsource/plus-jakarta-sans/500.css";
      @import "@fontsource/plus-jakarta-sans/600.css";
      @import "@fontsource/plus-jakarta-sans/700.css";
      @import "@fontsource/plus-jakarta-sans/800.css";
      @import "@fontsource/playfair-display/600.css";
      @import "@fontsource/playfair-display/700.css";
      @import "@fontsource/playfair-display/600-italic.css";
    </style>
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-serif {
        font-family: 'Playfair Display', Georgia, serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-brand-accent selection:text-white">
    <AdminDashboard
      client:only="react"
      initialTours={initialTours}
      initialBlogs={initialBlogs}
      initialServices={initialServices}
      initialFaqs={initialFaqs}
      initialTestimonials={initialTestimonials}
      initialSiteSettings={initialSiteSettings}
      initialHomeSettings={homeData}
      availableImages={availableImages}
      viewerRole={viewerRole}
    />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('[SW] Registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>
