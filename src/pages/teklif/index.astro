---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import siteSettings from '../../content/settings/site.json';
---

<Layout
  title="Kişiye Özel Tatil Teklifiniz | Phuket Tatili"
  description="Phuket Tatili seyahat danışmanınız tarafından size özel hazırlanan tur ve transfer teklifinizi görüntüleyin."
>
  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 pt-24 pb-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">

      <div class="my-12 p-8 sm:p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-lg space-y-6">
        
        <div class="w-16 h-16 mx-auto rounded-full bg-brand-primary/10 text-brand-primary flex items-center justify-center">
          <svg aria-hidden="true" class="w-8 h-8 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>

        <div class="space-y-2">
          <h1 class="text-2xl sm:text-4xl font-serif font-black text-slate-900 dark:text-white">
            Özel Tatil Teklifinizi İnceleyin
          </h1>
          <p class="text-xs font-semibold text-brand-primary dark:text-brand-accent">
            Phuket Tatili Dijital Teklif Portalı
          </p>
          <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto pt-1">
            Seyahat danışmanınızın WhatsApp veya e-posta üzerinden ilettiği teklif numarasını girerek tüm tur programını, otel transferlerini ve fiyat detaylarını görüntüleyin.
          </p>
        </div>

        <!-- Teklif Arama Formu -->
        <form id="proposal-search-form" class="max-w-md mx-auto space-y-3 pt-2">
          <div class="relative">
            <input
              type="text"
              id="proposal-code-input"
              placeholder="Örn: PT-2026-001"
              autocomplete="off"
              required
              class="w-full px-5 py-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white font-mono text-center text-lg uppercase tracking-wider font-bold focus:border-brand-primary focus:outline-hidden transition-colors"
            />
          </div>
          <button
            type="submit"
            class="w-full py-4 rounded-2xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-sm shadow-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
          >
            Teklifi Görüntüle
          </button>
        </form>

        <div class="pt-6 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 space-y-3">
          <p>
            Henüz bir teklif almadınız mı? Seyahat danışmanımızla iletişime geçerek 15 dakika içinde size özel tatil planı ve fiyat teklifi oluşturabilirsiniz.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent('Merhaba, Phuket tatilim için kişiye özel tur ve tatil teklifi almak istiyorum.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full bg-whatsapp hover:bg-whatsapp-dark text-white font-bold text-xs inline-flex items-center gap-2 shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
            >
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span>WhatsApp ile Teklif İste</span>
            </a>
            <a
              href="/turlar"
              class="px-5 py-2.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-xs hover:bg-slate-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
            >
              Tüm Turları Keşfet
            </a>
          </div>
        </div>

        <!-- Güvenlik & Lisans Rozeti -->
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-center gap-2">
          <svg aria-hidden="true" class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          <span>Tayland Turizm Bakanlığı TAT Lisans No: <strong>34/02894</strong> &bull; 1.000.000 THB Kaza Sigortası</span>
        </div>

      </div>

    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('proposal-search-form');
  const input = document.getElementById('proposal-code-input') as HTMLInputElement | null;

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = input.value.trim().toUpperCase();
      if (code) {
        window.location.href = `/teklif/${encodeURIComponent(code)}`;
      }
    });
  }
</script>
