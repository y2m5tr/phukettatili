---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getSupabaseAdmin, isSupabaseAdminConfigured } from '../../lib/server/supabaseAdmin';
import { checkRateLimit } from '../../lib/server/rateLimit';
import { resolveAssetUrl } from '../../lib/assets';
import { fmtMoney } from '../../lib/moneyFormat';
import {
  type CuratedProposalData,
  calculateProposalFinancials,
  MEAL_PLAN_META,
  TRANSPORT_META,
} from '../../lib/curatedProposal';
import type { SavedProposalItem } from '../../components/admin/proposal/proposalStorageUtils';
import siteSettings from '../../content/settings/site.json';

const codeParam = (Astro.params.code || '').trim();
const cleanCode = codeParam.toUpperCase();

// Rate limiting — IP başına dakikada 20 teklif sorgusu
const clientIp =
  Astro.clientAddress ||
  (Astro.request.headers.get('x-forwarded-for') || '').split(',')[0].trim() ||
  'unknown';

const limiter = await checkRateLimit('teklif', clientIp, 20, 60);
if (!limiter.allowed) {
  Astro.response.status = 429;
  Astro.response.headers.set('Retry-After', String(limiter.retryAfterSeconds));
}

let proposal: CuratedProposalData | null = null;

// 1. URL Query Param Fallback (Hızlı paylaşım / Çevrimdışı senkron)
const payloadQuery = Astro.url.searchParams.get('p') || Astro.url.searchParams.get('data');
if (payloadQuery) {
  try {
    const jsonStr = Buffer.from(payloadQuery, 'base64').toString('utf8');
    proposal = JSON.parse(jsonStr) as CuratedProposalData;
  } catch {}
}

// 2. Supabase Bulut Veritabanından Teklif Arama
if (!proposal && limiter.allowed && isSupabaseAdminConfigured() && cleanCode) {
  try {
    const db = getSupabaseAdmin();
    if (db) {
      const { data, error } = await db
        .from('cms_collections')
        .select('data')
        .eq('key', 'proposals')
        .single();

      if (!error && data?.data && Array.isArray(data.data)) {
        const proposalsList = data.data as SavedProposalItem[];
        const found = proposalsList.find(
          (p) =>
            (p.id && p.id.toUpperCase() === cleanCode) ||
            (p.data?.proposalNumber && p.data.proposalNumber.toUpperCase() === cleanCode)
        );
        if (found?.data) {
          proposal = found.data;
        }
      }
    }
  } catch {}
}

const financials = proposal
  ? calculateProposalFinancials(proposal, { tryRate: 0.95, usdRate: 36, eurRate: 39 })
  : null;

const agentPhone = proposal?.agentInfo?.phone?.replace(/\D/g, '') || siteSettings.whatsappNumber || '66828950665';
const confirmMsg = encodeURIComponent(
  `Merhaba ${proposal?.agentInfo?.name || 'Phuket Tatili'}, ${proposal?.proposalNumber || cleanCode} numaralı "${proposal?.packageTitle || 'Tatil'}" teklifinizi inceledim. Rezervasyonumu onaylamak ve başlatmak istiyorum!`
);
const confirmWhatsAppUrl = `https://wa.me/${agentPhone}?text=${confirmMsg}`;

const pageTitle = proposal
  ? `Özel Tatil Teklifi (${proposal.proposalNumber}) — ${proposal.customerName} | Phuket Tatili`
  : `Tatil Teklifi Bulunamadı | Phuket Tatili`;
---

<Layout title={pageTitle} description="Phuket Tatili kişiye özel tur ve tatil planlama teklifi.">
  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 pt-24 pb-32">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      {!proposal && (
        <div class="my-16 p-8 sm:p-12 text-center rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg space-y-4">
          <div class="w-16 h-16 mx-auto rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center">
            <svg aria-hidden="true" class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h1 class="proposal-title text-2xl sm:text-3xl font-serif font-bold text-slate-900 dark:text-white">
            Teklif Kaydı Bulunamadı
          </h1>
          <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto">
            <strong>&quot;{cleanCode}&quot;</strong> numaralı teklif sistemde bulunamadı veya süresi dolmuş olabilir. Lütfen danışmanınızla iletişime geçiniz.
          </p>
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent('Merhaba, teklif linkime ulaşamadım, yardımcı olabilir misiniz?')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-full bg-whatsapp text-white font-bold text-sm shadow-md hover:bg-whatsapp-dark transition-colors inline-flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
            >
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span>WhatsApp Destek Hattı</span>
            </a>
            <a
              href="/turlar"
              class="px-6 py-3 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-sm hover:bg-slate-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
            >
              Tüm Turları İncele
            </a>
          </div>
        </div>
      )}

      {proposal && (
        <div class="space-y-6">

          <div class="p-6 sm:p-8 rounded-3xl bg-slate-900 text-white shadow-xl relative overflow-hidden">
            <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6 mb-6">
              <div class="space-y-1">
                <h1 class="proposal-title text-2xl sm:text-4xl font-serif font-black tracking-tight">
                  {proposal.packageTitle}
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 font-light">
                  {proposal.packageSubtitle}
                </p>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-white/10 border border-white/15 text-amber-300 mt-2">
                  <span>Kişiye özel hazırlanan tatil programı</span>
                </div>
              </div>

              <div class="shrink-0 text-left sm:text-right bg-white/10 p-4 rounded-2xl border border-white/15">
                <div class="text-xs font-medium text-slate-300">Teklif No</div>
                <div class="text-base sm:text-lg font-black font-mono text-brand-gold">{proposal.proposalNumber}</div>
                <div class="text-[11px] text-slate-400 mt-1">Geçerlilik: {proposal.validUntilDate}</div>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
              <div class="space-y-0.5">
                <span class="text-slate-400">Sayın Misafirimiz</span>
                <div class="font-bold text-sm text-white">{proposal.customerName}</div>
              </div>
              <div class="space-y-0.5">
                <span class="text-slate-400">Kişi Sayısı</span>
                <div class="font-bold text-sm text-white">
                  {proposal.adultCount} Yetişkin {proposal.childCount > 0 ? `+ ${proposal.childCount} Çocuk` : ''}
                </div>
              </div>
              <div class="space-y-0.5">
                <span class="text-slate-400">Konaklama / Bölge</span>
                <div class="font-bold text-sm text-white truncate">{proposal.hotelName}</div>
              </div>
              <div class="space-y-0.5">
                <span class="text-slate-400">Seyahat Danışmanı</span>
                <div class="font-bold text-sm text-amber-300 truncate">{proposal.agentInfo?.name}</div>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs shadow-xs">
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              <span class="font-semibold text-slate-700 dark:text-slate-200">
                Tayland Turizm Bakanlığı TAT Lisans No: <strong>34/02894</strong> &bull; 1.000.000 THB Kaza Sigortası
              </span>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-extrabold text-[11px]">
              %100 Türkçe Yerinde Operasyon
            </span>
          </div>

          <div class="space-y-4">
            <h2 class="proposal-section-title text-xl sm:text-2xl font-serif font-bold text-slate-900 dark:text-white flex items-center justify-between">
              <span>Tur & Transfer Programınız</span>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary">
                {proposal.days.length} Günlük Rota
              </span>
            </h2>

            <div class="space-y-4">
              {proposal.days.map((day, idx) => {
                const transMeta = TRANSPORT_META[day.transportType];
                const mealMeta = MEAL_PLAN_META[day.mealPlan];
                return (
                  <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex flex-col md:flex-row gap-5 items-start">
                      <div class="flex-1 space-y-3">
                        <div class="flex flex-wrap items-center gap-2 text-xs">
                          <span class="px-2.5 py-1 rounded-full font-bold bg-brand-primary text-white">
                            Gün {idx + 1}
                          </span>
                          {day.date && (
                            <span class="inline-flex items-center gap-1 text-slate-500 font-medium">
                              <svg aria-hidden="true" class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                              <span>{day.date}</span>
                            </span>
                          )}
                          {day.pickupWindow && (
                            <span class="inline-flex items-center gap-1 text-brand-accent font-semibold">
                              <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                              <span>{day.pickupWindow}</span>
                            </span>
                          )}
                          <span class="px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-medium">
                            {transMeta.icon} {transMeta.label}
                          </span>
                        </div>

                        <div>
                          <h3 class="text-lg sm:text-xl font-serif font-bold text-slate-900 dark:text-white">
                            {day.tourTitle}
                          </h3>
                          {day.highlight && (
                            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">
                              {day.highlight}
                            </p>
                          )}
                        </div>

                        <div class="flex flex-wrap items-center gap-2 pt-2 text-xs text-slate-500">
                          {day.mealPlan !== 'none' && (
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
                              <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                              <span>{mealMeta.label}</span>
                            </span>
                          )}
                          {day.nationalParkFeeStatus === 'included' && (
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 font-medium">
                              ✓ Milli Park Girişi Dahil
                            </span>
                          )}
                        </div>
                      </div>

                      {day.image && (
                        <div class="w-full md:w-48 h-36 rounded-2xl overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-800">
                          <img
                            src={resolveAssetUrl(day.image)}
                            alt={day.tourTitle}
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 shadow-xs">
              <h3 class="font-serif font-bold text-base sm:text-lg text-slate-900 dark:text-white flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Teklifinize Dahil Olanlar
              </h3>
              <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-2 leading-relaxed">
                {proposal.inclusions.map((inc) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 shrink-0 font-bold">✓</span>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="p-5 sm:p-6 rounded-3xl bg-amber-500/10 dark:bg-amber-500/15 border border-amber-500/30 space-y-3 shadow-xs">
              <h3 class="font-serif font-bold text-base sm:text-lg text-amber-800 dark:text-amber-200 flex items-center gap-2">
                <svg aria-hidden="true" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>
                <span>Size Özel Ayrıcalıklar & İkramlar</span>
              </h3>
              <ul class="text-xs text-amber-900 dark:text-amber-300 space-y-2 leading-relaxed">
                {proposal.specialGifts && proposal.specialGifts.length > 0 ? (
                  proposal.specialGifts.map((gift) => (
                    <li class="flex items-start gap-2">
                      <span class="shrink-0">★</span>
                      <span>{gift}</span>
                    </li>
                  ))
                ) : (
                  <li>• 7/24 Türkçe WhatsApp Operasyon Kalkanı</li>
                )}
                <li>• Tayland Fırtına & Kötü Hava %100 Kesintisiz İade Güvencesi</li>
              </ul>
            </div>
          </div>

          {financials && (
            <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-lg space-y-5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-5">
                <div>
                  <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white">
                    Fiyat & Ödeme Planı
                  </h3>
                  <p class="text-xs text-slate-500">
                    Sürpriz ve gizli masraf yok. Tüm milli park girişleri ve transferler dahildir.
                  </p>
                </div>
                <div class="text-left sm:text-right">
                  <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 block">
                    Toplam Paket Tutarı
                  </span>
                  <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
                    {fmtMoney(financials.totalThb)} <span class="text-sm font-bold text-slate-500">THB</span>
                  </div>
                  <div class="text-xs text-slate-500 font-medium">
                    (Yaklaşık {fmtMoney(financials.totalTry)} TL / {financials.totalUsd} USD)
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs bg-slate-50 dark:bg-slate-800/60 p-4 rounded-2xl">
                <div>
                  <span class="text-slate-500 block">Ön Ödeme / Rezervasyon Kaparası (%{proposal.depositPercent || 30}):</span>
                  <span class="font-bold text-sm text-slate-800 dark:text-white">
                    {fmtMoney(financials.depositThb)} THB (~{fmtMoney(Math.round(financials.depositThb * 0.95))} TL)
                  </span>
                  <p class="text-[11px] text-slate-400 mt-0.5">Türkiye IBAN (TL), Kredi Kartı veya Wise ile kolayca ödenebilir.</p>
                </div>
                <div>
                  <span class="text-slate-500 block">Kalan Bakiye:</span>
                  <span class="font-bold text-sm text-slate-800 dark:text-white">
                    {fmtMoney(financials.remainingThb)} THB
                  </span>
                  <p class="text-[11px] text-slate-400 mt-0.5">Phuket&apos;e ulaştığınızda tur günü nakit Baht olarak ödenir.</p>
                </div>
              </div>

              {proposal.customNotes && (
                <p class="text-xs text-slate-500 italic bg-amber-500/5 p-3 rounded-xl border border-amber-500/20 flex items-start gap-1.5">
                  <svg aria-hidden="true" class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span>{proposal.customNotes}</span>
                </p>
              )}
            </div>
          )}

        </div>
      )}

    </div>

    {proposal && (
      <div class="fixed bottom-0 left-0 right-0 z-50 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 p-3 sm:p-4 shadow-xl">
        <div class="max-w-4xl mx-auto flex items-center justify-between gap-3">
          <div class="hidden sm:block">
            <span class="text-[11px] text-slate-500 block">Kişiye Özel Fiyat Teklifi</span>
            <span class="font-black text-lg text-slate-900 dark:text-white">
              {financials ? `${fmtMoney(financials.totalThb)} THB` : ''}
            </span>
          </div>

          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button
              type="button"
              onclick="window.print()"
              class="px-4 py-3 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-200 transition-colors inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
              title="Yazdır veya PDF Kaydet"
            >
              <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
              <span>PDF</span>
            </button>

            <a
              href={confirmWhatsAppUrl}
              target="_blank"
              rel="noopener noreferrer"
