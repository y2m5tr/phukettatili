---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { buildWhatsAppUrl, formatPrice, WHATSAPP_NUMBER } from '@/utils/whatsapp';
import CurrencyConverter from '@/components/CurrencyConverter.astro';
import TourCard from '@/components/TourCard.astro';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour: any) => {
    const similarTours = tours
      .filter((t: any) => t.data.category === tour.data.category && t.id !== tour.id)
      .slice(0, 3);
      
    return {
      params: { slug: tour.id.replace(/\.md$/, '') },
      props: { tour, similarTours },
    };
  });
}

interface Props {
  tour: CollectionEntry<'tours'>;
  similarTours: CollectionEntry<'tours'>[];
}

const { tour, similarTours } = Astro.props;
const { data } = tour;
const { Content } = await render(tour);
const slug = tour.id.replace(/\.md$/, '');

const formattedPrice = formatPrice(data.price_type, data.price_thb);
const waUrl = buildWhatsAppUrl(
  data.title,
  `Seçilen Tur: ${data.title}\nSüre: ${data.duration}\nKişi Sayısı:\nTercih Edilen Tarih:`
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTour',
  name: data.title,
  description: data.excerpt,
  image: `https://phukettatili.netlify.app/assets/${data.image}`,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'THB',
    price: data.price_thb ? String(data.price_thb) : undefined,
    availability: 'https://schema.org/InStock',
    url: `https://phukettatili.netlify.app/turlar/${slug}/`,
  },
  touristType: ['Family', 'Couple', 'AdventureSeeker'],
  provider: {
    '@type': 'Organization',
    name: 'Phuket Tatili',
    url: 'https://phukettatili.netlify.app',
    sameAs: ['https://wa.me/66828950665'],
  },
};
---

<Layout
  title={data.title}
  description={data.excerpt}
  image={`/assets/${data.image}`}
  breadcrumbTitle={data.title}
  categoryLabel={data.category_label}
  categorySlug={data.category}
  schema={schema}
>
  <!-- TOUR HERO (GALERİ VEYA TEK RESİM) -->
  <section class="tour-hero">
    <div class="tour-gallery-slider" id="tour-gallery-slider">
      {data.gallery && data.gallery.length > 0 ? (
        data.gallery.map((imgName: string, index: number) => (
          <div class={`tour-gallery-slide ${index === 0 ? 'active' : ''}`}>
            <img src={`/assets/${imgName}`} alt={`${data.title} - Görsel ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} data-lightbox="tour-gallery" />
          </div>
        ))
      ) : (
        <div class="tour-gallery-slide active">
          <img src={`/assets/${data.image}`} alt={data.title} loading="eager" data-lightbox="tour-gallery" />
        </div>
      )}
      
      {data.gallery && data.gallery.length > 1 && (
        <>
          <button class="slider-btn slider-btn--prev" id="prev-tour-slide" aria-label="Önceki Görsel">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="slider-btn slider-btn--next" id="next-tour-slide" aria-label="Sonraki Görsel">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="slider-dots" id="tour-slider-dots">
            {data.gallery.map((_: any, index: number) => (
              <button class={`slider-dot ${index === 0 ? 'active' : ''}`} aria-label={`Görsel ${index + 1}`}></button>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="tour-hero-overlay"></div>

    <div class="wb-container tour-hero__inner">
      <a href="/turlar/" class="tour-hero-back">← Tüm Turlara Dön</a>
      <div class="tour-hero__kicker">{data.category_label}</div>
      <h1 class="h1-display">{data.title}</h1>
      <p class="tour-hero-excerpt">{data.excerpt}</p>

      <dl class="tour-meta tour-hero-meta">
        <div>
          <dt>Süre</dt>
          <dd>{data.duration}</dd>
        </div>
        <div>
          <dt>Fiyat</dt>
          <dd>{formattedPrice}</dd>
        </div>
        <div>
          <dt>Kategori</dt>
          <dd>{data.category_label}</dd>
        </div>
        {data.age_min && (
          <div>
            <dt>Yaş Sınırı</dt>
            <dd>{data.age_min}</dd>
          </div>
        )}
        {data.max_weight && (
          <div>
            <dt>Maksimum Kilo</dt>
            <dd>{data.max_weight} kg</dd>
          </div>
        )}
      </dl>

      <div class="tour-actions">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener"
          class="wb-button wb-button--primary"
        >
          <img
            src="/assets/whatsapp-mark.svg"
            alt=""
            width="18"
            height="18"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
          WhatsApp'ta Müsaitlik Sor
        </a>
      </div>
    </div>
  </section>

  <!-- TOUR DETAIL CONTENT -->
  <section class="tour-layout">
    <article class="tour-content">
      {data.source_status === 'owner_approved' && (
        <div class="tour-disclosure">
          <strong>Güvence Notu</strong>
          <p>
            Bu tur Phuket Tatili yerel işletme onayıyla listelenmiştir. Saatler, dahil/hariç hizmetler, transfer bölgesi ve güncel ücretler rezervasyon öncesinde WhatsApp üzerinden yazılı olarak teyit edilir.
          </p>
        </div>
      )}

      <div class="tour-body">
        <Content />
      </div>

      {data.included.length > 0 && (
        <>
          <h2>Dahil Olan Hizmetler</h2>
          <ul>
            {data.included.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}

      {data.excluded.length > 0 && (
        <>
          <h2>Dahil Olmayanlar</h2>
          <ul>
            {data.excluded.map((item: string) => (
              <li class="excluded-item">{item}</li>
            ))}
          </ul>
        </>
      )}

      {data.program.length > 0 && (
        <>
          <h2>Program Akışı</h2>
          <ol>
            {data.program.map((step: string) => (
              <li>{step}</li>
            ))}
          </ol>
        </>
      )}

      {data.restrictions.length > 0 && (
        <>
          <h2>Önemli Kısıtlamalar ve Sağlık Kuralları</h2>
          <ul>
            {data.restrictions.map((r: string) => (
              <li>{r}</li>
            ))}
          </ul>
        </>
      )}

      {data.faq.length > 0 && (
        <>
          <h2>Sık Sorulan Sorular</h2>
          <div class="tour-faq">
            {data.faq.map((item: any) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </>
      )}

      <h2>Güvenli Rezervasyon Süreci</h2>
      <div class="booking-process">
        <div class="booking-step">
          <strong>01. Türkçe Yerel Destek</strong>
          <p>Phuket'te yerel ekibimiz sorularınızı anında yanıtlar.</p>
        </div>
        <div class="booking-step">
          <strong>02. Yazılı Teyit</strong>
          <p>Tüm detaylar, dahil olanlar ve fiyat ödeme öncesinde yazılı gelir.</p>
        </div>
        <div class="booking-step">
          <strong>03. Tedarikçi Denetimi</strong>
          <p>Lisanslı ve sigortalı resmi Tayland tur operatörleriyle çalışılır.</p>
        </div>
        <div class="booking-step">
          <strong>04. Hava Şartı Esnekliği</strong>
          <p>Liman kapanışlarında tarih değişimi veya iade yapılır.</p>
        </div>
      </div>
    </article>

    <!-- STICKY BOOKING CARD -->
    <aside class="tour-booking" id="booking-widget" data-tour-title={tour.data.title} data-base-wa={WHATSAPP_NUMBER}>
      <h3>Rezervasyon Talebi</h3>
      <div class="tour-booking__price">
        <strong>{formattedPrice}</strong>
        <small>Güncel fiyat ve müsaitlik yazılı doğrulanır</small>
      </div>

      <div class="booking-inputs">
        <div class="input-group">
          <label for="tour-date">Tarih Seçin</label>
          <input type="date" id="tour-date" min={new Date().toISOString().split('T')[0]} />
        </div>
        <div class="input-group">
          <label for="tour-pax">Kişi Sayısı</label>
          <select id="tour-pax">
            <option value="1 Yetişkin">1 Yetişkin</option>
            <option value="2 Yetişkin" selected>2 Yetişkin</option>
            <option value="3 Yetişkin">3 Yetişkin</option>
            <option value="4 Yetişkin">4 Yetişkin</option>
            <option value="5+ Kişi">5+ Kişi</option>
            <option value="Çocuklu Aile">Çocuklu Aile</option>
          </select>
        </div>
      </div>

      <div class="tour-booking__process">
        <p>1. WhatsApp'tan tarih ve kişi sayınızı iletin.</p>
        <p>2. Güncel müsaitliği ve net tutarı onaylayalım.</p>
        <p>3. Kapora sonrası rezervasyon fişiniz düzenlensin.</p>
      </div>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener"
        class="wb-button wb-button--primary tour-booking__cta"
        id="wa-cta-button"
      >
        <img
          src="/assets/whatsapp-mark.svg"
          alt=""
          width="18"
          height="18"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        WhatsApp'ta Sor ↗
      </a>
      <small class="tour-booking__note">
        Mesaj göndermek herhangi bir ödeme veya kesin yükümlülük doğurmaz.
      </small>
    </aside>
    
    <!-- CURRENCY CONVERTER -->
    <div style="position: sticky; top: 550px;">
      <CurrencyConverter />
    </div>

  </section>

  <!-- SIMILAR TOURS -->
  {similarTours && similarTours.length > 0 && (
    <section class="similar-tours-section">
      <div class="section-header" style="margin-bottom: var(--space-xl); text-align: center;">
        <span class="section-kicker">İlginizi Çekebilir</span>
        <h2 class="section-title">Benzer Turlar</h2>
      </div>
      <div class="similar-tours-grid">
        {similarTours.map((st: any) => (
          <TourCard tour={st} />
        ))}
      </div>
    </section>
  )}
</Layout>

<script>
  // Dinamik WhatsApp Linki Oluşturma
  document.addEventListener('astro:page-load', () => {
    const widget = document.getElementById('booking-widget');
    if (!widget) return;

    const dateInput = document.getElementById('tour-date') as HTMLInputElement;
    const paxInput = document.getElementById('tour-pax') as HTMLSelectElement;
    const waButton = document.getElementById('wa-cta-button') as HTMLAnchorElement;

    const tourTitle = widget.getAttribute('data-tour-title') || 'Tur';
    const waNumber = widget.getAttribute('data-base-wa') || '66828950665';

    function updateWaLink() {
      const dateVal = dateInput.value ? new Date(dateInput.value).toLocaleDateString('tr-TR') : 'Belirtilmedi';
      const paxVal = paxInput.value;

      const message = `Merhaba, ${tourTitle} hakkında bilgi almak istiyorum.\n\n📅 Tarih: ${dateVal}\n👥 Kişi: ${paxVal}`;
      waButton.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
    }

    if (dateInput) dateInput.addEventListener('change', updateWaLink);
    if (paxInput) paxInput.addEventListener('change', updateWaLink);
    
    // GALERİ SLIDER MANTIĞI
    const slider = document.getElementById('tour-gallery-slider');
    if (slider) {
      const slides = slider.querySelectorAll('.tour-gallery-slide');
      const dots = document.querySelectorAll('#tour-slider-dots .slider-dot');
      const prevBtn = document.getElementById('prev-tour-slide');
      const nextBtn = document.getElementById('next-tour-slide');
      
      if (slides.length > 1) {
        let currentSlide = 0;
        
        const showSlide = (index: number) => {
          slides.forEach(s => s.classList.remove('active'));
          dots.forEach(d => d.classList.remove('active'));
          
          let newIndex = index;
          if (newIndex < 0) newIndex = slides.length - 1;
          if (newIndex >= slides.length) newIndex = 0;
          
          slides[newIndex].classList.add('active');
          if (dots[newIndex]) dots[newIndex].classList.add('active');
          currentSlide = newIndex;
        };
        
        const nextSlide = () => showSlide(currentSlide + 1);
        const prevSlide = () => showSlide(currentSlide - 1);
        
        prevBtn?.addEventListener('click', prevSlide);
        nextBtn?.addEventListener('click', nextSlide);
        
        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => showSlide(i));
        });
        
        // Touch Swipe
        let startX = 0;
        slider.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, {passive: true});
        slider.addEventListener('touchend', (e) => {
          const endX = e.changedTouches[0].clientX;
          const diff = startX - endX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) nextSlide();
            else prevSlide();
          }
        });
        
        // Auto slide
        let autoSlide = setInterval(nextSlide, 5000);
        slider.addEventListener('mouseenter', () => clearInterval(autoSlide));
        slider.addEventListener('mouseleave', () => autoSlide = setInterval(nextSlide, 5000));
      }
    }
  });
</script>

<style>
/* Tour Detail Styles */
.tour-hero {
  position: relative;
  min-height: 60vh;
  display: flex;
  align-items: center;
  color: var(--wb-warm-white);
  overflow: hidden;
}

.tour-gallery-slider {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.tour-gallery-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.tour-gallery-slide.active {
  opacity: 1;
  pointer-events: auto;
}

.tour-gallery-slide img {
  width: 100%;
