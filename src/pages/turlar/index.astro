---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TourShowcase from '../../components/ui/TourShowcase';
import { resolveAssetUrl, responsiveSrcset } from '../../lib/assets';
import { getCloudTours, applyTourOverlay } from '../../lib/server/tourContent';
import { fmtMoney } from '../../lib/moneyFormat';

// Dinamik SSR: panelde değişen fiyat/başlık/kapak listede de görünsün. Eskiden
// bu sayfa prerender=true iken tur DETAY sayfası content_store okuyordu;
// panelde fiyat değişince detayda yeni, listede eski fiyat görünüyordu.
export const prerender = false;

// CDN cache: sayfa 60sn Vercel edge'de, 5 dk bayat kabul edilir.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const mdTours: CollectionEntry<'tours'>[] = await getCollection('tours');
const tours: CollectionEntry<'tours'>[] = applyTourOverlay(mdTours, await getCloudTours());
const categoriesCollection = await getCollection('categories');
const sortedTours = [...tours].sort((a, b) => a.data.order - b.data.order);
const sliderTours = [...tours]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order)
  .slice(0, 5);

// Category map to Turkish labels
const categoryMap = new Map<string, string>();
categoriesCollection.forEach(cat => {
  categoryMap.set(cat.data.slug, cat.data.label_tr);
});

// Unique categories present in tours
const uniqueCategorySlugs = [...new Set(tours.map(tour => tour.data.category))];
const categories = uniqueCategorySlugs.map(slug => ({
  slug,
  label: categoryMap.get(slug) || slug.replace(/-/g, ' ')
}));

const site = Astro.site || 'https://phukettatili.com';

// Filtre türetme: Türkçe rehber sinyali dahil edilen hizmetlerde geçiyorsa
// true kabul edilir. Yapılandırılmış alan eklendiğinde burası tek noktadan
// değiştirilebilir.
const hasTurkishGuide = (tour: CollectionEntry<'tours'>) => {
  const haystack = [tour.data.included, tour.data.excerpt, tour.data.category_label]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return haystack.includes('türkçe') || haystack.includes('turkce');
};

const priceBand = (price: number | null | undefined): 'quote' | 'budget' | 'mid' | 'premium' => {
  if (!price || price <= 0) return 'quote';
  if (price < 2000) return 'budget';
  if (price < 5000) return 'mid';
  return 'premium';
};
const schemas: Record<string, unknown>[] = [
  {
    "@type": "CollectionPage",
    "name": "Phuket Turları — Türkçe Rehberli Ada & Doğa Gezileri",
    "description": "Phuket'in en popüler ada turları, Phi Phi, James Bond, Similan sürat teknesi gezileri, fil bakım deneyimi ve şehir turları.",
    "url": new URL('/turlar/', site).toString(),
  },
  {
    "@type": "ItemList",
    "name": "Phuket Turları",
    "numberOfItems": sortedTours.length,
    "itemListElement": sortedTours.map((tour, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL(`/turlar/${tour.id}/`, site).toString(),
      "name": tour.data.title,
    })),
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": new URL('/', site).toString() },
      { "@type": "ListItem", "position": 2, "name": "Turlar", "item": new URL('/turlar/', site).toString() },
    ],
  },
];
---

<Layout
  title="Phuket Turları — Türkçe Rehberli Ada & Doğa Gezileri"
  description="Phuket'in en popüler ada turları, Phi Phi, James Bond, Similan sürat teknesi gezileri, fil bakım deneyimi ve şehir turları. En uygun fiyat ve yerel Türkçe rehberlik."
  schemas={schemas}
>
  <div class="bg-brand-primary text-white py-16 px-4 relative overflow-hidden">
    <div class="max-w-6xl mx-auto text-center relative z-10">
        <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Tüm Turlar</h1>
        <p class="text-slate-300 max-w-xl mx-auto text-base mb-10">
          Günübirlik ada turlarından özel VIP rotalara kadar Phuket'i bizimle keşfedin.
        </p>
      
      <!-- Slider -->
      <TourShowcase tours={sliderTours} client:load />
    </div>
  </div>

  <section class="py-16 bg-slate-50 dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Canlı Anlık Tur Arama Çubuğu (Instant Search) -->
      <div class="max-w-md mx-auto mb-8 relative">
        <div class="relative">
          <input
            type="text"
            id="tour-search-input"
            placeholder="Tur adı, ada veya aktivite ara (örn: Phi Phi, Fil, Kano, VIP)..."
            class="w-full pl-11 pr-10 py-3.5 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-800 dark:text-slate-100 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-accent/50 focus:border-brand-accent transition-all placeholder:text-slate-400"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          <button
            type="button"
            id="tour-search-clear"
            class="hidden absolute right-3.5 top-3.5 w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-400 hover:text-slate-600 dark:hover:text-white flex items-center justify-center text-xs font-bold cursor-pointer"
            aria-label="Aramayı Temizle"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Filter Categories (SEO-friendly crawlable links with JS instant filtering) -->
      <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-12">
        <a 
          href="/turlar/" 
          data-filter="all" 
          class="filter-btn px-5 py-2.5 rounded-full bg-brand-gold text-slate-950 font-bold shadow-md transition-all duration-300 hover:scale-105"
        >
          Tümü
        </a>
        {categories.map(cat => (
          <a 
            href={`/turlar/?kategori=${cat.slug}`} 
            data-filter={cat.slug} 
            class="filter-btn px-6 py-2.5 rounded-full bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium shadow hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-slate-700 hover:scale-105"
          >
            {cat.label}
          </a>
        ))}
      </div>

      <!-- Ek Filtreler: Fiyat Bandı / Süre / Türkçe Rehber -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400">Fiyat</span>
          <select
            id="tour-price-filter"
            class="px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-gold/40"
          >
            <option value="all">Tümü</option>
            <option value="budget">Bütçe Dostu</option>
            <option value="mid">Orta Seviye</option>
            <option value="premium">Premium & VIP</option>
            <option value="quote">Teklif ile</option>
          </select>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400">Süre</span>
          <select
            id="tour-duration-filter"
            class="px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-gold/40"
          >
            <option value="all">Tümü</option>
            <option value="tam gün">Tam Gün</option>
            <option value="yarım gün">Yarım Gün</option>
            <option value="akşam">Akşam</option>
          </select>
        </div>
        <label class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 cursor-pointer">
          <input type="checkbox" id="turkish-guide-filter" class="accent-brand-gold" />
          <span>Türkçe Rehberli</span>
        </label>
      </div>

      <!-- Tours Grid -->
      <div id="tours-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedTours.map((tour) => (
          <div
            class="tour-card"
            data-category={tour.data.category}
            data-price={tour.data.price_thb || 0}
            data-price-band={priceBand(tour.data.price_thb)}
            data-turkish-guide={hasTurkishGuide(tour)}
            data-duration={(tour.data.duration || '').toLowerCase()}
          >
              <a href={`/turlar/${tour.id}`} class="premium-card group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
                <div class="relative h-64 overflow-hidden">
                  <img
                    src={resolveAssetUrl(tour.data.image)}
                    srcset={responsiveSrcset(tour.data.image)}
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    alt={tour.data.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                  <!-- Wishlist Heart Button -->
                  <button
                    type="button"
                    class="ptt-wishlist-btn absolute top-4 left-4 z-20 w-9 h-9 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur text-slate-400 hover:text-rose-500 flex items-center justify-center shadow-md border border-white/40 dark:border-slate-700/60 cursor-pointer"
                    data-tour-id={tour.id}
                    onclick={`event.preventDefault(); event.stopPropagation(); window.togglePttShortlist && window.togglePttShortlist({ id: '${tour.id}', title: ${JSON.stringify(tour.data.title)}, image: '${tour.data.image || ''}', duration: '${tour.data.duration || 'Tam Gün'}', category: '${tour.data.category_label || tour.data.category || ''}' });`}
                    title="Tatil Planıma Ekle"
                    aria-label={`${tour.data.title} turunu tatil planıma ekle`}
                  >
                    <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </button>
                  <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-brand-primary text-xs font-bold px-3 py-1 rounded-full">
                    {tour.data.category_label || categoryMap.get(tour.data.category) || tour.data.category}
                  </div>
                </div>
                <div class="p-6">
                  <h2 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white">{tour.data.title}</h2>
                  <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-2">{tour.data.excerpt}</p>
                  <div class="flex justify-between items-center border-t border-slate-100 dark:border-slate-700 pt-4 mt-4">
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{tour.data.duration || 'Tam Gün'}</span>
                    {tour.data.price_thb && tour.data.price_thb > 0 ? (
                      <span class="text-xl font-bold text-brand-primary dark:text-white tracking-tight">{fmtMoney(tour.data.price_thb)} <span class="text-xs font-semibold text-amber-500">THB</span></span>
                    ) : (
                      <span class="text-xs font-bold text-slate-900 dark:text-amber-300 bg-amber-400/15 px-2.5 py-1 rounded-full">Özel Fiyat Teklifi</span>
                    )}
                  </div>
                </div>
              </a>
                </div>
        ))}
      </div>
      
      <!-- Empty State (Hidden by default) -->
      <div id="no-tours-message" class="hidden text-center py-20 bg-white dark:bg-slate-800 rounded-3xl p-12 shadow-sm border border-slate-100 dark:border-slate-700">
        <h3 class="text-2xl font-bold text-slate-400 dark:text-slate-300 mb-2">Tur Bulunamadı</h3>
        <p class="text-slate-500 dark:text-slate-400">Bu kategoriye ait turumuz bulunmamaktadır.</p>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Script that runs on client side to handle SEO query-string filtering (?kategori=slug)
  document.addEventListener('astro:page-load', () => {
    const filterBtns = document.querySelectorAll<HTMLAnchorElement>('.filter-btn');
    const tourCards = document.querySelectorAll<HTMLElement>('.tour-card');
    const noToursMessage = document.getElementById('no-tours-message');
    const searchInput = document.getElementById('tour-search-input') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('tour-search-clear') as HTMLButtonElement | null;

    if (!tourCards.length) return;

    let activeCategory = 'all';
    let activeSearchText = '';
    let activePriceBand = 'all';
    let activeDuration = 'all';
    let requireTurkishGuide = false;

    function renderFilteredCards() {
      let visibleCount = 0;
      const q = activeSearchText.trim().toLowerCase();

      tourCards.forEach(card => {
        const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
        const cardText = (card.textContent || '').toLowerCase();
        const cardPriceBand = card.getAttribute('data-price-band') || 'all';
        const cardDuration = (card.getAttribute('data-duration') || '').toLowerCase();
        const cardTurkishGuide = card.getAttribute('data-turkish-guide') === 'true';

        const matchCat = activeCategory === 'all' || activeCategory === '' || cardCategory === activeCategory;
        const matchSearch = q === '' || cardText.includes(q);
        const matchPrice = activePriceBand === 'all' || cardPriceBand === activePriceBand;
        const matchDuration = activeDuration === 'all' || cardDuration.includes(activeDuration);
        const matchGuide = !requireTurkishGuide || cardTurkishGuide;

        if (matchCat && matchSearch && matchPrice && matchDuration && matchGuide) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noToursMessage) {
        noToursMessage.classList.toggle('hidden', visibleCount > 0);
      }
    }

    function applyCategory(catValue: string, updateUrl = true) {
      activeCategory = catValue.trim().toLowerCase();

      filterBtns.forEach(btn => {
        const btnFilter = (btn.getAttribute('data-filter') || '').toLowerCase();
        const isActive = btnFilter === activeCategory || (activeCategory === '' && btnFilter === 'all');
        
        if (isActive) {
          btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
          btn.classList.add('bg-brand-gold', 'text-slate-950', 'shadow-md');
        } else {
          btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
          btn.classList.remove('bg-brand-gold', 'text-slate-950', 'shadow-md');
        }
      });

      renderFilteredCards();

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (activeCategory === 'all' || activeCategory === '') {
          url.searchParams.delete('kategori');
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('kategori', activeCategory);
          url.searchParams.delete('category');
        }
        url.hash = '';
        window.history.pushState({ kategori: activeCategory }, '', url.toString());
      }
    }

    // Attach click events to category buttons
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e: MouseEvent) => {
        e.preventDefault();
        const filterVal = btn.getAttribute('data-filter') || 'all';
        applyCategory(filterVal, true);
      });
    });

    // Attach search input events
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        activeSearchText = searchInput.value;
        if (searchClearBtn) {
          searchClearBtn.classList.toggle('hidden', activeSearchText.length === 0);
        }
        renderFilteredCards();
      });
    }

    if (searchClearBtn && searchInput) {
      searchClearBtn.addEventListener('click', () => {
        searchInput.value = '';
        activeSearchText = '';
        searchClearBtn.classList.add('hidden');
        searchInput.focus();
        renderFilteredCards();
      });
    }

    // Attach additional filter events
    const priceFilter = document.getElementById('tour-price-filter') as HTMLSelectElement | null;
    if (priceFilter) {
      priceFilter.addEventListener('change', () => {
        activePriceBand = priceFilter.value;
        renderFilteredCards();
      });
    }

    const durationFilter = document.getElementById('tour-duration-filter') as HTMLSelectElement | null;
    if (durationFilter) {
      durationFilter.addEventListener('change', () => {
        activeDuration = durationFilter.value;
        renderFilteredCards();
      });
    }

    const guideFilter = document.getElementById('turkish-guide-filter') as HTMLInputElement | null;
    if (guideFilter) {
      guideFilter.addEventListener('change', () => {
        requireTurkishGuide = guideFilter.checked;
        renderFilteredCards();
      });
    }

    // Handle browser Back / Forward buttons
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      const queryCat = params.get('kategori') || params.get('category') || window.location.hash.replace('#', '') || 'all';
      applyCategory(queryCat, false);
    });

    // Read initial category on page load
    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('kategori') || params.get('category') || window.location.hash.replace('#', '');
    if (initialCategory) {
      applyCategory(initialCategory, false);
    }
  });
</script>
