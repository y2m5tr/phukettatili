---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FadeIn from '../../components/ui/FadeIn';
import TourShowcase from '../../components/ui/TourShowcase';
import { resolveAssetUrl } from '../../lib/assets';
import { getCloudTours, applyTourOverlay } from '../../lib/server/tourContent';

// Dinamik SSR: panelde değişen fiyat/başlık/kapak listede de görünsün. Eskiden
// bu sayfa prerender=true iken tur DETAY sayfası content_store okuyordu;
// panelde fiyat değişince detayda yeni, listede eski fiyat görünüyordu.
export const prerender = false;

// CDN cache: sayfa 60sn Vercel edge'de, 5 dk bayat kabul edilir.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const mdTours: CollectionEntry<'tours'>[] = await getCollection('tours');
const tours: CollectionEntry<'tours'>[] = applyTourOverlay(mdTours, await getCloudTours());
const categoriesCollection = await getCollection('categories');
const sortedTours = [...tours].sort((a, b) => a.data.order - b.data.order);
const sliderTours = [...tours]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order)
  .slice(0, 5);

// Category map to Turkish labels
const categoryMap = new Map<string, string>();
categoriesCollection.forEach(cat => {
  categoryMap.set(cat.data.slug, cat.data.label_tr);
});

// Unique categories present in tours
const uniqueCategorySlugs = [...new Set(tours.map(tour => tour.data.category))];
const categories = uniqueCategorySlugs.map(slug => ({
  slug,
  label: categoryMap.get(slug) || slug.replace(/-/g, ' ')
}));

const site = Astro.site || 'https://phukettatili.com';
const schemas: Record<string, unknown>[] = [
  {
    "@type": "ItemList",
    "name": "Phuket Turları",
    "numberOfItems": sortedTours.length,
    "itemListElement": sortedTours.map((tour, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL(`/turlar/${tour.id}/`, site).toString(),
      "name": tour.data.title,
    })),
  },
];
---

<Layout
  title="Phuket Turları — Türkçe Rehberli Ada & Doğa Gezileri"
  description="Phuket'in en popüler ada turları, Phi Phi, James Bond, Similan sürat teknesi gezileri, fil bakım deneyimi ve şehir turları. En uygun fiyat ve yerel Türkçe rehberlik."
  schemas={schemas}
>
  <div class="bg-brand-primary text-white py-16 px-4 relative overflow-hidden">
    <div class="max-w-6xl mx-auto text-center relative z-10">
      <FadeIn client:load direction="up">
        <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Tüm Turlar</h1>
      </FadeIn>
      <FadeIn client:load delay={0.2} direction="up">
        <p class="text-slate-300 max-w-xl mx-auto text-base mb-10">
          Günübirlik ada turlarından özel VIP rotalara kadar Phuket'i bizimle keşfedin.
        </p>
      </FadeIn>
      
      <!-- Slider -->
      <TourShowcase tours={sliderTours} client:load />
    </div>
  </div>

  <section class="py-16 bg-slate-50 dark:bg-surface-1 px-4">
    <div class="max-w-6xl mx-auto">
      
      <!-- Filter Categories (SEO-friendly crawlable links with JS instant filtering) -->
      <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-12">
        <a 
          href="/turlar/" 
          data-filter="all" 
          class="filter-btn px-6 py-2.5 rounded-full bg-brand-accent text-white font-medium shadow-md transition-all duration-300 hover:scale-105"
        >
          Tümü
        </a>
        {categories.map(cat => (
          <a 
            href={`/turlar/?kategori=${cat.slug}`} 
            data-filter={cat.slug} 
            class="filter-btn px-6 py-2.5 rounded-full bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium shadow hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-slate-700 hover:scale-105"
          >
            {cat.label}
          </a>
        ))}
      </div>

      <!-- Tours Grid -->
      <div id="tours-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedTours.map((tour, index) => (
          <div class="tour-card" data-category={tour.data.category}>
            <FadeIn client:visible delay={0.1 * (index % 3)} direction="up">
              <a href={`/turlar/${tour.id}`} class="premium-card group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl transition-all duration-300 border border-slate-100 dark:border-slate-700">
                <div class="relative h-64 overflow-hidden">
                  <img 
                    src={resolveAssetUrl(tour.data.image)}
                    alt={tour.data.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-brand-primary/20 group-hover:bg-transparent transition-colors duration-500"></div>
                  <!-- Wishlist Heart Button -->
                  <button
                    type="button"
                    class="ptt-wishlist-btn absolute top-4 left-4 z-20 w-9 h-9 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur text-slate-400 hover:text-rose-500 flex items-center justify-center shadow-md border border-white/40 dark:border-slate-700/60 cursor-pointer"
                    data-tour-id={tour.id}
                    onclick={`event.preventDefault(); event.stopPropagation(); window.togglePttShortlist && window.togglePttShortlist({ id: '${tour.id}', title: ${JSON.stringify(tour.data.title)}, image: '${tour.data.image || ''}', duration: '${tour.data.duration || 'Tam Gün'}', category: '${tour.data.category_label || tour.data.category || ''}' });`}
                    title="Tatil Planıma Ekle"
                    aria-label={`${tour.data.title} turunu tatil planıma ekle`}
                  >
                    <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                  </button>
                  <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-brand-primary text-xs font-bold px-3 py-1 rounded-full">
                    {tour.data.category_label || categoryMap.get(tour.data.category) || tour.data.category}
                  </div>
                </div>
                <div class="p-6">
                  <h2 class="text-xl font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white">{tour.data.title}</h2>
                  <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 line-clamp-2">{tour.data.excerpt}</p>
                  <div class="flex justify-between items-center border-t border-slate-100 dark:border-slate-700 pt-4 mt-4">
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{tour.data.duration || 'Tam Gün'}</span>
                    {tour.data.price_thb && tour.data.price_thb > 0 ? (
                      <span class="text-lg font-bold text-brand-primary dark:text-white">{tour.data.price_thb.toLocaleString()} THB</span>
                    ) : (
                      <span class="text-xs font-bold text-brand-accent bg-brand-accent/10 px-2.5 py-1 rounded-full">Fiyat Teklifi Alın</span>
                    )}
                  </div>
                </div>
              </a>
            </FadeIn>
          </div>
        ))}
      </div>
      
      <!-- Empty State (Hidden by default) -->
      <div id="no-tours-message" class="hidden text-center py-20 bg-white dark:bg-slate-800 rounded-3xl p-12 shadow-sm border border-slate-100 dark:border-slate-700">
        <h3 class="text-2xl font-bold text-slate-400 dark:text-slate-300 mb-2">Tur Bulunamadı</h3>
        <p class="text-slate-500 dark:text-slate-400">Bu kategoriye ait turumuz bulunmamaktadır.</p>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Script that runs on client side to handle SEO query-string filtering (?kategori=slug)
  document.addEventListener('astro:page-load', () => {
    const filterBtns = document.querySelectorAll<HTMLAnchorElement>('.filter-btn');
    const tourCards = document.querySelectorAll<HTMLElement>('.tour-card');
    const noToursMessage = document.getElementById('no-tours-message');

    if (!filterBtns.length || !tourCards.length) return;

    function applyFilter(filterValue: string, updateUrl = true) {
      // Normalize
      const targetCategory = filterValue.trim().toLowerCase();

      // Update buttons active visual state
      filterBtns.forEach(btn => {
        const btnFilter = (btn.getAttribute('data-filter') || '').toLowerCase();
        const isActive = btnFilter === targetCategory || (targetCategory === '' && btnFilter === 'all');
        
        if (isActive) {
          btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
          btn.classList.add('bg-brand-accent', 'text-white', 'shadow-md');
        } else {
          btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
          btn.classList.remove('bg-brand-accent', 'text-white', 'shadow-md');
        }
      });

      // Filter cards
      let visibleCount = 0;
      tourCards.forEach(card => {
        const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();
        if (targetCategory === 'all' || targetCategory === '' || cardCategory === targetCategory) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Show/hide empty state
      if (noToursMessage) {
        noToursMessage.classList.toggle('hidden', visibleCount > 0);
      }

      // Update URL with query string for clean indexing and shareability
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (targetCategory === 'all' || targetCategory === '') {
          url.searchParams.delete('kategori');
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('kategori', targetCategory);
          url.searchParams.delete('category');
        }
        url.hash = '';
        window.history.pushState({ kategori: targetCategory }, '', url.toString());
      }
    }

    // Attach click events
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e: MouseEvent) => {
        e.preventDefault();
        const filterVal = btn.getAttribute('data-filter') || 'all';
        applyFilter(filterVal, true);
      });
    });

    // Handle browser Back / Forward buttons
    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      const queryCat = params.get('kategori') || params.get('category') || window.location.hash.replace('#', '') || 'all';
      applyFilter(queryCat, false);
    });

    // Read initial category on page load
    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('kategori') || params.get('category') || window.location.hash.replace('#', '');
    if (initialCategory) {
      applyFilter(initialCategory, false);
    }
  });
</script>
