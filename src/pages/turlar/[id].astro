---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Accordion from '../../components/ui/Accordion';
import siteSettings from '../../content/settings/site.json';
import TourQuickBookingDrawer from '../../components/tour/TourQuickBookingDrawer';
import TourSmartBundle from '../../components/tour/TourSmartBundle';
import { getCloudTours, applyTourOverlay, applyTourOverlayToEntry } from '../../lib/server/tourContent';
import { resolveAssetUrl, resolveOgImageUrl } from '../../lib/assets';
// 500 satır kuralı: hero, program, galeri, rezervasyon sidebar'ı, benzer
// turlar, lightbox ve mobil sabit bar ./components/tour/detail/'e taşındı;
// JSON-LD şemaları ve varsayılan SSS'ler tourDetailSchemas.ts'e alındı.
import TourHero from '../../components/tour/detail/TourHero.astro';
import TourProgramTimeline from '../../components/tour/detail/TourProgramTimeline.astro';
import TourGallery from '../../components/tour/detail/TourGallery.astro';
import TourBookingSidebar from '../../components/tour/detail/TourBookingSidebar.astro';
import TourRelatedTours from '../../components/tour/detail/TourRelatedTours.astro';
import TourGalleryLightbox from '../../components/tour/detail/TourGalleryLightbox.astro';
import TourMobileStickyBar from '../../components/tour/detail/TourMobileStickyBar.astro';
import {
  buildTourDetailSchemas,
  defaultTourFaqs,
  getWeeklyViewCount,
} from '../../components/tour/detail/tourDetailSchemas';

// Dinamik SSR: panelde degisen kapak/galeri aninda yansir (bulut overlay).
// Build'deki .md verisi taban; uzerine content_store bulut kaydi gelir.
// Bulut yoksa site statik veriyle calismaya devam eder.
export const prerender = false;

// CDN cache: sayfa 60sn Vercel edge'de, 5 dk bayat kabul edilir.
// Panel degisikligi aninda degil en gec ~1 dk icinde yansir — ama
// her goruntulemede SSR + Supabase fetch maliyeti ortadan kalkar.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// Tur kaydini id'den bul (dinamik route — props yok)
const { id } = Astro.params;
const allToursForRelated: CollectionEntry<'tours'>[] = await getCollection('tours');
const tour = allToursForRelated.find((t) => t.id === id);

if (!tour) {
  return Astro.redirect('/turlar', 302);
}

// Bulut overlay: panelde düzenlenen alanlar (başlık, kapak, galeri, fiyat,
// program, dahil/hariç, SSS) anında yansır. Liste sayfalarıyla (turlar/index,
// tur-kategorisi, anasayfa) AYNI modülü kullanır — detay/liste tutarlılığı
// yapısal olarak garanti.
const cloudTours = await getCloudTours();

// Bu entry YERİNDE güncellenir: render(tour) gövdeyi entry'nin iç
// (body/loader) alanlarından üretir, yeni obje bu alanları düşürür.
applyTourOverlayToEntry(tour, cloudTours);

const { Content } = await render(tour);
const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const googleRating = siteSettings?.googleRating || '4.9';
const googleReviewCount = Number(siteSettings?.googleReviewCount) || 148;

// Benzer turlar: aynı kategoriden, mevcut tur hariç, sıralamaya göre ilk 3.
// Bu kartlar da taze fiyat/başlıkla görünsün diye overlay'i saf fonksiyonla
// uygula (yeni objeler üretir; `tour` zaten render için yerinde güncellendi).
const relatedTours = applyTourOverlay(allToursForRelated, cloudTours)
  .filter((t) => t.id !== tour.id && t.data.category === tour.data.category)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const site = Astro.site || 'https://phukettatili.com';
const tourURL = new URL(`/turlar/${tour.id}/`, site).toString();

// Sosyal Kanıt: haftalık gerçekçi inceleme sayısı
const weeklyViewCount = getWeeklyViewCount(tour.id);

// Zengin Sıkça Sorulan Sorular (Google FAQPage Rich Snippet Destekli)
const tourFaqs = tour.data.faq && tour.data.faq.length > 0 ? tour.data.faq : defaultTourFaqs;

// JSON-LD şemaları (TouristTrip, Product, BreadcrumbList, FAQPage) — SEO kritik,
// tur bazında aggregateRating basılmaz (bkz. tourDetailSchemas.ts notu).
const schemas = buildTourDetailSchemas(tour, site, tourFaqs);

// Initial WhatsApp message template
const initialMessage = `Merhaba, ${tour.data.title} turu için 2 Kişilik uygunluk durumu ve fiyat teklifi almak istiyorum.`;
const initialWhatsAppUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(initialMessage)}`;
---

<Layout
  title={tour.data.title}
  description={tour.data.excerpt}
  image={tour.data.image ? resolveOgImageUrl(tour.data.image, site) : undefined}
  preloadImage={resolveAssetUrl(tour.data.image)}
  schemas={schemas}
>
  <TourHero tour={tour} weeklyViewCount={weeklyViewCount} />

  <!-- Content Section -->
  <section class="py-16 pb-32 bg-slate-50 dark:bg-surface-1">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2 prose prose-lg prose-slate dark:prose-invert prose-headings:font-serif prose-headings:text-brand-primary dark:prose-headings:text-white prose-a:text-brand-accent hover:prose-a:text-brand-primary max-w-none">
        <h2 class="text-3xl border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">Tur Hakkında</h2>
        <Content />

        <TourProgramTimeline tour={tour} />
        <TourGallery tour={tour} />

        <!-- Akıllı Paket Önerisi (Cross-Sell Bundle) -->
        <TourSmartBundle
          client:load
          currentTourTitle={tour.data.title}
          currentTourPrice={tour.data.price_thb || 0}
          whatsappNumber={whatsappNumber}
        />

        <!-- Sıkça Sorulan Sorular (Google FAQPage Rich Snippet Destekli) -->
        {tourFaqs && tourFaqs.length > 0 && (
          <div class="mt-16">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">
              <h3 class="text-2xl sm:text-3xl font-serif font-bold text-brand-primary dark:text-white">
                Sıkça Sorulan Sorular
              </h3>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-brand-accent/10 text-brand-accent">
                {tourFaqs.length} Soru & Cevap
              </span>
            </div>
            <Accordion client:load faqs={tourFaqs} />
          </div>
        )}
      </div>

      <TourBookingSidebar
        tour={tour}
        whatsappNumber={whatsappNumber}
        googleRating={googleRating}
        googleReviewCount={googleReviewCount}
        initialWhatsAppUrl={initialWhatsAppUrl}
      />

      <!-- Mobil Sabit Rezervasyon Barı & Hızlı Teklif Çekmecesi -->
      <TourQuickBookingDrawer
        client:load
        tourTitle={tour.data.title}
        tourId={tour.id}
        priceThb={tour.data.price_thb || 0}
        whatsappNumber={whatsappNumber}
      />
    </div>
  </section>

  <TourRelatedTours tour={tour} relatedTours={relatedTours} />

  <TourGalleryLightbox />
  <TourMobileStickyBar tour={tour} whatsappNumber={whatsappNumber} />
</Layout>

<script>
  import '../../components/tour/detail/tourDetailClient';
</script>
