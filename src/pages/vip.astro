---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/ui/FadeIn';
import Accordion from '../components/ui/Accordion';
import siteSettings from '../content/settings/site.json';

export const prerender = true;

const site = Astro.site || 'https://phukettatili.com';
const vipUrl = new URL('/vip/', site).toString();

const vipFaqs = [
  {
    q: "Phuket VIP transfer sürecinde havalimanı karşılaması nasıl yapılır?",
    a: "Uçağınız Phuket Uluslararası Havalimanı'na indiğinde, profesyonel şoförümüz çıkış kapısında isminizin yazılı olduğu tabela ile sizi karşılar, bagajlarınıza yardımcı olur ve doğrudan tahsis edilen VIP araca yönlendirir."
  },
  {
    q: "Özel yat kiralama fiyatına neler dahildir?",
    a: "Özel yat ve katamaran kiralama hizmetlerimizde lisanslı kaptan, mürettebat, yakıt, şnorkel ekipmanları, meyve ikramları, alkolsüz içecekler ve seçili bölgelerden iskeleye çift yönlü VIP transfer dahildir."
  },
  {
    q: "Özel rota ve ada duraklarını kendimiz belirleyebilir miyiz?",
    a: "Evet. Deniz ve rüzgar güvenliği standartlarına uygun olmak koşuluyla kalkış saatinizi, yüzme molası vereceğiniz koyları (Phi Phi, Phang Nga, Coral, Racha) ve teknedeki programı tamamen grubunuza özel planlıyoruz."
  }
];

const schemas: Record<string, unknown>[] = [
  {
    "@type": "Service",
    "name": "Phuket VIP Hizmetler — Özel Yat Kiralama & Lüks Transfer",
    "description": "Phuket'te özel şoförlü VIP havalimanı transferi, lüks özel yat ve katamaran kiralama hizmetleri.",
    "provider": {
      "@type": "TravelAgency",
      "name": "Phuket Tatili",
      "url": site.toString(),
      "telephone": "+66 82 895 0665"
    },
    "areaServed": {
      "@type": "Place",
      "name": "Phuket, Tayland"
    },
    "url": vipUrl,
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "VIP Hizmetler",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Phuket VIP Havalimanı Karşılama ve Transfer"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Özel Lüks Yat ve Katamaran Kiralama"
          }
        }
      ]
    }
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": new URL('/', site).toString() },
      { "@type": "ListItem", "position": 2, "name": "VIP Hizmetler", "item": vipUrl }
    ]
  },
  {
    "@type": "FAQPage",
    "mainEntity": vipFaqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<Layout
  title="Phuket VIP Hizmetler — Özel Yat Kiralama & Lüks Transfer"
  description="Phuket'te kişiye özel lüks katamaran ve yat kiralama, özel şoförlü VIP transfer ve size özel ada rotaları. Kusursuz ve ayrıcalıklı tatil deneyimi."
  schemas={schemas}
>
  <div class="bg-brand-primary text-white py-24 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-40 z-0">
      <img src="/assets/phuket_yacht.webp" alt="Phuket VIP Yacht" class="w-full h-full object-cover animate-ken-burns" />
    </div>
    <div class="relative max-w-4xl mx-auto text-center z-10">
      <FadeIn direction="up">
        <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6">VIP <span class="text-brand-gold italic">Ayrıcalığı</span></h1>
      </FadeIn>
      <FadeIn delay={0.2} direction="up">
        <p class="text-slate-300 text-lg md:text-xl font-light">
          Size ve sevdiklerinize özel, sıradanlıktan uzak, kusursuz detaylarla örülmüş seyahat deneyimleri.
        </p>
      </FadeIn>
    </div>
  </div>

  <section class="py-24 bg-white px-4">
    <div class="max-w-6xl mx-auto">
      
      <!-- Service 1 -->
      <div class="flex flex-col md:flex-row gap-12 items-center mb-24">
        <div class="md:w-1/2 w-full">
          <FadeIn direction="right">
            <div class="aspect-video rounded-3xl overflow-hidden shadow-xl">
              <img src="/assets/yacht.webp" alt="Özel Yat" class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-700" />
            </div>
          </FadeIn>
        </div>
        <div class="md:w-1/2 w-full">
          <FadeIn delay={0.2} direction="left">
            <h3 class="text-3xl font-serif text-brand-primary font-bold mb-4">Özel Yat ve Katamaran Kiralama</h3>
            <p class="text-slate-600 mb-6 leading-relaxed">
              Kalabalıktan uzak, sadece size ait bir rota oluşturun. Phi Phi, James Bond, Racha veya Similan Adaları'na aileniz veya arkadaş grubunuzla konforlu, lüks ve izole bir seyahat gerçekleştirin.
            </p>
            <ul class="space-y-3 text-sm text-slate-700 font-medium mb-8">
              <li class="flex items-center gap-2"><svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Özel Kaptan ve Mürettebat</li>
              <li class="flex items-center gap-2"><svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Teknede Özel Şef & İkramlar</li>
              <li class="flex items-center gap-2"><svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Esnek Rota ve Zamanlama</li>
            </ul>
            <a href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent('VIP Yat kiralama hakkında bilgi almak istiyorum.')}`} target="_blank" class="inline-block border-2 border-brand-primary text-brand-primary px-8 py-3 rounded-full font-bold hover:bg-brand-primary hover:text-white transition-colors">
              Fiyat Alın
            </a>
          </FadeIn>
        </div>
      </div>

      <!-- Service 2 -->
      <div class="flex flex-col md:flex-row-reverse gap-12 items-center">
        <div class="md:w-1/2 w-full">
          <FadeIn direction="left">
            <div class="aspect-video rounded-3xl overflow-hidden shadow-xl">
              <img src="/assets/phuket_transfer.webp" alt="Özel Transfer" class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-700" />
            </div>
          </FadeIn>
        </div>
        <div class="md:w-1/2 w-full">
          <FadeIn delay={0.2} direction="right">
            <h3 class="text-3xl font-serif text-brand-primary font-bold mb-4">Lüks VIP Transfer</h3>
            <p class="text-slate-600 mb-6 leading-relaxed">
              Havalimanı inişinizden itibaren ayrıcalığı hissetmeye başlayın. Özel şoförlü, lüks tasarımlı VIP araçlarımızla otelinize konforlu ve güvenli bir şekilde ulaşın.
            </p>
            <ul class="space-y-3 text-sm text-slate-700 font-medium mb-8">
              <li class="flex items-center gap-2"><svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Havalimanı Karşılama</li>
              <li class="flex items-center gap-2"><svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Wi-Fi ve İkramlıklar</li>
              <li class="flex items-center gap-2"><svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Tam Gün Şoförlü Araç Kiralama Seçeneği</li>
            </ul>
            <a href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent('VIP Transfer hakkında bilgi almak istiyorum.')}`} target="_blank" class="inline-block border-2 border-brand-primary text-brand-primary px-8 py-3 rounded-full font-bold hover:bg-brand-primary hover:text-white transition-colors">
              Rezervasyon Yapın
            </a>
          </FadeIn>
        </div>
      </div>

      <!-- VIP FAQ Section -->
      <div class="mt-24 border-t border-slate-100 pt-16">
        <div class="max-w-3xl mx-auto text-center mb-10">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Merak Edilenler</span>
          <h2 class="text-3xl font-serif text-brand-primary font-bold mt-2">VIP Hizmetler Sıkça Sorulan Sorular</h2>
        </div>
        <Accordion client:visible faqs={vipFaqs} />
      </div>

    </div>
  </section>
</Layout>
