---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

export const prerender = false;
---

<Layout title="Mobil Fotoğraf Yükleyici | Phuket Tatili" description="Rehber ve saha ekibi için hızlı fotoğraf yükleme">
  <div class="min-h-screen bg-slate-950 text-white flex flex-col justify-between p-4 sm:p-6 max-w-lg mx-auto">
    <!-- Üst Başlık -->
    <div class="pt-6 text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold">
        <span>⚡ Saha & Tur Arşivi</span>
      </div>
      <h1 class="text-2xl font-serif font-black text-white">
        Mobil Fotoğraf Yükleyici
      </h1>
      <p class="text-xs text-slate-400 max-w-xs mx-auto">
        Telefonunuzdan çektiğiniz tur veya otel fotoğraflarını anında sitenin medya kütüphanesine aktarın.
      </p>
    </div>

    <!-- Yükleme Kutusu -->
    <div class="my-8 bg-slate-900/80 border border-slate-800 rounded-3xl p-6 text-center space-y-5 shadow-2xl backdrop-blur-xl">
      <div class="w-20 h-20 mx-auto rounded-3xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-3xl shadow-inner">
        📸
      </div>

      <div>
        <label class="block w-full py-4 px-6 rounded-2xl bg-brand-accent hover:bg-brand-accent/90 text-white font-black text-base shadow-xl shadow-brand-accent/30 cursor-pointer transition transform active:scale-95">
          <span>Fotoğraf Seç / Çek</span>
          <input
            id="mobile-file-input"
            type="file"
            accept="image/*"
            multiple
            class="hidden"
          />
        </label>
        <span class="text-[11px] text-slate-400 block mt-2">
          Birden fazla fotoğraf seçebilirsiniz (Otomatik WebP sıkıştırması yapılır).
        </span>
      </div>

      <!-- İlerleme / Durum Kutusu -->
      <div id="upload-status-box" class="hidden p-4 rounded-2xl bg-slate-950 border border-slate-800 text-left space-y-2">
        <div class="flex items-center justify-between text-xs font-bold text-slate-300">
          <span id="upload-status-title">İşleniyor...</span>
          <span id="upload-status-count" class="text-amber-400 font-mono">0 / 0</span>
        </div>
        <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
          <div id="upload-progress-bar" class="bg-amber-400 h-full w-0 transition-all duration-300 rounded-full"></div>
        </div>
        <p id="upload-status-detail" class="text-[10px] text-slate-400 font-mono"></p>
      </div>
    </div>

    <!-- Yüklenen Son Fotoğraflar -->
    <div class="space-y-3">
      <div class="flex items-center justify-between text-xs font-bold text-slate-400 px-1">
        <span>Yeni Yüklenenler</span>
        <span id="recent-count" class="text-[10px] bg-slate-800 px-2 py-0.5 rounded-full font-mono">0</span>
      </div>
      <div id="uploaded-grid" class="grid grid-cols-3 gap-2.5 max-h-56 overflow-y-auto p-1">
        <!-- Javascript ile doldurulur -->
      </div>
    </div>

    <!-- Alt Bilgi -->
    <div class="pt-6 pb-2 text-center text-[10px] text-slate-400">
      <p>Phuket Tatili Operasyon Sistemi · Güvenli Mobil Yükleme</p>
    </div>
  </div>

  <script is:inline>
    const fileInput = document.getElementById('mobile-file-input');
    const statusBox = document.getElementById('upload-status-box');
    const statusTitle = document.getElementById('upload-status-title');
    const statusCount = document.getElementById('upload-status-count');
    const statusDetail = document.getElementById('upload-status-detail');
    const progressBar = document.getElementById('upload-progress-bar');
    const uploadedGrid = document.getElementById('uploaded-grid');
    const recentCount = document.getElementById('recent-count');

    let totalUploaded = 0;

    const slugify = (name) => {
      const base = name.replace(/\.[^/.]+$/, '');
      const map = { 'ç':'c','Ç':'c','ğ':'g','Ğ':'g','ı':'i','I':'i','İ':'i','ö':'o','Ö':'o','ş':'s','Ş':'s','ü':'u','Ü':'u' };
      return base.split('').map(ch => map[ch] || ch).join('').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 50) || 'mobil-foto';
    };

    // Client-side auto WebP compression
    const compressFile = (file) => {
      return new Promise((resolve) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const maxDim = 1920;
          const scale = Math.min(1, maxDim / Math.max(img.width, img.height));
          const w = Math.round(img.width * scale);
          const h = Math.round(img.height * scale);

          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          if (!ctx) return resolve({ blob: file, name: file.name, w: img.width, h: img.height });

          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, w, h);
          ctx.drawImage(img, 0, 0, w, h);

          canvas.toBlob((blob) => {
            URL.revokeObjectURL(url);
            if (blob) {
              resolve({ blob, name: slugify(file.name) + '.webp', w, h });
            } else {
              resolve({ blob: file, name: file.name, w, h });
            }
          }, 'image/webp', 0.85);
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          resolve({ blob: file, name: file.name, w: 0, h: 0 });
        };
        img.src = url;
      });
    };

    fileInput?.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files || []);
      if (files.length === 0) return;

      statusBox.classList.remove('hidden');
      statusTitle.textContent = 'Görseller işleniyor ve yükleniyor...';
      statusCount.textContent = `0 / ${files.length}`;
      progressBar.style.width = '0%';

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        statusDetail.textContent = `İşleniyor: ${file.name} (${(file.size / 1024 / 1024).toFixed(1)} MB)`;

        try {
          // 1) Sıkıştır
          const compressed = await compressFile(file);
          statusDetail.textContent = `Buluta aktarılıyor: ${(compressed.blob.size / 1024).toFixed(0)} KB WebP`;

          // 2) Yükle
          const fd = new FormData();
          fd.append('file', compressed.blob, compressed.name);
          fd.append('filename', compressed.name);

          const res = await fetch('/api/upload', { method: 'POST', body: fd });
          if (!res.ok) throw new Error('Upload error');
          const data = await res.json();

          if (data.url) {
            // Görseli listeye ekle
            const thumb = document.createElement('div');
            thumb.className = 'relative aspect-square rounded-xl overflow-hidden border border-slate-700 bg-slate-900 animate-fadeIn';
            thumb.innerHTML = `
              <img src="${data.url}" class="w-full h-full object-cover" />
              <div class="absolute bottom-1 right-1 bg-black/60 px-1 rounded text-[9px] text-emerald-400 font-bold">✓</div>
            `;
            uploadedGrid.prepend(thumb);
            totalUploaded++;
            recentCount.textContent = totalUploaded;

            // Media listesini güncelle
            try {
              const cmsRes = await fetch('/api/content?key=media');
              let currentList = [];
              if (cmsRes.ok) {
                const cmsJson = await cmsRes.json();
                currentList = Array.isArray(cmsJson) ? cmsJson : (cmsJson.data || []);
              }
              const newMediaItem = {
                id: `med-${Date.now()}`,
                title: file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' '),
                url: data.url,
                type: 'uploaded',
                size: `${Math.round(compressed.blob.size / 1024)} KB · ${compressed.w}×${compressed.h}`,
                createdAt: new Date().toLocaleDateString('tr-TR'),
                slug: compressed.name
              };
              await fetch('/api/content?key=media', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify([newMediaItem, ...currentList])
              });
            } catch (err) {
              console.warn('CMS sync note:', err);
            }
          }
        } catch (err) {
          console.error('Yükleme hatası:', err);
        }

        const pct = Math.round(((i + 1) / files.length) * 100);
        progressBar.style.width = `${pct}%`;
        statusCount.textContent = `${i + 1} / ${files.length}`;
      }

      statusTitle.textContent = 'Tüm fotoğraflar başarıyla yüklendi! ✅';
      statusDetail.textContent = `${files.length} fotoğraf sisteme kaydedildi.`;
      fileInput.value = '';
    });
  </script>
</Layout>
