.s3-fish { position:absolute; inset:0; pointer-events:none; }
.fish { position:absolute; animation:fishSwim 8s ease-in-out infinite; }
.f1{font-size:1.8rem;top:45%;left:-8%;animation-duration:9s;animation-delay:1s;}
.f2{font-size:1.3rem;top:60%;left:-6%;animation-duration:7s;animation-delay:3.5s;}
.f3{font-size:1.1rem;top:35%;left:-5%;animation-duration:11s;animation-delay:6s;}
@keyframes fishSwim { 0%{transform:translateX(0) scaleX(1);opacity:0;}5%{opacity:1;}45%{transform:translateX(110vw) scaleX(1);opacity:1;}50%{transform:translateX(110vw) scaleX(-1);opacity:1;}95%{transform:translateX(0) scaleX(-1);opacity:1;}100%{transform:translateX(0) scaleX(1);opacity:0;} }

.island-cards { display:flex; gap:.4rem; flex-wrap:wrap; }
.icard { display:flex; flex-direction:column; align-items:center; gap:.3rem; background:rgba(255,255,255,.13); border:1px solid rgba(255,255,255,.22); border-radius:var(--radius-md); padding:.6rem .8rem; font-size:.8rem; color:#fff; font-weight:600; backdrop-filter:blur(10px); opacity:0; transform:scale(.75) translateY(12px); }
.icard span:first-child { font-size:1.3rem; }
.is-active .ic1{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) .72s forwards;}
.is-active .ic2{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) .86s forwards;}
.is-active .ic3{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) 1s forwards;}
.is-active .ic4{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) 1.14s forwards;}
.is-active .ic5{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) 1.28s forwards;}

/* ═══ S4 — ADVENTURE ═══ */
.s4 { background:linear-gradient(170deg,#0f2218 0%,#1e4a28 40%,#2d7038 80%,#3a8c40 100%); }
.s4-jungle { position:absolute; inset:0; background:radial-gradient(ellipse 60% 70% at 80% 50%,rgba(100,220,80,.08) 0%,transparent 70%); animation:jungleGlow 4s ease-in-out infinite; }
@keyframes jungleGlow { 0%,100%{opacity:.5;}50%{opacity:1;} }
.jungle-layer { position:absolute; bottom:0; right:0; left:0; height:85%; pointer-events:none; }
.jtree { position:absolute; bottom:-5%; animation:treeSway 5s ease-in-out infinite; }
.jt1{right:2%;font-size:clamp(3rem,9vw,9rem);animation-delay:0s;}
.jt2{right:14%;font-size:clamp(2rem,5vw,5rem);animation-delay:1s;}
.jt3{right:24%;font-size:clamp(3rem,8vw,7rem);animation-delay:2s;}
.jt4{right:35%;font-size:clamp(1.5rem,4vw,4rem);animation-delay:.5s;}
.jt5{right:42%;font-size:clamp(1.8rem,4vw,3.5rem);animation-delay:1.5s;}
@keyframes treeSway { 0%,100%{transform-origin:bottom;transform:rotate(-5deg);}33%{transform-origin:bottom;transform:rotate(5deg);}66%{transform-origin:bottom;transform:rotate(-2deg);} }
.zipline-wire { position:absolute; top:18%; right:5%; width:40%; height:2px; background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),rgba(255,255,255,.5)); transform:rotate(-8deg); z-index:3; }
.zl-person { position:absolute; left:0%; top:-22px; font-size:1.6rem; animation:ziplineRide 4s ease-in-out infinite; }
@keyframes ziplineRide { 0%{left:0%;transform:rotate(-10deg);}50%{left:90%;transform:rotate(5deg);}100%{left:0%;transform:rotate(-10deg);} }
.dust-particles { position:absolute; bottom:18%; left:0; right:0; pointer-events:none; }
.dust { position:absolute; left:var(--dx); width:6px; height:6px; background:rgba(180,140,90,.4); border-radius:50%; animation:dustFly 2s ease-out var(--dd) infinite; }
@keyframes dustFly { 0%{transform:translate(0,0) scale(1);opacity:.6;}100%{transform:translate(30px,-30px) scale(.2);opacity:0;} }
.adventure-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:.35rem; }
.adv-item { display:flex; flex-direction:column; align-items:center; gap:.25rem; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.15); border-radius:var(--radius-sm); padding:.55rem .35rem; backdrop-filter:blur(6px); opacity:0; transform:translateY(16px); }
.is-active .adv-item { animation:slideUp .4s cubic-bezier(.34,1.5,.64,1) calc(.7s + var(--ai) * .1s) forwards; }
.adv-icon { font-size:1.3rem; animation:iconWiggle 2.5s ease-in-out infinite; }
.adv-item:nth-child(odd)  .adv-icon{animation-delay:0s;}
.adv-item:nth-child(even) .adv-icon{animation-delay:.5s;}
@keyframes iconWiggle { 0%,100%{transform:rotate(-6deg) scale(1);}50%{transform:rotate(6deg) scale(1.18);} }
.adv-name { font-size:.68rem; font-weight:700; color:rgba(255,255,255,.9); text-align:center; }

/* ═══ S5 — FOOD ═══ */
.s5 { background:linear-gradient(145deg,#fff3e8 0%,#fde8c8 50%,#fff8ee 100%); }
.s5-bg { position:absolute; inset:0; background:radial-gradient(ellipse 70% 60% at 70% 60%,rgba(230,100,30,.07) 0%,transparent 70%); animation:s5glow 5s ease-in-out infinite; }
@keyframes s5glow { 0%,100%{opacity:.6;transform:scale(1);}50%{opacity:1;transform:scale(1.06);} }
.steam-container { position:absolute; right:12%; top:15%; width:160px; height:180px; }
.bowl-emoji { position:absolute; bottom:0; left:50%; transform:translateX(-50%); font-size:clamp(3rem,8vw,7rem); animation:bowlBob 3s ease-in-out infinite; z-index:2; }
@keyframes bowlBob { 0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(-6px);} }
.steam { position:absolute; left:50%; transform:translateX(-50%); width:8px; height:40px; background:linear-gradient(to top,rgba(180,180,200,.6),transparent); border-radius:50%; bottom:55%; filter:blur(3px); animation:steamRise 2.5s ease-in-out infinite; }
.st1{left:42%;animation-delay:0s;}
.st2{left:52%;animation-delay:.6s;width:6px;}
.st3{left:62%;animation-delay:1.2s;width:5px;}
@keyframes steamRise { 0%{transform:translateX(-50%) translateY(0) scaleX(1);opacity:0;}20%{opacity:.8;}100%{transform:translateX(calc(-50% + 10px)) translateY(-55px) scaleX(2.5);opacity:0;} }
.lanterns { position:absolute; top:0; right:0; left:60%; height:45%; pointer-events:none; }
.lantern-wrap { position:absolute; top:0; animation:lanternSwing 3.5s ease-in-out infinite; transform-origin:top center; }
.lw1{left:5%;font-size:clamp(1.5rem,3.5vw,3rem);animation-delay:0s;}
.lw2{left:28%;font-size:clamp(1.2rem,3vw,2.5rem);animation-delay:.7s;}
.lw3{left:52%;font-size:clamp(1.5rem,3.5vw,3rem);animation-delay:1.4s;}
.lw4{left:75%;font-size:clamp(1rem,2.5vw,2rem);animation-delay:2.1s;}
@keyframes lanternSwing { 0%,100%{transform:rotate(-13deg);}50%{transform:rotate(13deg);} }
.spice-float { position:absolute; right:8%; bottom:25%; pointer-events:none; }
.spice { position:absolute; font-size:1.2rem; animation:spiceOrbit 6s ease-in-out infinite; }
.sp1{animation-delay:0s;}
.sp2{animation-delay:1.5s;left:30px;top:-20px;}
.sp3{animation-delay:3s;left:-15px;top:20px;font-size:1rem;}
.sp4{animation-delay:4.5s;left:40px;top:15px;font-size:.9rem;}
@keyframes spiceOrbit { 0%,100%{transform:translate(0,0) scale(1);}25%{transform:translate(9px,-9px) scale(1.12) rotate(12deg);}50%{transform:translate(-6px,-15px) scale(.88) rotate(-6deg);}75%{transform:translate(11px,-7px) scale(1.06) rotate(9deg);} }
.food-row { display:flex; flex-wrap:wrap; gap:.45rem; }
.food-item { font-size:.82rem; font-weight:700; background:rgba(255,255,255,.85); backdrop-filter:blur(6px); border:1px solid var(--wb-line); border-radius:var(--radius-md); padding:.5rem .85rem; color:var(--wb-ink); opacity:0; transform:translateY(10px) scale(.9); }
.is-active .fi1{animation:popIn .4s cubic-bezier(.34,1.6,.64,1) .70s forwards;}
.is-active .fi2{animation:popIn .4s cubic-bezier(.34,1.6,.64,1) .85s forwards;}
.is-active .fi3{animation:popIn .4s cubic-bezier(.34,1.6,.64,1) 1.00s forwards;}
.is-active .fi4{animation:popIn .4s cubic-bezier(.34,1.6,.64,1) 1.15s forwards;}

/* ═══ S6 — NIGHT ═══ */
.s6 { background:radial-gradient(ellipse at 50% 0%,#1a0a40 0%,#0d0820 50%,#050310 100%); }
.s6-night { position:absolute; inset:0; background:radial-gradient(ellipse 60% 40% at 50% 100%,rgba(80,0,120,.3) 0%,transparent 70%); animation:nightPulse 4s ease-in-out infinite; }
@keyframes nightPulse { 0%,100%{opacity:.6;}50%{opacity:1;} }
.star-field { position:absolute; inset:0; pointer-events:none; }
.star { position:absolute; left:var(--sx); top:var(--sy); width:var(--ss); height:var(--ss); background:#fff; border-radius:50%; animation:starTwinkle 2.5s ease-in-out var(--sd) infinite; }
@keyframes starTwinkle { 0%,100%{opacity:.12;transform:scale(1);}50%{opacity:1;transform:scale(1.6);box-shadow:0 0 5px rgba(255,255,255,.9);} }
.spotlights { position:absolute; top:0; left:0; right:0; bottom:0; overflow:hidden; pointer-events:none; }
.spot { position:absolute; bottom:0; width:0; height:0; border-left:80px solid transparent; border-right:80px solid transparent; transform-origin:bottom center; filter:blur(2px); }
.sp-a{border-bottom:70vh solid rgba(201,107,85,.12);left:20%;animation:spotSwing 5s ease-in-out infinite;}
.sp-b{border-bottom:70vh solid rgba(150,80,220,.1);left:50%;animation:spotSwing 7s ease-in-out infinite reverse;}
.sp-c{border-bottom:70vh solid rgba(80,120,220,.08);left:70%;animation:spotSwing 6s ease-in-out infinite 2s;}
@keyframes spotSwing { 0%,100%{transform:rotate(-18deg);}50%{transform:rotate(18deg);} }
.fireworks { position:absolute; top:12%; right:12%; pointer-events:none; }
.fw-particle { position:absolute; width:4px; height:4px; background:var(--wb-clay); border-radius:50%; animation:fwBurst 2.5s ease-out var(--fd) infinite; }
.fw2 { background:#d4af37; }
@keyframes fwBurst { 0%{transform:rotate(var(--fa)) translateY(0) scale(1);opacity:1;}60%{opacity:.8;}100%{transform:rotate(var(--fa)) translateY(-55px) scale(.15);opacity:0;} }
.curtain-left,.curtain-right { position:absolute; top:0; bottom:0; width:6%; background:linear-gradient(90deg,rgba(60,0,60,.5),transparent); }
.curtain-left{left:0;}
.curtain-right{right:0;transform:scaleX(-1);}
.shows-list { display:flex; flex-direction:column; gap:.4rem; }
.show-card { display:flex; align-items:center; gap:.75rem; background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.12); border-radius:var(--radius-md); padding:.65rem .9rem; backdrop-filter:blur(10px); opacity:0; transform:translateX(-20px); }
.show-card:hover { background:rgba(255,255,255,.14); }
.is-active .sh1{animation:slideRight .45s cubic-bezier(.34,1.4,.64,1) .70s forwards;}
.is-active .sh2{animation:slideRight .45s cubic-bezier(.34,1.4,.64,1) .88s forwards;}
.is-active .sh3{animation:slideRight .45s cubic-bezier(.34,1.4,.64,1) 1.06s forwards;}
.show-icon { font-size:1.4rem; flex-shrink:0; animation:iconPop 2s ease-in-out infinite; }
.sh1 .show-icon{animation-delay:0s;}
.sh2 .show-icon{animation-delay:.5s;}
.sh3 .show-icon{animation-delay:1s;}
@keyframes iconPop { 0%,100%{transform:scale(1);}50%{transform:scale(1.22) rotate(5deg);} }
.show-card strong { display:block; color:#fff; font-size:.88rem; }
.show-card small  { color:rgba(255,255,255,.55); font-size:.73rem; }

/* ═══ S7 — YACHT ═══ */
.s7 { background:linear-gradient(180deg,#ff8c42 0%,#ffb347 15%,#87ceeb 40%,#4da6d4 65%,#1a6fa0 100%); }
.s7-sky { position:absolute; inset:0; background:radial-gradient(ellipse 100% 50% at 50% 0%,rgba(255,140,60,.4) 0%,transparent 55%); animation:sunsetGlow 6s ease-in-out infinite; }
@keyframes sunsetGlow { 0%,100%{opacity:.8;}50%{opacity:1;} }
.s7-sunset { position:absolute; top:0; left:0; right:0; height:45%; background:linear-gradient(180deg,rgba(255,100,30,.25) 0%,transparent 100%); animation:sunsetFade 8s ease-in-out infinite; }
@keyframes sunsetFade { 0%,100%{opacity:.7;}50%{opacity:1;} }
.s7-sun-disc { position:absolute; font-size:clamp(3rem,7vw,6.5rem); right:10%; top:2%; animation:sunDip 10s ease-in-out infinite; filter:drop-shadow(0 0 20px rgba(255,140,30,.6)); }
@keyframes sunDip { 0%,100%{top:2%;filter:drop-shadow(0 0 20px rgba(255,140,30,.6));}50%{top:5%;filter:drop-shadow(0 0 45px rgba(255,160,50,.95));} }
.s7-sea { position:absolute; bottom:0; left:0; right:0; height:45%; background:linear-gradient(180deg,rgba(26,111,160,.6) 0%,rgba(10,60,100,.9) 100%); }
.sea-r { position:absolute; left:30%; right:0; height:3px; background:linear-gradient(90deg,transparent,rgba(255,160,60,.4),rgba(255,180,80,.6),rgba(255,160,60,.4),transparent); border-radius:50%; animation:reflectShimmer 3s ease-in-out infinite; }
.sr1{top:15%;width:40%;animation-delay:0s;}
.sr2{top:30%;width:55%;animation-delay:.8s;}
.sr3{top:50%;width:35%;animation-delay:1.6s;}
@keyframes reflectShimmer { 0%,100%{opacity:.4;transform:scaleX(1);}50%{opacity:.95;transform:scaleX(1.18);} }
.sea-wave-top { position:absolute; top:0; width:200%; left:-50%; height:20px; background:rgba(255,255,255,.08); border-radius:50%; animation:waveTop 5s ease-in-out infinite; }
.swt1{animation-delay:0s;}
.swt2{animation-delay:2s;opacity:.5;}
@keyframes waveTop { 0%,100%{transform:translateX(0) scaleY(1);}50%{transform:translateX(3%) scaleY(1.35);} }
.yacht-wrap { position:absolute; right:8%; bottom:38%; z-index:3; animation:yachtBob 5s ease-in-out infinite; }
@keyframes yachtBob { 0%,100%{transform:translateY(0) rotate(-2deg);}50%{transform:translateY(-18px) rotate(2.5deg);} }
.yacht-body { font-size:clamp(3rem,9vw,9rem); filter:drop-shadow(0 8px 20px rgba(0,0,0,.2)); }
.yacht-wake { height:4px; background:linear-gradient(90deg,transparent,rgba(255,255,255,.35)); border-radius:2px; margin-top:-8px; animation:wakeExpand 2s ease-out infinite; }
@keyframes wakeExpand { 0%{width:10px;opacity:.7;}100%{width:90px;opacity:0;} }
.seagulls { position:absolute; top:22%; left:5%; right:55%; pointer-events:none; }
.sg { position:absolute; font-size:1rem; animation:seagullFly 7s ease-in-out infinite; opacity:.85; }
.sg1{top:0;left:0;animation-delay:0s;}
.sg2{top:20px;left:35px;font-size:.75rem;animation-delay:1.5s;}
.sg3{top:-15px;left:65px;font-size:.85rem;animation-delay:3s;}
@keyframes seagullFly { 0%,100%{transform:translate(0,0);}25%{transform:translate(16px,-22px) scale(.9);}50%{transform:translate(32px,-10px) scale(1.06);}75%{transform:translate(48px,-26px) scale(.94);} }
.champagne { position:absolute; right:22%; bottom:55%; }
.cb { font-size:1.8rem; display:block; animation:champagneWave 2s ease-in-out infinite; }
@keyframes champagneWave { 0%,100%{transform:rotate(-10deg) scale(1);}50%{transform:rotate(10deg) scale(1.12);} }
.cbubble { position:absolute; left:var(--cx); bottom:100%; width:5px; height:5px; background:rgba(255,215,0,.5); border:1px solid rgba(255,215,0,.7); border-radius:50%; animation:champBubble 1.5s ease-in var(--cd) infinite; }
@keyframes champBubble { 0%{transform:translateY(0);opacity:.8;}100%{transform:translateY(-38px) translateX(6px);opacity:0;} }
.yacht-features { display:flex; gap:.4rem; flex-wrap:wrap; }
.yf { display:flex; align-items:center; gap:.4rem; background:rgba(255,255,255,.75); backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,.5); border-radius:var(--radius-pill); padding:.4rem .9rem; font-size:.8rem; font-weight:700; color:var(--wb-ink); opacity:0; transform:translateY(10px) scale(.85); }
.yf span:first-child { font-size:1rem; }
.is-active .yf1{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) .70s forwards;}
.is-active .yf2{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) .85s forwards;}
.is-active .yf3{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) 1.00s forwards;}
.is-active .yf4{animation:popIn .4s cubic-bezier(.34,1.7,.64,1) 1.15s forwards;}

/* ═══ S8 — CTA ═══ */
.s8 { background:var(--wb-ink); }
.s8-bg { position:absolute; inset:0; background:radial-gradient(ellipse 70% 70% at 50% 50%,rgba(201,107,85,.12) 0%,transparent 70%); animation:s8pulse 4s ease-in-out infinite; }
@keyframes s8pulse { 0%,100%{transform:scale(1);opacity:.8;}50%{transform:scale(1.1);opacity:1;} }
.orb-field { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.s8-orb { position:absolute; border-radius:50%; filter:blur(55px); animation:orbDrift 8s ease-in-out infinite; }
.o1{width:350px;height:350px;background:rgba(201,107,85,.22);top:-100px;left:-80px;animation-delay:0s;}
.o2{width:250px;height:250px;background:rgba(104,114,99,.18);bottom:-80px;right:5%;animation-delay:2.5s;}
.o3{width:180px;height:180px;background:rgba(201,107,85,.14);top:40%;left:45%;animation-delay:5s;}
.o4{width:120px;height:120px;background:rgba(212,175,55,.12);top:10%;right:20%;animation-delay:3.5s;}
@keyframes orbDrift { 0%,100%{transform:translate(0,0) scale(1);}33%{transform:translate(20px,-14px) scale(1.08);}66%{transform:translate(-12px,16px) scale(.92);} }
.confetti-field { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.confetti-piece { position:absolute; left:var(--cx); top:-10px; width:7px; height:7px; background:var(--cr); border-radius:2px; animation:confettiFall 3s ease-in var(--cd) infinite; }
@keyframes confettiFall { 0%{transform:translateY(0) rotate(0deg);opacity:1;}80%{opacity:.7;}100%{transform:translateY(110vh) rotate(720deg);opacity:0;} }

.s8-eyebrow,.anim-tag-center { font-size:.8rem; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:var(--wb-clay); margin:0; opacity:0; transform:translateY(12px); }
.is-active .anim-tag-center { animation:slideUp .5s ease .1s forwards; }
.s8-headline,.anim-headline-center { font-family:'Playfair Display',var(--font-body),serif; font-size:clamp(1.8rem,4.5vw,3.2rem); font-weight:700; color:#fff; line-height:1.18; margin:0; }
.anim-headline-center .word { display:inline-block; opacity:0; transform:translateY(24px) rotateX(-25deg); }
.is-active .anim-headline-center .w1{animation:wordIn .5s cubic-bezier(.34,1.56,.64,1) .2s forwards;}
.is-active .anim-headline-center .w2{animation:wordIn .5s cubic-bezier(.34,1.56,.64,1) .32s forwards;}
.is-active .anim-headline-center .w3{animation:wordIn .5s cubic-bezier(.34,1.56,.64,1) .44s forwards;}
.is-active .anim-headline-center .w4{animation:wordIn .5s cubic-bezier(.34,1.56,.64,1) .56s forwards;}
.is-active .anim-headline-center .w5{animation:wordIn .5s cubic-bezier(.34,1.56,.64,1) .68s forwards;}
.s8-sub,.anim-body-center { font-size:clamp(.875rem,1.5vw,1.05rem); color:rgba(255,255,255,.65); margin:0; opacity:0; transform:translateY(10px); }
.is-active .anim-body-center { animation:slideUp .5s ease .78s forwards; }
.s8-cta-wrap,.anim-cta { position:relative; display:inline-flex; opacity:0; transform:scale(.8); }
.is-active .anim-cta { animation:popIn .55s cubic-bezier(.34,1.6,.64,1) .9s forwards; }
.s8-cta { position:relative; z-index:2; display:inline-flex; align-items:center; gap:.6rem; background:var(--wb-clay); color:#fff; font-size:clamp(1rem,1.8vw,1.2rem); font-weight:700; padding:.9rem 2.2rem; border-radius:var(--radius-pill); text-decoration:none; transition:transform .2s ease,box-shadow .2s ease,background .2s ease; box-shadow:0 6px 28px rgba(201,107,85,.5); }
.s8-cta:hover { transform:translateY(-4px) scale(1.04); box-shadow:0 14px 45px rgba(201,107,85,.7); background:#c85f40; }
.cta-ripple { position:absolute; inset:0; border-radius:var(--radius-pill); border:2px solid rgba(201,107,85,.5); animation:ctaRipple 2.4s ease-out infinite; }
.r2{animation-delay:.8s;}
.r3{animation-delay:1.6s;}
@keyframes ctaRipple { 0%{transform:scale(1);opacity:.6;}100%{transform:scale(2.2);opacity:0;} }
.s8-note,.anim-note { font-size:.8rem; color:rgba(255,255,255,.38); margin:0; opacity:0; }
.is-active .anim-note { animation:slideUp .5s ease 1.1s forwards; }

/* ═══ CONTROLS ═══ */
.story-controls { display:flex; align-items:center; justify-content:center; gap:var(--space-sm); margin-top:var(--space-md); }
.story-btn { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:50%; border:1.5px solid var(--wb-line); background:var(--wb-warm-white); color:var(--wb-ink); cursor:pointer; transition:all .2s ease; }
.story-btn:hover:not(:disabled) { border-color:var(--wb-clay); color:var(--wb-clay); background:rgba(201,107,85,.06); transform:scale(1.1); }
.story-btn:disabled { opacity:.22; cursor:default; }
.story-btn--play { width:48px; height:48px; background:var(--wb-ink); border-color:var(--wb-ink); color:#fff; }
.story-btn--play:hover:not(:disabled) { background:var(--wb-clay); border-color:var(--wb-clay); transform:scale(1.12); }
