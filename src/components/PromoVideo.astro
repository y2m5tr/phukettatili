<script>
(() => {
  const SCENES = 8;
  const DURATION = 8000;
  let current = 0, playing = true, elapsed = 0, rafId: number, startTime: number, paused = false;
  const stage    = document.getElementById('story-stage')!;
  const sceneEls = Array.from(stage.querySelectorAll<HTMLElement>('.story-scene'));
  const dots     = Array.from(document.querySelectorAll<HTMLElement>('.story-dot'));
  const prevBtn  = document.getElementById('story-prev') as HTMLButtonElement;
  const nextBtn  = document.getElementById('story-next') as HTMLButtonElement;
  const playBtn  = document.getElementById('story-play') as HTMLButtonElement;
  const bar      = document.getElementById('story-progress-bar')!;
  const label    = document.getElementById('story-current')!;
  const iPause   = playBtn.querySelector<HTMLElement>('.icon-pause')!;
  const iPlay    = playBtn.querySelector<HTMLElement>('.icon-play')!;

  const ANIM_SELECTORS = '.anim-tag,.anim-headline,.word,.anim-body,.anim-card,.anim-tag-center,.anim-headline-center .word,.anim-body-center,.anim-cta,.anim-note,.pop-pill,.adv-item,.icard,.food-item,.yf,.show-card';

  function activateScene(idx: number) {
    sceneEls.forEach((s, i) => {
      const wasActive = s.classList.contains('is-active');
      s.classList.toggle('is-active', i === idx);
      s.classList.toggle('is-prev', i < idx);
      s.classList.toggle('is-next', i > idx);
      if (i === idx && !wasActive) {
        s.querySelectorAll<HTMLElement>(ANIM_SELECTORS).forEach(el => {
          el.style.animation = 'none';
          void el.getBoundingClientRect();
          el.style.animation = '';
        });
      }
    });
    dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
    label.textContent = String(idx + 1);
    prevBtn.disabled = idx === 0;
    nextBtn.disabled = idx === SCENES - 1;
  }

  function startProgress() {
    startTime = performance.now() - elapsed;
    const tick = () => {
      elapsed = performance.now() - startTime;
      bar.style.width = Math.min((elapsed / DURATION) * 100, 100) + '%';
      if (elapsed < DURATION) { rafId = requestAnimationFrame(tick); }
      else { elapsed = 0; current < SCENES - 1 ? goTo(current + 1) : (playing = false, setIcon(false)); }
    };
    rafId = requestAnimationFrame(tick);
  }
  const stopProgress = () => cancelAnimationFrame(rafId);
  const setIcon = (p: boolean) => {
    iPause.style.display = p ? '' : 'none';
    iPlay.style.display  = p ? 'none' : '';
    playBtn.setAttribute('aria-label', p ? 'Duraklat' : 'Oynat');
  };
  function goTo(idx: number) {
    stopProgress(); elapsed = 0;
    current = Math.max(0, Math.min(SCENES - 1, idx));
    activateScene(current);
    bar.style.width = '0%';
    if (playing) startProgress();
  }

  activateScene(0); startProgress();
  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));
  playBtn.addEventListener('click', () => { playing = !playing; setIcon(playing); playing ? (current === SCENES-1 ? goTo(0) : startProgress()) : stopProgress(); });
  dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

  let tx = 0;
  stage.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, {passive:true});
  stage.addEventListener('touchend', e => { const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 45) goTo(dx < 0 ? current+1 : current-1); });
  document.addEventListener('keydown', e => { if(e.key==='ArrowRight') goTo(current+1); if(e.key==='ArrowLeft') goTo(current-1); if(e.key===' '){e.preventDefault();playBtn.click();} });
  stage.addEventListener('mouseenter', () => { if(playing){stopProgress();paused=true;} });
  stage.addEventListener('mouseleave', () => { if(playing&&paused){startProgress();paused=false;} });
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { playing=false; stopProgress(); setIcon(false); }
})();
</script>

<style>
.story-section { position:relative; background:var(--wb-warm-white); padding:var(--space-2xl) 0 var(--space-xl); overflow:hidden; }
.story-progress { position:absolute; top:0; left:0; right:0; height:3px; background:var(--wb-line); z-index:20; }
.story-progress-bar { height:100%; background:linear-gradient(90deg,var(--wb-clay),#e8885c); width:0%; transition:none; box-shadow:0 0 10px rgba(201,107,85,0.6); }
.story-counter { position:absolute; top:var(--space-md); right:var(--space-lg); font-size:.8125rem; font-weight:700; color:var(--wb-olive); z-index:20; font-variant-numeric:tabular-nums; }
.story-counter-sep { opacity:.4; margin:0 2px; }

.story-stage { position:relative; width:min(100% - 2rem, 72rem); margin-inline:auto; aspect-ratio:16/7; border-radius:var(--radius-xl); overflow:hidden; box-shadow:0 20px 80px rgba(23,42,57,.2); cursor:pointer; isolation:isolate; }

/* ── SCENE TRANSITIONS ── */
.story-scene { position:absolute; inset:0; display:flex; align-items:center; justify-content:flex-start; padding:clamp(1.5rem,4vw,3.5rem); opacity:0; pointer-events:none; transform:translateX(80px) scale(0.97); transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1); will-change:opacity,transform; }
.story-scene.is-active { opacity:1; transform:translateX(0) scale(1); pointer-events:auto; }
.story-scene.is-prev  { transform:translateX(-80px) scale(.97); }
.story-scene.is-next  { transform:translateX(80px)  scale(.97); }

/* ── CONTENT LAYER ── */
.scene-content { position:relative; z-index:5; max-width:54%; display:flex; flex-direction:column; gap:clamp(.5rem,1.2vw,.9rem); }
.scene-content--dark .scene-headline, .scene-content--dark .scene-body { color:#fff; }
.scene-content--center { max-width:100%; align-items:center; text-align:center; }

/* TAG */
.scene-tag,.anim-tag { display:inline-flex; align-items:center; gap:.4rem; font-size:.72rem; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--wb-clay); background:rgba(201,107,85,.1); border:1px solid rgba(201,107,85,.25); padding:.3rem .75rem; border-radius:var(--radius-pill); width:fit-content; opacity:0; transform:translateY(14px); }
.scene-tag--light { color:#fff; background:rgba(255,255,255,.15); border-color:rgba(255,255,255,.3); }
.is-active .anim-tag { animation:slideUp .5s cubic-bezier(.34,1.56,.64,1) .05s forwards; }
.adv-tag { color:#a3e63c; background:rgba(163,230,60,.15); border-color:rgba(163,230,60,.3); }
.vip-tag { color:#d4af37; background:rgba(212,175,55,.12); border-color:rgba(212,175,55,.3); }

/* WORDS */
.scene-headline { font-family:'Playfair Display',var(--font-body),serif; font-size:clamp(1.6rem,3.5vw,2.8rem); font-weight:700; color:var(--wb-ink); line-height:1.15; margin:0; overflow:visible; }
.scene-headline--light { color:#fff; }
.adv-headline { color:#fff; }
.word { display:inline-block; opacity:0; transform:translateY(22px) rotateX(-30deg); transform-origin:bottom center; }
.is-active .word.w1 { animation:wordIn .55s cubic-bezier(.34,1.56,.64,1) .18s forwards; }
.is-active .word.w2 { animation:wordIn .55s cubic-bezier(.34,1.56,.64,1) .30s forwards; }
.is-active .word.w3 { animation:wordIn .55s cubic-bezier(.34,1.56,.64,1) .42s forwards; }
.is-active .word.w4 { animation:wordIn .55s cubic-bezier(.34,1.56,.64,1) .54s forwards; }
.is-active .word.w5 { animation:wordIn .55s cubic-bezier(.34,1.56,.64,1) .66s forwards; }
@keyframes wordIn { to { opacity:1; transform:translateY(0) rotateX(0deg); } }

/* BODY */
.scene-body,.anim-body { font-size:clamp(.875rem,1.6vw,1.05rem); color:var(--wb-olive); line-height:1.6; margin:0; max-width:44ch; opacity:0; transform:translateY(12px); }
.scene-body--light { color:rgba(255,255,255,.85); }
.adv-body { color:rgba(255,255,255,.82); }
.scene-body strong { color:var(--wb-ink); }
.scene-body--light strong, .adv-body strong { color:#fff; }
.adv-strong { color:#a3e63c; }
.is-active .anim-body { animation:slideUp .5s ease .55s forwards; }

/* CARD */
.anim-card { opacity:0; transform:translateY(16px); }
.is-active .anim-card { animation:slideUp .5s cubic-bezier(.34,1.4,.64,1) .7s forwards; }

@keyframes slideUp { to { opacity:1; transform:translateY(0); } }
@keyframes popIn   { to { opacity:1; transform:scale(1); } }
@keyframes slideRight { to { opacity:1; transform:translateX(0); } }

/* ── DRIVER CARD ── */
.driver-card { display:flex; align-items:center; gap:var(--space-sm); background:rgba(255,255,255,.92); backdrop-filter:blur(8px); border:1px solid var(--wb-line); border-radius:var(--radius-md); padding:.75rem 1rem; box-shadow:0 4px 20px rgba(0,0,0,.08); width:fit-content; }
