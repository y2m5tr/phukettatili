---
import { buildWhatsAppUrl } from '@/utils/whatsapp';

const waUrl = buildWhatsAppUrl('Phuket tatil planı yapmak istiyorum, bilgi alabilir miyim?');
---

<section class="story-section" id="tanitim-filmi" aria-label="Phuket tatil hikayesi">

  <div class="story-progress" aria-hidden="true">
    <div class="story-progress-bar" id="story-progress-bar"></div>
  </div>

  <div class="story-counter" aria-hidden="true">
    <span id="story-current">1</span><span class="story-counter-sep">/</span><span>8</span>
  </div>

  <div class="story-stage" id="story-stage">

    <!-- ═══ SAHNE 1 — HAVAALANI (0–8s) ═══ -->
    <div class="story-scene s1" data-scene="1">
      <div class="s1-sky" aria-hidden="true"></div>
      <div class="s1-clouds" aria-hidden="true">
        <div class="cloud-wrap cw1"><span class="cloud">☁️</span></div>
        <div class="cloud-wrap cw2"><span class="cloud">☁️</span></div>
        <div class="cloud-wrap cw3"><span class="cloud">☁️</span></div>
        <div class="cloud-wrap cw4"><span class="cloud">☁️</span></div>
      </div>
      <div class="s1-plane" aria-hidden="true">✈️</div>
      <div class="s1-runway" aria-hidden="true">
        <div class="runway-line"></div>
        <div class="runway-line"></div>
        <div class="runway-line"></div>
        <div class="runway-line"></div>
        <div class="runway-line"></div>
      </div>
      <div class="scene-content">
        <div class="scene-tag anim-tag">🛬 Adım 1 — Karşılama</div>
        <h2 class="scene-headline anim-headline">
          <span class="word w1">Phuket'e</span>
          <span class="word w2">hoş</span>
          <span class="word w3">geldiniz.</span>
        </h2>
        <p class="scene-body anim-body">
          Uçağınız indi. Türkçe tabelayla bir şoför sizi bekliyor —<br/>
          <strong>sıcak bir karşılama, konforlu bir başlangıç.</strong>
        </p>
        <div class="driver-card anim-card">
          <span class="driver-emoji bounce-icon">🚗</span>
          <div>
            <strong>Özel VIP Transfer</strong>
            <small>Phuket Airport → Oteliniz</small>
          </div>
          <span class="card-badge">✓ Hazır</span>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 2 — OTEL (8–16s) ═══ -->
    <div class="story-scene s2" data-scene="2">
      <div class="s2-ocean" aria-hidden="true">
        <div class="ocean-wave ow1"></div>
        <div class="ocean-wave ow2"></div>
        <div class="ocean-wave ow3"></div>
      </div>
      <div class="s2-sky" aria-hidden="true"></div>
      <div class="s2-sun" aria-hidden="true">☀️</div>
      <div class="s2-palms" aria-hidden="true">
        <div class="palm-wrap pw1">🌴</div>
        <div class="palm-wrap pw2">🌴</div>
        <div class="palm-wrap pw3">🌴</div>
      </div>
      <div class="s2-birds" aria-hidden="true">
        <span class="bird b1">🕊️</span>
        <span class="bird b2">🕊️</span>
      </div>
      <div class="scene-content">
        <div class="scene-tag anim-tag">🏨 Adım 2 — Konaklama</div>
        <h2 class="scene-headline anim-headline">
          <span class="word w1">Odanız</span>
          <span class="word w2">sizi</span>
          <span class="word w3">bekliyor.</span>
        </h2>
        <p class="scene-body anim-body">
          Deniz manzaralı oda. Andaman Denizi'nde
          <strong>turuncu gün batımı.</strong>
        </p>
        <div class="feature-pills anim-card">
          <span class="pill pop-pill" style="--d:.0s">🏖️ Denize yakın</span>
          <span class="pill pop-pill" style="--d:.1s">🍳 Kahvaltı</span>
          <span class="pill pop-pill" style="--d:.2s">💆 Spa</span>
          <span class="pill pop-pill" style="--d:.3s">🌊 Havuz</span>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 3 — ADA TURLARI (16–24s) ═══ -->
    <div class="story-scene s3" data-scene="3">
      <div class="s3-deep" aria-hidden="true"></div>
      <div class="bubbles" aria-hidden="true">
        <div class="bubble" style="--bx:5%;--bd:0s;--bs:.4rem"></div>
        <div class="bubble" style="--bx:12%;--bd:.4s;--bs:.6rem"></div>
        <div class="bubble" style="--bx:19%;--bd:.8s;--bs:.5rem"></div>
        <div class="bubble" style="--bx:26%;--bd:1.2s;--bs:.8rem"></div>
        <div class="bubble" style="--bx:33%;--bd:1.6s;--bs:.45rem"></div>
        <div class="bubble" style="--bx:40%;--bd:2s;--bs:.7rem"></div>
        <div class="bubble" style="--bx:47%;--bd:2.4s;--bs:.5rem"></div>
        <div class="bubble" style="--bx:54%;--bd:2.8s;--bs:.9rem"></div>
        <div class="bubble" style="--bx:61%;--bd:3.2s;--bs:.4rem"></div>
        <div class="bubble" style="--bx:68%;--bd:3.6s;--bs:.6rem"></div>
        <div class="bubble" style="--bx:75%;--bd:4s;--bs:.5rem"></div>
        <div class="bubble" style="--bx:82%;--bd:4.4s;--bs:.7rem"></div>
        <div class="bubble" style="--bx:89%;--bd:4.8s;--bs:.4rem"></div>
        <div class="bubble" style="--bx:93%;--bd:5.2s;--bs:.6rem"></div>
      </div>
      <div class="s3-surface" aria-hidden="true">
        <div class="surf-wave sw1"></div>
        <div class="surf-wave sw2"></div>
      </div>
      <div class="s3-fish" aria-hidden="true">
        <span class="fish f1">🐠</span>
        <span class="fish f2">🐡</span>
        <span class="fish f3">🐟</span>
      </div>
      <div class="scene-content scene-content--dark">
        <div class="scene-tag scene-tag--light anim-tag">🏝️ Adım 3 — Ada Turları</div>
        <h2 class="scene-headline scene-headline--light anim-headline">
          <span class="word w1">Ada</span>
          <span class="word w2">turlarına</span>
          <span class="word w3">çıkın.</span>
        </h2>
        <p class="scene-body scene-body--light anim-body">
          Kristal berraklığında sularda <strong>sürat teknesi</strong> ile efsanevi adalar.
        </p>
        <div class="island-cards anim-card">
          <div class="icard ic1"><span>🤿</span><span>Phi Phi</span></div>
          <div class="icard ic2"><span>⛵</span><span>James Bond</span></div>
          <div class="icard ic3"><span>🪸</span><span>Coral Is.</span></div>
          <div class="icard ic4"><span>🌊</span><span>Similan</span></div>
          <div class="icard ic5"><span>🏖️</span><span>Raya Yai</span></div>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 4 — MACERA (24–32s) ═══ -->
    <div class="story-scene s4" data-scene="4">
      <div class="s4-jungle" aria-hidden="true"></div>
      <div class="jungle-layer" aria-hidden="true">
        <span class="jtree jt1">🌴</span>
        <span class="jtree jt2">🌿</span>
        <span class="jtree jt3">🌴</span>
        <span class="jtree jt4">🌿</span>
        <span class="jtree jt5">🌿</span>
      </div>
      <div class="zipline-wire" aria-hidden="true">
        <div class="zl-person">🧗</div>
      </div>
      <div class="dust-particles" aria-hidden="true">
        <div class="dust" style="--dx:10%;--dd:0s"></div>
        <div class="dust" style="--dx:22%;--dd:.3s"></div>
        <div class="dust" style="--dx:34%;--dd:.6s"></div>
        <div class="dust" style="--dx:46%;--dd:.9s"></div>
        <div class="dust" style="--dx:58%;--dd:1.2s"></div>
        <div class="dust" style="--dx:70%;--dd:1.5s"></div>
        <div class="dust" style="--dx:82%;--dd:1.8s"></div>
        <div class="dust" style="--dx:91%;--dd:2.1s"></div>
      </div>
      <div class="scene-content">
        <div class="scene-tag anim-tag adv-tag">⚡ Adım 4 — Macera</div>
        <h2 class="scene-headline anim-headline adv-headline">
          <span class="word w1">Adrenalini</span>
          <span class="word w2">hissedin.</span>
        </h2>
        <p class="scene-body anim-body adv-body">
          Orman tepelerinden <strong class="adv-strong">zipline</strong>, kırmızı topraklarda ATV, filleri besleyin.
        </p>
        <div class="adventure-grid anim-card">
          <div class="adv-item" style="--ai:0"><span class="adv-icon">🏍️</span><span class="adv-name">ATV & Quad</span></div>
          <div class="adv-item" style="--ai:1"><span class="adv-icon">🦅</span><span class="adv-name">Zipline</span></div>
          <div class="adv-item" style="--ai:2"><span class="adv-icon">🐘</span><span class="adv-name">Fil Turu</span></div>
          <div class="adv-item" style="--ai:3"><span class="adv-icon">🛶</span><span class="adv-name">Kano</span></div>
          <div class="adv-item" style="--ai:4"><span class="adv-icon">🤿</span><span class="adv-name">Şnorkel</span></div>
          <div class="adv-item" style="--ai:5"><span class="adv-icon">🧗</span><span class="adv-name">Rafting</span></div>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 5 — YEMEK & KÜLTÜR (32–40s) ═══ -->
    <div class="story-scene s5" data-scene="5">
      <div class="s5-bg" aria-hidden="true"></div>
      <div class="steam-container" aria-hidden="true">
        <div class="bowl-emoji">🍜</div>
        <div class="steam st1"></div>
        <div class="steam st2"></div>
        <div class="steam st3"></div>
      </div>
      <div class="lanterns" aria-hidden="true">
        <div class="lantern-wrap lw1">🏮</div>
        <div class="lantern-wrap lw2">🏮</div>
        <div class="lantern-wrap lw3">🏮</div>
        <div class="lantern-wrap lw4">🏮</div>
      </div>
      <div class="spice-float" aria-hidden="true">
        <span class="spice sp1">🌶️</span>
        <span class="spice sp2">🥭</span>
        <span class="spice sp3">🍋</span>
        <span class="spice sp4">🌿</span>
      </div>
      <div class="scene-content">
        <div class="scene-tag anim-tag">🍜 Adım 5 — Yemek & Kültür</div>
        <h2 class="scene-headline anim-headline">
          <span class="word w1">Tayland'ı</span>
          <span class="word w2">tadın.</span>
        </h2>
        <p class="scene-body anim-body">
          Taze deniz mahsülleri, pad thai, mango tatlısı —
          ve tarihi <strong>Phuket Old Town.</strong>
        </p>
        <div class="food-row anim-card">
          <div class="food-item fi1">🦞 Seafood</div>
          <div class="food-item fi2">🍜 Pad Thai</div>
          <div class="food-item fi3">🥭 Mango</div>
          <div class="food-item fi4">🌶️ Tom Yum</div>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 6 — GECE GÖSTERİLERİ (40–48s) ═══ -->
    <div class="story-scene s6" data-scene="6">
      <div class="s6-night" aria-hidden="true"></div>
      <div class="star-field" aria-hidden="true">
        <div class="star" style="--sx:5%;--sy:8%;--sd:0s;--ss:.4rem"></div>
        <div class="star" style="--sx:12%;--sy:15%;--sd:.3s;--ss:.6rem"></div>
        <div class="star" style="--sx:20%;--sy:5%;--sd:.6s;--ss:.35rem"></div>
        <div class="star" style="--sx:28%;--sy:22%;--sd:.9s;--ss:.5rem"></div>
        <div class="star" style="--sx:35%;--sy:10%;--sd:1.2s;--ss:.45rem"></div>
        <div class="star" style="--sx:44%;--sy:18%;--sd:1.5s;--ss:.7rem"></div>
        <div class="star" style="--sx:52%;--sy:6%;--sd:1.8s;--ss:.4rem"></div>
        <div class="star" style="--sx:60%;--sy:25%;--sd:2.1s;--ss:.55rem"></div>
        <div class="star" style="--sx:68%;--sy:12%;--sd:2.4s;--ss:.38rem"></div>
        <div class="star" style="--sx:75%;--sy:20%;--sd:2.7s;--ss:.62rem"></div>
        <div class="star" style="--sx:82%;--sy:7%;--sd:3s;--ss:.42rem"></div>
        <div class="star" style="--sx:89%;--sy:30%;--sd:3.3s;--ss:.5rem"></div>
        <div class="star" style="--sx:93%;--sy:14%;--sd:3.6s;--ss:.35rem"></div>
        <div class="star" style="--sx:8%;--sy:38%;--sd:3.9s;--ss:.48rem"></div>
        <div class="star" style="--sx:16%;--sy:45%;--sd:4.2s;--ss:.4rem"></div>
        <div class="star" style="--sx:24%;--sy:35%;--sd:4.5s;--ss:.58rem"></div>
        <div class="star" style="--sx:32%;--sy:50%;--sd:4.8s;--ss:.38rem"></div>
        <div class="star" style="--sx:40%;--sy:40%;--sd:5.1s;--ss:.65rem"></div>
        <div class="star" style="--sx:48%;--sy:55%;--sd:5.4s;--ss:.4rem"></div>
        <div class="star" style="--sx:56%;--sy:42%;--sd:5.7s;--ss:.52rem"></div>
        <div class="star" style="--sx:64%;--sy:48%;--sd:6s;--ss:.45rem"></div>
        <div class="star" style="--sx:72%;--sy:35%;--sd:6.3s;--ss:.6rem"></div>
        <div class="star" style="--sx:80%;--sy:52%;--sd:6.6s;--ss:.38rem"></div>
        <div class="star" style="--sx:88%;--sy:38%;--sd:6.9s;--ss:.5rem"></div>
        <div class="star" style="--sx:95%;--sy:48%;--sd:7.2s;--ss:.42rem"></div>
        <div class="star" style="--sx:3%;--sy:58%;--sd:7.5s;--ss:.55rem"></div>
        <div class="star" style="--sx:11%;--sy:65%;--sd:7.8s;--ss:.4rem"></div>
        <div class="star" style="--sx:19%;--sy:58%;--sd:8.1s;--ss:.48rem"></div>
        <div class="star" style="--sx:27%;--sy:70%;--sd:8.4s;--ss:.38rem"></div>
        <div class="star" style="--sx:37%;--sy:62%;--sd:8.7s;--ss:.6rem"></div>
        <div class="star" style="--sx:45%;--sy:75%;--sd:9s;--ss:.42rem"></div>
        <div class="star" style="--sx:53%;--sy:65%;--sd:9.3s;--ss:.5rem"></div>
        <div class="star" style="--sx:61%;--sy:70%;--sd:9.6s;--ss:.36rem"></div>
        <div class="star" style="--sx:70%;--sy:60%;--sd:9.9s;--ss:.55rem"></div>
        <div class="star" style="--sx:78%;--sy:72%;--sd:10.2s;--ss:.42rem"></div>
      </div>
      <div class="spotlights" aria-hidden="true">
        <div class="spot sp-a"></div>
        <div class="spot sp-b"></div>
        <div class="spot sp-c"></div>
      </div>
      <div class="fireworks" aria-hidden="true">
        <div class="fw-particle" style="--fa:0deg;--fd:0s"></div>
        <div class="fw-particle" style="--fa:30deg;--fd:.15s"></div>
        <div class="fw-particle" style="--fa:60deg;--fd:.3s"></div>
        <div class="fw-particle" style="--fa:90deg;--fd:.45s"></div>
        <div class="fw-particle" style="--fa:120deg;--fd:.6s"></div>
        <div class="fw-particle" style="--fa:150deg;--fd:.75s"></div>
        <div class="fw-particle" style="--fa:180deg;--fd:.9s"></div>
        <div class="fw-particle" style="--fa:210deg;--fd:1.05s"></div>
        <div class="fw-particle" style="--fa:240deg;--fd:1.2s"></div>
        <div class="fw-particle" style="--fa:270deg;--fd:1.35s"></div>
        <div class="fw-particle" style="--fa:300deg;--fd:1.5s"></div>
        <div class="fw-particle" style="--fa:330deg;--fd:1.65s"></div>
        <div class="fw-particle fw2" style="--fa:15deg;--fd:.5s"></div>
        <div class="fw-particle fw2" style="--fa:45deg;--fd:.65s"></div>
        <div class="fw-particle fw2" style="--fa:75deg;--fd:.8s"></div>
        <div class="fw-particle fw2" style="--fa:105deg;--fd:.95s"></div>
        <div class="fw-particle fw2" style="--fa:135deg;--fd:1.1s"></div>
        <div class="fw-particle fw2" style="--fa:165deg;--fd:1.25s"></div>
        <div class="fw-particle fw2" style="--fa:195deg;--fd:1.4s"></div>
        <div class="fw-particle fw2" style="--fa:225deg;--fd:1.55s"></div>
        <div class="fw-particle fw2" style="--fa:255deg;--fd:1.7s"></div>
        <div class="fw-particle fw2" style="--fa:285deg;--fd:1.85s"></div>
        <div class="fw-particle fw2" style="--fa:315deg;--fd:2s"></div>
        <div class="fw-particle fw2" style="--fa:345deg;--fd:2.15s"></div>
      </div>
      <div class="curtain-left" aria-hidden="true"></div>
      <div class="curtain-right" aria-hidden="true"></div>
      <div class="scene-content scene-content--dark">
        <div class="scene-tag scene-tag--light anim-tag">🎭 Adım 6 — Gece Gösterileri</div>
        <h2 class="scene-headline scene-headline--light anim-headline">
          <span class="word w1">Geceye</span>
          <span class="word w2">renk</span>
          <span class="word w3">katın.</span>
        </h2>
        <p class="scene-body scene-body--light anim-body">
          Dünyaca ünlü gösteriler, sahne sanatı —
          <strong>Phuket'in efsanevi gece hayatı.</strong>
        </p>
        <div class="shows-list anim-card">
          <div class="show-card sh1">
            <span class="show-icon">🎪</span>
            <div><strong>Phuket Fantasea</strong><small>Fil, akrobasi, illüzyon</small></div>
          </div>
          <div class="show-card sh2">
            <span class="show-icon">💃</span>
            <div><strong>Simon Cabaret</strong><small>Phuket'in en ünlü gösterisi</small></div>
          </div>
          <div class="show-card sh3">
            <span class="show-icon">🎆</span>
            <div><strong>Siam Niramit</strong><small>Tayland kültürü & tarihi</small></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 7 — VIP YAT (48–56s) ═══ -->
    <div class="story-scene s7" data-scene="7">
      <div class="s7-sky" aria-hidden="true"></div>
      <div class="s7-sunset" aria-hidden="true"></div>
      <div class="s7-sun-disc" aria-hidden="true">🌅</div>
      <div class="s7-sea" aria-hidden="true">
        <div class="sea-r sr1"></div>
        <div class="sea-r sr2"></div>
        <div class="sea-r sr3"></div>
        <div class="sea-wave-top swt1"></div>
        <div class="sea-wave-top swt2"></div>
      </div>
      <div class="yacht-wrap" aria-hidden="true">
        <div class="yacht-body">⛵</div>
        <div class="yacht-wake"></div>
      </div>
      <div class="seagulls" aria-hidden="true">
        <span class="sg sg1">🐦</span>
        <span class="sg sg2">🐦</span>
        <span class="sg sg3">🐦</span>
      </div>
      <div class="champagne" aria-hidden="true">
        <span class="cb cb1">🥂</span>
        <div class="cbubble" style="--cx:40%;--cd:0s"></div>
        <div class="cbubble" style="--cx:44%;--cd:.3s"></div>
        <div class="cbubble" style="--cx:48%;--cd:.6s"></div>
        <div class="cbubble" style="--cx:52%;--cd:.9s"></div>
        <div class="cbubble" style="--cx:56%;--cd:1.2s"></div>
        <div class="cbubble" style="--cx:60%;--cd:1.5s"></div>
      </div>
      <div class="scene-content">
        <div class="scene-tag anim-tag vip-tag">👑 Adım 7 — VIP Yat</div>
        <h2 class="scene-headline anim-headline">
          <span class="word w1">Lüksü</span>
          <span class="word w2">hak</span>
          <span class="word w3">edin.</span>
        </h2>
        <p class="scene-body anim-body">
          Özel yat, gün batımında Andaman —
          sadece siz, aileniz ve <strong>sonsuz mavi.</strong>
        </p>
        <div class="yacht-features anim-card">
          <div class="yf yf1"><span>🛥️</span><span>Özel Yat</span></div>
          <div class="yf yf2"><span>🌅</span><span>Gün Batımı</span></div>
          <div class="yf yf3"><span>🍾</span><span>Catering</span></div>
          <div class="yf yf4"><span>🤿</span><span>Şnorkel</span></div>
        </div>
      </div>
    </div>

    <!-- ═══ SAHNE 8 — CTA (56–64s) ═══ -->
    <div class="story-scene s8" data-scene="8">
      <div class="s8-bg" aria-hidden="true"></div>
      <div class="orb-field" aria-hidden="true">
        <div class="s8-orb o1"></div>
        <div class="s8-orb o2"></div>
        <div class="s8-orb o3"></div>
        <div class="s8-orb o4"></div>
      </div>
      <div class="confetti-field" aria-hidden="true">
        <div class="confetti-piece" style="--cx:0%;--cd:0s;--cr:var(--wb-clay)"></div>
        <div class="confetti-piece" style="--cx:5%;--cd:.18s;--cr:#d4af37"></div>
        <div class="confetti-piece" style="--cx:10%;--cd:.36s;--cr:rgba(255,255,255,.6)"></div>
        <div class="confetti-piece" style="--cx:15%;--cd:.54s;--cr:var(--wb-clay)"></div>
        <div class="confetti-piece" style="--cx:20%;--cd:.72s;--cr:#d4af37"></div>
        <div class="confetti-piece" style="--cx:25%;--cd:.9s;--cr:rgba(255,255,255,.6)"></div>
        <div class="confetti-piece" style="--cx:30%;--cd:1.08s;--cr:var(--wb-clay)"></div>
        <div class="confetti-piece" style="--cx:35%;--cd:1.26s;--cr:#d4af37"></div>
