.card-badge { margin-left:auto; font-size:.72rem; font-weight:700; color:#25a244; background:rgba(37,162,68,.1); border:1px solid rgba(37,162,68,.25); border-radius:var(--radius-pill); padding:.2rem .6rem; animation:badgePulse 2s ease-in-out infinite; }
@keyframes badgePulse { 0%,100%{box-shadow:0 0 0 0 rgba(37,162,68,.3);}50%{box-shadow:0 0 0 6px rgba(37,162,68,0);} }

/* ── PILLS ── */
.feature-pills { display:flex; flex-wrap:wrap; gap:.4rem; }
.pill { font-size:.8rem; font-weight:600; background:rgba(255,255,255,.88); backdrop-filter:blur(6px); border:1px solid var(--wb-line); border-radius:var(--radius-pill); padding:.35rem .75rem; color:var(--wb-ink); white-space:nowrap; }
.pop-pill { opacity:0; transform:scale(.7); }
.is-active .pop-pill { animation:popIn .45s cubic-bezier(.34,1.7,.64,1) calc(.7s + var(--d)) forwards; }

/* ═══ S1 — AIRPORT ═══ */
.s1 { background:linear-gradient(160deg,#b8ddf5 0%,#d4edfc 35%,#fef6e8 70%); }
.s1-sky { position:absolute; inset:0; background:radial-gradient(ellipse 120% 60% at 70% 40%,rgba(255,220,150,.35) 0%,transparent 70%); animation:skyGlow 6s ease-in-out infinite; }
@keyframes skyGlow { 0%,100%{opacity:.6;}50%{opacity:1;} }
.s1-plane { position:absolute; font-size:clamp(3.5rem,9vw,8rem); right:5%; top:50%; transform:translateY(-50%); filter:drop-shadow(0 10px 30px rgba(0,0,0,.12)); animation:planeFloat 7s ease-in-out infinite; z-index:2; }
@keyframes planeFloat { 0%,100%{transform:translateY(-50%) rotate(-3deg) scale(1);}25%{transform:translateY(calc(-50% - 18px)) rotate(2deg) scale(1.04);}75%{transform:translateY(calc(-50% + 10px)) rotate(-5deg) scale(.97);} }
.s1-clouds { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
.cloud-wrap { position:absolute; animation:cloudScroll 20s linear infinite; }
.cloud { font-size:clamp(1.8rem,4vw,3.5rem); opacity:.65; }
.cw1{top:8%;left:-8%;animation-duration:22s;animation-delay:0s;}
.cw2{top:22%;left:-5%;animation-duration:18s;animation-delay:-6s;}
.cw3{top:14%;left:-12%;animation-duration:26s;animation-delay:-12s;}
.cw4{top:30%;left:-6%;animation-duration:20s;animation-delay:-4s;font-size:1.6rem;opacity:.4;}
@keyframes cloudScroll { to{transform:translateX(110vw);} }
.s1-runway { position:absolute; bottom:0; left:0; right:0; height:25%; background:linear-gradient(to top,#c8c2b8 0%,rgba(200,194,184,0) 100%); overflow:hidden; display:flex; align-items:center; justify-content:center; gap:40px; }
.runway-line { width:60px; height:8px; background:rgba(255,255,255,.6); border-radius:4px; animation:runwayScroll 1.2s linear infinite; }
.runway-line:nth-child(2){animation-delay:.24s;}
.runway-line:nth-child(3){animation-delay:.48s;}
.runway-line:nth-child(4){animation-delay:.72s;}
.runway-line:nth-child(5){animation-delay:.96s;}
@keyframes runwayScroll { from{transform:translateX(120px);opacity:0;}40%{opacity:1;}to{transform:translateX(-120px);opacity:0;} }

/* ═══ S2 — HOTEL ═══ */
.s2 { background:linear-gradient(180deg,#87ceeb 0%,#b0dff0 30%,#e0f4f0 55%,#d4e8c0 100%); }
.s2-sky { position:absolute; inset:0; background:radial-gradient(ellipse 80% 50% at 60% 20%,rgba(255,180,60,.25) 0%,transparent 70%); animation:skyShift 8s ease-in-out infinite; }
@keyframes skyShift { 0%,100%{opacity:.8;}50%{opacity:1;} }
.s2-sun { position:absolute; font-size:clamp(2.5rem,7vw,6rem); right:12%; top:8%; animation:sunGlow 4s ease-in-out infinite; z-index:1; }
