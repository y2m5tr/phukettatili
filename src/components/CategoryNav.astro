---
import { getCollection } from 'astro:content';

interface Props {
  currentCategorySlug?: string;
}

// Prop currentCategorySlug is accepted for interface compatibility with existing pages
const categories = (await getCollection('categories')).sort((a: any, b: any) => a.data.order - b.data.order);
---

<nav class="category-nav" aria-label="Tur kategorileri">
  <div class="category-container">
    {categories.map((cat: any) => {
      const totalItems = cat.data.children.length;
      return (
        <div class="category-card" data-category={cat.data.slug}>
          <div class="category-header">
            <div class="category-icon">{cat.data.icon}</div>
            <h3 class="category-title">{cat.data.label_tr}</h3>
            <span class="category-count">{totalItems}</span>
          </div>
          
          <p class="category-description">{cat.data.short_desc}</p>
          
          <div class="category-subgrid">
            {cat.data.children.slice(0, 4).map((child: any) => (
              <a href={`/tur-kategorisi/${child.slug}/`} class="category-subitem" data-category={cat.data.slug}>
                <span class="subitem-dot"></span>
                <span>{child.label_tr}</span>
              </a>
            ))}
            {totalItems > 4 && (
              <a href={`/tur-kategorisi/${cat.data.slug}/`} class="category-more" data-category={cat.data.slug}>
                +{totalItems - 4} daha
              </a>
            )}
          </div>
        </div>
      );
    })}
  </div>
</nav>

<style>
.category-nav {
  margin-top: var(--space-2xl);
}

.category-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-lg);
  max-width: 75rem;
  margin-inline: auto;
}

.category-card {
  background: var(--wb-warm-white);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  border: 1px solid var(--wb-line);
}

.category-card:hover {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  transform: translateY(-2px);
}

.category-header {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-sm);
}

.category-icon {
  font-size: 1.5rem;
  filter: grayscale(0.3);
  flex-shrink: 0;
}

.category-title {
  font-family: var(--font-body);
  font-size: 1.125rem;
  font-weight: 600;
  margin: 0;
  color: var(--wb-ink);
  flex: 1;
  line-height: 1.3;
}

.category-count {
  background: var(--wb-clay);
  color: var(--wb-warm-white);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  display: block;
  text-align: center;
  line-height: 1;
  width: 32px;
  height: 32px;
}

.category-description {
  color: var(--wb-olive);
  font-size: 0.9375rem;
  line-height: 1.5;
  margin-bottom: var(--space-md);
}

.category-subgrid {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid var(--wb-line);
  margin-top: auto;
}

.category-subitem,
.category-more {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  color: var(--wb-ink);
  text-decoration: none;
  font-size: 0.875rem;
  transition: all 0.2s ease;
}

.category-subitem:hover,
.category-more:hover {
  color: var(--wb-clay);
  padding-left: 6px;
}

.subitem-dot {
  width: 6px;
  height: 6px;
  background: var(--wb-clay);
  border-radius: 50%;
  flex-shrink: 0;
}

.category-more {
  color: var(--wb-clay);
  font-weight: 500;
  padding-top: 4px;
  border-top: 1px dashed var(--wb-line);
  margin-top: 4px;
}

.category-more:hover {
  color: var(--wb-clay);
  text-decoration: underline;
}

/* Responsive Styles */
@media (max-width: 1200px) {
  .category-container {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .category-container {
    grid-template-columns: 1fr;
  }
  
  .category-card {
    padding: var(--space-md);
  }
  
  .category-icon {
    font-size: 1.375rem;
  }
  
  .category-title {
    font-size: 1rem;
  }
  
  .category-description {
    font-size: 0.9375rem;
  }
}

@media (max-width: 480px) {
  .category-card {
    padding: var(--space-sm);
  }
  
  .category-title {
    font-size: 0.9375rem;
  }
  
  .category-subitem {
    font-size: 0.8125rem;
  }
}

/* Reduced Motion Support */
@media (prefers-reduced-motion: reduce) {
  .category-card {
    transition: none;
  }
}
</style>