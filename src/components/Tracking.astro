---
/**
 * PAZARLAMA VE TAKİP KODLARI (ANALYTICS & PIXEL)
 * 
 * Sitenize Google Analytics veya Meta (Facebook) Pixel kurduğunuzda
 * size verilen ID numaralarını aşağıdaki değişkenlere yapıştırmanız yeterlidir.
 * Eğer ID boş bırakılırsa, o takip kodu çalışmayacaktır (siteyi yavaşlatmaz).
 */

// 1. Google Analytics (GA4) ID'niz (Örn: "G-1234567890")
const GOOGLE_ANALYTICS_ID = "";

// 2. Meta (Facebook) Pixel ID'niz (Örn: "123456789012345")
const META_PIXEL_ID = "";
---

{/* ================= GOOGLE ANALYTICS ================= */}
{GOOGLE_ANALYTICS_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_ID}`}></script>
    <script is:inline define:vars={{ id: GOOGLE_ANALYTICS_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', id);
    </script>
  </>
)}

{/* ================= META (FACEBOOK) PIXEL ================= */}
{META_PIXEL_ID && (
  <script is:inline define:vars={{ id: META_PIXEL_ID }}>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', id);
    fbq('track', 'PageView');
  </script>
)}
