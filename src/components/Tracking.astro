---
const gaId = import.meta.env.PUBLIC_GA_ID || 'G-40W78BJ6BD';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || '1413248243676873';
const hasTracking = Boolean(gaId || metaPixelId);
---

{hasTracking && (
  <div
    id="tracking-consent"
    data-ga-id={gaId}
    data-meta-pixel-id={metaPixelId}
    class="fixed bottom-20 sm:bottom-4 left-3 right-3 sm:left-auto sm:right-6 sm:max-w-md z-[65] hidden rounded-2xl border border-slate-200/90 bg-white/95 backdrop-blur-md p-3.5 text-slate-800 shadow-2xl dark:border-slate-700/80 dark:bg-slate-900/95 dark:text-white"
    role="dialog"
    aria-labelledby="tracking-consent-title"
  >
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="text-base shrink-0" aria-hidden="true">🍪</span>
        <p id="tracking-consent-title" class="text-xs text-slate-600 dark:text-slate-300 leading-snug">
          Deneyiminizi geliştirmek için çerezleri kullanıyoruz.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <button
          id="tracking-reject"
          type="button"
          class="min-h-[44px] min-w-[44px] px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex items-center justify-center cursor-pointer"
        >
          Reddet
        </button>
        <button
          id="tracking-accept"
          type="button"
          class="min-h-[44px] px-4 py-2.5 rounded-xl bg-brand-primary text-xs font-bold text-white hover:bg-brand-amber transition-colors shadow-sm flex items-center justify-center cursor-pointer"
        >
          Kabul Et
        </button>
      </div>
    </div>
  </div>
)}

<script>
  import { syncUtmFromCurrentUrl, getStoredUtm, enrichWhatsAppUrl, formatCampaignRef } from '../lib/marketing/utmTracker';

  declare global {
    interface Window {
      dataLayer: any[];
      gtag: (...args: any[]) => void;
      fbq: any;
    }
  }

  const key = 'tracking-consent-v1';
  const initialize = () => {
    // Sayfa açılışında gelen UTM parametrelerini hafızaya al
    const activeUtm = syncUtmFromCurrentUrl();

    const panel = document.getElementById('tracking-consent');
    if (!panel) return;

    // WhatsApp lead takibi: sitenin iş modeli WhatsApp üzerinden kapandığı
    // için tüm wa.me tıklamaları GA/Meta'ya dönüşüm eventi olarak akar.
    // Delegasyon ile tek listener — anasayfa CTA'ları, tur detay sidebar'ı,
    // mobil sabit bar, footer, destek widget'ı vb. hepsini kapsar.
    const trackWhatsAppLead = (target: Element | null) => {
      if (!target) return;
      const anchor = target.closest('a[href*="wa.me/"], a[href*="api.whatsapp.com"]') as HTMLAnchorElement | null;
      if (!anchor) return;

      const currentUtm = getStoredUtm() || activeUtm;

      // WhatsApp linkini kampanya referans koduyla zenginleştir
      if (anchor.href && currentUtm) {
        anchor.href = enrichWhatsAppUrl(anchor.href, currentUtm);
      }

      // En yakın [data-wa-lead-source] bağlamı; yoksa sayfa yolundan kaynak çıkar.
      const ctxEl = anchor.closest('[data-wa-lead-source]') as HTMLElement | null;
      const source = ctxEl?.dataset.waLeadSource
        || anchor.dataset.waLeadSource
        || document.body.dataset.waLeadSource
        || location.pathname;

      const payload = {
        link_url: anchor.href,
        lead_source: source,
        page_path: location.pathname + location.search,
        campaign_ref: formatCampaignRef(currentUtm),
        utm_source: currentUtm?.utm_source,
        utm_campaign: currentUtm?.utm_campaign,
        utm_medium: currentUtm?.utm_medium,
      };

      window.gtag?.('event', 'whatsapp_lead', payload);
      window.gtag?.('event', 'generate_lead', payload);
      // Meta Pixel için birincil Lead ve Contact dönüşümü
      window.fbq?.('track', 'Lead', payload);
      window.fbq?.('track', 'Contact', payload);
    };

    if (!document.body.dataset.waLeadBound) {
      document.body.dataset.waLeadBound = 'true';
      document.body.addEventListener('click', (e) => {
        trackWhatsAppLead(e.target as Element | null);
      });
    }

    const load = () => {
      const gaId = panel.dataset.gaId;
      const pixelId = panel.dataset.metaPixelId;

      if (gaId && !document.querySelector('[data-ga-loaded]')) {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
        script.dataset.gaLoaded = 'true';
        document.head.append(script);

        window.dataLayer = window.dataLayer || [];
        window.gtag = (...args: any[]) => window.dataLayer.push(args);
        window.gtag('js', new Date());
        window.gtag('config', gaId);

        document.addEventListener('astro:page-load', () => {
          window.gtag?.('event', 'page_view', {
            page_location: location.href,
            page_path: location.pathname + location.search,
            page_title: document.title,
          });
        });
      }

      if (pixelId && !window.fbq) {
        const fbq: any = (...args: any[]) => {
          fbq.queue.push(args);
        };
        fbq.queue = [];
        window.fbq = fbq;
        window.fbq('init', pixelId);
        window.fbq('track', 'PageView');

        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://connect.facebook.net/en_US/fbevents.js';
        document.head.append(script);

        document.addEventListener('astro:page-load', () => {
          window.fbq?.('track', 'PageView');
        });
      }
    };

    let consent: string | null = null;
    try {
      consent = localStorage.getItem(key);
    } catch {
      /* Storage unavailable */
    }

    if (consent === 'accepted') {
      load();
    } else if (consent !== 'rejected') {
      panel.classList.remove('hidden');
    }

    document.getElementById('tracking-accept')?.addEventListener('click', () => {
      try {
        localStorage.setItem(key, 'accepted');
      } catch {}
      panel.classList.add('hidden');
      load();
    }, { once: true });

    document.getElementById('tracking-reject')?.addEventListener('click', () => {
      try {
        localStorage.setItem(key, 'rejected');
      } catch {}
      panel.classList.add('hidden');
    }, { once: true });
  };

  document.addEventListener('astro:page-load', initialize);
</script>
