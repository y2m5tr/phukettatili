---
import siteSettings from '../content/settings/site.json';
const currentYear = new Date().getFullYear();
const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
const email = siteSettings?.email || 'info@phukettatili.com';
const instagramUrl = siteSettings?.instagramUrl || 'https://instagram.com/phukettatili';
---
<footer class="bg-brand-primary text-slate-300 py-16 mt-auto border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="col-span-1 md:col-span-2">
      <div class="flex items-center gap-3 mb-6">
        <img src="/assets/logo-main-transparent.png" alt="Phuket Tatili Logo" class="h-16 w-auto object-contain brightness-0 invert opacity-90" />
        <h3 class="font-serif text-3xl text-white">Phuket <span class="text-brand-gold italic">Tatili</span></h3>
      </div>
      <p class="text-sm font-light leading-relaxed max-w-sm mb-6 text-slate-400">
        Tayland'ın en güzel adalarında unutulmaz anılar biriktirin. Özel turlar, VIP hizmetler ve 7/24 Türkçe rehberlik ile ayrıcalıklı bir tatil deneyimi.
      </p>
    </div>
    
    <div>
      <h4 class="text-white font-bold mb-4 font-serif text-lg">Turlar & Hizmetler</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href="/turlar" class="hover:text-brand-gold transition-colors">Tüm Turlar</a></li>
        <li><a href="/vip" class="hover:text-brand-gold transition-colors">VIP Hizmetler</a></li>
        <li><a href="/transferler" class="hover:text-brand-gold transition-colors">Phuket Transferleri</a></li>
        <li><a href="/oteller" class="hover:text-brand-gold transition-colors">Otel & Konaklama</a></li>
        <li><a href="/paketler" class="hover:text-brand-gold transition-colors">Tatil Paketleri</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-bold mb-4 font-serif text-lg">Kurumsal & İletişim</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href="/hakkimizda" class="hover:text-brand-gold transition-colors">Hakkımızda</a></li>
        <li><a href="/blog" class="hover:text-brand-gold transition-colors">Phuket Rehberi & Blog</a></li>
        <li><a href="/iletisim" class="hover:text-brand-gold transition-colors">İletişim</a></li>
        <li><a href="/gizlilik-ve-kosullar" class="hover:text-brand-gold transition-colors">Gizlilik ve Koşullar</a></li>
        <li class="pt-2">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-brand-gold font-semibold hover:underline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            +{whatsappNumber}
          </a>
        </li>
        {email && (
          <li>
            <a href={`mailto:${email}`} class="inline-flex items-center gap-2 text-slate-400 hover:text-brand-gold transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              {email}
            </a>
          </li>
        )}
        {instagramUrl && (
          <li>
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-slate-400 hover:text-brand-gold transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              Instagram
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
  
  <div class="max-w-6xl mx-auto px-4 mt-12 pt-8 border-t border-slate-800 text-sm text-center text-slate-400">
    <p>&copy; {currentYear} {siteSettings?.siteTitle || 'Phuket Tatili'}. Tüm hakları saklıdır.</p>
  </div>
</footer>
