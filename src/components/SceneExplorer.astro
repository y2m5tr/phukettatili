---
const scenes = [
  {
    img: 'underwater.webp',
    alt: 'Phuket açıklarında berrak suda yüzen gezgin',
    small: 'Sualtı · Racha Yai',
    title: 'Mavinin altına in.',
    body: 'İlk deneyiminizse sakin, tecrübeliyseniz daha derin.',
    href: '/tur-kategorisi/sea-activities/',
    tabIcon: '🐠',
    tabLabel: 'Sualtı',
    tabSub: 'Racha Yai'
  },
  {
    img: 'beach.webp',
    alt: "Phuket'te turkuaz denizli sakin kumsal",
    small: 'Kıyı · Yavaş gün',
    title: 'Takvimi kıyıda unut.',
    body: 'Kalabalıktan uzak bir koy, iyi bir öğle yemeği.',
    href: '/tur-kategorisi/coral-island/',
    tabIcon: '🏖️',
    tabLabel: 'Sakin koylar',
    tabSub: 'Yavaş gün'
  },
  {
    img: 'pileh.webp',
    alt: "Pileh Lagoon'un dik kayalıkları",
    small: 'Tekne · Phi Phi',
    title: "Pileh'e herkesten önce.",
    body: 'Günün saatini doğru seçip lagünü en dingin anında görün.',
    href: '/tur-kategorisi/phi-phi-islands/',
    tabIcon: '🏝️',
    tabLabel: 'Ada rotası',
    tabSub: 'Phi Phi'
  },
  {
    img: 'family.webp',
    alt: 'Phuket sahilinde aile',
    small: 'Ailece · Esnek plan',
    title: 'Herkese iyi gelen gün.',
    body: 'Çocukların enerjisi ve sizin dinlenme isteğiniz dengede kalsın.',
    href: '/paketler/',
    tabIcon: '👨‍👩‍👧',
    tabLabel: 'Ailece',
    tabSub: 'Esnek plan'
  },
  {
    img: 'yacht.webp',
    alt: 'Premium yat atmosferi',
    small: 'VIP yat · Özel rota',
    title: 'Rotayı kendine ayır.',
    body: 'Yat, rota ve günün ritmi tamamen size göre netleşsin.',
    href: '/tur-kategorisi/private-charters/',
    tabIcon: '⛵',
    tabLabel: 'VIP yat',
    tabSub: 'Özel rota'
  },
  {
    img: 'beachclub.webp',
    alt: 'Phuket beach club gün batımı',
    small: 'Beach club · Gün batımı',
    title: 'Gün batınca tempo değişsin.',
    body: 'Masa, giriş ve koşullar yazılı olarak doğrulansın.',
    href: '/vip-ozel/',
    tabIcon: '🌅',
