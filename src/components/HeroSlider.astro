---
import { resolveAssetUrl, responsiveSrcset } from '../lib/assets';

interface Slide {
  src: string;
  alt: string;
  srcset?: string;
}

interface Props {
  customFirstImage?: string;
  sliderImages?: string[];
}

const { customFirstImage, sliderImages } = Astro.props;
const fallbackHeroImage = '/assets/phuket_hero.webp';
const resolvedFirstImage = resolveAssetUrl(
  customFirstImage || (sliderImages && sliderImages[0]) || fallbackHeroImage
);

const defaultSlides: Slide[] = [
  { src: resolvedFirstImage, alt: "Phuket Kumsalları ve Turkuaz Deniz", srcset: responsiveSrcset(resolvedFirstImage) },
  { src: '/assets/pileh.webp', alt: "Phi Phi Pi Leh Zümrüt Lagün" },
  { src: '/assets/yacht.webp', alt: "Lüks VIP Yat ve Katamaran Deneyimi" },
  { src: '/assets/longtail.webp', alt: "Geleneksel Longtail Rotaları" },
];

let slides: Slide[] = defaultSlides.map((s) => ({
  ...s,
  srcset: responsiveSrcset(s.src),
}));

if (sliderImages && sliderImages.length > 0) {
  slides = sliderImages.map((img, idx) => ({
    src: resolveAssetUrl(img),
    alt: `Phuket Tatili Karşılama Slayt ${idx + 1}`,
    srcset: responsiveSrcset(img),
  }));
} else if (customFirstImage) {
  const customSrc = resolvedFirstImage;
  slides = [
    { src: customSrc, alt: "Phuket Tatili Özel Karşılama", srcset: responsiveSrcset(customFirstImage) },
    ...defaultSlides.filter((s) => s.src !== customSrc).map((s) => ({
      ...s,
      srcset: responsiveSrcset(s.src),
    })),
  ];
}
---

<div id="hero-slider" class="absolute inset-0 z-0 overflow-hidden">
  {slides.map((slide, index) => (
    <div
      class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${
        index === 0 ? 'opacity-100 z-[1]' : 'opacity-0 z-0 pointer-events-none'
      }`}
      data-slide-index={index}
    >
      <img
        src={slide.src}
        srcset={slide.srcset}
        sizes="100vw"
        alt={slide.alt}
        class={`w-full h-full object-cover ${index % 2 === 0 ? 'animate-ken-burns' : 'animate-ken-burns-alt'}`}
        loading={index === 0 ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : 'auto'}
      />
    </div>
  ))}

  <!-- Okunurluk sağlayan yumuşak gradyan katmanı -->
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,.72)_0%,rgba(15,23,42,.34)_42%,rgba(2,6,23,.92)_100%)] z-10 pointer-events-none"></div>

  <!-- Slayt Göstergeleri -->
  <div class="absolute bottom-7 left-0 right-0 z-20 flex justify-center items-center gap-2">
    {slides.map((_, index) => (
      <button
        type="button"
        class={`hero-indicator h-1 rounded-full transition-all duration-500 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 ${
          index === 0 ? 'w-7 bg-brand-gold' : 'w-2 bg-white/45 hover:bg-white/80'
        }`}
        data-index={index}
        aria-label={`Slayt ${index + 1}`}
      />
    ))}
  </div>
</div>

<script>
  let heroInterval: ReturnType<typeof setInterval> | null = null;

  const setupHeroSlider = () => {
    if (heroInterval) {
      clearInterval(heroInterval);
      heroInterval = null;
    }

    const slider = document.getElementById('hero-slider');
    if (!slider) return;

    const slides = slider.querySelectorAll<HTMLElement>('.hero-slide');
    const indicators = slider.querySelectorAll<HTMLButtonElement>('.hero-indicator');
    if (slides.length <= 1) return;

    let currentIndex = 0;

    const goToSlide = (targetIndex: number) => {
      slides[currentIndex].classList.remove('opacity-100', 'z-[1]');
      slides[currentIndex].classList.add('opacity-0', 'z-0', 'pointer-events-none');
      indicators[currentIndex].classList.remove('w-7', 'bg-brand-gold');
      indicators[currentIndex].classList.add('w-2', 'bg-white/45');

      currentIndex = (targetIndex + slides.length) % slides.length;

      slides[currentIndex].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      slides[currentIndex].classList.add('opacity-100', 'z-[1]');
      indicators[currentIndex].classList.remove('w-2', 'bg-white/45');
      indicators[currentIndex].classList.add('w-7', 'bg-brand-gold');
    };

    const nextSlide = () => goToSlide(currentIndex + 1);

    heroInterval = setInterval(nextSlide, 5000);

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const targetIdx = Number(target.dataset.index || 0);
        goToSlide(targetIdx);

        if (heroInterval) {
          clearInterval(heroInterval);
          heroInterval = setInterval(nextSlide, 5000);
        }
      });
    });
  };

  document.addEventListener('astro:page-load', setupHeroSlider);
</script>
