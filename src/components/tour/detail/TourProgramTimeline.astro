---
import type { CollectionEntry } from 'astro:content';
import { resolveAssetUrl } from '../../../lib/assets';

interface Props {
  tour: CollectionEntry<'tours'>;
}
const { tour } = Astro.props;

function getContextualStepImage(desc: string, tourData: any, idx: number): string {
  const text = (desc || '').toLowerCase();
  const slug = (tour.id || '').toLowerCase();

  // 1. Otel & Karşılama
  if (idx === 0 || text.includes('otel') || text.includes('alınış') || text.includes('servis')) {
    return 'itinerary/hotel_transfer.webp';
  }
  if (text.includes('iskele') || text.includes('marina') || text.includes('brifing') || text.includes('karşılama') || text.includes('kahvaltı') || text.includes('atıştırmalık')) {
    return 'itinerary/pier_lounge.webp';
  }

  // 2. Özel Macera Turları
  if (slug.includes('atv') || text.includes('atv') || text.includes('quad')) {
    const atvImgs = ['atv-1.webp', 'atv-2.webp', 'atv-3.webp'];
    return atvImgs[idx % atvImgs.length];
  }
  if (slug.includes('fil') || text.includes('fil') || text.includes('kerchor')) {
    return 'itinerary/elephant_mud_bath.webp';
  }
  if (slug.includes('zipline') || slug.includes('hanuman') || text.includes('zipline') || text.includes('canopy')) {
    return 'itinerary/zipline_canopy_bridge.webp';
  }
  if (slug.includes('rafting') || text.includes('rafting') || text.includes('akarsu')) {
    return 'itinerary/whitewater_rafting_rapid.webp';
  }
  if (slug.includes('khao-sok') || text.includes('cheow lan') || text.includes('göl')) {
    return 'itinerary/cheow_lan_lake_raft.webp';
  }

  // 3. İkonik Rotalar (James Bond & Phang Nga)
  if (text.includes('james bond') || text.includes('khao tapu') || text.includes('khao phing')) {
    return 'james-bond-1.webp';
  }
  if (text.includes('panyi') || text.includes('yüzen köy')) {
    return 'itinerary/koh_panyi_stilt_village.webp';
  }
  if (text.includes('panak') || text.includes('hong') || text.includes('kano') || text.includes('mağara')) {
    return 'itinerary/sea_kayak_cave.webp';
  }

  // 4. Şov & Sahne Turları
  if (slug.includes('fantasea')) return 'phuket_fantasea.webp';
  if (slug.includes('carnival')) return 'carnival_magic.webp';
  if (slug.includes('simon')) return 'simon_cabaret.webp';
  if (slug.includes('siam-niramit')) return 'siam_niramit_cover.webp';

  // 5. Şehir ve Kültür
  if (text.includes('old town') || text.includes('şehir') || text.includes('sino')) {
    return 'itinerary/old_phuket_heritage.webp';
  }
  if (text.includes('buddha') || text.includes('wat') || text.includes('tapınak')) {
    return 'itinerary/big_buddha_temple.webp';
  }

  // 6. Similan & Surin
  if (text.includes('sailing rock') || text.includes('yelken kaya')) {
    return 'itinerary/sailing_rock_view.webp';
  }
  if (text.includes('kaplumbağa') || text.includes('turtle')) {
    return 'itinerary/sea_turtle_reef.webp';
  }

  // 7. Phi Phi & Maya Bay
  if (text.includes('maya bay') || text.includes('pileh') || text.includes('lagün')) {
    return 'itinerary/maya_bay_lagoon.webp';
  }
  if (text.includes('maymun') || text.includes('monkey')) {
    return 'itinerary/monkey_beach_wild.webp';
  }

  // 8. Şnorkel & Sualtı
  if (text.includes('şnorkel') || text.includes('resif') || text.includes('mercan') || text.includes('balık')) {
    return 'itinerary/tropical_reef_fish.webp';
  }

  // 9. Yemek & Mola
  if (text.includes('öğle yemeği') || text.includes('yemek') || text.includes('açık büfe')) {
    return 'itinerary/thai_buffet_lunch.webp';
  }

  // 10. Plaj & Deniz
  if (text.includes('plaj') || text.includes('kumsal') || text.includes('yüzme') || text.includes('paddleboard')) {
    return 'itinerary/white_sand_beach.webp';
  }

  // 11. Dönüş & Gün Batımı
  if (text.includes('dönüş') || text.includes('sunset') || text.includes('gün batımı')) {
    return 'itinerary/sunset_sea_cruise.webp';
  }

  // 12. Seyir & Tekne
  if (text.includes('sürat teknesi') || text.includes('katamaran') || text.includes('seyir')) {
    return 'itinerary/speedboat_sea.webp';
  }

  return tourData.image || 'itinerary/white_sand_beach.webp';
}
---

{tour.data.program && tour.data.program.length > 0 && (
  <div class="mt-16">
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">
      <div>
        <h3 class="text-2xl sm:text-3xl font-serif font-bold text-brand-primary dark:text-white">
          Tur Programı (Itinerary)
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Gününüzün adım adım saatlik akışı ve her duraktaki görsel deneyiminiz.
        </p>
      </div>
      <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary dark:text-brand-accent shrink-0">
        {tour.data.program.length} Aşama
      </span>
    </div>

    <div class="relative border-l-2 border-brand-accent/70 ml-4 space-y-8 pb-4">
      {tour.data.program.map((item, idx) => {
        const match = item.match(/^(\d{1,2}:\d{2})\s*[-–]\s*(.+)$/);
        const time = match ? match[1] : '';
        const desc = match ? match[2] : item;
        const rawImages = tour.data.program_images?.[idx];
        let stepImages: string[] = Array.isArray(rawImages)
          ? (rawImages.filter(Boolean) as string[])
          : (rawImages ? [rawImages as string] : []);

        if (stepImages.length === 0) {
          stepImages = [getContextualStepImage(desc, tour.data, idx)];
        }

        return (
          <div class="relative pl-7 sm:pl-9">
            <span class="absolute -left-[11px] top-1.5 w-5 h-5 rounded-full bg-brand-accent border-4 border-slate-50 dark:border-surface-1 shadow-xs"></span>
            <div class="bg-white dark:bg-slate-800/90 p-5 sm:p-6 rounded-2xl shadow-xs hover:shadow-md border border-slate-100 dark:border-slate-700/80 transition-shadow overflow-hidden">
              <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-start justify-between">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2.5">
                    {time && (
                      <span class="inline-flex items-center gap-1 bg-brand-accent/15 text-brand-accent font-extrabold px-3 py-0.5 rounded-full text-xs tracking-wide">
                        <span>🕒</span>
                        <span>{time.trim()}</span>
                      </span>
                    )}
                    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                      Aşama {idx + 1}
                    </span>
                  </div>
                  <p class="text-slate-700 dark:text-slate-200 text-sm sm:text-base m-0 leading-relaxed font-normal">
                    {desc.trim()}
                  </p>
                </div>

                {stepImages.length === 1 && (
                  <div
                    class="relative w-full sm:w-48 h-44 sm:h-32 shrink-0 rounded-2xl overflow-hidden group cursor-pointer gallery-trigger shadow-xs hover:shadow-md transition-all border border-slate-200/70 dark:border-slate-700/80"
                    data-index={`program-${idx}-0`}
                    data-src={resolveAssetUrl(stepImages[0])}
                    aria-label={`${tour.data.title} program fotoğrafı ${idx + 1}`}
                    role="button"
                    tabindex="0"
                  >
                    <img
                      src={resolveAssetUrl(stepImages[0])}
                      alt={`${tour.data.title} — ${desc.trim().slice(0, 60)}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-between p-2.5">
                      <span class="text-[11px] font-semibold text-white flex items-center gap-1">
                        <span>🔍</span> Büyüt
                      </span>
                      <span class="text-[10px] text-white/80 bg-white/20 backdrop-blur-xs px-2 py-0.5 rounded-md">
                        Fotoğraf
                      </span>
                    </div>
                  </div>
                )}

                {stepImages.length > 1 && (
                  <div class="flex flex-wrap sm:flex-nowrap gap-2 shrink-0 pt-2 sm:pt-0 w-full sm:w-auto">
                    {stepImages.map((img, imgIdx) => (
                      <div
                        class="relative w-24 sm:w-28 h-20 sm:h-24 rounded-xl overflow-hidden group cursor-pointer gallery-trigger shadow-xs hover:shadow-md transition-all border border-slate-100 dark:border-slate-700"
                        data-index={`program-${idx}-${imgIdx}`}
                        data-src={resolveAssetUrl(img)}
                        aria-label={`${tour.data.title} program fotoğrafı ${idx + 1}.${imgIdx + 1}`}
                        role="button"
                        tabindex="0"
                      >
                        <img
                          src={resolveAssetUrl(img)}
                          alt={`${tour.data.title} — ${desc.trim().slice(0, 60)} (${imgIdx + 1})`}
                          loading="lazy"
                          decoding="async"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        />
                        <span class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded-md bg-black/65 backdrop-blur-xs text-[10px] text-white font-medium">
                          {imgIdx + 1}/{stepImages.length}
                        </span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
