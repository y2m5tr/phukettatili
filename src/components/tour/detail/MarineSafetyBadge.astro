---
import { getMarineSafetyStatus, type MarineSafetyReport } from '../../../lib/marineWeather';

interface Props {
  tourCategory?: string;
  tourTitle?: string;
}

const { tourCategory, tourTitle = '' } = Astro.props;

// Yalnızca ada ve deniz turları için göster (kültür ve kara turlarında gereksiz kalabalık yapmaz)
const isMarineTour =
  tourCategory === 'island-tours' ||
  /phi phi|james bond|similan|racha|coral|hong|rok|surin|tekne|yacht|katamaran|speedboat|longtail/i.test(tourTitle);

let marineReport: MarineSafetyReport | null = null;
if (isMarineTour) {
  try {
    marineReport = await getMarineSafetyStatus();
  } catch {}
}
---

{isMarineTour && marineReport && (
  <div class="mb-5 p-4 rounded-2xl bg-sky-500/10 dark:bg-sky-500/15 border border-sky-500/25 space-y-2.5">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-xs font-semibold text-sky-800 dark:text-sky-300">
        <span class="relative flex h-2 w-2">
          <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
        </span>
        <span>Andaman Denizi &bull; Canlı Seyir Durumu</span>
      </div>
      <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">
        Tayland Liman Bşk.
      </span>
    </div>

    <div class="flex items-baseline gap-2">
      {marineReport.level === 'calm' && (
        <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Seyir Koşulları Mükemmel (Deniz Sakin)</span>
        </span>
      )}
      {marineReport.level === 'moderate' && (
        <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-amber-700 dark:text-amber-300">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>Orta Dalgalı: Turlar Rutin Devam Ediyor</span>
        </span>
      )}
      {marineReport.level === 'severe' && (
        <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-rose-700 dark:text-rose-300">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          <span>Dalga Uyarısı: Korunaklı Rotalar Açık</span>
        </span>
      )}
    </div>

    <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600 dark:text-slate-300 bg-white/70 dark:bg-slate-900/60 p-2.5 rounded-xl border border-sky-500/15">
      <div>
        <span class="text-slate-400 block text-[10px]">Öngörülen Dalga:</span>
        <strong class="text-slate-800 dark:text-slate-200">{marineReport.waveHeightMeters} metre</strong>
      </div>
      <div>
        <span class="text-slate-400 block text-[10px]">Rüzgar Hızı:</span>
        <strong class="text-slate-800 dark:text-slate-200">{marineReport.windSpeedKnots} knot ({marineReport.windDirectionText})</strong>
      </div>
    </div>

    <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed italic flex items-start gap-1">
      <svg aria-hidden="true" class="w-3.5 h-3.5 text-sky-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
      <span><strong>Hava Güvencesi:</strong> Liman Başkanlığı fırtına nedeniyle tur çıkışını durdurursa %100 kesintisiz para iadesi veya ücretsiz tarih değişikliği yapılır.</span>
    </p>
  </div>
)}
