---
import type { CollectionEntry } from 'astro:content';
import { resolveAssetUrl } from '../../../lib/assets';
import { fmtMoney } from '../../../lib/moneyFormat';

interface Props {
  tour: CollectionEntry<'tours'>;
  relatedTours: CollectionEntry<'tours'>[];
}
const { tour, relatedTours } = Astro.props;
---

<!-- Related Tours (same category, SEO cross-links) -->
{relatedTours.length > 0 && (
  <section class="py-16 bg-white dark:bg-surface-1 px-4 border-t border-slate-100 dark:border-slate-800">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8 gap-4">
        <div class="min-w-0 flex-1">
          <h2 class="related-tour-title text-2xl md:text-3xl font-serif font-bold text-brand-primary dark:text-white break-words">
            {tour.data.category_label || 'Aynı Kategoride'} Turları
          </h2>
        </div>
        <a href={`/turlar/?kategori=${tour.data.category}`} class="text-sm font-semibold text-brand-accent hover:underline whitespace-nowrap shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent rounded-lg px-2 py-1">
          Tümünü İncele
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedTours.map((t) => (
          <a href={`/turlar/${t.id}`} class="premium-card group block rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-sm hover:shadow-md transition-shadow duration-300 border border-slate-200/80 dark:border-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent">
            <div class="relative h-44 overflow-hidden">
              <img
                src={resolveAssetUrl(t.data.image)}
                alt={t.data.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-brand-primary/10 group-hover:bg-transparent transition-colors duration-300"></div>
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold text-brand-primary dark:text-white group-hover:text-brand-accent transition-colors line-clamp-1">{t.data.title}</h3>
              <p class="text-slate-600 dark:text-slate-300 text-sm mt-1.5 line-clamp-2">{t.data.excerpt}</p>
              <div class="flex justify-between items-center border-t border-slate-100 dark:border-slate-700 pt-3 mt-3">
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{t.data.duration || 'Tam Gün'}</span>
                {t.data.price_thb && t.data.price_thb > 0 ? (
                  <span class="text-sm font-bold text-brand-primary dark:text-white" data-thb-price={t.data.price_thb} data-price-label="kişi başı">{fmtMoney(t.data.price_thb)} THB</span>
                ) : (
                  <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-500/15 px-2.5 py-1 rounded-full">Özel Teklif</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .related-tour-title {
    overflow-wrap: break-word;
  }
</style>
