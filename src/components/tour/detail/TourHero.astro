---
import type { CollectionEntry } from 'astro:content';
import { resolveAssetUrl, responsiveSrcset } from '../../../lib/assets';
import { fmtMoney } from '../../../lib/moneyFormat';

interface Props {
  tour: CollectionEntry<'tours'>;
  weeklyViewCount: number;
}
const { tour, weeklyViewCount } = Astro.props;
---

<!-- Hero Section for Tour -->
<section class="relative h-[60dvh] min-h-[420px] flex items-end pb-12">
  <div class="absolute inset-0 z-0">
    <img
      src={resolveAssetUrl(tour.data.image)}
      srcset={responsiveSrcset(tour.data.image)}
      sizes="100vw"
      alt={tour.data.title}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover motion-safe:animate-ken-burns"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-surface-1 via-surface-1/50 to-transparent z-10"></div>
  </div>

  <div class="relative z-20 max-w-6xl mx-auto px-4 w-full">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <span class="inline-block bg-brand-accent text-white px-3.5 py-1 rounded-full text-sm font-semibold shadow-md">
        {tour.data.category_label || tour.data.category}
      </span>
      <!-- Sosyal Kanıt & Canlı İlgi Rozeti -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900/80 border border-amber-400/40 text-amber-200 text-xs font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 motion-safe:animate-pulse"></span>
        <span>Bu hafta {weeklyViewCount} gezgin inceledi &bull; Son rezervasyon Patong</span>
      </div>
    </div>

    <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-black text-white mb-3 sm:mb-4 drop-shadow-md leading-tight">
      {tour.data.title}
    </h1>
    <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-slate-200">
      {tour.data.duration && (
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span class="font-medium">{tour.data.duration}</span>
        </div>
      )}
      {tour.data.price_thb && tour.data.price_thb > 0 ? (
        <div class="flex items-center gap-2 font-bold text-2xl text-white drop-shadow-md">
          <span data-thb-price={tour.data.price_thb} data-price-label="kişi başı">{fmtMoney(tour.data.price_thb)} THB</span>
          <span class="text-xs font-medium text-slate-300 bg-slate-900/80 px-2.5 py-0.5 rounded-full border border-white/20">kişi başı</span>
        </div>
      ) : (
        <div class="flex items-center gap-2 font-semibold text-sm sm:text-base text-emerald-300 bg-slate-900/80 px-3.5 py-1.5 rounded-full border border-emerald-400/40">
          <span class="w-2 h-2 rounded-full bg-emerald-400 motion-safe:animate-pulse"></span>
          <span>WhatsApp ile Özel Fiyat Teklifi</span>
        </div>
      )}

      <!-- Tatil Planıma / Favorilere Ekle Butonu -->
      <button
        type="button"
        class="ptt-wishlist-btn inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/80 hover:bg-slate-800 active:bg-slate-950 text-white font-semibold text-xs border border-white/25 cursor-pointer shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
        data-tour-id={tour.id}
        onclick={`event.preventDefault(); window.togglePttShortlist && window.togglePttShortlist({ id: '${tour.id}', title: ${JSON.stringify(tour.data.title)}, image: '${tour.data.image || ''}', duration: '${tour.data.duration || 'Tam Gün'}', category: '${tour.data.category_label || tour.data.category || ''}' });`}
        title="Tatil Planıma Ekle"
        aria-label="Bu turu tatil planıma ekle"
      >
        <svg aria-hidden="true" class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        <span>Tatil Planıma Ekle</span>
      </button>
    </div>

    <!-- Mobil & Masaüstü Hızlı Aksiyon & Risk Tersine Çevirme Rozetleri -->
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <a
        href="#booking-sidebar"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-whatsapp hover:bg-whatsapp-dark active:bg-whatsapp-dark text-white font-semibold text-xs sm:text-sm shadow-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>WhatsApp ile Fiyat & Müsaitlik Al</span>
      </a>

      <div class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-slate-900/80 border border-white/20 text-slate-200 text-xs font-medium">
        <svg aria-hidden="true" class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        <span>Kötü Hava & Fırtına %100 İade Garantisi</span>
      </div>

      <div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-full bg-slate-900/80 border border-white/20 text-slate-200 text-xs font-medium">
        <svg aria-hidden="true" class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        <span>Milli Park & Transfer Dahil</span>
      </div>
    </div>
  </div>
</section>
