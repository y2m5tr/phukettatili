---
import { getMarineSafetyStatus } from '../../lib/marineWeather';

let report = null;
try {
  report = await getMarineSafetyStatus();
} catch {
  report = null;
}

const isCalm = report?.level === 'calm';
const statusText = isCalm ? 'Deniz Sakin' : 'Deniz Hareketli';
---

<!-- Canlı Phuket Durum Butonu (Sadece Tetikleyici - Modal Root Seviyesindedir) -->
<button
  type="button"
  id="phuket-status-pill-btn"
  class="group inline-flex items-center gap-1.5 py-1 px-2 sm:px-2.5 rounded-full bg-slate-900/60 dark:bg-slate-800/80 hover:bg-slate-900/85 dark:hover:bg-slate-700/80 text-white backdrop-blur-md border border-white/10 shadow-xs transition-all active:scale-95 cursor-pointer shrink-0"
  title="Canlı Phuket Deniz ve Hava Durumu Raporunu Gör"
  aria-label="Canlı Phuket Deniz ve Hava Durumu"
>
  <!-- Canlı Yanıp Sönen Yeşil Nokta -->
  <span class="relative flex h-2 w-2 shrink-0">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
  </span>

  <!-- Canlı Phuket Saati -->
  <span id="live-phuket-clock" class="font-mono font-bold text-amber-300 tracking-tight text-xs">
    17:00
  </span>

  <span class="text-white/30 text-[10px]">·</span>

  <!-- Hava & Deniz Özeti -->
  <span class="text-[11px] font-medium text-slate-200 group-hover:text-white flex items-center gap-1">
    <span>☀️ 31°C</span>
    <span class="hidden md:inline text-slate-300">· {statusText}</span>
  </span>

  <svg class="w-3 h-3 text-white/50 group-hover:text-white transition-transform group-hover:translate-x-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
  </svg>
</button>

<script>
  function setupLiveClockPill() {
    // 1. Canlı Phuket Saati (Asia/Bangkok = UTC+7)
    const clockEl = document.getElementById('live-phuket-clock');
    const updateTime = () => {
      if (!clockEl) return;
      try {
        const phuketTimeStr = new Intl.DateTimeFormat('tr-TR', {
          timeZone: 'Asia/Bangkok',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }).format(new Date());
        clockEl.textContent = phuketTimeStr;
      } catch {
        clockEl.textContent = '17:00';
      }
    };
    updateTime();
    setInterval(updateTime, 10000);

    // 2. Tıklandığında Root Seviyesindeki Modalı Tetikle
    const pillBtn = document.getElementById('phuket-status-pill-btn');
    pillBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('ptt:weather-modal:open'));
    });
  }

  document.addEventListener('astro:page-load', setupLiveClockPill);
</script>
