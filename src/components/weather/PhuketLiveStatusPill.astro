---
import { getMarineSafetyStatus } from '../../lib/marineWeather';

let report = null;
try {
  report = await getMarineSafetyStatus();
} catch {
  report = null;
}

const isCalm = report?.level === 'calm';
const statusText = isCalm ? 'Deniz Sakin' : 'Deniz Hareketli';
---

<!-- Canlı Phuket Durum Butonu (Sadece Tetikleyici - Modal Root Seviyesindedir) -->
<button
  type="button"
  id="phuket-status-pill-btn"
  class="group inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full bg-slate-900/90 dark:bg-slate-800 text-white border border-slate-700/80 shadow-xs transition-colors hover:bg-slate-800 dark:hover:bg-slate-700 active:bg-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent cursor-pointer shrink-0 whitespace-nowrap"
  title="Canlı Phuket Deniz ve Hava Durumu Raporunu Gör"
  aria-label="Canlı Phuket Deniz ve Hava Durumu"
>
  <!-- Canlı Yanıp Sönen Yeşil Nokta -->
  <span class="relative flex h-2 w-2 shrink-0">
    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
  </span>

  <!-- Canlı Phuket Saati -->
  <span id="live-phuket-clock" class="font-mono font-bold text-amber-300 tracking-tight text-xs">
    17:00
  </span>

  <span class="text-white/30 text-[10px]" aria-hidden="true">|</span>

  <!-- Hava & Deniz Özeti -->
  <span class="text-[11px] font-medium text-slate-200 group-hover:text-white flex items-center gap-1">
    <svg aria-hidden="true" class="w-3.5 h-3.5 text-amber-300 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" /></svg>
    <span>31°C</span>
    <span class="hidden md:inline text-slate-300">({statusText})</span>
  </span>

  <svg aria-hidden="true" class="w-3 h-3 text-white/50 group-hover:text-white transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
  </svg>
</button>

<script>
  function setupLiveClockPill() {
    // 1. Canlı Phuket Saati (Asia/Bangkok = UTC+7)
    const clockEl = document.getElementById('live-phuket-clock');
    const updateTime = () => {
      if (!clockEl) return;
      try {
        const phuketTimeStr = new Intl.DateTimeFormat('tr-TR', {
          timeZone: 'Asia/Bangkok',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        }).format(new Date());
        clockEl.textContent = phuketTimeStr;
      } catch {
        clockEl.textContent = '17:00';
      }
    };
    updateTime();
    setInterval(updateTime, 10000);

    // 2. Tıklandığında Root Seviyesindeki Modalı Tetikle
    const pillBtn = document.getElementById('phuket-status-pill-btn');
    pillBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('ptt:weather-modal:open'));
    });
  }

  document.addEventListener('astro:page-load', setupLiveClockPill);
</script>
