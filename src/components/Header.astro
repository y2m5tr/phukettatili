---
import siteSettingsJson from '../content/settings/site.json';
import { getPublicHomeContent, mergeSiteSettings } from '../lib/server/homeSettings';
import { resolveAssetUrl } from '../lib/assets';
import TopAnnouncementBar from './TopAnnouncementBar.astro';

let siteSettings: Record<string, any> = siteSettingsJson;
try {
  const panelContent = await getPublicHomeContent();
  siteSettings = mergeSiteSettings(siteSettingsJson, panelContent.siteSettings) as Record<string, any>;
} catch {}

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const logoUrl = siteSettings?.logoUrl || '/assets/logo-main-transparent.png';
const logoText = (siteSettings?.logoText || 'Phuket Tatili').trim();
const lastSpaceIdx = logoText.lastIndexOf(' ');
const logoFirstPart = lastSpaceIdx !== -1 ? logoText.substring(0, lastSpaceIdx) : logoText;
const logoAccentPart = lastSpaceIdx !== -1 ? logoText.substring(lastSpaceIdx + 1) : '';
---
<header id="site-header" class="fixed w-full top-0 z-50 transition-all duration-500 bg-white/90 dark:bg-surface-1/95 backdrop-blur-xl border-b border-slate-200/50 dark:border-slate-800/80 shadow-sm">
  <TopAnnouncementBar />
  <div class="max-w-7xl mx-auto px-6">
    <div class="header-inner flex items-center justify-between h-20 transition-all duration-300">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group mr-8 lg:mr-12 xl:mr-16">
        <img
          src={resolveAssetUrl(logoUrl, '/assets/logo-main-transparent.png')}
          alt={`${logoText} Logo`}
          width="460"
          height="340"
          decoding="async"
          class="header-logo-img h-14 lg:h-16 w-auto object-contain group-hover:scale-105 transition-all duration-300"
        />
        {logoText && (
          <span class="font-serif text-2xl lg:text-3xl font-bold text-brand-primary dark:text-white tracking-tight whitespace-nowrap">
            {logoFirstPart}{' '}
            {logoAccentPart && <span class="text-brand-accent italic">{logoAccentPart}</span>}
          </span>
        )}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-6 xl:gap-7">
        <a href="/" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">Ana Sayfa</a>

        {/* Turlar Dropdown */}
        <div class="relative group py-2">
          <a href="/turlar" class="flex items-center gap-1 text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors">
            <span>Turlar</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto">
            <div class="w-72 p-2.5 bg-white/95 dark:bg-surface-1/95 backdrop-blur-xl rounded-2xl shadow-xl border border-slate-200/80 dark:border-slate-800 space-y-1">
              <a href="/turlar/?kategori=island-tours" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                <span class="text-base shrink-0">🏝️</span>
                <div>
                  <span class="block">Ada Turları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Phi Phi, James Bond, Similan</span>
                </div>
              </a>
              <a href="/turlar/?kategori=adventure-tours" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-emerald-500/10 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                <span class="text-base shrink-0">⚡</span>
                <div>
                  <span class="block">Macera & Doğa Turları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">ATV, Zipline, Rafting, Kano</span>
                </div>
              </a>
              <a href="/turlar/?kategori=entertainment-tours" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-purple-500/10 hover:text-purple-700 dark:hover:text-purple-400 transition-colors">
                <span class="text-base shrink-0">🎭</span>
                <div>
                  <span class="block">Şov & Eğlence Parkları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Fantasea, Carnival Magic, Simon</span>
                </div>
              </a>
              <a href="/turlar/fil-besleme-ve-bakim-deneyimi" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-teal-500/10 hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
                <span class="text-base shrink-0">🐘</span>
                <div>
                  <span class="block">Etik Fil Koruma Parkları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Besleme, Banyo & Safari</span>
                </div>
              </a>
              <a href="/turlar/?kategori=private-charters" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-sky-500/10 hover:text-sky-700 dark:hover:text-sky-400 transition-colors">
                <span class="text-base shrink-0">🛥️</span>
                <div>
                  <span class="block">Özel Tekne Kiralama</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Katamaran, Sürat & Longtail</span>
                </div>
              </a>
              <div class="pt-1.5 border-t border-slate-100 dark:border-slate-800 space-y-1">
                <a href="/tatil-asistani" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-[11px] font-extrabold text-amber-600 dark:text-amber-400 hover:bg-amber-500/10 transition-colors">
                  <span>✨ 3 Adımda Tatil Planla →</span>
                </a>
                <a href="/turlar" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-[11px] font-extrabold text-brand-primary dark:text-brand-accent hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                  <span>Tüm Turları İncele →</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* VIP & Transfer Dropdown */}
        <div class="relative group py-2">
          <a href="/transferler" class="flex items-center gap-1 text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors">
            <span>VIP & Transfer</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto">
            <div class="w-72 p-2.5 bg-white/95 dark:bg-surface-1/95 backdrop-blur-xl rounded-2xl shadow-xl border border-slate-200/80 dark:border-slate-800 space-y-1">
              <a href="/transferler" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-sky-500/10 hover:text-sky-700 dark:hover:text-sky-400 transition-colors">
                <span class="text-base shrink-0">✈️</span>
                <div>
                  <span class="block">VIP Havalimanı Transferi</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Hızlı Geçiş & Özel Minivan</span>
                </div>
              </a>
              <a href="/vip" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                <span class="text-base shrink-0">👑</span>
                <div>
                  <span class="block">Lüks Yat Kiralama</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Özel Katamaran & Mürettebat</span>
                </div>
              </a>
              <a href="/transferler" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-indigo-500/10 hover:text-indigo-700 dark:hover:text-indigo-400 transition-colors">
                <span class="text-base shrink-0">🏨</span>
                <div>
                  <span class="block">Oteller Arası Transfer & Bagaj</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Bölge Geçişi ve Bagaj Taşıma</span>
                </div>
              </a>
              <a href="/paketler" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-pink-500/10 hover:text-pink-700 dark:hover:text-pink-400 transition-colors">
                <span class="text-base shrink-0">🌴</span>
                <div>
                  <span class="block">Balayı & Kişiye Özel Paketler</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Özel Tatil Programları</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        {/* Tatil Planlayıcı Linki */}
        <a href="/tatil-asistani" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative flex items-center gap-1.5 after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">
          <span>Tatil Planlayıcı</span>
          <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 font-extrabold uppercase tracking-wider">3 Adım</span>
        </a>

        {/* Rehber Dropdown */}
        <div class="relative group py-2">
          <a href="/blog" class="flex items-center gap-1 text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors">
            <span>Rehber</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto">
            <div class="w-60 p-2.5 bg-white/95 dark:bg-surface-1/95 backdrop-blur-xl rounded-2xl shadow-xl border border-slate-200/80 dark:border-slate-800 space-y-1">
              <a href="/blog" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                <span class="text-base shrink-0">📖</span>
                <div>
                  <span class="block">Phuket Gezi Rehberi</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Tavsiyeler, Plajlar & Yemekler</span>
                </div>
              </a>
              <a href="/tayca" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-teal-500/10 hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
                <span class="text-base shrink-0">🇹🇭</span>
                <div>
                  <span class="block">Pratik Cep Taycası</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Turist Cümleleri & Kelimeler</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <a href="/iletisim" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">İletişim</a>
        
        <button id="theme-toggle" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-600 dark:text-slate-300 shrink-0 cursor-pointer" aria-label="Gece/Gündüz Modu">
          <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg id="theme-toggle-light-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
          </svg>
        </button>

        <a
          href="/#testimonials"
          class="hidden xl:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-800 dark:text-slate-200 transition-colors shrink-0"
          title="Google Doğrulanmış Misafir Yorumları (4.9 / 5)"
        >
          <span class="text-amber-400 text-xs">★</span>
          <span>4.9</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Google (150+)</span>
        </a>

        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" class="ml-1 lg:ml-2 bg-[#25D366] text-white px-5 py-2.5 lg:px-6 lg:py-3 rounded-full text-sm font-bold hover:bg-[#128C7E] transition-all transform hover:-translate-y-1 hover:shadow-xl shadow-md flex items-center gap-2 shrink-0 whitespace-nowrap">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden rounded-xl p-3 text-brand-primary dark:text-white transition-colors hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent cursor-pointer" aria-label="Menüyü Aç" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation (Modern, Ergonomic, Full-Height Responsive Overlay) -->
<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 w-full h-full bg-white/98 dark:bg-slate-900/98 backdrop-blur-2xl z-[100] hidden overflow-y-auto overscroll-contain"
  aria-hidden="true"
>
  <div class="w-full max-w-lg mx-auto min-h-full flex flex-col justify-between p-5 pt-[calc(1rem+env(safe-area-inset-top,0px))] pb-[calc(2.5rem+env(safe-area-inset-bottom,0px))]">
    {/* Üst Bar: Logo + Kapat */}
    <div class="flex items-center justify-between pb-4 border-b border-slate-200/80 dark:border-slate-800 shrink-0">
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl">🌴</span>
        <span class="font-serif font-bold text-brand-primary dark:text-white text-xl tracking-tight">Phuket <span class="text-brand-accent italic">Tatili</span></span>
      </a>
      <button id="mobile-menu-close" class="p-2.5 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white rounded-xl bg-slate-100 dark:bg-slate-800 cursor-pointer" aria-label="Menüyü Kapat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    {/* Ana Ergonomik Liste */}
    <div class="py-4 space-y-2.5 flex-1">
      {/* 1. Ana Sayfa */}
      <a href="/" class="flex items-center justify-between px-4 py-3 rounded-2xl bg-slate-50 dark:bg-slate-800/40 text-slate-900 dark:text-white font-bold text-base hover:bg-brand-accent/10 hover:text-brand-accent transition-colors">
        <span class="flex items-center gap-3">
          <span class="text-xl">🏠</span>
          <span>Ana Sayfa</span>
        </span>
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>

      {/* 2. Turlar & Aktiviteler */}
      <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/40 p-3 space-y-2">
        <div class="flex items-center justify-between px-1">
          <a href="/turlar" class="flex items-center gap-3 text-slate-900 dark:text-white font-bold text-base hover:text-brand-accent">
            <span class="text-xl">🏝️</span>
            <span>Turlar & Aktiviteler</span>
          </a>
          <a href="/turlar" class="text-xs font-extrabold text-brand-accent hover:underline">Tümü →</a>
        </div>
        <div class="flex flex-wrap gap-1.5 pt-1">
          <a href="/turlar/?kategori=island-tours" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-2xs border border-slate-200/60 dark:border-slate-800 hover:border-brand-accent">
            Ada Turları
          </a>
          <a href="/turlar/?kategori=adventure-tours" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-2xs border border-slate-200/60 dark:border-slate-800 hover:border-brand-accent">
            Macera & Rafting
          </a>
          <a href="/turlar/?kategori=entertainment-tours" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-2xs border border-slate-200/60 dark:border-slate-800 hover:border-brand-accent">
            Şov & Kültür
          </a>
          <a href="/turlar/fil-besleme-ve-bakim-deneyimi" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-2xs border border-slate-200/60 dark:border-slate-800 hover:border-brand-accent">
            Etik Fil Parkı
          </a>
          <a href="/turlar/?kategori=private-charters" class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold shadow-2xs border border-slate-200/60 dark:border-slate-800 hover:border-brand-accent">
            Özel Yat
          </a>
        </div>
      </div>

      {/* 2.5 Tatil Asistanı */}
      <a href="/tatil-asistani" class="flex items-center justify-between p-3.5 rounded-2xl bg-gradient-to-r from-amber-500/15 via-amber-500/5 to-transparent border border-amber-500/30 text-slate-900 dark:text-white font-bold text-sm">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">✨</span>
          <div>
            <span class="block text-slate-900 dark:text-white font-bold">Tatil Planlayıcı</span>
            <span class="block text-[11px] text-amber-600 dark:text-amber-400 font-normal">3 Adımda Sana Özel Phuket Rotası</span>
          </div>
        </div>
        <span class="text-xs text-amber-600 dark:text-amber-400 font-black">Planla →</span>
      </a>

      {/* 3. VIP & Transfer Hizmetleri */}
