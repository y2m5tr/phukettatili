---
import siteSettingsJson from '../content/settings/site.json';
import { getPublicHomeContent, mergeSiteSettings } from '../lib/server/homeSettings';
import { resolveAssetUrl } from '../lib/assets';
import TopAnnouncementBar from './TopAnnouncementBar.astro';
import PhuketLiveStatusPill from './weather/PhuketLiveStatusPill.astro';

let siteSettings: Record<string, any> = siteSettingsJson;
try {
  const panelContent = await getPublicHomeContent();
  siteSettings = mergeSiteSettings(siteSettingsJson, panelContent.siteSettings) as Record<string, any>;
} catch {}

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const googleRating = siteSettings?.googleRating || '4.9';
const googleReviewCount = Number(siteSettings?.googleReviewCount) || 148;
const logoUrl = siteSettings?.logoUrl || '/assets/logo-main-transparent.png';
const logoText = (siteSettings?.logoText || 'Phuket Tatili').trim();
const lastSpaceIdx = logoText.lastIndexOf(' ');
const logoFirstPart = lastSpaceIdx !== -1 ? logoText.substring(0, lastSpaceIdx) : logoText;
const logoAccentPart = lastSpaceIdx !== -1 ? logoText.substring(lastSpaceIdx + 1) : '';
---
<header id="site-header" class="fixed w-full top-0 z-50 bg-white/95 dark:bg-surface-1/95 backdrop-blur-md border-b border-slate-200/60 dark:border-slate-800 shadow-sm transition-colors duration-200">
  <TopAnnouncementBar />
  <div class="max-w-7xl mx-auto px-6">
    <div class="header-inner flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group mr-4 lg:mr-8 xl:mr-12">
        <img
          src={resolveAssetUrl(logoUrl, '/assets/logo-main-transparent.png')}
          alt={`${logoText} Logo`}
          width="460"
          height="340"
          decoding="async"
          class="header-logo-img h-14 lg:h-16 w-auto object-contain"
        />
        {logoText && (
          <span class="font-serif text-2xl lg:text-3xl font-bold text-brand-primary dark:text-white tracking-tight whitespace-nowrap">
            {logoFirstPart}{' '}
            {logoAccentPart && <span class="text-brand-accent italic">{logoAccentPart}</span>}
          </span>
        )}
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-4 lg:gap-5 xl:gap-7">
        <a href="/" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-0.5 after:bg-brand-accent after:opacity-0 after:transition-opacity hover:after:opacity-100">Ana Sayfa</a>

        {/* Turlar Dropdown */}
        <div class="relative group py-2">
          <a href="/turlar" class="flex items-center gap-1 text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors">
            <span>Turlar</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5 motion-safe:transition-transform duration-200 group-hover:rotate-180 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
            <div class="w-72 p-2.5 bg-white dark:bg-surface-1 rounded-2xl shadow-xl space-y-1">
              <a href="/turlar/?kategori=island-tours" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
                <div>
                  <span class="block">Ada Turları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Phi Phi, James Bond, Similan</span>
                </div>
              </a>
              <a href="/turlar/?kategori=adventure-tours" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-emerald-500/10 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </span>
                <div>
                  <span class="block">Macera & Doğa Turları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">ATV, Zipline, Rafting, Kano</span>
                </div>
              </a>
              <a href="/turlar/?kategori=entertainment-tours" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-purple-500/10 hover:text-purple-700 dark:hover:text-purple-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-purple-500/15 text-purple-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
                </span>
                <div>
                  <span class="block">Şov & Eğlence Parkları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Fantasea, Carnival Magic, Simon</span>
                </div>
              </a>
              <a href="/turlar/fil-besleme-ve-bakim-deneyimi" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-teal-500/10 hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-teal-500/15 text-teal-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                </span>
                <div>
                  <span class="block">Etik Fil Koruma Parkları</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Besleme, Banyo & Safari</span>
                </div>
              </a>
              <a href="/turlar/?kategori=private-charters" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-sky-500/10 hover:text-sky-700 dark:hover:text-sky-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-sky-500/15 text-sky-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                </span>
                <div>
                  <span class="block">Özel Tekne Kiralama</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Katamaran, Sürat & Longtail</span>
                </div>
              </a>
              <div class="pt-1.5 border-t border-slate-100 dark:border-slate-800 space-y-1">
                <a href="/tatil-asistani" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-[11px] font-semibold text-amber-600 dark:text-amber-400 hover:bg-amber-500/10 transition-colors">
                  <span>3 Adımda Tatil Planla</span>
                  <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
                <a href="/turlar" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-[11px] font-semibold text-brand-primary dark:text-brand-accent hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                  <span>Tüm Turları İncele</span>
                  <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* VIP & Transfer Dropdown */}
        <div class="relative group py-2">
          <a href="/transferler" class="flex items-center gap-1 text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors">
            <span>VIP & Transfer</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5 motion-safe:transition-transform duration-200 group-hover:rotate-180 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
            <div class="w-72 p-2.5 bg-white dark:bg-surface-1 rounded-2xl shadow-xl space-y-1">
              <a href="/fast-track" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-sky-500/10 hover:text-sky-700 dark:hover:text-sky-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-sky-500/15 text-sky-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </span>
                <div>
                  <span class="block">VIP Fast Track (Havalimanı)</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Kuyruksuz Pasaport & Karşılama</span>
                </div>
              </a>
              <a href="/transferler" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-emerald-500/10 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
                </span>
                <div>
                  <span class="block">VIP Havalimanı & Otel Transferi</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Klimalı Özel Minibüs & Şoför</span>
                </div>
              </a>
              <a href="/ozel-tekne-kiralama" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                </span>
                <div>
                  <span class="block">Özel Tekne & Katamaran</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Kişiye Özel Rota & Kaptan</span>
                </div>
              </a>
              <a href="/vip" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-indigo-500/10 hover:text-indigo-700 dark:hover:text-indigo-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-indigo-500/15 text-indigo-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                </span>
                <div>
                  <span class="block">VIP Concierge & Özel Yatlar</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Lüks Yat ve Acente Ayrıcalıkları</span>
                </div>
              </a>
              <a href="/paketler" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-pink-500/10 hover:text-pink-700 dark:hover:text-pink-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-pink-500/15 text-pink-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                </span>
                <div>
                  <span class="block">Balayı & Kişiye Özel Paketler</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Özel Tatil Programları</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        {/* Tatil Planlayıcı Linki */}
        <a href="/tatil-asistani" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative flex items-center gap-1.5 after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-0.5 after:bg-brand-accent after:opacity-0 after:transition-opacity hover:after:opacity-100">
          <span>Tatil Planlayıcı</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-300 font-medium">3 Adım</span>
        </a>

        {/* Rehber Dropdown */}
        <div class="relative group py-2">
          <a href="/blog" class="flex items-center gap-1 text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors">
            <span>Rehber</span>
            <svg aria-hidden="true" class="w-3.5 h-3.5 motion-safe:transition-transform duration-200 group-hover:rotate-180 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-opacity duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
            <div class="w-60 p-2.5 bg-white dark:bg-surface-1 rounded-2xl shadow-xl space-y-1">
              <a href="/blog" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-amber-500/10 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                </span>
                <div>
                  <span class="block">Phuket Gezi Rehberi</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Tavsiyeler, Plajlar & Yemekler</span>
                </div>
              </a>
              <a href="/tayca" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 hover:bg-teal-500/10 hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
                <span class="w-7 h-7 rounded-lg bg-teal-500/15 text-teal-600 flex items-center justify-center shrink-0">
                  <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
                </span>
                <div>
                  <span class="block">Pratik Cep Taycası</span>
                  <span class="block text-[10px] text-slate-400 font-normal">Turist Cümleleri & Kelimeler</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <a href="/iletisim" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-full after:h-0.5 after:bg-brand-accent after:opacity-0 after:transition-opacity hover:after:opacity-100">İletişim</a>
        
        <button id="theme-toggle" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-600 dark:text-slate-300 shrink-0 cursor-pointer" aria-label="Gece/Gündüz Modu">
          <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg id="theme-toggle-light-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
          </svg>
        </button>

        <a
          href="/#testimonials"
          class="hidden lg:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700/80 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-800 dark:text-slate-200 transition-colors shrink-0"
          title={`Google Doğrulanmış Misafir Yorumları (${googleRating} / 5)`}
        >
          <span class="text-amber-400 text-xs">★</span>
          <span>{googleRating}</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Google ({googleReviewCount}+)</span>
