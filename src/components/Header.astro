---
import siteSettings from '../content/settings/site.json';
import TopAnnouncementBar from './TopAnnouncementBar.astro';

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
---
<header id="site-header" class="fixed w-full top-0 z-50 transition-all duration-500 bg-white/90 dark:bg-surface-1/95 backdrop-blur-xl border-b border-slate-200/50 dark:border-slate-800/80 shadow-sm">
  <TopAnnouncementBar />
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group mr-8 lg:mr-12 xl:mr-16">
        <img src="/assets/logo-main-transparent.png" alt="Phuket Tatili Logo" width="460" height="340" decoding="async" class="h-14 lg:h-16 w-auto object-contain group-hover:scale-105 transition-transform duration-300" />
        <span class="font-serif text-2xl lg:text-3xl font-bold text-brand-primary dark:text-white tracking-tight whitespace-nowrap">Phuket <span class="text-brand-accent italic">Tatili</span></span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-7 xl:gap-8">
        <a href="/" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">Ana Sayfa</a>
        <a href="/turlar" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">Turlar</a>
        <a href="/vip" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">VIP Hizmetler</a>
        <a href="/transferler" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">Transferler</a>
        <a href="/blog" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">Rehber</a>
        <a href="/hakkimizda" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">Hakkımızda</a>
        <a href="/iletisim" class="text-slate-600 dark:text-slate-200 hover:text-brand-accent dark:hover:text-brand-accent font-semibold text-sm lg:text-base whitespace-nowrap transition-colors relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-brand-accent after:transition-all hover:after:w-full">İletişim</a>
        
        <button id="theme-toggle" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-600 dark:text-slate-300 shrink-0" aria-label="Gece/Gündüz Modu">
          <svg id="theme-toggle-dark-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg id="theme-toggle-light-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"></path>
          </svg>
        </button>

        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" class="ml-1 lg:ml-2 bg-[#25D366] text-white px-5 py-2.5 lg:px-6 lg:py-3 rounded-full text-sm font-bold hover:bg-[#128C7E] transition-all transform hover:-translate-y-1 hover:shadow-xl shadow-md flex items-center gap-2 shrink-0 whitespace-nowrap">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden rounded-xl p-3 text-brand-primary dark:text-white transition-colors hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent" aria-label="Menüyü Aç" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="mobile-menu fixed inset-0 bg-white dark:bg-surface-1 z-40 hidden flex-col pt-24 px-6 gap-6 text-xl" aria-hidden="true">
    <a href="/" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">Ana Sayfa</a>
    <a href="/turlar" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">Turlar</a>
    <a href="/vip" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">VIP Hizmetler</a>
    <a href="/transferler" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">Transferler</a>
    <a href="/blog" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">Rehber</a>
    <a href="/hakkimizda" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">Hakkımızda</a>
    <a href="/iletisim" class="text-brand-primary dark:text-white font-bold hover:text-brand-accent transition-colors">İletişim</a>
    <a href={`https://wa.me/${whatsappNumber}`} target="_blank" class="bg-[#25D366] text-white px-6 py-4 rounded-xl text-center font-bold mt-4">
      WhatsApp'tan Ulaşın
    </a>
    <button id="mobile-menu-close" class="absolute top-6 right-4 p-2 text-brand-primary dark:text-white" aria-label="Menüyü Kapat">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu && closeBtn) {
      const setMenuState = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        menu.classList.toggle('flex', open);
        menu.classList.toggle('is-open', open);
        menu.setAttribute('aria-hidden', String(!open));
        btn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) closeBtn.focus();
      };

      btn.onclick = () => setMenuState(true);
      closeBtn.onclick = () => setMenuState(false);

      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setMenuState(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.classList.contains('is-open')) setMenuState(false);
      });
    }

    const header = document.getElementById('site-header');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
    updateHeader();
    window.removeEventListener('scroll', (window as any)._onHeaderScroll);
    (window as any)._onHeaderScroll = updateHeader;
    window.addEventListener('scroll', updateHeader, { passive: true });

    // Theme Toggle Logic
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

    if (themeToggleBtn && themeToggleDarkIcon && themeToggleLightIcon) {
      const isDark = () => document.documentElement.classList.contains('dark');
      const updateIcons = () => {
        if (isDark()) {
          themeToggleLightIcon.classList.remove('hidden');
          themeToggleDarkIcon.classList.add('hidden');
        } else {
          themeToggleDarkIcon.classList.remove('hidden');
          themeToggleLightIcon.classList.add('hidden');
        }
      };

      updateIcons();

      themeToggleBtn.onclick = () => {
        const nextDark = !isDark();
        document.documentElement.classList.toggle('dark', nextDark);
        localStorage.setItem('theme', nextDark ? 'dark' : 'light');
        updateIcons();
      };
    }
  });
</script>
