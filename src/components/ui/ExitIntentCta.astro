---
import siteSettings from '../../content/settings/site.json';

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
const defaultWaMessage = encodeURIComponent(
  'Merhaba! Siteden ayrılmadan önce danışmak istedim; Phuket tatilim için en uygun tur rotaları ve güncel fiyat teklifleri hakkında bilgi alabilir miyim?'
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${defaultWaMessage}`;
---

<div
  id="exit-intent-modal"
  class="fixed inset-0 z-[120] hidden items-center justify-center p-4 bg-slate-950/80 transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-intent-title"
>
  <div
    id="exit-intent-card"
    class="relative w-full max-w-lg bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-200/80 dark:border-slate-800 space-y-5"
  >
    <!-- Kapatma Butonu -->
    <button
      type="button"
      id="exit-intent-close"
      class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white flex items-center justify-center text-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
      aria-label="Kapat"
    >
      ✕
    </button>

    <div class="space-y-2 text-center sm:text-left">
      <h3
        id="exit-intent-title"
        class="text-xl sm:text-2xl font-serif font-black text-slate-900 dark:text-white leading-tight"
      >
        Ayrılmadan Önce: Size Özel Rota & Avantajlı Fiyat Alın!
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        Phuket’te yerel Türk ekibimizle hangi turun otelinize daha yakın olduğunu, hava durumunu veya her şey dahil paketleri WhatsApp’tan hemen sorabilirsiniz.
      </p>
    </div>

    <!-- Güvence Maddeleri -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 p-3.5 rounded-2xl border border-slate-200/60 dark:border-slate-700/60">
      <div class="flex items-center gap-2">
        <span class="text-emerald-500 font-bold">✓</span>
        <span>Milli Park & Transfer Dahil</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-500 font-bold">✓</span>
        <span>Fırtına & Kötü Hava %100 İade</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-500 font-bold">✓</span>
        <span>1.000.000 THB Kaza Sigortası</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-emerald-500 font-bold">✓</span>
        <span>TAT Lisans No: 34/02894</span>
      </div>
    </div>

    <!-- CTA & Vazgeç Butonları -->
    <div class="space-y-2 pt-1">
      <a
        href={waUrl}
        id="exit-intent-wa-cta"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-4 px-6 rounded-2xl bg-whatsapp hover:bg-whatsapp-dark active:bg-whatsapp-dark text-white font-bold text-sm shadow-md flex items-center justify-center gap-2.5 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
      >
        <svg aria-hidden="true" class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span>WhatsApp ile Ücretsiz Danış & Teklif Al</span>
      </a>

      <button
        type="button"
        id="exit-intent-dismiss"
        class="w-full py-2 text-center text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 whitespace-nowrap"
      >
        Sayfayı incelemeye devam et
      </button>
    </div>
  </div>
</div>

<script>
  function setupExitIntent() {
    const modal = document.getElementById('exit-intent-modal');
    const card = document.getElementById('exit-intent-card');
    const closeBtn = document.getElementById('exit-intent-close');
    const dismissBtn = document.getElementById('exit-intent-dismiss');
    const waCta = document.getElementById('exit-intent-wa-cta');

    if (!modal || !card) return;

    // Admin, bilet veya teklif sayfalarında çalıştırma
    const pathname = window.location.pathname;
    if (
      pathname.startsWith('/admin') ||
      pathname.startsWith('/bilet') ||
      pathname.startsWith('/teklif') ||
      pathname.startsWith('/rezervasyon')
    ) {
      return;
    }

    const STORAGE_KEY = 'ptt_exit_intent_seen';
    if (sessionStorage.getItem(STORAGE_KEY) === '1') {
      return;
    }

    let isShown = false;

    function showModal() {
      if (isShown || sessionStorage.getItem(STORAGE_KEY) === '1') return;
      isShown = true;
      sessionStorage.setItem(STORAGE_KEY, '1');

      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      // requestAnimationFrame for smooth fade/scale
      requestAnimationFrame(() => {
        modal?.classList.remove('opacity-0');
        modal?.classList.add('opacity-100');
        card?.classList.remove('scale-95');
        card?.classList.add('scale-100');
      });
    }

    function hideModal() {
      modal?.classList.remove('opacity-100');
      modal?.classList.add('opacity-0');
      card?.classList.remove('scale-100');
      card?.classList.add('scale-95');
      setTimeout(() => {
        modal?.classList.remove('flex');
        modal?.classList.add('hidden');
      }, 300);
    }

    closeBtn?.addEventListener('click', hideModal);
    dismissBtn?.addEventListener('click', hideModal);
    waCta?.addEventListener('click', hideModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });

    // 1. Desktop: Cursor leaving viewport at the top
    const handleMouseLeave = (e: MouseEvent) => {
      if (e.clientY <= 15) {
        showModal();
        document.removeEventListener('mouseleave', handleMouseLeave);
      }
    };
    document.addEventListener('mouseleave', handleMouseLeave);

    // 2. Mobile / Tablet: 35 saniye bekleme zamanlayıcısı
    const timer = setTimeout(() => {
      showModal();
    }, 35000);

    // Temizleme: sayfa değiştiğinde timer kaldır
    document.addEventListener(
      'astro:before-swap',
      () => {
        clearTimeout(timer);
        document.removeEventListener('mouseleave', handleMouseLeave);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', setupExitIntent);
</script>
