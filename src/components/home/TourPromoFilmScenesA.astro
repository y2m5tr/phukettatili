---
// TourPromoFilmScenesA — Perde 2 sahne 1-5: kano, şnorkel, fil, zipline, ATV.
// TourPromoFilm.astro içindeki sahne JS'i bu .pf-slide'leri yönetir.
---

  <!-- S1: Kano — karst mağarasından geçiş -->
  <div class="pf-slide absolute inset-0 opacity-0">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full">
      <defs>
        <linearGradient id="pf-kayak-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#a8e0f5" />
          <stop offset="1" stop-color="#e7f7fb" />
        </linearGradient>
        <linearGradient id="pf-kayak-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#45bcd8" />
          <stop offset="1" stop-color="#7fd8e8" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#pf-kayak-sky)" />
      <rect y="520" width="1600" height="380" fill="url(#pf-kayak-sea)" />
      <g fill="#6db190">
        <path d="M280 520 l 90 -260 l 80 260 z" />
        <path d="M420 520 l 110 -320 l 95 320 z" opacity="0.9" />
        <path d="M560 520 l 80 -220 l 70 220 z" />
        <path d="M1120 520 l 100 -290 l 85 290 z" opacity="0.9" />
        <path d="M1260 520 l 80 -210 l 70 210 z" />
      </g>
      <!-- mağara kemerleri -->
      <path d="M660 520 q 140 -180 280 0 z" fill="#3f8a6d" />
      <path d="M700 520 q 100 -130 200 0 z" fill="#2f7d61" />
      <!-- kano + küreği çizen misafir -->
      <g class="pf-kayak-bob">
        <g transform="translate(800 700)">
          <path d="M-90 0 q 90 34 180 0 l -16 8 q -74 22 -148 0 z" fill="#e0634a" />
          <path d="M-90 0 q 90 30 180 0 l -10 -16 q -80 -20 -160 0 z" fill="#f0785c" />
          <circle cx="-14" cy="-24" r="13" fill="#ffcf9e" />
          <path d="M-28 -28 q 14 -18 28 0 l -2 10 q -12 -8 -24 0 z" fill="#f5b23a" />
          <rect x="-24" y="-14" width="24" height="18" rx="6" fill="#e05c4a" />
          <g class="pf-paddle">
            <ellipse rx="9" ry="16" fill="#8a5a3b" transform="translate(18 -34) rotate(20)" />
            <rect x="16" y="-60" width="5" height="60" rx="2" fill="#8a5a3b" transform="rotate(8 18 -30)" />
          </g>
          <g class="pf-splash" stroke="#ffffff" stroke-width="4" fill="none" stroke-linecap="round">
            <path d="M-104 6 q -10 -12 -4 -22" />
            <path d="M104 6 q 10 -12 4 -22" />
          </g>
        </g>
      </g>
      <g class="pf-waves-b" stroke="#ffffff" stroke-width="3" fill="none" opacity="0.4" stroke-linecap="round">
        <path d="M0 800 q 40 -12 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0" />
      </g>
    </svg>
  </div>

  <!-- S2: Şnorkel — balık sürüsü -->
  <div class="pf-slide absolute inset-0 opacity-0">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full">
      <defs>
        <linearGradient id="pf-snorkel-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#36b6d6" />
          <stop offset="1" stop-color="#0e7fa6" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#pf-snorkel-sea)" />
      <!-- ışık huzmeleri -->
      <g opacity="0.2" fill="#ffffff">
        <path d="M300 0 l 80 0 l 200 900 l -160 900 z" />
        <path d="M900 0 l 70 0 l 150 900 l -120 900 z" />
      </g>
      <!-- mercanlar -->
      <g>
        <path d="M180 900 q -30 -140 20 -200 q 40 60 10 200 z" fill="#e0726a" />
        <path d="M230 900 q -10 -110 30 -150 q 30 40 8 150 z" fill="#e8906a" />
        <path d="M1380 900 q -30 -160 25 -215 q 45 65 10 215 z" fill="#d65c8c" />
        <path d="M1430 900 q -8 -100 28 -140 q 28 36 8 140 z" fill="#e88ab0" />
      </g>
      <!-- balık sürüsü -->
      <g fill="#ffd166">
        <g class="pf-fish-a">
          <ellipse cx="0" cy="0" rx="20" ry="11" />
          <path d="M-20 0 l -16 -9 l 0 18 z" />
          <circle cx="9" cy="-2" r="2.4" fill="#0e7fa6" />
        </g>
        <g class="pf-fish-a pf-fish-late"><ellipse cx="0" cy="0" rx="20" ry="11" /><path d="M-20 0 l -16 -9 l 0 18 z" /><circle cx="9" cy="-2" r="2.4" fill="#0e7fa6" /></g>
      </g>
      <g fill="#6ee7d0">
        <g class="pf-fish-b"><ellipse cx="0" cy="0" rx="16" ry="9" /><path d="M-16 0 l -13 -8 l 0 16 z" /><circle cx="7" cy="-2" r="2" fill="#0e7fa6" /></g>
      </g>
      <!-- şnorkelli misafir -->
      <g class="pf-swimmer">
        <g transform="translate(1150 420)">
          <ellipse cx="0" cy="0" rx="44" ry="16" fill="#ffcf9e" />
          <path d="M-40 -6 q -50 -30 -84 -6 q 50 26 84 6 z" fill="#ffcf9e" />
          <circle cx="-86" cy="-16" r="0" />
          <circle cx="44" cy="-2" r="0" />
          <g transform="translate(58 -4)">
            <circle cx="0" cy="0" r="15" fill="#ffcf9e" />
            <rect x="-6" y="-6" width="26" height="12" rx="6" fill="#4bb8d9" opacity="0.85" />
            <path d="M4 -14 q 4 -22 22 -14 q -6 10 -14 12 z" fill="#f5b23a" />
          </g>
        </g>
      </g>
      <!-- kabarcıklar -->
      <g class="pf-bubbles" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.6">
        <circle cx="1210" cy="380" r="5" />
        <circle cx="1226" cy="350" r="7" />
        <circle cx="1240" cy="315" r="4" />
<circle cx="1200" cy="345" r="3" />
      </g>
    </svg>
  </div>

  <!-- S3: Fil bakımı -->
  <div class="pf-slide absolute inset-0 opacity-0">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full">
      <defs>
        <linearGradient id="pf-ele-bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#cdebc4" />
          <stop offset="1" stop-color="#e8f5d8" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#pf-ele-bg)" />
      <circle cx="1280" cy="170" r="55" fill="#ffd166" />
      <g fill="#a9d692">
        <path d="M0 660 q 300 -120 640 -20 q 380 90 960 -30 l 0 290 l -1600 0 z" />
      </g>
      <g fill="#8cc47a" opacity="0.7">
        <path d="M120 720 q 200 -80 420 -10 q 260 70 560 -20 q 300 -70 500 10 l 0 200 l -1480 0 z" />
      </g>
      <!-- büyük fil -->
      <g class="pf-elephant">
        <g transform="translate(760 620)">
          <ellipse cx="0" cy="-120" rx="150" ry="115" fill="#9b8d9e" />
          <circle cx="-120" cy="-210" r="62" fill="#9b8d9e" />
          <path d="M-158 -190 q -60 90 -30 150 q 8 18 26 10 q -16 -60 12 -110 z" fill="#8a7a8d" />
          <path d="M-84 -160 q -30 70 -12 118 q 6 16 22 8 q -10 -50 8 -92 z" fill="#8a7a8d" />
          <ellipse cx="-190" cy="-70" rx="16" ry="60" fill="#8a7a8d" transform="rotate(14 -190 -70)" />
          <ellipse cx="-36" cy="-30" rx="18" ry="64" fill="#8a7a8d" transform="rotate(-10 -36 -30)" />
          <ellipse cx="60" cy="-40" rx="17" ry="60" fill="#8a7a8d" transform="rotate(8 60 -40)" />
          <circle cx="-140" cy="-222" r="4" fill="#5e5461" />
          <circle cx="-98" cy="-222" r="4" fill="#5e5461" />
          <path d="M-104 -248 q 4 -20 20 -8 z" fill="#7c6f80" />
          <path d="M-70 -250 q 6 -22 22 -10 z" fill="#7c6f80" />
          <path d="M-56 -18 q 60 26 120 0 l -20 20 q -40 14 -80 0 z" fill="#f5e9d0" opacity="0.9" />
        </g>
      </g>
      <!-- kuyruk sallanışı -->
      <g class="pf-ele-tail" transform="translate(918 560)">
        <path d="M0 0 q 30 40 14 84" stroke="#9b8d9e" stroke-width="18" fill="none" stroke-linecap="round" />
        <circle cx="14" cy="84" r="10" fill="#8a7a8d" />
      </g>
      <!-- misafir: kovayla su döküyor -->
      <g class="pf-keeper" transform="translate(560 730)">
        <circle cx="0" cy="-90" r="20" fill="#ffcf9e" />
        <path d="M-24 -96 q 24 -30 48 0 l -4 16 q -20 -14 -40 0 z" fill="#f5b23a" />
        <rect x="-22" y="-72" width="44" height="52" rx="10" fill="#e05c4a" />
        <g class="pf-bucket">
          <path d="M-10 -78 l 20 0 l -4 20 l -12 0 z" fill="#8a5a3b" />
          <path d="M-10 -78 q 10 -10 20 0" stroke="#5e452c" stroke-width="3" fill="none" />
        </g>
        <ellipse cx="0" cy="-18" rx="24" ry="6" fill="#7a6a80" />
        <ellipse cx="16" cy="-6" rx="8" ry="4" fill="#7a6a80" />
      </g>
    </svg>
  </div>

  <!-- S4: Zipline -->
  <div class="pf-slide absolute inset-0 opacity-0">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full">
      <defs>
        <linearGradient id="pf-zip-bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#bfe8f2" />
          <stop offset="0.6" stop-color="#dff2d9" />
          <stop offset="1" stop-color="#cdebb8" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#pf-zip-bg)" />
      <circle cx="290" cy="140" r="48" fill="#ffd166" />
      <circle cx="290" cy="140" r="72" fill="#ffd166" opacity="0.25" />
      <!-- uzak tepeler -->
      <g fill="#9ecf8f">
        <path d="M0 700 q 200 -180 420 -60 q 180 100 360 20 q 240 -120 820 40 l 0 200 l -1600 0 z" />
      </g>
      <!-- platform ağaçları -->
      <g>
        <rect x="142" y="330" width="26" height="330" fill="#8a5a3b" />
        <rect x="1418" y="240" width="28" height="420" fill="#8a5a3b" />
        <g fill="#2f7d61">
          <circle cx="155" cy="320" r="72" />
          <circle cx="90" cy="360" r="46" opacity="0.8" />
          <circle cx="1432" cy="225" r="84" />
          <circle cx="1360" cy="272" r="52" opacity="0.8" />
        </g>
        <rect x="120" y="655" width="70" height="12" rx="4" fill="#b07148" />
        <rect x="1390" y="655" width="76" height="12" rx="4" fill="#b07148" />
      </g>
      <!-- zipline halatı -->
      <path id="pf-zip-line" d="M155 340 C 500 560, 1000 420, 1432 250" stroke="#5e452c" stroke-width="5" fill="none" />
      <!-- kayan misafir -->
      <g>
        <g class="pf-zipper">
          <g transform="translate(0 0)">
            <circle cx="0" cy="-74" r="17" fill="#ffcf9e" />
            <path d="M-18 -80 q 18 -22 36 0 l -3 12 q -15 -12 -30 0 z" fill="#f5b23a" />
            <rect x="-16" y="-62" width="32" height="40" rx="8" fill="#4bb8d9" />
            <rect x="-22" y="-30" width="14" height="12" rx="5" fill="#f0785c" />
            <path d="M10 -50 l 34 -14 l -6 20 z" fill="#ffcf9e" />
            <path d="M-14 -58 l 26 -2 l -4 16 l -20 2 z" fill="#e05c4a" />
            <!-- makara -->
            <circle cx="0" cy="-14" r="7" fill="#5e452c" />
            <path d="M-2 -14 l 2 0" stroke="#5e452c" stroke-width="3" />
          </g>
        </g>
      </g>
      <!-- hız çizgileri -->
      <g class="pf-speedlines" stroke="#ffffff" stroke-width="5" stroke-linecap="round" opacity="0.7">
        <path d="M-80 -90 l -40 0" />
        <path d="M-90 -60 l -34 0" />
        <path d="M-84 -30 l -40 0" />
      </g>
    </svg>
  </div>

  <!-- S5: ATV -->
  <div class="pf-slide absolute inset-0 opacity-0">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full">
      <defs>
        <linearGradient id="pf-atv-bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffe3b3" />
          <stop offset="1" stop-color="#e8c992" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#pf-atv-bg)" />
      <circle cx="1300" cy="160" r="52" fill="#ff9e5c" />
      <!-- orman silüeti -->
      <g fill="#3f8a6d">
        <path d="M0 560 q 160 -200 340 -80 q 140 90 300 20 q 200 -110 400 30 q 240 100 560 -60 l 0 120 l -1600 0 z" opacity="0.6" />
      </g>
      <!-- patika -->
      <path d="M0 900 L 500 700 L 1100 640 L 1600 560 L 1600 900 Z" fill="#b8935e" />
      <path d="M0 900 L 500 700 L 1100 640 L 1600 560" stroke="#a17b49" stroke-width="14" fill="none" stroke-dasharray="60 34" />
      <!-- toz bulutu -->
      <g class="pf-dust" fill="#d9b57f" opacity="0.8">
        <circle cx="0" cy="0" r="18" />
        <circle cx="34" cy="8" r="26" opacity="0.6" />
        <circle cx="-30" cy="14" r="14" opacity="0.5" />
      </g>
      <!-- ATV -->
      <g class="pf-atv">
        <g transform="translate(0 0)">
          <rect x="-70" y="-40" width="140" height="30" rx="12" fill="#e05c4a" />
          <path d="M-70 -40 q 30 -26 70 -24 l 60 24 z" fill="#f0785c" />
          <rect x="-14" y="-78" width="30" height="40" rx="6" fill="#4bb8d9" />
          <circle cx="-58" cy="-2" r="34" fill="#2f2f2f" />
          <circle cx="-58" cy="-2" r="14" fill="#d9d9d9" />
          <circle cx="58" cy="-2" r="34" fill="#2f2f2f" />
          <circle cx="58" cy="-2" r="14" fill="#d9d9d9" />
          <!-- sürücü -->
          <circle cx="0" cy="-96" r="17" fill="#ffcf9e" />
          <path d="M-16 -102 q 16 -20 32 0 l -3 11 q -13 -10 -26 0 z" fill="#5e452c" />
          <rect x="-15" y="-86" width="30" height="38" rx="8" fill="#4bb8d9" />
          <path d="M14 -78 l 28 10 l -8 14 l -22 -8 z" fill="#ffcf9e" />
          <!-- egzoz dumanı -->
          <g class="pf-exhaust" fill="#e8e0d0" opacity="0.6">
            <circle cx="-92" cy="-30" r="8" />
            <circle cx="-108" cy="-44" r="11" />
            <circle cx="-126" cy="-62" r="13" />
          </g>
        </g>
      </g>
    </svg>
  </div>

