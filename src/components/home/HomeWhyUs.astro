---
import FadeIn from '../ui/FadeIn';
import { resolveAssetUrl } from '../../lib/assets';

export interface WhyUsCardItem {
  badge: string;
  title: string;
  desc: string;
  image: string;
  icon?: string;
}

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  cards?: WhyUsCardItem[];
}

const {
  badge = '★ Neden Phuket Tatili?',
  title = 'Ayrıcalıklı, Güvenli ve Tamamen Size Özel',
  subtitle = "Standart turların karmaşasından uzak, Tayland'daki yerel ekibimizle her anınız güvence altında.",
  cards: customCards,
} = Astro.props;

const defaultCards: WhyUsCardItem[] = [
  {
    badge: 'Tam Güvence',
    title: 'Güvenli Seyahat',
    desc: 'Tüm ada ve doğa turlarımız resmi Tayland Turizm Otoritesi (TAT) lisanslı tekneler ve tam kapsamlı yolcu sigortasıyla gerçekleştirilir.',
    image: 'beach.webp',
    icon: 'shield',
  },
  {
    badge: 'Yerel Ekip',
    title: '7/24 Türkçe Destek',
    desc: "Phuket'te yaşayan yerel ekibimiz inişinizden dönüşünüze kadar WhatsApp üzerinden kesintisiz yanınızda. Dil sorunu yaşamadan tatil yapın.",
    image: 'culture.webp',
    icon: 'chat',
  },
  {
    badge: 'Ayrıcalıklı Rota',
    title: 'VIP Deneyim',
    desc: 'Kalabalıktan izole özel yat turları, lüks şoförlü transferler ve sadece size özel planlanan esnek saatli ada rotaları.',
    image: 'yacht.webp',
    icon: 'star',
  },
];

const cards = customCards && customCards.length > 0 ? customCards : defaultCards;
---

<!-- Features / Why Choose Us -->
<section class="py-24 bg-slate-900 relative overflow-hidden px-4 text-white">
  <!-- Subtle Background Ambient Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-brand-accent/15 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute -bottom-20 right-10 w-[400px] h-[300px] bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Section Title -->
    <FadeIn client:visible delay={0.1}>
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-amber-300 text-xs font-bold uppercase tracking-widest">
          {badge}
        </span>
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-white mt-4">
          {title}
        </h2>
        <p class="text-slate-300 text-base md:text-lg mt-4 font-light leading-relaxed">
          {subtitle}
        </p>
      </div>
    </FadeIn>

    <!-- 3 Feature Cards with Images, Icons & Rich Micro-Details -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {cards.map((card, idx) => (
        <FadeIn client:visible delay={0.2 + idx * 0.15} direction="up">
          <div class="group relative rounded-3xl overflow-hidden bg-slate-800/90 border border-slate-700/80 hover:border-brand-accent/60 transition-all duration-500 shadow-xl hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full">
            <!-- Visual Header -->
            <div class="relative h-48 overflow-hidden">
              <img
                src={resolveAssetUrl(card.image)}
                alt={card.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
              
              <!-- Floating Icon Badge -->
              <div class="absolute bottom-4 left-6 w-12 h-12 rounded-2xl bg-brand-accent text-white flex items-center justify-center shadow-lg shadow-brand-accent/30 transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
                {idx === 0 ? (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                  </svg>
                ) : idx === 1 ? (
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z"/>
                  </svg>
                ) : (
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                  </svg>
                )}
              </div>

              <!-- Top Pill -->
              <div class="absolute top-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-semibold text-amber-400 border border-amber-500/30">
                {card.badge}
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
              <div>
                <h3 class="text-2xl font-serif font-bold text-white group-hover:text-amber-400 transition-colors mb-3">
                  {card.title}
                </h3>
                <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">
                  {card.desc}
                </p>
              </div>

              <ul class="space-y-2.5 pt-4 border-t border-slate-700/60 text-xs text-slate-300">
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  <span>Resmi TAT Lisanslı Deniz Araçları & Sigorta</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  <span>Kesintisiz WhatsApp & Türkçe Rehber Güvencesi</span>
                </li>
              </ul>
            </div>
          </div>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
