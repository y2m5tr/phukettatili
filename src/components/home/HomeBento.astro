---
import FadeIn from '../ui/FadeIn';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
}

const {
  badge = 'Deneyimler & Rotalar',
  title = "Phuket'te Neler Yapabilirsiniz?",
  subtitle = 'Günübirlik tropik ada kaçamaklarından özel yat turlarına, konforlu VIP transferlerden etik doğa deneyimlerine kadar Phuket\'in en iyileri.',
} = Astro.props;
---

<!-- Bento Grid: Phuket'te Neler Yapabilirsiniz? -->
<section class="py-20 bg-white dark:bg-surface-1 px-4 border-b border-slate-100 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto">
    <FadeIn delay={0.1}>
      <div class="text-center mb-14">
        <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">{badge}</span>
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-brand-primary dark:text-white mt-2">
          {title}
        </h2>
        <p class="text-slate-600 dark:text-slate-300 max-w-2xl mx-auto text-sm md:text-base font-light mt-3 leading-relaxed">
          {subtitle}
        </p>
      </div>
    </FadeIn>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      <!-- 1. Ada Turları (7 Cols) -->
      <div class="lg:col-span-7">
        <FadeIn delay={0.15} direction="up" className="h-full">
          <a
            href="/turlar/?kategori=island-tours"
            class="group relative block h-[380px] lg:h-[420px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
          >
            <img
              src="/assets/pileh.webp"
              alt="Phuket Ada Turları"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/45 to-transparent"></div>
            
            <div class="absolute top-5 left-5 z-10">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3"/><path d="M3 17c1.5 0 1.5 1 3 1s1.5-1 3-1 1.5 1 3 1 1.5-1 3-1 1.5 1 3 1"/></svg>
                Ada Turları
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-7 lg:p-9 z-10">
              <h3 class="font-serif text-2xl lg:text-3xl font-bold text-white group-hover:text-brand-accent transition-colors leading-snug">
                Phi Phi, Maya Bay, James Bond & Similan
              </h3>
              <p class="text-slate-300 text-sm mt-2 max-w-lg leading-relaxed line-clamp-2">
                Zümrüt yeşili lagünler, kireçtaşı kayalıklar ve bembeyaz kumsallarda unutulmaz ada keşifleri.
              </p>
              <div class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-accent group-hover:text-white transition-colors">
                Rotaları Keşfet <span class="transform group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        </FadeIn>
      </div>

      <!-- 2. Özel Yat & Katamaran (5 Cols) -->
      <div class="lg:col-span-5">
        <FadeIn delay={0.25} direction="up" className="h-full">
          <a
            href="/vip"
            class="group relative block h-[380px] lg:h-[420px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
          >
            <img
              src="/assets/yacht.webp"
              alt="Özel Yat ve Katamaran Kiralama"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/45 to-transparent"></div>
            
            <div class="absolute top-5 left-5 z-10">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M22 18H2a4 4 0 0 0 4 4h12a4 4 0 0 0 4-4Z"/><path d="M2.15 12.5 7 4h10l4.85 8.5H2.15Z"/></svg>
                Özel Kiralama
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-7 lg:p-9 z-10">
              <h3 class="font-serif text-2xl lg:text-3xl font-bold text-white group-hover:text-brand-accent transition-colors leading-snug">
                Özel Yat & Katamaran
              </h3>
              <p class="text-slate-300 text-sm mt-2 leading-relaxed line-clamp-2">
                Size ve sevdiklerinize özel, kalabalıktan uzak izole koylar ve esnek rotalar.
              </p>
              <div class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-accent group-hover:text-white transition-colors">
                VIP Seçenekler <span class="transform group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        </FadeIn>
      </div>

      <!-- 3. VIP Transferler (4 Cols) -->
      <div class="md:col-span-1 lg:col-span-4">
        <FadeIn delay={0.3} direction="up" className="h-full">
          <a
            href="/transferler"
            class="group relative block h-[320px] lg:h-[350px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
          >
            <img
              src="/assets/phuket_transfer.webp"
              alt="Phuket VIP Transferler"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>
            
            <div class="absolute top-5 left-5 z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2 11 2 11.3 2 11.6V16c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
                VIP Transfer
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
              <h3 class="font-serif text-xl lg:text-2xl font-bold text-white group-hover:text-brand-accent transition-colors">
                Havalimanı & Ada Transferi
              </h3>
              <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed line-clamp-2">
                Özel şoförlü, lüks VIP araçlarla konforlu ve dakik ulaşım.
              </p>
              <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-brand-accent group-hover:text-white transition-colors">
                İncele <span>→</span>
              </div>
            </div>
          </a>
        </FadeIn>
      </div>

      <!-- 4. Etik Fil Barınakları (4 Cols) -->
      <div class="md:col-span-1 lg:col-span-4">
        <FadeIn delay={0.35} direction="up" className="h-full">
          <a
            href="/turlar/fil-besleme-ve-bakim-deneyimi"
            class="group relative block h-[320px] lg:h-[350px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
          >
            <img
              src="/assets/elephant.webp"
              alt="Phuket Etik Fil Barınağı Deneyimi"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>
            
            <div class="absolute top-5 left-5 z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="5" r="2"/><circle cx="17" cy="8" r="2"/><circle cx="19.5" cy="15" r="2"/><path d="M8.5 10.5a5 5 0 0 1 5 5V19a3.5 3.5 0 0 1-6.8 1Q6 18 4 17.3A3.5 3.5 0 0 1 5 10.5z"/></svg>
                Doğa Deneyimi
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
              <h3 class="font-serif text-xl lg:text-2xl font-bold text-white group-hover:text-brand-accent transition-colors">
                Etik Fil Barınakları
              </h3>
              <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed line-clamp-2">
                Zincirsiz, hayvan refahına uygun doğal koruma alanlarında besleme ve bakım.
              </p>
              <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-brand-accent group-hover:text-white transition-colors">
                İncele <span>→</span>
              </div>
            </div>
          </a>
        </FadeIn>
      </div>

      <!-- 5. Kültür & Sahne Şovları (4 Cols) -->
      <div class="md:col-span-2 lg:col-span-4">
        <FadeIn delay={0.4} direction="up" className="h-full">
          <a
            href="/turlar/?kategori=entertainment-tours"
            class="group relative block h-[320px] lg:h-[350px] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-slate-200/40 dark:border-white/10"
          >
            <img
              src="/assets/culture.webp"
              alt="Phuket Kültür ve Sahne Şovları"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>
            
            <div class="absolute top-5 left-5 z-10">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold border border-white/20">
                <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15 8.5 10.5 4 9l4.5-1.5L10 3l1.5 4.5L16 9l-4.5 1.5z"/><path d="M17.5 20.5 16.75 18l-2.25-.75 2.25-.75.75-2.5.75 2.5 2.25.75-2.25.75z"/></svg>
                Sahne & Eğlence
              </span>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
              <h3 class="font-serif text-xl lg:text-2xl font-bold text-white group-hover:text-brand-accent transition-colors">
                Kültür & Sahne Şovları
              </h3>
              <p class="text-slate-300 text-xs sm:text-sm mt-1.5 leading-relaxed line-clamp-2">
                Carnival Magic, Simon Cabaret ve Siam Niramit ışık ve dans gösterileri.
              </p>
              <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-brand-accent group-hover:text-white transition-colors">
                İncele <span>→</span>
              </div>
            </div>
          </a>
        </FadeIn>
      </div>
    </div>
  </div>
</section>
