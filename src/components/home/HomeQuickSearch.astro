---
import FadeIn from '../ui/FadeIn';

interface Props {
  className?: string;
  title?: string;
  badge?: string;
}

const {
  className = '',
  title = 'Hızlı Tur Arama & Akıllı Filtre',
  badge = '18 Aktif Rota · Türkçe Rehber Güvencesi',
} = Astro.props;

const categories = [
  { value: 'all', label: 'Tüm Kategoriler' },
  { value: 'island-tours', label: '🏝️ Ada Turları (Phi Phi, James Bond)' },
  { value: 'private-charters', label: '🛥️ Özel Yat & Katamaran' },
  { value: 'adventure-tours', label: '⚡ Macera & Doğa (Rafting, ATV)' },
  { value: 'entertainment-tours', label: '🎭 Şov & Tematik Parklar' },
];

const durations = [
  { value: 'all', label: 'Tüm Süreler' },
  { value: 'full-day', label: 'Tam Gün (08:00 - 17:00)' },
  { value: 'half-day', label: 'Yarım Gün (Sabah / Öğleden Sonra)' },
  { value: 'sunset', label: 'Gün Batımı & Akşam Rotaları' },
];

const travelerTypes = [
  { value: 'all', label: 'Herkes İçin Uygun' },
  { value: 'couple', label: '💑 Balayı & Çift' },
  { value: 'family', label: '👨‍👩‍👧‍👦 Aile & Çocuklu' },
  { value: 'friends', label: '⚡ Arkadaş Grubu & Macera' },
];
---

<div class={`w-full max-w-5xl mx-auto px-4 ${className}`}>
  <FadeIn client:load delay={0.7} direction="up">
    <div class="relative rounded-3xl bg-slate-900/85 backdrop-blur-xl border border-white/20 p-4 sm:p-6 shadow-2xl shadow-slate-950/50">
      
      <!-- Üst Mini Başlık -->
      <div class="flex items-center justify-between gap-4 mb-4 pb-3 border-b border-white/10 text-xs">
        <div class="flex items-center gap-2 text-amber-400 font-bold uppercase tracking-wider">
          <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>{title}</span>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-slate-300 text-[11px]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{badge}</span>
        </span>
      </div>

      <!-- Arama Formu -->
      <form id="home-quick-search-form" action="/turlar/" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 items-end">
        
        <!-- 1. Kategori -->
        <div class="space-y-1.5">
          <label for="search-category" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
            Tur Kategorisi
          </label>
          <div class="relative">
            <select
              id="search-category"
              name="kategori"
              class="w-full px-3.5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 focus:bg-slate-900 border border-white/15 focus:border-brand-gold text-white text-xs sm:text-sm font-medium transition-colors appearance-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-brand-gold pr-9"
            >
              {categories.map((cat) => (
                <option value={cat.value} class="bg-slate-900 text-white py-2">
                  {cat.label}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <!-- 2. Tur Süresi -->
        <div class="space-y-1.5">
          <label for="search-duration" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
            Tur Süresi
          </label>
          <div class="relative">
            <select
              id="search-duration"
              name="sure"
              class="w-full px-3.5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 focus:bg-slate-900 border border-white/15 focus:border-brand-gold text-white text-xs sm:text-sm font-medium transition-colors appearance-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-brand-gold pr-9"
            >
              {durations.map((dur) => (
                <option value={dur.value} class="bg-slate-900 text-white py-2">
                  {dur.label}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <!-- 3. Seyahat Tarzı -->
        <div class="space-y-1.5">
          <label for="search-style" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300">
            Seyahat Tarzı
          </label>
          <div class="relative">
            <select
              id="search-style"
              name="tarz"
              class="w-full px-3.5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 focus:bg-slate-900 border border-white/15 focus:border-brand-gold text-white text-xs sm:text-sm font-medium transition-colors appearance-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-brand-gold pr-9"
            >
              {travelerTypes.map((t) => (
                <option value={t.value} class="bg-slate-900 text-white py-2">
                  {t.label}
                </option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <!-- 4. Aksiyon Butonu -->
        <div>
          <button
            type="submit"
            class="w-full h-[46px] rounded-2xl bg-brand-accent hover:bg-brand-accent/90 text-white font-semibold text-sm shadow-md shadow-slate-950/20 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Turları Bul</span>
          </button>
        </div>
      </form>
    </div>
  </FadeIn>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('home-quick-search-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const catSelect = document.getElementById('search-category') as HTMLSelectElement | null;
      const targetCategory = catSelect?.value;

      if (!targetCategory || targetCategory === 'all') {
        window.location.href = '/turlar/';
      } else {
        window.location.href = `/turlar/?kategori=${encodeURIComponent(targetCategory)}`;
      }
    });
  });
</script>
