---
import siteSettingsJson from '../../content/settings/site.json';

interface BadgeItem {
  icon: string;
  title: string;
  desc: string;
  highlight: string;
}

interface Props {
  className?: string;
  badges?: BadgeItem[];
  /** Panel ayarlarıyla merge edilmiş değerler (index.astro'dan gelir). */
  googleRating?: string;
  googleReviewCount?: number;
}

const { className = '', badges: customBadges, googleRating: ratingProp, googleReviewCount: countProp } = Astro.props;

// Yorum sayısı/puanı TEK KAYNAK: önce prop (panel merge'li siteSettings),
// o yoksa statik site.json. Dört ayrı dosyada elle yazılı "148+", "150+",
// "4.9" değerleri birbirinden kopuktu — artık buradan besleniyor.
const googleRating = ratingProp || (siteSettingsJson as Record<string, unknown>)?.googleRating || '4.9';
const googleReviewCount = countProp || Number((siteSettingsJson as Record<string, unknown>)?.googleReviewCount) || 148;

const defaultBadges: BadgeItem[] = [
  {
    icon: '⭐',
    title: `${googleReviewCount}+ Doğrulanmış Yorum`,
    desc: `${googleRating}/5 Google ve sosyal medya puanı, gerçek misafir değerlendirmeleri`,
    highlight: 'Kanıtlanmış Memnuniyet',
  },
  {
    icon: '🇹🇷',
    title: 'Phuket Merkezli Yerel Ekip',
    desc: 'Yerinde Türk operasyon ekibi ve dil engelsiz Türkçe rehberlik desteği',
    highlight: 'Yerinde Türk Ekip',
  },
  {
    icon: '🚐',
    title: 'Otelinizden Klimalı Alım',
    desc: 'Tüm turlarda otelinizden iskeleye çift yönlü konforlu VIP transfer',
    highlight: 'Kapıdan Kapıya',
  },
  {
    icon: '🛡️',
    title: 'T.A.T. Lisans No: 34/02894',
    desc: 'Tayland Turizm Bakanlığı resmi seyahat acentesi lisansı ve tam yasal güvence',
    highlight: 'Resmi Acente',
  },
];

const badges = customBadges && customBadges.length > 0 ? customBadges : defaultBadges;
---

<section class={`py-7 bg-white dark:bg-surface-2 border-y border-slate-200/80 dark:border-slate-800/80 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-slate-200/80 dark:divide-slate-700/70">
      {badges.map((badge) => (
        <div class="flex items-start gap-2.5 px-3 py-2 sm:px-5 sm:py-1.5 first:pl-0 last:pr-0 group">
          <span class="text-xl sm:text-2xl shrink-0 opacity-80 transition-transform duration-300 group-hover:scale-105" aria-hidden="true">
            {badge.icon}
          </span>
          <div class="min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-[0.14em] text-brand-accent dark:text-amber-400">
              {badge.highlight}
            </span>
            <h3 class="font-bold text-xs sm:text-sm text-brand-primary dark:text-white truncate mt-0.5">
              {badge.title}
            </h3>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2 mt-0.5 leading-relaxed font-light">
              {badge.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
