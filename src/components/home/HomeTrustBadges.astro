---
import siteSettingsJson from '../../content/settings/site.json';

interface BadgeItem {
  icon?: string;
  iconType?: 'star' | 'flag' | 'van' | 'shield';
  title: string;
  desc: string;
  highlight: string;
}

interface Props {
  className?: string;
  badges?: BadgeItem[];
  /** Panel ayarlarıyla merge edilmiş değerler (index.astro'dan gelir). */
  googleRating?: string;
  googleReviewCount?: number;
}

const { className = '', badges: customBadges, googleRating: ratingProp, googleReviewCount: countProp } = Astro.props;

const googleRating = ratingProp || (siteSettingsJson as Record<string, unknown>)?.googleRating || '4.9';
const googleReviewCount = countProp || Number((siteSettingsJson as Record<string, unknown>)?.googleReviewCount) || 148;

const defaultBadges: BadgeItem[] = [
  {
    iconType: 'star',
    title: `${googleReviewCount}+ Doğrulanmış Yorum`,
    desc: `${googleRating}/5 Google ve sosyal medya puanı, gerçek misafir değerlendirmeleri`,
    highlight: 'Kanıtlanmış Memnuniyet',
  },
  {
    iconType: 'flag',
    title: 'Phuket Merkezli Yerel Ekip',
    desc: 'Yerinde Türk operasyon ekibi ve dil engelsiz Türkçe rehberlik desteği',
    highlight: 'Yerinde Türk Ekip',
  },
  {
    iconType: 'van',
    title: 'Otelinizden Klimalı Alım',
    desc: 'Tüm turlarda otelinizden iskeleye çift yönlü konforlu VIP transfer',
    highlight: 'Kapıdan Kapıya',
  },
  {
    iconType: 'shield',
    title: 'T.A.T. Lisans No: 34/02894',
    desc: 'Tayland Turizm Bakanlığı resmi seyahat acentesi lisansı ve tam yasal güvence',
    highlight: 'Resmi Acente',
  },
];

const badges = customBadges && customBadges.length > 0 ? customBadges : defaultBadges;

function resolveBadgeIcon(badge: BadgeItem, index: number): 'star' | 'flag' | 'van' | 'shield' {
  if (badge.iconType) return badge.iconType;
  if (badge.icon?.includes('⭐') || badge.icon?.includes('star')) return 'star';
  if (badge.icon?.includes('🇹🇷') || badge.icon?.includes('flag')) return 'flag';
  if (badge.icon?.includes('🚐') || badge.icon?.includes('van')) return 'van';
  if (badge.icon?.includes('🛡') || badge.icon?.includes('shield')) return 'shield';
  const defaults: ('star' | 'flag' | 'van' | 'shield')[] = ['star', 'flag', 'van', 'shield'];
  return defaults[index % defaults.length];
}
---

<section class={`py-6 bg-white dark:bg-surface-2 border-y border-slate-200 dark:border-slate-800 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-0 lg:divide-x lg:divide-slate-200 dark:lg:divide-slate-800">
      {badges.map((badge, idx) => {
        const iconType = resolveBadgeIcon(badge, idx);
        return (
          <div class="flex items-start gap-3 px-1 sm:px-4 py-1.5 first:pl-0 last:pr-0 group">
            <div class="w-9 h-9 shrink-0 rounded-xl bg-slate-100 dark:bg-slate-800 text-brand-primary dark:text-amber-400 flex items-center justify-center shadow-xs">
              {iconType === 'star' && (
                <svg class="w-5 h-5 fill-amber-400 text-amber-400" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                </svg>
              )}
              {iconType === 'flag' && (
                <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
                </svg>
              )}
              {iconType === 'van' && (
                <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 17a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4zM3 9h11v6H3V9zm11 2h4l3 3v1h-7v-4z" />
                </svg>
              )}
              {iconType === 'shield' && (
                <svg class="w-5 h-5 text-brand-primary dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
            </div>
            <div class="min-w-0">
              <span class="block text-[11px] font-semibold text-brand-accent dark:text-amber-400">
                {badge.highlight}
              </span>
              <h3 class="font-bold text-xs sm:text-sm text-brand-primary dark:text-white truncate mt-0.5">
                {badge.title}
              </h3>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2 mt-0.5 leading-relaxed">
                {badge.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
