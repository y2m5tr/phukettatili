---
import FadeIn from '../ui/FadeIn';
import { resolveAssetUrl } from '../../lib/assets';

export interface GuestMoment {
  image: string;
  title: string;
  tag: string;
  location: string;
}

interface Props {
  guestMoments?: GuestMoment[];
  instagramUrl?: string;
  instagramHandle?: string;
  badge?: string;
  title?: string;
  subtitle?: string;
}

const defaultMoments: GuestMoment[] = [
  {
    image: 'couple.webp',
    title: 'Phi Phi & Maya Bay',
    tag: 'Balayı & Çift Rotaları',
    location: 'Phi Phi Adaları',
  },
  {
    image: 'pileh.webp',
    title: 'Zümrüt Lagün Yüzme',
    tag: 'Popüler Ada Turu',
    location: 'Pileh Lagoon',
  },
  {
    image: 'elephant.webp',
    title: 'Etik Fil Barınağı',
    tag: 'Doğa & Yaban Hayatı',
    location: 'Phuket Elephant Sanctuary',
  },
  {
    image: 'underwater.webp',
    title: 'Şnorkel & Mercan Resifleri',
    tag: 'Deniz Aktiviteleri',
    location: 'Racha & Coral Adası',
  },
  {
    image: 'bay.webp',
    title: 'Phang Nga Kano Keşfi',
    tag: 'Mağara & Lagün',
    location: 'James Bond & Hong Adası',
  },
];

const { 
  guestMoments: customMoments, 
  instagramUrl = "https://instagram.com/phukettatili",
  badge = "@phukettatili",
  title = "Misafirlerimizin Phuket Anıları",
  subtitle = "Özel turlarımızda misafirlerimizin biriktirdiği gerçek anlar. Güncel ada rotaları ve turlarımızdan hikayeler için bizi Instagram'da takip edin."
} = Astro.props;

const guestMoments = customMoments && customMoments.length > 0 ? customMoments : defaultMoments;
---

<!-- Guest Moments & Social Proof (Instagram) -->
<section class="py-24 bg-white dark:bg-surface-1 px-4 border-t border-slate-100 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <FadeIn client:visible delay={0.1}>
        <div>
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-brand-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">{badge}</span>
          </div>
          <h2 class="text-3xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold tracking-tight">
            {title}
          </h2>
          <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base mt-3 max-w-xl font-light">
            {subtitle}
          </p>
        </div>
      </FadeIn>
      
      <FadeIn client:visible delay={0.2}>
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="premium-cta inline-flex items-center gap-2.5 bg-gradient-to-r from-brand-accent to-amber-700 hover:from-amber-700 hover:to-amber-800 text-white px-6 py-3.5 rounded-full text-sm font-bold shadow-lg transition-all transform hover:scale-105 shrink-0"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          <span>Instagram'da Takip Et</span>
          <span aria-hidden="true">↗</span>
        </a>
      </FadeIn>
    </div>

    <!-- 5-column / responsive grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
      {guestMoments.map((item, index) => (
        <FadeIn client:visible delay={0.08 * index} direction="up">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="premium-card group relative block aspect-[4/5] rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-900 shadow-md hover:shadow-2xl transition-all duration-500 border border-slate-100 dark:border-slate-800"
            aria-label={`${item.title} - Instagram'da incele`}
          >
            <img
              src={resolveAssetUrl(item.image)}
              alt={item.title}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
            />
            
            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent opacity-80 group-hover:opacity-95 transition-opacity duration-300"></div>

            <!-- Instagram Icon Top Right -->
            <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transform translate-y-1 group-hover:translate-y-0 transition-all duration-300">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </div>

            <!-- Content Bottom -->
            <div class="absolute bottom-0 inset-x-0 p-4 text-white">
              <span class="inline-block text-[11px] font-semibold text-amber-300 uppercase tracking-wider mb-1">
                {item.tag}
              </span>
              <h3 class="font-serif text-sm sm:text-base font-bold leading-tight group-hover:text-amber-200 transition-colors">
                {item.title}
              </h3>
              <p class="text-[11px] text-slate-300 flex items-center gap-1 mt-1 opacity-90">
                <svg class="w-3 h-3 text-brand-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span class="truncate">{item.location}</span>
              </p>
            </div>
          </a>
        </FadeIn>
      ))}
    </div>
  </div>
</section>
