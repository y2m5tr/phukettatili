---
import { getMarineSafetyStatus, type MarineSafetyReport } from '../../lib/marineWeather';
import siteSettings from '../../content/settings/site.json';

const settings = siteSettings as any;
const isEnabled = settings?.marineSentinelEnabled !== false;
const mode = settings?.marineSentinelMode || 'auto';

let report: MarineSafetyReport;
try {
  report = await getMarineSafetyStatus();
} catch {
  report = {
    level: 'calm',
    waveHeightMeters: 0.6,
    windSpeedKnots: 8,
    windDirectionText: 'KKB',
    summary: 'Andaman Denizi sakin ve ada turları için ideal koşullarda.',
    warningNote: 'Tüm sürat teknesi ve katamaran turları tam zamanında icra edilmektedir.',
    lastUpdated: new Date().toISOString(),
    source: 'fallback',
    regionStatus: {
      phi_phi: { status: 'safe', note: 'Maya Bay ve Pileh Lagünü sakin, yüzme için mükemmel.' },
      phang_nga: { status: 'safe', note: 'Rüzgardan korunaklı kireçtaşı adaları ve kano rotaları.' },
      racha: { status: 'safe', note: 'Şnorkel görüş mesafesi yüksek (20m+).' },
      similan: { status: 'safe', note: 'Açık deniz seyri uygun.' },
    },
  };
}

// Admin Manuel Operasyon Müdahalesi varsa ez
if (mode === 'manual' && settings?.manualMarineStatus) {
  report.level = settings.manualMarineStatus;
  if (settings.manualMarineText) {
    report.summary = settings.manualMarineText;
    report.warningNote = settings.manualMarineText;
  }
  if (settings.manualMarineWave) {
    report.waveHeightMeters = Number(settings.manualMarineWave);
  }
}

const levelBadge = {
  calm: {
    text: 'Deniz Sakin ve Seyir İçin Uygun',
    color: 'emerald',
    bg: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',
  },
  moderate: {
    text: 'Orta Dalgalı (Güvenli Seyir)',
    color: 'amber',
    bg: 'bg-amber-500/10 border-amber-500/30 text-amber-400',
  },
  severe: {
    text: 'Liman Uyarısı / Yüksek Dalga',
    color: 'rose',
    bg: 'bg-rose-500/10 border-rose-500/30 text-rose-400',
  },
}[report.level] || {
  text: 'Deniz Koşulları Uygun',
  color: 'emerald',
  bg: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',
};
---

{isEnabled && (
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="relative rounded-3xl bg-slate-950 border border-slate-800 p-6 sm:p-10 shadow-2xl overflow-hidden">
      <div class="relative z-10 space-y-6">
        
        <!-- Üst Başlık & Canlı Durum Rozeti -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 border border-sky-500/30 text-sky-400">
              <span class="w-2 h-2 rounded-full bg-sky-400 motion-safe:animate-ping" aria-hidden="true"></span>
              <span>Canlı Andaman Denizi ve Hava Durumu Radarı</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold font-serif text-white tracking-tight">
              Phuket Günlük Seyir ve Şnorkel Güvenlik Raporu
            </h2>
            <p class="text-xs sm:text-sm text-slate-400">
              Tayland Liman Başkanlığı ve Açık Deniz Meteoroloji radarları ile anlık doğrulanmaktadır.
            </p>
          </div>

          <!-- Canlı Güvenlik Seviyesi -->
          <div class={`px-4 py-2.5 rounded-2xl border flex items-center gap-3 shrink-0 ${levelBadge.bg}`}>
            <span class="w-3 h-3 rounded-full bg-current motion-safe:animate-pulse" aria-hidden="true"></span>
            <div>
              <span class="text-[10px] text-slate-400 block">Güncel durum</span>
              <strong class="text-xs sm:text-sm font-bold">{levelBadge.text}</strong>
            </div>
          </div>
        </div>

        <!-- Metrikler & Bölge Kartları -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Metrik 1: Dalga Boyu -->
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-1">
            <span class="text-xs text-slate-400 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M3 9c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2" />
              </svg>
              <span>Dalga Boyu</span>
            </span>
            <div class="text-2xl font-black text-white">
              ~{report.waveHeightMeters} <span class="text-xs font-normal text-slate-400">metre</span>
            </div>
            <span class="text-[11px] text-emerald-400 block font-medium">Sürat tekneleri için sakin</span>
          </div>

          <!-- Metrik 2: Rüzgar -->
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-1">
            <span class="text-xs text-slate-400 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <span>Rüzgar Hızı</span>
            </span>
            <div class="text-2xl font-black text-white">
              {report.windSpeedKnots} <span class="text-xs font-normal text-slate-400">knot</span>
            </div>
            <span class="text-[11px] text-slate-400 block">Yön: {report.windDirectionText}</span>
          </div>

          <!-- Metrik 3: Deniz Suyu Sıcaklığı -->
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-1">
            <span class="text-xs text-slate-400 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Su Sıcaklığı</span>
            </span>
            <div class="text-2xl font-black text-white">
              29°C <span class="text-xs font-normal text-slate-400">Ilık</span>
            </div>
            <span class="text-[11px] text-sky-400 block font-medium">Yüzme için kusursuz</span>
          </div>

          <!-- Metrik 4: Şnorkel Görüş Mesafesi -->
          <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 space-y-1">
            <span class="text-xs text-slate-400 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span>Görüş Mesafesi</span>
            </span>
            <div class="text-2xl font-black text-white">
              18 - 25m
            </div>
            <span class="text-[11px] text-emerald-400 block font-medium">Kristal berraklık</span>
          </div>

        </div>

        <!-- Ada Bölgeleri Durum Özeti -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          
          <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="space-y-0.5 text-xs">
              <strong class="text-white block font-bold">Phi Phi ve Maya Bay</strong>
              <p class="text-slate-400 leading-relaxed">
                Pileh Lagünü ve Maya Bay dalgasız ve yüzme için ideal. Sürat teknesi ve katamaran seferleri açık.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="space-y-0.5 text-xs">
              <strong class="text-white block font-bold">James Bond ve Phang Nga</strong>
              <p class="text-slate-400 leading-relaxed">
                Körfez yapısı rüzgara kapalı olduğundan deniz göl gibi sakin; kano rotaları için elverişli.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-slate-900 border border-slate-800 flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <div class="space-y-0.5 text-xs">
              <strong class="text-white block font-bold">Racha ve Coral Adaları</strong>
              <p class="text-slate-400 leading-relaxed">
                Phuket’e sadece 20 dk mesafede, beyaz kumlu plajlar ve rengarenk mercan resifleri ziyaretçilerini bekliyor.
              </p>
            </div>
          </div>

        </div>

        <!-- Alt Kaptan Tavsiyesi & WhatsApp CTA -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 border-t border-slate-800">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Kaptan Notu:</strong> {report.summary}</span>
          </div>

          <a
            href="/turlar"
            class="inline-flex items-center gap-2 px-5 py-2.5 min-h-[44px] rounded-xl bg-brand-accent hover:bg-brand-accent/90 active:bg-brand-accent/80 text-white font-bold text-xs shadow-md transition-colors shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            <span>Günün Uygun Turlarını İncele</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>

    </div>
  </section>
)}
