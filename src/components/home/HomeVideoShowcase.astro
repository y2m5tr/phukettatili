---
import { resolveAssetUrl, responsiveSrcset } from '../../lib/assets';

interface Props {
  videoSrc?: string;
  posterImage?: string;
  title?: string;
  subtitle?: string;
  badge?: string;
}

const {
  videoSrc = '/assets/tours_video.mp4',
  posterImage = 'phuket_hero.webp',
  title = "Phuket'i Saniyeler İçinde Keşfedin",
  subtitle = "Turlarımızdan kareler: zümrüt lagünler, longtail tekneler, gün batımı yat seyri ve daha fazlası.",
  badge = "Tanıtım Filmi",
} = Astro.props;

const resolvedPoster = resolveAssetUrl(posterImage, '/assets/phuket_hero.webp');
---

<section class="relative py-20 bg-white dark:bg-surface-1 px-4 border-b border-slate-100 dark:border-slate-800/60">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-10">
      <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">{badge}</span>
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-brand-primary dark:text-white mt-2">
        {title}
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base max-w-2xl mx-auto font-light mt-3 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Video Trigger Card (video yüklenmez, sadece tıklanınca) -->
    <button
      id="home-video-trigger"
      type="button"
      class="group relative block w-full aspect-video rounded-3xl overflow-hidden shadow-2xl border border-slate-200/40 dark:border-white/10 transition-all duration-500 hover:shadow-3xl focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-accent/50"
      aria-label="Tanıtım videosunu oynat"
    >
      <!-- Poster: hero görseli -->
      <img
        src={resolvedPoster}
        srcset={responsiveSrcset(resolvedPoster)}
        sizes="(min-width: 1152px) 1152px, 100vw"
        alt="Phuket tanıtım videosu kapak görüntüsü"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      <!-- Karartma katmanı -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/30 to-transparent"></div>

      <!-- Merkez Play Butonu -->
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/15 backdrop-blur-md border border-white/30 shadow-2xl transition-all duration-300 group-hover:bg-brand-accent/90 group-hover:scale-110 group-hover:border-transparent">
          <span class="absolute inset-0 rounded-full bg-white/10 animate-ping group-hover:animate-none" aria-hidden="true"></span>
          <svg class="relative w-9 h-9 md:w-11 md:h-11 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </span>
      </div>

      <!-- Alt Bilgi Bandı -->
      <div class="absolute bottom-0 left-0 right-0 p-5 md:p-7 flex items-center justify-between">
        <div class="text-left">
          <p class="font-serif text-lg md:text-xl font-bold text-white">Phuket Tatili — Turlardan Kareler</p>
          <p class="text-slate-300 text-xs md:text-sm mt-0.5">01:00 · Tanıtım Filmi</p>
        </div>
        <span class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white text-xs font-semibold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M10 9l5 3-5 3V9z"></path></svg>
          Tam Ekran İzle
        </span>
      </div>
    </button>
  </div>
</section>

<!-- Fullscreen Video Modal -->
<div
  id="home-video-modal"
  class="fixed inset-0 z-[100] bg-slate-950/95 backdrop-blur-md hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Tanıtım Videosu"
>
  <button
    id="home-video-close"
    type="button"
    class="absolute top-5 right-5 z-10 p-3 rounded-full bg-white/10 hover:bg-white/25 text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
    aria-label="Videoyu kapat"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>

  <div class="w-full max-w-6xl">
    <video
      id="home-video-player"
      class="w-full max-h-[80vh] rounded-2xl shadow-2xl bg-black"
      src={videoSrc}
      controls
      playsinline
      preload="none"
    ></video>
    <p class="text-center text-slate-400 text-xs mt-4">ESC tuşu veya kapat butonu ile çıkabilirsiniz</p>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const trigger = document.getElementById('home-video-trigger');
    const modal = document.getElementById('home-video-modal');
    const player = document.getElementById('home-video-player') as HTMLVideoElement | null;
    const closeBtn = document.getElementById('home-video-close');

    if (!trigger || !modal || !player) return;
    if (trigger.dataset.bound === 'true') return;
    trigger.dataset.bound = 'true';

    const openModal = () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      player.play().catch(() => { /* otomatik oynatma engellendiyse kullanıcı kontrolle başlatır */ });
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      player.pause();
      player.currentTime = 0;
    };

    trigger.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    document.addEventListener('astro:before-swap', () => {
      if (!modal.classList.contains('hidden')) {
        player.pause();
        document.body.style.overflow = '';
      }
    }, { once: true });
  });
</script>