---
import type { CollectionEntry } from 'astro:content';
import FadeIn from '../ui/FadeIn';
import { resolveAssetUrl, responsiveSrcset } from '../../lib/assets';
import { fmtMoney } from '../../lib/moneyFormat';

interface Props {
  featuredTours: CollectionEntry<'tours'>[];
}

const { featuredTours } = Astro.props;

function getDifferentiatorBadge(tour: CollectionEntry<'tours'>, index: number): string {
  const slug = tour.id || '';
  if (slug.includes('phi-phi')) return '⭐ En Çok Tercih Edilen';
  if (slug.includes('james-bond')) return '🛶 Kano & Mağara Keşfi';
  if (slug.includes('fil')) return '🐘 Etik & Aile Dostu';
  if (slug.includes('yat') || slug.includes('charter') || slug.includes('moonlight')) return '👑 Özel VIP Tekne';
  if (index === 0) return '⭐ En Çok Tercih Edilen';
  if (index === 1) return '🇹🇷 Türkçe Rehber Destekli';
  return '🌴 Özel Ada Deneyimi';
}
---

<!-- Featured Tours -->
<section class="py-20 md:py-24 bg-slate-50 dark:bg-surface-1 px-4 overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <FadeIn delay={0.1}>
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-14 gap-4">
        <div class="max-w-xl">
          <span class="block text-xs tracking-[0.2em] uppercase text-brand-accent font-sans font-bold mb-3">Öne Çıkan Deneyimler</span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold tracking-tight">Phuket'i En Güzel Haliyle Yaşayın</h2>
          <p class="text-slate-600 dark:text-slate-400 mt-3 text-sm sm:text-base leading-relaxed">Yerel ekibimizin bizzat denetlediği, Türkçe rehber destekli ve misafirlerimizin en yüksek puan verdiği özel rotalar.</p>
        </div>
        <a href="/turlar" class="hidden md:inline-flex items-center gap-2 text-sm font-bold text-brand-accent hover:text-brand-primary dark:hover:text-white transition-colors pb-1">
          Tüm Turları İncele
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </FadeIn>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTours.length > 0 ? featuredTours.map((tour, index) => {
        const differentiator = getDifferentiatorBadge(tour, index);
        const hasPrice = tour.data.price_thb && tour.data.price_thb > 0;
        
        return (
          <FadeIn delay={0.15 + (index * 0.12)} direction="up">
            <a href={`/turlar/${tour.id}`} class="premium-card group flex flex-col h-full rounded-2xl overflow-hidden bg-white dark:bg-slate-800/90 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200/80 dark:border-slate-700/80">
              {/* Görsel Alanı */}
              <div class="relative h-64 overflow-hidden bg-slate-900">
                <img
                  src={resolveAssetUrl(tour.data.image)}
                  srcset={responsiveSrcset(tour.data.image)}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt={tour.data.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/20 to-transparent"></div>
                
                {/* 1. Rozet: Farklılaştırıcı Özellik */}
                <div class="absolute top-3.5 left-3.5 bg-slate-900/85 backdrop-blur-md text-white text-[11px] font-semibold px-3 py-1.5 rounded-full border border-white/15 shadow-sm">
                  {differentiator}
                </div>

                {/* 2. Rozet: Süre */}
                <div class="absolute top-3.5 right-3.5 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md text-slate-800 dark:text-slate-200 text-[11px] font-semibold px-2.5 py-1.5 rounded-full shadow-sm flex items-center gap-1">
                  <span>⏱️</span>
                  <span>{tour.data.duration || 'Tam Gün'}</span>
                </div>

                {/* Görsel altı kategori bilgisi */}
                <div class="absolute bottom-3 left-4 text-[11px] font-bold uppercase tracking-wider text-amber-300/90">
                  {tour.data.category_label || 'Ada & Doğa Turu'}
                </div>
              </div>

              {/* İçerik Alanı */}
              <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="text-lg sm:text-xl font-serif font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white leading-snug">
                    {tour.data.title}
                  </h3>
                  <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm mb-4 line-clamp-2 leading-relaxed">
                    {tour.data.excerpt}
                  </p>
                </div>

                {/* Satış Odaklı Fiyat & Aksiyon Çubuğu */}
                <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700/80 pt-4 mt-2">
                  <div>
                    <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                      {hasPrice ? 'Kişi Başı' : 'Fiyat'}
                    </span>
                    {hasPrice ? (
                      <span class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight">
                        {fmtMoney(tour.data.price_thb || 0)} <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">THB</span>
                      </span>
                    ) : (
                      <span class="text-xs font-bold text-brand-accent bg-brand-accent/10 px-2.5 py-1 rounded-full">
                        Teklif İsteyin
                      </span>
                    )}
                  </div>

                  <span class="inline-flex items-center gap-1 text-xs font-bold text-brand-primary dark:text-white group-hover:text-brand-accent transition-colors px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-700/60 group-hover:bg-brand-accent/10">
                    İncele
                    <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </span>
                </div>
              </div>
            </a>
          </FadeIn>
        );
      }) : (
        <div class="col-span-3 text-center text-slate-500 py-10">Turlar yükleniyor...</div>
      )}
    </div>
    
    <FadeIn delay={0.3}>
      <div class="text-center mt-10 md:hidden">
        <a href="/turlar" class="inline-flex items-center gap-2 text-sm font-bold text-brand-accent hover:text-brand-primary dark:hover:text-white transition-colors">
          Tüm Turları İncele 
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    </FadeIn>
  </div>
</section>
