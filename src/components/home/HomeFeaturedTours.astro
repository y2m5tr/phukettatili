---
import type { CollectionEntry } from 'astro:content';
import TourCardImageCarousel from '../tour/TourCardImageCarousel.astro';
import { fmtMoney } from '../../lib/moneyFormat';

interface Props {
  featuredTours: CollectionEntry<'tours'>[];
}

const { featuredTours } = Astro.props;

function getDifferentiatorBadge(tour: CollectionEntry<'tours'>, index: number): string {
  const slug = tour.id || '';
  if (slug.includes('phi-phi')) return 'En Çok Tercih Edilen';
  if (slug.includes('james-bond')) return 'Kano & Mağara';
  if (slug.includes('fil')) return 'Etik & Aile Dostu';
  if (slug.includes('yat') || slug.includes('charter') || slug.includes('moonlight')) return 'Özel VIP Tekne';
  if (index === 0) return 'En Çok Tercih Edilen';
  if (index === 1) return 'Türkçe Rehberli';
  return 'Özel Ada Deneyimi';
}
---

<!-- Featured Tours -->
<section class="py-16 md:py-24 bg-slate-50 dark:bg-surface-1 px-4 overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 md:mb-12 gap-5">
      <div class="max-w-2xl">
        <h2 class="text-3xl sm:text-4xl md:text-5xl text-brand-primary dark:text-white font-serif font-bold tracking-tight">
          Phuket’i En Güzel Haliyle Yaşayın
        </h2>
        <p class="text-slate-600 dark:text-slate-400 mt-3 text-sm sm:text-base leading-relaxed">
          Yerel ekibimizin bizzat denetlediği, Türkçe rehber destekli ve misafirlerimizin en yüksek puan verdiği özel rotalar.
        </p>
      </div>
      <a 
        href="/turlar" 
        class="hidden md:inline-flex items-center gap-2 text-sm font-bold text-brand-accent hover:text-brand-primary dark:hover:text-white transition-colors pb-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-lg"
      >
        Tüm Turları İncele
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTours.length > 0 ? featuredTours.map((tour, index) => {
        const differentiator = getDifferentiatorBadge(tour, index);
        const hasPrice = tour.data.price_thb && tour.data.price_thb > 0;

        return (
          <a 
            href={`/turlar/${tour.id}`} 
            class="premium-card group flex flex-col h-full rounded-2xl overflow-hidden bg-white dark:bg-slate-800 shadow-sm hover:shadow-xl active:bg-slate-50 dark:active:bg-slate-700/60 transition-shadow duration-200 border border-slate-200 dark:border-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            {/* Görsel Alanı (Parmakla Kaydırılabilir Galeri & Carousel) */}
            <div class="relative h-64 overflow-hidden bg-slate-900">
              <TourCardImageCarousel
                image={tour.data.image || '/assets/phuket_hero.webp'}
                gallery={tour.data.gallery}
                title={tour.data.title}
              />
              
              {/* 1. Rozet: Farklılaştırıcı Özellik */}
              <div class="absolute top-3.5 left-3.5 bg-slate-900 text-white text-[11px] font-semibold px-3 py-1.5 rounded-full border border-slate-800 shadow-sm z-20 pointer-events-none">
                {differentiator}
              </div>

              {/* 2. Rozet: Süre */}
              <div class="absolute top-3.5 right-3.5 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 text-[11px] font-semibold px-2.5 py-1.5 rounded-full border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-1 z-20 pointer-events-none">
                <span>{tour.data.duration || 'Tam Gün'}</span>
              </div>

              {/* Görsel altı kategori bilgisi */}
              <div class="absolute bottom-3 left-4 text-[11px] font-semibold text-amber-300 z-20 pointer-events-none">
                {tour.data.category_label || 'Ada ve Doğa Turu'}
              </div>
            </div>

            {/* İçerik Alanı */}
            <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
              <div>
                <h3 class="text-lg sm:text-xl font-serif font-bold mb-2 group-hover:text-brand-accent transition-colors text-brand-primary dark:text-white leading-snug">
                  {tour.data.title}
                </h3>
                <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm mb-4 line-clamp-2 leading-relaxed">
                  {tour.data.excerpt}
                </p>
              </div>

              {/* Satış Odaklı Fiyat & Aksiyon Çubuğu */}
              <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700/80 pt-4 mt-2">
                <div>
                  <span class="block text-[11px] font-medium text-slate-500 dark:text-slate-400">
                    {hasPrice ? 'Kişi başı' : 'Fiyat'}
                  </span>
                  {hasPrice ? (
                    <span class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                      <span data-thb-price={tour.data.price_thb} data-price-label="kişi başı">{fmtMoney(tour.data.price_thb || 0)} THB</span>
                      <span class="block text-[10px] font-medium text-slate-400" data-price-secondary></span>
                    </span>
                  ) : (
                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full flex items-center gap-1.5 mt-0.5">
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                      WhatsApp ile Fiyat Al
                    </span>
                  )}
                </div>

                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-950 bg-brand-gold hover:bg-amber-300 transition-colors px-3.5 py-2 min-h-[38px] rounded-xl shadow-sm">
                  <span>İncele</span>
                  <svg class="w-3.5 h-3.5 motion-safe:group-hover:translate-x-0.5 motion-safe:transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </span>
              </div>
            </div>
          </a>
        );
      }) : (
        <div class="col-span-3 text-center text-slate-500 py-10">Turlar yükleniyor…</div>
      )}
    </div>
    
    <div class="text-center mt-10 md:hidden">
      <a 
        href="/turlar" 
        class="inline-flex items-center justify-center gap-2 text-sm font-bold text-brand-accent hover:text-brand-primary dark:hover:text-white transition-colors min-h-[44px] px-6 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
      >
        Tüm Turları İncele 
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </div>
</section>
