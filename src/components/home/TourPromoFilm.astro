---
// TourPromoFilm — Animasyonlu tanıtım filmi (mp4 yok, sıfır video yükü).
// 3 perde: (1) çizgi film tarzı SVG açılış — Phuket'e uçuş, (2) gerçek tur
// fotoğraflarıyla Ken Burns kurgusu ve tur başlıkları, (3) logo + kapanış CTA.
// Görünür olunca kendiliğinden oynar; duraklat/devam, döngü ve
// prefers-reduced-motion desteği içerir. Sahne SVG'leri ayrı dosyalarda:
// TourPromoFilmScenesA.astro (S1-5) ve TourPromoFilmScenesB.astro (S6-9)
import TourPromoFilmScenesA from './TourPromoFilmScenesA.astro';
import TourPromoFilmScenesB from './TourPromoFilmScenesB.astro';
const scenes = [
  { title: 'Lagünde Kano', sub: 'Karst kayaların arasına kürek çek' },
  { title: 'Şnorkelle Şaşkın Balıklar', sub: 'Kristal suda renk cümbüşü' },
  { title: 'Fillerle Tanış', sub: 'Kurtarılmış filler: besleme ve bakım' },
  { title: 'Zipline Havada Uçuş', sub: 'Ormanın tepesinden süzül' },
  { title: 'ATV ile Orman Patisi', sub: 'Çamur, toz, adrenalin' },
  { title: 'Adalar Arası Sürat', sub: 'Sürat teknesiyle lagünden lagüne' },
  { title: 'Akşam Gösterileri', sub: 'Siam Niramit · FantaSea · Carnival Magic' },
  { title: 'Gün Batımı Yat Keyfi', sub: 'Andaman denizi altın rengi' },
  { title: 'Gece Denizde Yıldızlar', sub: 'Kano ve parlayan plankton' },
];

const INTRO_MS = 5500;
const SLIDE_MS = 3000;
const OUTRO_MS = 6000;
const HOLD_MS = 2000;
---

<section class="relative py-16 md:py-20 bg-white dark:bg-surface-1 px-4" aria-label="Tanıtım filmi">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-8 md:mb-10">
      <span class="text-xs uppercase tracking-widest text-brand-accent font-bold">Tanıtım Filmi</span>
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-brand-primary dark:text-white mt-2">
        Phuket'te Seni Neler Bekliyor?
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base max-w-2xl mx-auto font-light mt-3 leading-relaxed">
        Sabah koresinden gece planktonuna — tatilinin filmi, daha başlamadan gör.
      </p>
    </div>

    <div
      id="promo-film-stage"
      class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-2xl border border-slate-200/40 dark:border-white/10 bg-sky-100 select-none"
      aria-label="Phuket tur aktivitelerini gösteren animasyonlu tanıtım filmi"
    >
      <!-- ═══ PERDE 1: Çizgi film açılış — Phuket'e uçuş ═══ -->
      <div data-act="intro" class="absolute inset-0 opacity-0 transition-opacity duration-700" aria-hidden="true">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full">
          <defs>
            <linearGradient id="pf-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8fd4f2" />
              <stop offset="0.62" stop-color="#cbeef8" />
              <stop offset="1" stop-color="#fdeec9" />
            </linearGradient>
            <linearGradient id="pf-sea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3fb3dd" />
              <stop offset="1" stop-color="#8fdcee" />
            </linearGradient>
            <path id="pf-route" d="M 140 200 C 420 90, 760 320, 1010 250 S 1330 420, 1180 560" />
          </defs>

          <rect width="1600" height="900" fill="url(#pf-sky)" />
          <!-- güneş -->
          <g class="pf-sun">
            <circle cx="1330" cy="150" r="46" fill="#ffcf6e" />
            <circle cx="1330" cy="150" r="72" fill="#ffcf6e" opacity="0.25" />
          </g>
          <!-- bulutlar -->
          <g fill="#ffffff" opacity="0.9">
            <g class="pf-cloud-1"><ellipse cx="260" cy="170" rx="70" ry="24" /><ellipse cx="320" cy="158" rx="46" ry="18" /></g>
            <g class="pf-cloud-2"><ellipse cx="880" cy="120" rx="58" ry="20" /><ellipse cx="930" cy="110" rx="38" ry="14" /></g>
          </g>

          <!-- deniz -->
          <rect y="560" width="1600" height="340" fill="url(#pf-sea)" />
          <g class="pf-waves-a" stroke="#ffffff" stroke-width="4" fill="none" opacity="0.5" stroke-linecap="round">
            <path d="M0 620 q 40 -14 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0" />
          </g>
          <g class="pf-waves-b" stroke="#ffffff" stroke-width="3" fill="none" opacity="0.35" stroke-linecap="round">
            <path d="M0 690 q 40 -12 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0 t 80 0" />
          </g>

          <!-- karst silüetleri (ufuk) -->
          <g fill="#5ea286">
            <path d="M600 560 l 40 -110 l 38 110 z" />
            <path d="M660 560 l 55 -150 l 50 150 z" opacity="0.85" />
            <path d="M740 560 l 34 -90 l 30 90 z" />
            <path d="M980 560 l 48 -130 l 42 130 z" opacity="0.9" />
            <path d="M1050 560 l 36 -95 l 32 95 z" />
          </g>
          <g fill="#3f8a6d">
            <path d="M80 560 q 120 -46 240 0 z" />
            <path d="M1310 560 q 110 -40 220 0 z" />
          </g>
          <!-- palmiye -->
          <g>
            <path d="M225 560 q -6 -80 4 -118" stroke="#3f8a6d" stroke-width="10" fill="none" stroke-linecap="round" />
            <g fill="#2f7d61">
              <path d="M229 442 q -50 -22 -78 8 q 46 6 78 -8 z" />
              <path d="M229 442 q 50 -26 82 4 q -50 10 -82 -4 z" />
              <path d="M229 442 q -18 -52 -60 -60 q 30 40 60 60 z" />
              <path d="M229 442 q 20 -54 64 -58 q -34 40 -64 58 z" />
            </g>
          </g>

          <!-- longtail tekne (sallanan) -->
          <g class="pf-boat">
            <g transform="translate(1240 640)">
              <path d="M-70 0 q 70 30 140 0 l -14 6 q -56 18 -112 0 z" fill="#8a5a3b" />
              <path d="M-70 0 q 70 26 140 0 l -8 -14 q -62 -16 -124 0 z" fill="#b07148" />
              <rect x="-8" y="-58" width="8" height="50" fill="#6e452c" />
              <path d="M-4 -58 l 40 12 l -40 10 z" fill="#e05c4a" />
              <circle cx="0" cy="-16" r="4" fill="#f5e9d0" />
              <circle cx="20" cy="-14" r="4" fill="#f5e9d0" />
            </g>
          </g>

          <!-- rota çizgisi -->
          <use href="#pf-route" class="pf-route-draw" stroke="#ffffff" stroke-width="5" stroke-dasharray="1" pathLength="1" stroke-dashoffset="1" stroke-linecap="round" fill="none" opacity="0.85" />

          <!-- uçağın kendisi: rota boyunca uçar -->
          <g>
            <animateMotion class="pf-plane-motion" dur="4.6s" begin="indefinite" fill="freeze" rotate="auto">
              <mpath href="#pf-route" />
            </animateMotion>
            <g transform="translate(0,0)">
              <ellipse rx="34" ry="12" fill="#ffffff" stroke="#d6c9a8" stroke-width="2" />
              <path d="M-6 0 l -26 -22 l 10 24 z" fill="#e8b84b" stroke="#d6a52e" stroke-width="2" />
              <path d="M-6 0 l -26 22 l 10 -24 z" fill="#e8b84b" stroke="#d6a52e" stroke-width="2" />
              <path d="M-2 -8 l 16 -12 l -4 12 z" fill="#e05c4a" />
              <circle cx="12" cy="0" r="3" fill="#7fb3d5" />
              <circle cx="2" cy="0" r="3" fill="#7fb3d5" />
            </g>
          </g>

          <!-- varış pini -->
          <g class="pf-pin" transform="translate(1180 560)">
            <path d="M0 0 c -26 -38 -12 -62 0 -62 c 12 0 26 24 0 62 z" fill="#e05c4a" stroke="#b8422f" stroke-width="3" transform="translate(0,0)" />
            <circle cy="-46" r="11" fill="#fff2e0" />
          </g>
        </svg>

        <!-- Açılış yazısı -->
        <div class="absolute inset-x-0 bottom-[18%] flex flex-col items-center gap-2 px-6 text-center">
          <p class="pf-title font-serif text-3xl md:text-5xl font-bold text-white drop-shadow-[0_3px_10px_rgba(15,60,80,0.45)]">
            Phuket'e Hoş Geldin
          </p>
          <p class="pf-sub text-sm md:text-base text-slate-800/80 font-medium tracking-wide bg-white/60 backdrop-blur-sm px-4 py-1 rounded-full">
            Macera başlamak üzere…
          </p>
        </div>
      </div>

      <!-- ═══ PERDE 2: Misafirin tatil günü — 9 çizgi film sahnesi ═══ -->
      <div data-act="slides" class="absolute inset-0 opacity-0 transition-opacity duration-700" aria-hidden="true">
        <TourPromoFilmScenesA />
        <TourPromoFilmScenesB />
        <!-- Ortak sahne altyazısı: 9 sahnenin hepsi tek katmanı paylaşır,
             metni tourPromoFilm.script.ts aktif sahne index'ine göre yazar. -->
        <div class="pf-caption absolute bottom-0 left-0 right-0 p-5 md:p-7 bg-gradient-to-t from-slate-950/70 to-transparent pointer-events-none">
          <p class="pf-cap-title font-serif text-xl md:text-3xl font-bold text-white drop-shadow-lg">{scenes[0].title}</p>
          <p class="pf-cap-sub text-xs md:text-sm text-slate-200/90 mt-1 font-light tracking-wide">{scenes[0].sub}</p>
        </div>
      </div>

      <!-- ═══ PERDE 3: Kapanış — logo & CTA ═══ -->
      <div data-act="outro" class="absolute inset-0 opacity-0 transition-opacity duration-700 flex flex-col items-center justify-center gap-5 bg-gradient-to-b from-sky-50 via-white to-amber-50 dark:from-slate-900 dark:via-slate-900 dark:to-slate-800 px-6 text-center">
        <img src="/assets/logo-main-transparent.png" alt="Phuket Tatili" class="pf-outro-el w-40 md:w-56 h-auto" loading="lazy" decoding="async" />
        <p class="pf-outro-el font-serif text-2xl md:text-4xl font-bold text-brand-primary dark:text-white leading-snug">
          Phuket'in en iyi günleri,<br /><span class="text-brand-accent italic">senin günlerin.</span>
        </p>
        <a href="/turlar" class="pf-outro-el premium-cta bg-brand-gold hover:bg-amber-300 text-slate-950 px-8 py-3.5 rounded-full font-bold shadow-xl transition-transform duration-300 hover:-translate-y-0.5">
          Turları Keşfet
        </a>
      </div>

      <!-- Kontroller -->
      <button
        id="promo-film-toggle"
        type="button"
        class="absolute bottom-4 right-4 z-20 flex items-center justify-center w-11 h-11 rounded-full bg-slate-950/45 hover:bg-slate-950/70 backdrop-blur-md text-white border border-white/25 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
        aria-label="Tanıtım filmini duraklat"
      >
        <svg class="w-5 h-5 hidden" data-icon="pause" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5h4v14H7zM13 5h4v14h-4z" />
        </svg>
        <svg class="w-5 h-5 hidden" data-icon="play" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg class="w-5 h-5 hidden" data-icon="replay" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" />
        </svg>
      </button>

      <!-- İlerleme çubuğu -->
      <div class="absolute bottom-0 left-0 right-0 h-1 z-20 bg-white/25">
        <div id="promo-film-progress" class="h-full bg-brand-gold origin-left" style="transform: scaleX(0)"></div>
      </div>
    </div>
    <p class="text-center text-slate-400 dark:text-slate-500 text-xs mt-3">Filmi duraklatabilirsin — sağ alttaki tuşla devam ettir.</p>
  </div>
</section>

<style is:global>
  @import './tourPromoFilm.css';
</style>

<script>
  import { initPromoFilm } from './tourPromoFilm.script';
  initPromoFilm();
</script>
