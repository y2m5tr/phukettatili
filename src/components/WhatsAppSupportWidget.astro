---
import siteSettings from '../content/settings/site.json';

const whatsappNumber = siteSettings?.whatsappNumber || '66828950665';
---

<!-- Proactive WhatsApp Support Bubble & Floating Button -->
<aside 
  id="proactive-whatsapp-widget" 
  class="hidden lg:flex fixed bottom-6 right-6 z-40 flex-col items-end pointer-events-none transition-opacity duration-300"
  aria-label="WhatsApp Canlı Destek"
>
  <!-- Chat Popup Bubble -->
  <div 
    id="wa-chat-bubble" 
    class="pointer-events-auto mb-4 hidden max-w-[340px] sm:max-w-[360px] w-[calc(100vw-2rem)] rounded-3xl bg-white dark:bg-slate-900 p-5 shadow-2xl border border-slate-200 dark:border-slate-800 transform translate-y-4 opacity-0 motion-safe:transition-[transform,opacity] duration-300 ease-out origin-bottom-right"
    role="dialog"
    aria-labelledby="wa-bubble-title"
  >
    <!-- Header with Online Badge & Close -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-brand-primary text-white flex items-center justify-center font-bold text-sm shadow-md">
            PT
          </div>
          <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white dark:border-slate-900 motion-safe:animate-pulse" title="Çevrimiçi"></span>
        </div>
        <div>
          <h3 id="wa-bubble-title" class="font-bold text-sm text-slate-900 dark:text-white leading-tight">
            Phuket Tatili Rehberi
          </h3>
          <p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span> Çevrimiçi · Türkçe Destek
          </p>
        </div>
      </div>
      
      <button 
        id="wa-bubble-close-btn" 
        type="button" 
        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 disabled:opacity-50"
        aria-label="Kapat"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Message Content -->
    <div class="bg-slate-50 dark:bg-slate-800/60 p-3.5 rounded-2xl mb-4 text-xs sm:text-sm text-slate-700 dark:text-slate-200 leading-relaxed border border-slate-100 dark:border-slate-700/50">
      <p class="font-bold text-slate-900 dark:text-white" data-wa-widget-context-title>
        Merhaba! Phuket tatilinizi birlikte planlayalım mı?
      </p>
      <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 leading-snug" data-wa-widget-context-subtitle>
        Otel bölgenizi ve tercihlerinizi iletin; <strong>size özel güncel teklifinizi</strong> hazırlayalım.
      </p>
    </div>

    <!-- Quick Action Prompts -->
    <div class="space-y-2">
      <a 
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, Phuket\'te en popüler ada turları ve güncel fiyat teklifleri hakkında bilgi alabilir miyim?')}`}
        target="_blank" 
        rel="noopener noreferrer"
        class="wa-quick-prompt flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl bg-slate-100/80 dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border border-slate-200/60 dark:border-slate-700 hover:border-emerald-300 dark:hover:border-emerald-700 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 group"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Popüler Ada Turları ve Fiyatlar
        </span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 transition-colors motion-safe:group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a 
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, Phuket havalimanı VIP Fast Track ve özel araç transferi için fiyat teklifi almak istiyorum.')}`}
        target="_blank" 
        rel="noopener noreferrer"
        class="wa-quick-prompt flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl bg-slate-100/80 dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border border-slate-200/60 dark:border-slate-700 hover:border-emerald-300 dark:hover:border-emerald-700 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 group"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          VIP Fast Track ve Transfer
        </span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 transition-colors motion-safe:group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a 
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, ailemiz/grubumuz için kişiye özel rota ve paket indirimli fiyat teklifi rica ediyorum.')}`}
        target="_blank" 
        rel="noopener noreferrer"
        class="wa-quick-prompt flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl bg-slate-100/80 dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border border-slate-200/60 dark:border-slate-700 hover:border-emerald-300 dark:hover:border-emerald-700 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 group"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Özel Rota ve Paket İndirimi
        </span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 transition-colors motion-safe:group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Direct WhatsApp Button -->
    <a
      href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Merhaba, Phuket tatili planlaması için bilgi almak istiyorum.')}`}
      target="_blank"
      rel="noopener noreferrer"
      data-wa-lead-source="support-widget"
      class="mt-3.5 flex items-center justify-center gap-2 w-full py-3 min-h-[44px] rounded-xl bg-whatsapp hover:bg-whatsapp-dark active:bg-whatsapp-dark text-white font-bold text-xs sm:text-sm shadow-md shadow-emerald-500/20 transition-colors motion-safe:transition-transform motion-safe:hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span>Canlı WhatsApp Sohbeti Başlat</span>
    </a>
  </div>

  <!-- Trigger Button (Floating WhatsApp Icon) -->
  <div class="pointer-events-auto relative">
    <!-- Unread Notification Badge -->
    <span 
      id="wa-unread-badge" 
      class="absolute -top-1 -right-1 z-10 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold text-white shadow-md motion-safe:animate-pulse"
    >
      1
    </span>

    <button 
      id="wa-trigger-btn"
      type="button"
      class="group flex items-center justify-center min-w-[56px] min-h-[56px] p-3.5 rounded-full bg-whatsapp text-white shadow-2xl hover:bg-whatsapp-dark motion-safe:hover:scale-105 active:bg-whatsapp-dark motion-safe:active:scale-95 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 disabled:opacity-50 disabled:pointer-events-none"
      aria-label="WhatsApp Canlı Danışman"
      aria-expanded="false"
      aria-controls="wa-chat-bubble"
    >
      <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span class="absolute right-full mr-3.5 bg-slate-900 text-white text-xs font-bold py-1.5 px-3 rounded-xl shadow-xl opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
        Canlı Destek
      </span>
    </button>
  </div>
</aside>

<script>
  const SESSION_DISMISS_KEY = 'phuket_wa_bubble_dismissed';

  document.addEventListener('astro:page-load', () => {
    const bubble = document.getElementById('wa-chat-bubble');
    const triggerBtn = document.getElementById('wa-trigger-btn');
    const closeBtn = document.getElementById('wa-bubble-close-btn');
    const badge = document.getElementById('wa-unread-badge');

    if (!bubble || !triggerBtn) return;

    let isOpen = false;

    const openBubble = () => {
      if (isOpen) return;
      isOpen = true;
      bubble.classList.remove('hidden');
      // trigger transition on next frame
      requestAnimationFrame(() => {
        bubble.classList.remove('translate-y-4', 'opacity-0');
        bubble.classList.add('translate-y-0', 'opacity-100');
      });
      triggerBtn.setAttribute('aria-expanded', 'true');
      if (badge) badge.classList.add('hidden');
    };

    const closeBubble = (userInitiated = false) => {
      if (!isOpen) return;
      isOpen = false;
      bubble.classList.remove('translate-y-0', 'opacity-100');
      bubble.classList.add('translate-y-4', 'opacity-0');
      setTimeout(() => {
        if (!isOpen) bubble.classList.add('hidden');
      }, 400);
      triggerBtn.setAttribute('aria-expanded', 'false');

      if (userInitiated) {
        try {
          sessionStorage.setItem(SESSION_DISMISS_KEY, 'true');
        } catch {}
      }
    };

    // Toggle button
    triggerBtn.addEventListener('click', () => {
      if (isOpen) {
        closeBubble(false);
      } else {
        openBubble();
      }
    });

    // Close button inside bubble
    closeBtn?.addEventListener('click', () => closeBubble(true));

    // On mobile (< 1024px), bottom nav is active with WhatsApp center button; disable auto-popup
    if (window.innerWidth < 1024) return;

    // Check if user already dismissed in this session
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(SESSION_DISMISS_KEY) === 'true';
    } catch {}

    if (!dismissed) {
      // 1. Timer: Auto-open after 14 seconds of browsing
      const timer = setTimeout(() => {
        openBubble();
      }, 14000);

      // 2. Desktop Exit-Intent: Show when mouse moves towards top of viewport
      const handleExitIntent = (e: MouseEvent) => {
        if (e.clientY <= 10 && !isOpen) {
          openBubble();
          document.removeEventListener('mouseleave', handleExitIntent);
        }
      };
      document.addEventListener('mouseleave', handleExitIntent);

      // Cleanup on page transitions
      document.addEventListener('astro:before-swap', () => {
        clearTimeout(timer);
        document.removeEventListener('mouseleave', handleExitIntent);
      }, { once: true });
    } else {
      // If already dismissed, hide the notification badge
      if (badge) badge.classList.add('hidden');
    }
  });
</script>
