---
import { resolveAssetUrl } from '../lib/assets';
interface Props {
  tour: {
    id: string;
    data: {
      title: string;
      category_label?: string;
      excerpt?: string;
      image?: string;
      duration?: string;
      price_thb?: number | null;
    };
  };
  badgeText?: string;
  whatsappNumber?: string;
}

const { tour, badgeText = "Rehberde Bahsedilen Öne Çıkan Rota", whatsappNumber = "66828950665" } = Astro.props;
const cleanPhone = whatsappNumber.replace(/[^0-9]/g, '');
---

<div class="related-tour-card my-12 overflow-hidden rounded-3xl border border-slate-700/60 bg-gradient-to-br from-slate-900 via-slate-800 to-brand-primary p-6 text-white shadow-2xl transition-all duration-300 hover:shadow-amber-500/10 sm:p-8 relative group">
  <!-- Ambient background glow -->
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-brand-gold/20 blur-3xl transition-all duration-700 group-hover:bg-brand-gold/30" aria-hidden="true"></div>

  <div class="relative z-10 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
      <!-- Tour Image Thumbnail -->
      <a href={`/turlar/${tour.id}`} class="relative h-32 w-full shrink-0 overflow-hidden rounded-2xl shadow-md sm:h-32 sm:w-36 block">
        <img
          src={resolveAssetUrl(tour.data.image)}
          alt={tour.data.title}
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-brand-primary/20"></div>
      </a>

      <!-- Tour Information -->
      <div class="flex-1">
        <div class="mb-2 inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/15 px-3 py-1 text-xs font-bold uppercase tracking-wider text-amber-300">
          <span>★</span> {badgeText}
        </div>
        <h3 class="font-serif text-xl sm:text-2xl font-bold text-white transition-colors group-hover:text-amber-200">
          <a href={`/turlar/${tour.id}`} class="hover:underline">
            {tour.data.title}
          </a>
        </h3>
        <p class="mt-2 text-sm font-light leading-relaxed text-slate-300 line-clamp-2">
          {tour.data.excerpt}
        </p>

        <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-slate-300">
          {tour.data.duration && (
            <span class="inline-flex items-center gap-1.5 font-medium">
              <svg class="h-4 w-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {tour.data.duration}
            </span>
          )}
          {tour.data.price_thb != null && tour.data.price_thb > 0 ? (
            <span class="font-bold text-white text-sm">
              {tour.data.price_thb.toLocaleString()} THB
            </span>
          ) : (
            <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-amber-300 border border-white/10">
              Fiyat Teklifi Alın
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="shrink-0 flex flex-col sm:flex-row gap-2.5 w-full md:w-auto">
      <a
        href={`/turlar/${tour.id}`}
        class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white px-5 py-3 text-xs font-bold transition-all border border-white/20 md:w-auto"
      >
        <span>Detayları İncele</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent(`Merhaba, "${tour.data.title}" turunuz hakkında bilgi ve fiyat teklifi almak istiyorum.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="premium-cta inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] hover:bg-[#128C7E] px-5 py-3 text-xs font-bold text-white shadow-xl transition-all hover:scale-[1.02] md:w-auto whitespace-nowrap"
      >
        <span>WhatsApp ile Sor</span>
        <span aria-hidden="true">💬</span>
      </a>
    </div>
  </div>
</div>
