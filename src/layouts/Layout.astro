---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tracking from '../components/Tracking.astro';
import WhatsAppSupportWidget from '../components/WhatsAppSupportWidget.astro';
import HolidayShortlist from '../components/ui/HolidayShortlist';
import siteSettings from '../content/settings/site.json';
import { resolveAssetUrl, responsiveSrcset } from '../lib/assets';

interface Props {
	title: string;
	description?: string;
    image?: string;
    preloadImage?: string;
    ogType?: 'website' | 'article';
    publishedTime?: string;
    /** Sayfa başlığı marka son ekini ("| Phuket Tatili") zaten içeriyorsa true */
    noTitleSuffix?: boolean;
    /** Arama motoru indekslemesini kapatmak için (404 vb.) */
    noIndex?: boolean;
    /** Sayfaya özel ek JSON-LD şemaları (Article, Product, FAQPage vb.) */
    schemas?: Record<string, unknown>[];
}

const {
  title,
  description = "Phuket Tatili - En özel anılarınız için lüks ve ayrıcalıklı seyahat deneyimleri.",
  image = "/assets/og-hero.jpg",
  preloadImage,
  ogType = 'website',
  publishedTime,
  noTitleSuffix = false,
  noIndex = false,
  schemas = [],
} = Astro.props;

// Canonical URL normalizasyonu: temiz rotaların sitemap ile uyumlu biçimde son slash ile bitmesini sağlar
const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith('/') || pathname.includes('.')
  ? pathname
  : `${pathname}/`;
const canonicalURL = new URL(normalizedPath, Astro.site || 'https://phukettatili.com');
const imageURL = new URL(image, Astro.site || 'https://phukettatili.com');
const fullTitle = noTitleSuffix || title.includes('Phuket Tatili') ? title : `${title} | Phuket Tatili`;
---

<!doctype html>
<html lang="tr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Phuket Tatili" />
		<meta name="theme-color" content="#0a0f1a" />
		<meta name="generator" content={Astro.generator} />
		<link rel="dns-prefetch" href="//xiyuozntwoqibvwivkms.supabase.co" />
		<link rel="dns-prefetch" href="//wa.me" />
        
        <!-- SEO & OpenGraph -->
        <title>{fullTitle}</title>
		<meta name="description" content={description} />
        {noIndex ? (
          <meta name="robots" content="noindex, nofollow" />
        ) : (
          <meta name="robots" content="index, follow" />
        )}
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="tr" href={canonicalURL} />
        <link rel="alternate" hreflang="x-default" href={canonicalURL} />

        <!-- Google Search Console dogrulama: PUBLIC_GSC_VERIFICATION env veya site.json ile set edilir -->
        {(() => {
          const raw = import.meta.env.PUBLIC_GSC_VERIFICATION || (siteSettings as any)?.googleSiteVerification || (siteSettings as any)?.gscVerification;
          if (!raw) return null;
          const clean = String(raw).replace(/^google-site-verification[=:]\s*/i, '').trim();
          return clean ? <meta name="google-site-verification" content={clean} /> : null;
        })()}

        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="tr_TR" />
        <meta property="og:site_name" content="Phuket Tatili" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />

        <!-- JSON-LD Structured Data: Organization & TravelAgency -->
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "TravelAgency",
          "name": "Phuket Tatili",
          "url": (Astro.site || 'https://phukettatili.com').toString(),
          "image": new URL("/assets/og-hero.jpg", Astro.site || 'https://phukettatili.com').toString(),
          "logo": new URL("/assets/logo-main-transparent.png", Astro.site || 'https://phukettatili.com').toString(),
          "description": "Phuket Tatili - Phuket ve çevresinde Türkçe rehberli ada turları, VIP havalimanı transferi ve özel lüks yat kiralama hizmetleri sunan yerel tur operatörü.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Phuket",
            "addressRegion": "Phuket",
            "addressCountry": "TH"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 7.8804,
            "longitude": 98.3923
          },
          "telephone": "+66 82 895 0665",
          "email": "info@phukettatili.com",
          "sameAs": [
            "https://instagram.com/phukettatili",
            "https://wa.me/66828950665"
          ],
          "priceRange": "$$",
          "currenciesAccepted": "THB, USD, EUR, TRY",
          "paymentAccepted": "Cash, Credit Card, Bank Transfer",
          "knowsLanguage": ["tr", "en", "th"],
          "knowsAbout": [
            "Phuket Turları",
            "Phi Phi Adaları",
            "James Bond Adası",
            "Similan Adaları",
            "Phuket Havalimanı VIP Transfer",
            "Lüks Yat Kiralama",
            "Fil Koruma Alanları"
          ],
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
              ],
              "opens": "08:00",
              "closes": "22:00"
            }
          ],
          // Puan bilgisi TEK KAYNAKTAN: site.json googleRating/googleReviewCount.
          // Değerler yoksa aggregateRating hiç basılmaz (uydurma markup cezası riski).
          ...((siteSettings as any)?.googleRating && (siteSettings as any)?.googleReviewCount ? {
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": String((siteSettings as any).googleRating),
              "reviewCount": String((siteSettings as any).googleReviewCount),
              "bestRating": "5",
              "worstRating": "1"
            }
          } : {}),
          "areaServed": [
            {
              "@type": "Place",
              "name": "Phuket, Thailand"
            },
            {
              "@type": "Place",
              "name": "Krabi, Thailand"
            },
            {
              "@type": "Place",
              "name": "Phang Nga, Thailand"
            }
          ]
        })} />
        {schemas.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />
        ))}

        <!-- Fontlar self-hosted (global.css içinde @fontsource) — dış CDN bağımlılığı yok -->
        {preloadImage && (
          <link
            rel="preload"
            as="image"
            href={resolveAssetUrl(preloadImage)}
            imagesrcset={responsiveSrcset(preloadImage)}
            imagesizes="100vw"
            fetchpriority="high"
          />
        )}

        <!-- Real Web Vitals LCP Measurement via PerformanceObserver -->
        <script is:inline>
          if (typeof PerformanceObserver !== 'undefined' && PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
            try {
              let lcpValue = 0;
              const po = new PerformanceObserver((entryList) => {
                const entries = entryList.getEntries();
                const lastEntry = entries[entries.length - 1];
                if (lastEntry) {
                  lcpValue = Math.round(lastEntry.startTime);
                }
              });
              po.observe({ type: 'largest-contentful-paint', buffered: true });

              const sendLCP = () => {
                if (lcpValue > 0 && typeof window.gtag === 'function') {
                  window.gtag('event', 'page_lcp', {
                    value: lcpValue,
                    metric_rating: lcpValue <= 2500 ? 'good' : lcpValue <= 4000 ? 'needs_improvement' : 'poor',
                  });
                }
              };
              window.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'hidden') sendLCP();
              }, { once: true });
              window.addEventListener('pagehide', sendLCP, { once: true });
            } catch {
              // Graceful fallback
            }
          }
        </script>
        
        <ClientRouter />

        <!-- Dark Mode Setup -->
        <script is:inline>
          // JS etkin işareti — .ptt-fade-in içeriği yalnızca hareket azaltma kapalıysa ve JS varsa gizlenir.
          // prefers-reduced-motion açıkken hiçbir öğe gizlenmez; ilk frame'den itibaren %100 görünür kalır.
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js');
          }
          const applyTheme = () => {
            const theme = (() => {
              if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme');
              }
              if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                return 'dark';
              }
              return 'light';
            })();
            if (theme === 'light') {
              document.documentElement.classList.remove('dark');
            } else {
              document.documentElement.classList.add('dark');
            }
            window.localStorage.setItem('theme', theme);
          };
          applyTheme();
          document.addEventListener('astro:after-swap', applyTheme);
        </script>
        
        <Tracking />
	</head>
	<body class="flex flex-col min-h-screen relative overflow-x-clip">
        <!-- Erişilebilirlik: klavye kullanıcıları header linklerini atlayabilsin -->
        <a
          href="#main-content"
          class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[110] focus:px-4 focus:py-2.5 focus:rounded-xl focus:bg-brand-primary focus:text-white focus:text-sm focus:font-bold focus:shadow-xl"
        >
          İçeriğe geç
        </a>
        <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
        <Header />
        <main id="main-content" class="flex-grow pt-28 sm:pt-32 overflow-x-clip">
		    <slot />
        </main>
        <Footer />
        
        <!-- Proactive Floating WhatsApp Widget -->
        <WhatsAppSupportWidget />

        <!-- Interactive Holiday Shortlist (Wishlist & Multi-Tour Inquiry) -->
        <HolidayShortlist client:idle />

        <script>
          document.addEventListener('astro:page-load', () => {
            // FadeIn gözlemcisi: .ptt-fade-in öğeleri viewport'a girince
            // .is-visible ekler (framer-motion whileInView + once:true eşleniği).
            const fadeEls = document.querySelectorAll<HTMLElement>('.ptt-fade-in:not(.is-visible)');
            if (fadeEls.length === 0) return;
            if (!('IntersectionObserver' in window)) {
              fadeEls.forEach((el) => el.classList.add('is-visible'));
              return;
            }
            const io = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    io.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '120px 0px' },
            );
            fadeEls.forEach((el) => io.observe(el));
          });

          document.addEventListener('astro:page-load', () => {
            // Premium kartlarda imleci takip eden spot ışığı
            if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches ||
                window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const onMove = (e: PointerEvent) => {
              const card = (e.currentTarget as HTMLElement);
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
              card.style.setProperty('--my', `${e.clientY - rect.top}px`);
            };
            document.querySelectorAll<HTMLElement>('.premium-card').forEach((card) => {
              card.addEventListener('pointermove', onMove);
            });
          });

          document.addEventListener('astro:page-load', () => {
            const bar = document.getElementById('scroll-progress');
            if (!bar) return;
            let raf = 0;
            const update = () => {
              raf = 0;
              const max = document.documentElement.scrollHeight - window.innerHeight;
              const pct = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
              bar.style.transform = `scaleX(${pct})`;
            };
            const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
            window.removeEventListener('scroll', (window as any)._onProgressScroll);
            (window as any)._onProgressScroll = onScroll;
            window.addEventListener('scroll', onScroll, { passive: true });
            update();
          });

          // PWA Kurulabilirlik ve Çevrimdışı Bellek (Turist Web App)
          if (typeof window !== 'undefined' && 'serviceWorker' in navigator && !window.location.pathname.startsWith('/admin')) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register('/sw.js').catch(() => {});
            }, { once: true });
          }
        </script>
	</body>
</html>
