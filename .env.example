# ==========================================================================
# PhuketTatili — ortam değişkenleri
#
# Kullanım: bu dosyayı `.env` olarak kopyala ve değerleri doldur.
#   cp .env.example .env
#
# `.env` gitignore'ludur — ASLA commit etme. Vercel'de aynı isimler
# Project → Settings → Environment Variables altında tanımlanır.
#
# Hiçbir değişken ZORUNLU değildir: tanımsızsa uygulama sınırlı modda
# açılır (admin panelleri kilitli kalır, public site statik içerikle
# çalışır). Detaylar her maddenin altında.
# ==========================================================================

# --- SUPABASE -------------------------------------------------------------
# Proje URL'si. Tanımsızsa koddaki varsayılan proje kullanılır
# (src/lib/supabase.ts ve src/lib/server/supabaseAdmin.ts).
# Public bir bilgidir ama astro.config.mjs şemasında `secret` olarak
# tanımlıdır ki build çıktısına gömülmesin.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon / publishable anahtar. Client'ta YALNIZCA realtime broadcast
# sinyalini dinlemek için kullanılır — tablo erişimi YOK (RLS anon'a kapalı,
# tüm okuma/yazma /api/* üzerinden servis rolüyle yapılır).
# RLS doğru kurulduğu sürece public olması güvenlidir.
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVIS ROLÜ ANAHTARI — RLS'i BYPASS EDER, veritabanında her şeye
# okuma/yazma hakkı verir. ASLA client'a sızmamalı:
#   • astro.config.mjs'te `context: 'server'` + `access: 'secret'`
#   • yalnızca src/lib/server/supabaseAdmin.ts üzerinden, sadece /api/*
#     route'larından erişilir (8 uç: bookings, content, public-booking,
#     b2b-booking, guest-checkin, auth/login, auth/session, auth/users)
#     + src/lib/server/rateLimit.ts
# Tanımsızsa rezervasyon/CRM kayıtları buluta yazılmaz (localStorage'da kalır).
SUPABASE_SERVICE_ROLE_KEY=

# --- OPERASYON PANELİ -----------------------------------------------------
# /ops-login geçiş dönemi şifresi. ADMIN_PASSCODE tanımlı DEĞİLSE paneller
# fail-closed kalır (src/middleware.ts `isAuthConfigured()` kontrolü) —
# yani /admin erişilemez olur. Bilinçli olarak varsayılan şifre yoktur.
# Üyelik/rol sistemi (Supabase) kuruluysa bu şifre yedek olarak kullanılır.
ADMIN_PASSCODE=

# ==========================================================================
# NOTLAR
#
# 1) supabaseAdmin.ts servis anahtarını şu sırayla dener:
#      SUPABASE_SERVICE_ROLE_KEY → SUPABASE_SERVICE_KEY →
#      SUPABASE_SECRET_KEY → SUPABASE_SERVICE_ROLE → SERVICE_ROLE_KEY
#    Sadece ilki gerekli; diğerleri eski kurulumlarla uyum için duruyor.
#    Yeni kurulumda yalnızca SUPABASE_SERVICE_ROLE_KEY doldur.
#
# 2) Şemada ayrıca SUPABASE_URL tanımlı (PUBLIC_SUPABASE_URL'nin sunucu
#    tarafı eşdeğeri). İkisi aynı değeri alır; genelde sadece PUBLIC_ olanı
#    doldurmak yeterli.
#
# 3) npm uyarısı: paket kurulumu plaintext HTTP üzerinden yapılıyorsa npm
#    "must use TLS 1.2 or higher" uyarısı verir. Düzeltme:
#      npm config set registry https://registry.npmjs.org/
# ==========================================================================

# --- SITE DEPLOY HOOK -----------------------------------------------------
# Vercel Project → Settings → Deploy Hooks'tan olusturulur.
# Panel CMS kaydetme sonrasi otomatik site yeniden insa tetiklenir.
# Boylece panelde galeri/fiyat degisikligi bir-iki dakika icinde canli
# sayfaya yansir (statik sayfalar build'den geldigi icin tetik sart).
VERCEL_DEPLOY_HOOK=

# Not: Media Storage bucket (panel fotoğrafları) Supabase SQL Editor'da
# scripts/supabase-schema.sql sonundaki storage bölümü çalıştırılarak
# oluşturulur. Ek env değişkeni GEREKMEZ — aynı service role anahtarı.

# --- WHATSAPP CLOUD API (META) --------------------------------------------
# Meta WhatsApp Business Cloud API entegrasyonu.
# Tanımsızsa sistem otomatik simülasyon modunda çalışır ve wa.me yedeğini kullanır.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=phuket_tatili_webhook_verify_2026
WHATSAPP_APP_SECRET=

# --- CRON SECRET ----------------------------------------------------------
# Vercel Cron veya dış zamanlayıcıların /api/whatsapp/dispatch-reminders
# ucunu yetkilendirmek için kullandığı gizli anahtar.
CRON_SECRET=

PUBLIC_GA_ID=G-XXXXXXXXXX
PUBLIC_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- SENTRY (HATA İZLEME) --------------------------------------------------
# Opsiyonel: boş bırakılırsa SDK hiç etkinleşmez, bundle'a maliyeti yoktur.
# Sentry.io'da proje oluşturup Client Keys sayfasındaki DSN'u kopyalayın.
# Sunucu tarafı: Vercel env'e SENTRY_DSN ekle.
# Tarayıcı tarafı: Vercel env'e PUBLIC_SENTRY_DSN ekle (public değerdir).
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
